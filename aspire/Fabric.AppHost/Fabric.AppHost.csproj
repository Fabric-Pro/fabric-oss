<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <!-- Emits packages.lock.json so the NuGet graph is scannable by the
         Dependency audit gate (SECURITY.md § CI enforcement). Without a lock
         file osv-scanner has nothing to read and the .NET surface is silently
         outside the audit. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>fabric-apphost-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <!-- Preview channel: Browsers is still gated behind ASPIREBROWSERLOGS001 in 13.6.x -->
    <PackageReference Include="Aspire.Hosting.Browsers" Version="13.6.4-preview.1.26523.11" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

</Project>

