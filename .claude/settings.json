{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-bash.mjs"
					},
					{
						"type": "command",
						"if": "Bash(git commit *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-claude-attribution.mjs"
					},
					{
						"type": "command",
						"if": "Bash(gh pr *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-claude-attribution.mjs"
					},
					{
						"type": "command",
						"if": "Bash(*prisma db push*)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-prisma-db-push.mjs"
					},
					{
						"type": "command",
						"if": "Bash(*psql *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-sql.mjs"
					},
					{
						"type": "command",
						"if": "Bash(*psql *)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-shared-env-sql-writes.mjs"
					},
					{
						"type": "command",
						"if": "Bash(git push*)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-branch-naming.mjs"
					},
					{
						"type": "command",
						"if": "Bash(gh pr create*)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-quality-gate.mjs"
					},
					{
						"type": "command",
						"if": "Bash(gh pr edit*)",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pr-quality-gate.mjs"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-paths.mjs"
					}
				]
			}
		]
	}
}
