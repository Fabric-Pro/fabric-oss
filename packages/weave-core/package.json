{
	"name": "@repo/weave-core",
	"private": true,
	"version": "0.1.3",
	"license": "Apache-2.0",
	"description": "Core utilities and types for fabric-weave multi-agent orchestration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./skills": {
			"types": "./dist/skills/index.d.ts",
			"import": "./dist/skills/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"eval": "bun run evals/runner.ts"
	},
	"dependencies": {
		"@repo/database": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"typescript": "^5.3.0"
	}
}
