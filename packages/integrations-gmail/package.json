{
	"name": "@fabricorg/integrations-gmail",
	"version": "0.1.10",
	"description": "Gmail integration plugin for Fabric — type augmentation + runtime",
	"keywords": [
		"fabric",
		"gmail",
		"google",
		"integration"
	],
	"homepage": "https://fabric.pro",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fabric-Pro/fabric-oss.git",
		"directory": "packages/integrations-gmail"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md",
		"LICENSE-APACHE-2.0"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"type-check": "tsgo --noEmit"
	},
	"peerDependencies": {
		"@fabricorg/sdk": "workspace:*"
	},
	"dependencies": {
		"@fabricorg/integrations-runtime": "workspace:*"
	},
	"devDependencies": {
		"@fabricorg/sdk": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"tsdown": "^0.23.0",
		"typescript": "5.9.3"
	}
}
