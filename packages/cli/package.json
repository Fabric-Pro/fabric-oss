{
	"name": "@fabricorg/cli",
	"version": "0.5.1",
	"description": "CLI for the Fabric AI platform",
	"keywords": [
		"fabric",
		"ai",
		"cli",
		"developer-tools"
	],
	"homepage": "https://fabric.pro",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fabric-Pro/fabric-oss.git",
		"directory": "packages/cli"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"fabric": "./dist/fabric.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"pack:deployment": "node scripts/pack-deployment.mjs",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"fabric": "node --import tsx/esm src/bin/fabric.ts"
	},
	"dependencies": {
		"@fabricorg/sdk-mcp": "workspace:*",
		"cli-table3": "^0.6.5",
		"commander": "^13.1.0",
		"conf": "^13.1.0",
		"fflate": "^0.8.3",
		"ignore": "7.0.9"
	},
	"devDependencies": {
		"@fabricorg/sdk": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"tsup": "^8.0.0",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"vitest": "^4.1.11"
	}
}
