{
	"name": "@repo/openapi-tools",
	"version": "0.0.3",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./parser": {
			"types": "./src/lib/parser.ts",
			"default": "./src/lib/parser.ts"
		},
		"./executor": {
			"types": "./src/lib/executor.ts",
			"default": "./src/lib/executor.ts"
		},
		"./describe": {
			"types": "./src/lib/describe.ts",
			"default": "./src/lib/describe.ts"
		},
		"./render": {
			"types": "./src/lib/render.ts",
			"default": "./src/lib/render.ts"
		}
	},
	"scripts": {
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@apidevtools/swagger-parser": "^10.1.1",
		"@repo/database": "workspace:*",
		"@repo/logs": "workspace:*",
		"js-yaml": "^4.3.0",
		"openapi-types": "^12.1.3",
		"zod": "4.0.5"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.15.29",
		"typescript": "5.9.3",
		"vitest": "^4.1.8"
	}
}
