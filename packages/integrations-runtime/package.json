{
	"name": "@fabricorg/integrations-runtime",
	"version": "0.1.0",
	"description": "Plugin contract and runtime for Fabric integrations (Apache-2.0 attribution to Corsair)",
	"keywords": [
		"fabric",
		"integrations",
		"plugins",
		"oauth",
		"webhooks"
	],
	"homepage": "https://fabric.pro",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fabric-Pro/fabric-oss.git",
		"directory": "packages/integrations-runtime"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md",
		"LICENSE-APACHE-2.0"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"tsup": "^8.0.0",
		"typescript": "5.9.3"
	}
}
