{
	"name": "@fabricorg/mcp-server",
	"version": "1.0.0",
	"description": "Server-side primitives for Fabric's hosted MCP server (sessions, access control, rate limiting)",
	"type": "module",
	"private": true,
	"main": "./index.ts",
	"exports": {
		".": "./index.ts"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@upstash/ratelimit": "^2.0.7",
		"@upstash/redis": "^1.35.8",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^22.15.29",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"fabric",
		"browser-automation",
		"ai-tools"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fabric-Pro/fabric-oss.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
