// =============================================================================
// PROJECT REPOSITORY INTEGRATIONS
// =============================================================================
// Project-level repository credentials shared with all project members.
// Owner configures once; any member can use repo as read-only LLM context.

enum RepositoryProvider {
  GITHUB
  GITLAB
  AZURE_DEVOPS
}

enum RepositoryAuthMethod {
  OAUTH
  PAT
}

enum RepositoryIntegrationStatus {
  ACTIVE
  TOKEN_EXPIRED
  // The credential itself is fine, but it cannot read THIS repository — the
  // provider app is not installed on it, or the token is scoped away from it.
  // Deliberately NOT a credential verdict: reconnecting cannot fix it, so the
  // recovery hint points at installing the app / re-adding with a PAT instead.
  REPO_UNAVAILABLE
  ERROR
  DISCONNECTED
}

model ProjectRepositoryIntegration {
  id        String @id @default(cuid())
  projectId String

  // Provider
  provider   RepositoryProvider
  authMethod RepositoryAuthMethod

  // Repository identification
  repositoryUrl   String
  repositoryOwner String
  repositoryName  String
  defaultBranch   String   @default("main")
  roleTag         String?  // Role tag/label (e.g., "Legacy", "New", "V1 Reference")
  // Branch the QA pipeline-results sync watches for CI runs. NULL = follow
  // defaultBranch. Separate from defaultBranch because that one also drives code
  // indexing: a team whose CI publishes test reports on `develop` must be able to
  // point QA there without moving what Atlas indexes.
  qaBranch        String?
  // Atlas branch pinning (per project+repo) — branches the user keeps handy in
  // the branch switcher. Display-only convenience; does not change monitoring.
  pinnedBranches  String[] @default([])

  // Encrypted credentials (server-side only, never returned to frontend)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  tokenScopes           String[]

  // For Azure DevOps PAT
  encryptedPat      String?
  azureOrganization String?

  // Status & health
  status          RepositoryIntegrationStatus @default(ACTIVE)
  lastHealthCheck DateTime?
  lastError       String?
  // Consecutive definitive-negative repo probes (not-found / forbidden) while
  // in REPO_UNAVAILABLE. At the sweep's retirement threshold the row leaves
  // the periodic sweep — a deleted/renamed repo can never self-heal, so
  // re-probing it forever is pure waste. Reset by reconnect, attachPat, or a
  // successful probe (accessible).
  probeFailCount  Int                         @default(0)

  // Set when the provider rejected the stored REFRESH token itself (a
  // grant-shaped OAuth rejection such as GitHub's `bad_refresh_token`), as
  // opposed to a platform-side refresh failure. TOKEN_EXPIRED alone does not
  // say which happened, and the scheduled health check keeps re-sweeping
  // TOKEN_EXPIRED OAuth rows precisely because a refresh usually recovers them.
  // Once the grant is dead no retry can recover it — only a user reconnect —
  // so this marker retires the row from that sweep. Cleared on every successful
  // refresh and on reconnect.
  refreshTokenRejectedAt DateTime?

  // Audit — nullable so the record survives if the configuring user is removed
  configuredByUserId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configuredBy User?   @relation("RepoIntegrationConfiguredBy", fields: [configuredByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, provider, repositoryOwner, repositoryName])
  @@index([projectId])
  @@index([status])
  @@map("project_repository_integration")
}

