// Edit history for a node override — one row per changed field per edit.
model AtlasNodeOverrideHistory {
  id         String @id @default(cuid())
  overrideId String

  field          String // "description" | "category"
  oldValue       String? @db.Text
  newValue       String? @db.Text
  editedByUserId String?

  // Tenant isolation (scalar columns for RLS; cascade handled via `override`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  override AtlasNodeOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_node_override_history")
}

// ── Multi-repo "System map": cross-repository relationships ───────────────────

enum AtlasCrossEdgeKind {
  SHARES_LIBRARY // both repos depend on the same significant library
  DEPENDS_ON // repo A imports/depends on repo B's published package
  CALLS_API // an A module/client calls B's API/endpoint (AI-derived)
  RELATES_TO // shared business domain/capability across repos (AI-derived)
}

enum AtlasCrossEdgeDetection {
  STRUCTURAL // deterministic (manifest/dependency match)
  AI // model-inferred from module/capability summaries
}

enum AtlasCrossLinkStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

// One detected cross-repository relationship between two analyses in a project.
// Lives OUTSIDE AtlasEdge (which is analysisId-scoped, with node
// `key`s unique only within one analysis). Endpoints reference (analysis, key);
// a null key means the repository itself (its System-map group container node).
model AtlasCrossEdge {
  id        String                  @id @default(cuid())
  projectId String
  mode      AtlasGraphMode
  kind      AtlasCrossEdgeKind
  detection AtlasCrossEdgeDetection

  sourceAnalysisId String
  sourceKey        String? // null = the source repository (group) itself
  targetAnalysisId String
  targetKey        String? // null = the target repository (group) itself

  weight      Int?
  description String? @db.Text // rationale / evidence (esp. AI-derived)

  // Tenant isolation (scalar columns for RLS; cascade via `project`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, mode, kind, sourceAnalysisId, sourceKey, targetAnalysisId, targetKey])
  @@index([projectId, mode])
  @@index([sourceAnalysisId])
  @@index([targetAnalysisId])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_cross_edge")
}

// Per-project cross-link run state: a freshness signature (recompute when the
// participating analyses/commits change), status, and AI telemetry. Mirrors the
// Analysis/AnalysisRun split.
model AtlasCrossLink {
  id        String               @id @default(cuid())
  projectId String               @unique
  status    AtlasCrossLinkStatus @default(PENDING)

  signature                String? // hash of participating analysisId+commitSha
  repositoryIntegrationIds String[] @default([]) // repos in the last link run
  edgeCount                Int      @default(0)

  model        String?
  totalTokens  Int?
  costMicroUsd Int? // micro-USD (1μ$ = $10^-6)
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?

  // Tenant isolation (scalar columns for RLS; cascade via `project`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("atlas_cross_link")
}

// One row per cross-link RECOMPUTE — the project-level "System map" relationship
// history (mirrors the Analysis/AnalysisRun split). Written whenever the cross
// edges are actually recomputed: `auto` (a stale signature, e.g. after a repo
// re-analysis), `remap` (user forced a recompute, edits preserved), or
// `remap_fresh` (user reset all cross-repo edits first). Surfaces in the System
// map's relationship history with time / cost / tokens / model / edge count.
model AtlasCrossLinkRun {
  id                String         @id @default(cuid())
  projectId         String
  triggeredByUserId String?
  trigger           String // "auto" | "remap" | "remap_fresh"
  status            AtlasRunStatus @default(RUNNING)

  repositoryIntegrationIds String[] @default([]) // repos participating in this run
  edgeCount                Int      @default(0)

  model        String?
  totalTokens  Int?
  costMicroUsd Int? // micro-USD (1μ$ = $10^-6)
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?

  // Tenant isolation (scalar columns for RLS; cascade via `project`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_cross_link_run")
}

// Shared per-project node positions for the multi-repo "System map" canvas.
// Keyed by the System-map React-Flow node id (`repo::${analysisId}` for repo
// group containers, `${analysisId}::${key}` for real cards) per (project, mode).
// Project-level + last-write-wins (NOT per-user) — mirrors how the single-repo
// layout lives on the node row so every member sees the same arrangement.
model AtlasSystemLayout {
  id        String         @id @default(cuid())
  projectId String
  mode      AtlasGraphMode
  nodeId    String // System-map RF node id (`repo::…` group, `${analysisId}::${key}` card)
  x         Float
  y         Float

  // Tenant isolation (scalar columns for RLS; cascade via `project`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One position per (project, mode, System-map node id).
  @@unique([projectId, mode, nodeId])
  @@index([projectId, mode])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_system_layout")
}

// STABLE user overrides for a GRAPH EDGE (solo intra-repo + System-map
// cross-repo). Keyed by ENDPOINTS — (repo integration + node key) for each side
// — NOT by analysisId, so the override SURVIVES re-analysis/recompute (it is
// overlaid onto whichever analysis currently serves that branch). Carries an
// optional user description, a manual-edge flag (user-created edge with no
// underlying AI/structural edge), a cross-repo flag, and a soft-delete marker
// (`deletedAt`). A null repository integration id = the project's legacy/default
// repo. Never deleted with an analysis.
model AtlasEdgeOverride {
  id        String         @id @default(cuid())
  projectId String
  branch    String         @default("main")
  mode      AtlasGraphMode

  sourceRepositoryIntegrationId String? // null = project's legacy/default repo
  sourceKey                     String
  targetRepositoryIntegrationId String? // null = project's legacy/default repo
  targetKey                     String

  kind            String // edge kind label for manual edges (RELATES_TO|CALLS_API|DEPENDS_ON|IMPORTS…)
  userDescription String?   @db.Text
  isManual        Boolean   @default(false) // true = user-created edge with no underlying AI/structural edge
  isCrossRepo     Boolean   @default(false) // true when source repo ≠ target repo
  // true = a reference GENERATED by the solo "re-map relationships" AI pass (stored
  // as a manual override so it overlays + survives re-analysis). Distinguishes
  // regeneratable AI references from hand-authored user edits: a "keep my edits"
  // re-map deletes only `isAiGenerated` rows; the moment a user edits or deletes one
  // it flips to false (becomes a user edit) and is then preserved across re-maps.
  isAiGenerated   Boolean   @default(false)
  // true = the user EXPLICITLY chose this edge's `kind` (re-typed the connection),
  // so the read overlay applies `kind` over the detected AI/structural kind. Stays
  // false for description-only edits + delete tracking overrides (whose `kind` is a
  // preserved/default value that must NOT override the real detected kind).
  isUserKind      Boolean   @default(false)
  deletedAt       DateTime? // soft-delete; null = active
  updatedByUserId String? // who last edited (nullable so the row survives user removal)

  // Tenant isolation (scalar columns for RLS; cascade via `project`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history AtlasEdgeOverrideHistory[]

  // One override per (project, branch, mode, source endpoint, target endpoint).
  @@unique([projectId, branch, mode, sourceRepositoryIntegrationId, sourceKey, targetRepositoryIntegrationId, targetKey])
  @@index([projectId, mode])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_edge_override")
}

// Edit history for an edge override — one row per action (created/description/
// deleted/restored).
model AtlasEdgeOverrideHistory {
  id         String @id @default(cuid())
  overrideId String

  action         String // "created" | "description" | "deleted" | "restored"
  oldValue       String? @db.Text
  newValue       String? @db.Text
  editedByUserId String?

  // Tenant isolation (scalar columns for RLS; cascade via `override`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  override AtlasEdgeOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_edge_override_history")
}

// Linked Meetings - Which recurring meetings are linked to a project for transcript sync
model ProjectLinkedMeeting {
  id               String   @id @default(cuid())
  projectId        String
  joinUrl          String // Teams meeting join URL (stable across recurring instances)
  subject          String?
  organizer        String?
  // Admin toggle: whether this meeting appears in the project Meeting Digest. Default true so
  // all currently-linked meetings show up immediately.
  includedInDigest Boolean  @default(true)
  linkedAt         DateTime @default(now())
  userId           String?
  organizationId   String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  transcripts ProjectMeetingTranscript[]
  agendas     ProjectMeetingAgenda[]

  @@unique([projectId, joinUrl])
  @@index([projectId])
  @@map("project_linked_meeting")
}

// Meeting Transcripts - Tracks synced transcript instances for dedup and metadata
// Per-transcript lifecycle for the auditable auto-analysis scan-status view.
// NOT_SCANNED -> IN_PROGRESS (atomic claim) -> SCANNED | FAILED.
enum MeetingTranscriptAnalysisStatus {
  NOT_SCANNED
  IN_PROGRESS
  SCANNED
  FAILED
}

model ProjectMeetingTranscript {
  id                       String                          @id @default(cuid())
  projectId                String
  linkedMeetingId          String
  meetingId                String // Online meeting ID from Graph API (per-instance)
  transcriptId             String // Transcript ID from Graph API
  meetingSubject           String?
  meetingDate              DateTime?
  contextId                String? // FK to ProjectContext created for this transcript
  summary                  String?                         @db.Text
  keywords                 String[]
  speakerNames             String[]
  contentLength            Int?
  wasSummarized            Boolean                         @default(false)
  extractedDecisions       Json?
  // Indexes into extractedDecisions a user dismissed as ADL candidates, so a
  // declined meeting decision is never re-suggested.
  dismissedDecisionIndexes Int[]                           @default([])
  extractedActionItems     Json?
  extractedQuestions       Json?
  insightsExtractedAt      DateTime?
  insightsVersion          Int?
  // Auto-analysis (monitored-meeting -> feature proposal) lifecycle + linkage markers.
  // analysisStatus is the claim/lifecycle marker that drives the per-transcript
  // scan-status view: NOT_SCANNED -> IN_PROGRESS (atomic compare-and-set claim) ->
  // SCANNED | FAILED. The NOT_SCANNED->IN_PROGRESS CAS is the "analyze exactly once"
  // guard — a transcript is never re-analyzed once it leaves NOT_SCANNED.
  analysisStatus           MeetingTranscriptAnalysisStatus @default(NOT_SCANNED)
  analysisStartedAt        DateTime?
  // Last terminal failure (set by the workflow once the analyze activity exhausts its
  // retries) — surfaced as "Failed" in the scan-status view.
  analysisError            String?                         @db.Text
  analysisFailedAt         DateTime?
  // analyzedAt is the completion timestamp: set on SCANNED (including zero-change runs).
  analyzedAt               DateTime?
  // PendingBacklogProposal created from this transcript (NULL when the run produced zero changes).
  analyzedProposalId       String?
  // Action-item linking cache (#1902), mirroring the insightsExtractedAt /
  // insightsVersion pair above: a meeting is matched against the backlog once
  // per link version, so re-opening it never re-spends embedding + LLM tokens.
  actionItemsLinkedAt      DateTime?
  actionItemsLinkVersion   Int?
  syncedAt                 DateTime                        @default(now())
  userId                   String?
  organizationId           String?

  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedMeeting   ProjectLinkedMeeting       @relation(fields: [linkedMeetingId], references: [id], onDelete: Cascade)
  user            User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourcedStories  UserStory[]                @relation("StorySourceMeeting")
  actionItems     ProjectMeetingActionItem[]
  actionItemLinks MeetingActionItemLink[]

  @@unique([projectId, meetingId, transcriptId])
  @@index([projectId])
  @@index([linkedMeetingId])
  @@index([meetingDate])
  @@map("project_meeting_transcript")
}

// Action items extracted from a meeting transcript (#1814). First-class rows
// (not Json) so members can check them off; `extractedActionItems` Json on the
// transcript is kept in sync during the transition for rollback. Completion is
// manual (completedAt/completedById); re-extraction replaces rows but carries
// completion over by normalized text match.
model ProjectMeetingActionItem {
  id                 String    @id @default(cuid())
  transcriptId       String // FK to ProjectMeetingTranscript.id (cuid)
  orderIndex         Int
  text               String    @db.Text
  tentativeOwnerName String?
  dueHint            String?
  completedAt        DateTime?
  completedById      String?
  sourceQuote        String? // #1896: verbatim transcript excerpt evidencing this item
  anchorLine         Int? // #1896: resolved line number into the transcript body
  createdAt          DateTime  @default(now())

  // Tenant isolation (scalar columns, mirroring ProjectMeetingTranscript)
  userId         String?
  organizationId String?

  transcript  ProjectMeetingTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  completedBy User?                    @relation("MeetingActionItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([transcriptId, orderIndex])
  @@index([transcriptId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_meeting_action_item")
}

/// How a link between a meeting action item and a work item came to be (#1902).
/// AUTO is the matcher's suggestion; MANUAL is a person's; CREATED is stamped
/// when a work item is created from the action item itself. Only AUTO rows are
/// ever written or skipped by a matching run — a person's decision is never
/// overwritten by the machine.
enum MeetingActionItemLinkOrigin {
  AUTO
  MANUAL
  CREATED

  @@map("meeting_action_item_link_origin")
}

/// DISMISSED is a tombstone, not a delete. Removing a link must be durable
/// against the next matching run, which would otherwise re-suggest exactly the
/// link the user just rejected — the same problem StoryDuplicateLink solves with
/// its DISMISSED status and listDismissedDuplicatePairKeys.
enum MeetingActionItemLinkStatus {
  ACTIVE
  DISMISSED

  @@map("meeting_action_item_link_status")
}

/// Link from a meeting action item to a work item (#1902).
///
/// Keyed on `itemKey` (sha256 of the normalized action item text) rather than on
/// ProjectMeetingActionItem.id, because extraction deletes and recreates those
/// rows on every run — see meeting-action-item-keys.ts for the full rationale.
/// `itemTextSnapshot` keeps the back-reference readable (and the deep link
/// usable) even after a re-extraction rewords the item out from under the key.
model MeetingActionItemLink {
  id               String                      @id @default(cuid())
  transcriptId     String
  projectId        String
  itemKey          String // sha256(normalizeItemText(text)), version-prefixed
  itemTextSnapshot String                      @db.Text
  storyId          String
  origin           MeetingActionItemLinkOrigin
  status           MeetingActionItemLinkStatus @default(ACTIVE)

  // Match provenance — AUTO rows only. Surfaced in the digest tooltip so a
  // suggestion reads as a suggestion (ai-copy-tone.md), never as a fact.
  similarity Float?
  confidence Float?
  reasoning  String? @db.Text

  createdById   String?
  createdAt     DateTime  @default(now())
  dismissedAt   DateTime?
  dismissedById String?

  // Tenant isolation (scalar columns, mirroring ProjectMeetingActionItem).
  userId         String?
  organizationId String?

  transcript ProjectMeetingTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story      UserStory                @relation(fields: [storyId], references: [id], onDelete: Cascade)

  // One row per (item, work item) pair — this is what makes the tombstone
  // durable and makes an upsert the natural revive path.
  @@unique([transcriptId, itemKey, storyId])
  @@index([storyId])
  @@index([transcriptId, status])
  @@index([projectId])
  @@map("meeting_action_item_link")
}

enum MeetingAgendaStatus {
  GENERATING
  READY
  FAILED

  @@map("meeting_agenda_status")
}

/// One SHARED agenda per upcoming meeting occurrence (#1901).
///
/// Identity is (linkedMeetingId, occurrenceStart), never a Graph event id:
/// Graph returns a DIFFERENT event id to every attendee for the same
/// occurrence, so an event-id key would fork the agenda per viewer. joinUrl is
/// stable across both the series and all attendees, and ProjectLinkedMeeting is
/// keyed on it.
///
/// Reschedule handling: the unique constraint is on the exact timestamp, but
/// getAgenda and generateAgenda both resolve on (linkedMeetingId, same UTC day)
/// so a meeting moved from 10:00 to 14:00 keeps its agenda instead of silently
/// forking into two. Caveat: a meeting recurring twice in one UTC day would
/// share one agenda.
///
/// `content` (markdown) is the sole source of truth once generated.
/// `generatedStructure` is provenance only and is NEVER read back — that is what
/// keeps FR3 editing simple, since no structured document has to be reconciled
/// against free-form user edits.
model ProjectMeetingAgenda {
  id              String   @id @default(cuid())
  projectId       String
  linkedMeetingId String
  occurrenceStart DateTime // UTC — occurrence identity

  status             MeetingAgendaStatus @default(GENERATING)
  content            String?             @db.Text // markdown; null until READY
  generatedStructure Json? // provenance only, never re-read
  contextStats       Json? // source counts + hadPriorTranscripts (drives FR5)
  // Which prompt produced this agenda (#2178 follow-up). Display-only, never
  // re-read for logic. Null for every agenda generated before the prompt became
  // editable, and the UI omits the line for those rather than claiming the
  // default was used.
  promptProvenance   Json?

  generatedAt        DateTime?
  generationError    String?   @db.Text
  temporalWorkflowId String?

  editedAt   DateTime?
  editedById String?
  version    Int       @default(1) // optimistic concurrency

  createdAt      DateTime @default(now())
  createdById    String
  userId         String?
  organizationId String?

  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedMeeting ProjectLinkedMeeting @relation(fields: [linkedMeetingId], references: [id], onDelete: Cascade)
  editedBy      User?                @relation("MeetingAgendaEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([linkedMeetingId, occurrenceStart])
  @@index([projectId, occurrenceStart])
  @@map("project_meeting_agenda")
}

// Slack Huddle Notes — tracking table for auto-synced huddle AI-notes canvases.
// Mirrors ProjectMeetingTranscript but keys on the canvas file id for
// update-in-place dedup (a just-posted canvas is empty, then populates; the
// contentHash drives the "did it change since last poll" decision).
model ProjectSlackHuddleNote {
  id              String @id @default(cuid())
  projectId       String
  linkedChannelId String // FK to ProjectLinkedSlackChannel
  canvasId        String // Slack canvas file id (the AI-notes file) — the dedup anchor
  channelId       String // Slack channel id the canvas was posted in
  slackTeamId     String // Slack workspace id

  // Canvas-carried huddle metadata (best-effort; may be absent on some payloads)
  huddleTranscriptFileId String?
  huddleSummaryId        String?
  huddleDateStart        DateTime?
  huddleDateEnd          DateTime?
  title                  String?

  contextId String? // FK to the ProjectContext created/updated for this canvas

  // Hash of the parsed markdown body. When the populated body arrives the hash
  // changes and we update in-place. Re-poll with an unchanged hash is a no-op.
  contentHash   String?
  contentLength Int?
  wasSummarized Boolean  @default(false)
  speakerNames  String[]

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String?
  organizationId String?

  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linkedChannel ProjectLinkedSlackChannel @relation(fields: [linkedChannelId], references: [id], onDelete: Cascade)
  user          User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, canvasId])
  @@index([projectId])
  @@index([linkedChannelId])
  @@index([huddleDateStart])
  @@map("project_slack_huddle_note")
}

// Teams Channel Monitor - Designated Teams channels polled for feature extraction
model ProjectLinkedTeamsChannel {
  id            String   @id @default(cuid())
  projectId     String
  teamId        String
  channelId     String
  teamName      String?
  channelName   String?
  channelWebUrl String?
  linkedAt      DateTime @default(now())

  // Incremental polling cursor (uses thread lastModifiedDateTime as source)
  lastMessageCreatedAt DateTime?
  lastMessageId        String?

  // Graph @odata.nextLink pagination token persisted between ticks when the
  // activity-level scan budget is exhausted before reaching unseen threads.
  // The next tick resumes from this point so busy channels with large
  // backlogs progress forward every tick instead of starving.
  scanPageToken String? @db.Text

  // Per-channel fault isolation state
  consecutiveFailures Int       @default(0)
  lastErrorMessage    String?   @db.Text
  lastErrorAt         DateTime?

  userId         String?
  organizationId String?

  // Microsoft Teams tenant ID for webhook event validation (security)
  tenantId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  seenMessages ProjectLinkedTeamsChannelSeenMessage[]

  @@unique([projectId, teamId, channelId])
  @@index([tenantId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_linked_teams_channel")
}

// Dedup marker: root message IDs already fed to the analyzer (one row per thread)
model ProjectLinkedTeamsChannelSeenMessage {
  id                String   @id @default(cuid())
  linkedChannelId   String
  messageId         String
  createdAt         DateTime @default(now())
  pendingProposalId String?

  linkedChannel   ProjectLinkedTeamsChannel @relation(fields: [linkedChannelId], references: [id], onDelete: Cascade)
  pendingProposal PendingBacklogProposal?   @relation(fields: [pendingProposalId], references: [id], onDelete: SetNull)

  @@unique([linkedChannelId, messageId])
  @@index([linkedChannelId])
  @@map("project_linked_teams_channel_seen_message")
}

// Teams Chat Monitor - Designated Microsoft Teams group chats polled for feature extraction.
// Mirrors ProjectLinkedTeamsChannel but anchored to a chatId (no team/channel hierarchy).
model ProjectLinkedTeamsChat {
  id         String   @id @default(cuid())
  projectId  String
  chatId     String
  chatTopic  String?
  chatWebUrl String?
  linkedAt   DateTime @default(now())

  // Incremental polling cursor
  lastMessageCreatedAt DateTime?
  lastMessageId        String?

  // Graph @odata.nextLink resume token persisted between ticks when the
  // activity-level scan budget runs out before reaching unseen messages.
  scanPageToken String? @db.Text

  // Per-chat fault isolation state
  consecutiveFailures Int       @default(0)
  lastErrorMessage    String?   @db.Text
  lastErrorAt         DateTime?

  userId         String?
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  seenMessages ProjectLinkedTeamsChatSeenMessage[]

  @@unique([projectId, chatId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_linked_teams_chat")
}

// Dedup marker: chat message IDs already fed to the analyzer. Each new message
// is treated as its own "thread" (chats have no native reply hierarchy in
// Microsoft Graph), so this is a per-message marker rather than per-thread.
model ProjectLinkedTeamsChatSeenMessage {
  id                String   @id @default(cuid())
  linkedChatId      String
  messageId         String
  createdAt         DateTime @default(now())
  pendingProposalId String?

  linkedChat      ProjectLinkedTeamsChat  @relation(fields: [linkedChatId], references: [id], onDelete: Cascade)
  pendingProposal PendingBacklogProposal? @relation(fields: [pendingProposalId], references: [id], onDelete: SetNull)

  @@unique([linkedChatId, messageId])
  @@index([linkedChatId])
  @@map("project_linked_teams_chat_seen_message")
}

// Slack Channel Monitor - Linked Slack channels with event-driven ingestion via Slack Events API.
// Mirrors ProjectLinkedTeamsChannel but `lastMessageTs` is a string (Slack's `ts` is "seconds.microseconds")
// and there is no scanPageToken because live messages arrive via webhook signals rather than polling.
model ProjectLinkedSlackChannel {
  id            String   @id @default(cuid())
  projectId     String
  slackTeamId   String // Slack workspace ID (analogous to Microsoft Teams tenant ID)
  channelId     String
  teamName      String?
  channelName   String?
  channelWebUrl String?
  linkedAt      DateTime @default(now())

  // Set when the user enables the monitor; backfill activity uses this as the lower bound.
  monitorEnabled     Boolean   @default(false)
  monitorEnabledAt   DateTime?
  // Set when the one-shot backfill activity completes. Webhook fanout signals the workflow
  // regardless of backfill state; dedup is handled at the seen-message table.
  backfillCompleteAt DateTime?

  // Slack `ts` of the newest message ingested. String-comparable lexicographically
  // (Slack guarantees zero-padded "seconds.microseconds" format).
  lastMessageTs String?

  // Per-channel fault isolation state
  consecutiveFailures Int       @default(0)
  lastErrorMessage    String?   @db.Text
  lastErrorAt         DateTime?

  userId         String?
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  seenMessages ProjectLinkedSlackChannelSeenMessage[]
  huddleNotes  ProjectSlackHuddleNote[]

  @@unique([projectId, slackTeamId, channelId])
  @@index([channelId, slackTeamId]) // webhook fanout lookup
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_linked_slack_channel")
}

// Dedup marker for Slack channel messages. Root message `ts` is the unique key per channel.
// INSERT-as-lock pattern: the analyze activity attempts an insert; unique-violation = another
// path (backfill vs live signal) already claimed this message, so skip the LLM call.
model ProjectLinkedSlackChannelSeenMessage {
  id                String   @id @default(cuid())
  linkedChannelId   String
  messageTs         String
  createdAt         DateTime @default(now())
  pendingProposalId String?

  linkedChannel   ProjectLinkedSlackChannel @relation(fields: [linkedChannelId], references: [id], onDelete: Cascade)
  pendingProposal PendingBacklogProposal?   @relation(fields: [pendingProposalId], references: [id], onDelete: SetNull)

  @@unique([linkedChannelId, messageTs])
  @@index([linkedChannelId])
  @@map("project_linked_slack_channel_seen_message")
}

enum PendingBacklogProposalSource {
  TEAMS_CHANNEL
  TEAMS_CHAT
  SLACK_CHANNEL
  AI_UPDATE_SIDEBAR
  MONITORED_MEETING
}

enum PendingBacklogProposalStatus {
  PENDING
  APPROVED
  APPLIED
  REJECTED
  FAILED
  SUPERSEDED
  // Reviewer-deferred: preserved but hidden from the active review queue and
  // excluded from every "needs-attention" count / context / dedup path exactly
  // like REJECTED. Reversible — a BACKLOG proposal can later be APPROVED or
  // REJECTED. No automatic transitions out (no expiration this phase).
  BACKLOG
}

// Pending backlog proposals awaiting human review (review inbox backing table)
model PendingBacklogProposal {
  id        String                       @id @default(cuid())
  projectId String
  source    PendingBacklogProposalSource
  status    PendingBacklogProposalStatus @default(PENDING)

  proposal       Json
  summary        String @db.Text
  changeCount    Int    @default(0)
  sourceMetadata Json?

  // Indexes into proposal.changes[] that have been successfully applied
  // (story created OR update dispatched). Used for idempotent retries —
  // previously-succeeded changes are skipped when a FAILED proposal is
  // re-approved.
  appliedChangeIndexes Int[] @default([])

  applyWorkflowId String?
  // Wall-clock when an apply workflow was dispatched for this proposal (AI
  // Update apply / retry). Null for awaiting-review proposals that were never
  // dispatched. The stuck-apply watchdog measures staleness from this, NOT
  // `createdAt` — a retry reuses the original row, so its `createdAt` is stale.
  applyStartedAt  DateTime?
  applyError      String?   @db.Text

  // Failure metadata. `applyError` (above) keeps the raw multi-line error text
  // truncated to 4000 chars; the columns below surface a classified cause
  // (`errorClass`) and a clean short summary (`errorMessage`) that the inbox
  // and roadmap banner render directly, plus a precise terminal timestamp
  // so failed proposals can be sorted by recency.
  errorClass   String?
  errorMessage String?   @db.Text
  failedAt     DateTime?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  appliedAt  DateTime?

  userId         String?
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     User?         @relation("PendingBacklogProposalReviewer", fields: [reviewedBy], references: [id])

  seenMessages      ProjectLinkedTeamsChannelSeenMessage[]
  seenChatMessages  ProjectLinkedTeamsChatSeenMessage[]
  seenSlackMessages ProjectLinkedSlackChannelSeenMessage[]
  drafts            BacklogProposalDraft[]

  @@index([projectId, status])
  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  // Stuck-apply watchdog: scans PENDING rows whose apply was dispatched and has
  // since gone stale. Keeps the periodic sweep off a sequential scan.
  @@index([status, applyStartedAt])
  @@map("pending_backlog_proposal")
}

enum BacklogProposalDraftStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Server-persisted, per-kind AI draft of a pending proposal's body. The
// in-review "draft this proposal through the project's prompt" step is a
// ~minute-long LLM call; persisting it here means it runs ONCE per
// (proposal, kind) across ALL users / tabs / sessions instead of re-running on
// every open. The unique (proposalId, kind) key is the atomic claim that makes
// concurrent triggers race-safe (insert-or-read → exactly one draft). The
// server-side `startedAt` is the shared clock for the live "drafting" counter,
// so every tab shows the same elapsed time and it survives refresh. Toggling
// Bug<->Feature drafts the OTHER kind into its own row without cancelling the
// first, so neither in-flight draft is wasted.
model BacklogProposalDraft {
  id         String                     @id @default(cuid())
  proposalId String
  kind       StoryKind
  status     BacklogProposalDraftStatus @default(RUNNING)

  // Populated when status = COMPLETED. The reviewed body is persisted verbatim
  // and used as-is on create (no re-draft at approve).
  description        String?  @db.Text
  acceptanceCriteria String?  @db.Text
  needsMoreInfo      Boolean? // bug triage flag (F-171), carried to create

  // Temporal workflow running the draft — used to cancel an in-flight draft
  // when a reviewer proceeds with creation before it finishes.
  workflowId String?
  error      String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdBy   String?

  proposal PendingBacklogProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, kind])
  @@index([proposalId])
  @@map("backlog_proposal_draft")
}

enum BacklogUpdateSessionStatus {
  APPLYING
  APPLIED
  PARTIALLY_APPLIED
  FAILED
}

// Read-only session log of "AI Backlog Update" runs (the AI Update assistant).
// One row per apply: captures the author, when it ran, the proposed changes, and
// the terminal outcome. Backs the "Session history" tab. Kept SEPARATE from the
// AuditLog (ticket-tied audit trail) by design.
model BacklogUpdateSession {
  id        String @id @default(cuid())
  projectId String

  // The PendingBacklogProposal this apply produced — correlation key for finalize.
  pendingProposalId String?
  // AgentConversation id linking the analyze + apply steps (best-effort; may be null).
  conversationId    String?

  source String                     @default("AI_UPDATE_SIDEBAR")
  status BacklogUpdateSessionStatus @default(APPLYING)

  summary     String @db.Text
  // Snapshot of the proposed changes (action/type/title/reasoning) for the read-only log.
  changes     Json
  changeCount Int    @default(0)
  createCount Int    @default(0)
  updateCount Int    @default(0)

  // Read-only snapshot of the AI Update chat (array of {role, content}) captured
  // at apply time, so the Session history can show the conversation that drove
  // the change. Forward-only — sessions created before capture have none.
  messages Json?

  // Terminal outcome (filled at finalize).
  appliedCount    Int       @default(0)
  failedCount     Int       @default(0)
  syncedToPMCount Int       @default(0)
  errors          Json?
  finalizedAt     DateTime?

  createdAt DateTime @default(now())

  // XOR tenant (both nullable; personal => organizationId null + userId set).
  userId         String?
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([pendingProposalId])
  @@index([userId])
  @@index([organizationId])
  @@map("backlog_update_session")
}

// Project Presence - Real-time tracking of who is viewing a project
model ProjectPresence {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  userName     String
  userImage    String?
  lastSeenAt   DateTime @default(now())
  activeTab    String? // "overview", "documents", "pipeline", "settings"
  editingDocId String? // If editing a specific document

  // Tenant isolation (organizationId copied from parent Project)
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([lastSeenAt])
  @@index([userId])
  @@index([organizationId])
  @@map("project_presence")
}

// Project Activity - Activity feed for real-time updates
model ProjectActivity {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  userName     String
  activityType String // "document_created", "document_updated", "context_added", etc.
  resourceType String? // "document", "context", "project"
  resourceId   String?
  resourceName String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // Tenant isolation (organizationId copied from parent Project)
  organizationId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("project_activity")
}

// AuditLog — append-only ledger of security-relevant events across auth, org,
// project, story, and audit categories. Powers the per-org and per-user audit
// viewer plus deployment-admin diagnostics. See
// `docs/audit-log/README.md §4 for the
// closed taxonomy, cascade rules, and the rationale behind every snapshot
// column. Snapshot fields (`actorEmailSnapshot`, `actorNameSnapshot`,
// `resourceName`) survive FK cascades; `Member` deliberately has no
// back-relation because membership-change events outlive the Member row.
model AuditLog {
  id String @id @default(cuid())

  // Tenant isolation (XOR per AGENTS.md lines 58-99)
  organizationId String?
  userId         String?

  // Actor identity (snapshots survive cascade)
  actorType          String // "user" | "system" | "api_key" | "agent"
  actorEmailSnapshot String?
  actorNameSnapshot  String?
  impersonatedById   String?

  // Event identity
  action   String // e.g. "auth.login.success" (D2 taxonomy)
  category String // "auth" | "org" | "project" | "story" | "audit"
  severity String // "info" | "warning" | "error" | "critical"
  outcome  String // "success" | "failure"

  // Resource identity (snapshots survive cascade)
  resourceType String?
  resourceId   String?
  resourceName String?
  projectId    String?

  // Request context
  ipAddress String?
  userAgent String?
  requestId String?
  sessionId String?

  // Structured details (redacted at write time, see D15)
  metadata Json?

  // Procedure latency in milliseconds (nullable — only populated for
  // request-scoped emissions by the `auditTimingMiddleware`).
  durationMs Int?

  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Tamper-evidence (SOC 2 CC7.2/CC7.3): audit rows must OUTLIVE the org they
  // reference — SetNull (not Cascade) so deleting an organization preserves its
  // audit trail (organizationId nulled; actor/resource/metadata snapshots keep
  // the context). Pairs with the append-only WORM trigger on audit_log.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  // Time-ordered scans with NO tenant/action predicate. Every index above has
  // `createdAt` as a TRAILING column, so none of them can serve a bare
  // createdAt range + sort — and two scheduled jobs do exactly that:
  //
  //   - the hourly seal job (`readWindowPage`) filters
  //     `createdAt >= periodStart AND < periodEnd` ordered by (createdAt, id);
  //   - the daily retention purge deletes `createdAt < cutoff` ordered by
  //     createdAt with a LIMIT subquery.
  //
  // Without this index both fall back to a scan proportional to the WHOLE
  // table, not to their window. The retention activity's own comment already
  // assumed this index existed ("lets each batch scan only the index head",
  // naming a `(createdAt, id)` ordering) — it did not, so the assumption was
  // false and the cost grew with total rows forever. A failed seal run does not
  // advance its window either, so the next run's window is larger: a
  // compounding loop rather than a fixed slowdown.
  //
  // Latent until automatic activity capture multiplied the insert rate. `id` is
  // included so the composite covers the cursor pagination both jobs use.
  @@index([createdAt, id])
  @@map("audit_log")
}

/// Tamper-evidence anchor for the append-only audit_log (SOC 2 CC7.1/CC7.2).
///
/// Each row is a periodic cryptographic "seal" over the immutable content of
/// every audit_log row whose createdAt falls in [periodStart, periodEnd). Seals
/// chain (prevSealHash -> the previous seal's sealHash) and are HMAC-signed with
/// a key held OUTSIDE the database, so modifying, deleting, or inserting a
/// sealed audit row is detectable even by someone who bypassed the WORM trigger.
/// Written only by the `audit-log-seal` Temporal schedule; itself append-only
/// (own WORM trigger, see the add_audit_log_seal migration). Verify with
/// `pnpm --filter @repo/database verify:audit-seals`.
model AuditLogSeal {
  id String @id @default(cuid())

  /// Monotonic chain position (1, 2, 3, ...). Unique so a racing double-seal
  /// fails safely on insert.
  sequence Int @unique

  /// Inclusive lower bound on covered rows' createdAt (the previous seal's
  /// periodEnd; epoch for the genesis seal).
  periodStart DateTime
  /// Exclusive upper bound on covered rows' createdAt (now - safety lag).
  periodEnd   DateTime

  /// Number of audit_log rows covered by this seal.
  rowCount Int

  /// SHA-256 fold over the per-row hashes of the covered rows, in canonical
  /// (createdAt ASC, id ASC) order.
  contentHash  String
  /// sealHash of sequence - 1; null only for the genesis seal.
  prevSealHash String?
  /// SHA-256 over the canonical seal header (sequence/window/rowCount/
  /// contentHash/prevSealHash) — the value that gets signed.
  sealHash     String
  /// HMAC-SHA256(sealHash) as hex, under the key identified by keyId.
  signature    String
  /// Algorithm + non-secret key fingerprint (e.g. "HMAC-SHA256:<fp>") so
  /// verification resolves the right key and keys can rotate non-destructively.
  keyId        String
  /// Seal format version (e.g. "v1") so the hashing scheme can evolve.
  version      String

  createdAt DateTime @default(now())

  @@index([periodEnd])
  @@map("audit_log_seal")
}

// PmSyncLog — append-only, metadata-only ledger of every PM-tool sync attempt
// (push + pull). Powers the per-project Sync History tab and the Review Center
// count. Mirrors `AuditLog` in structure, snapshot philosophy, and tenant
// isolation. Metadata-only by design: NO pushed-content
// snapshot — `errorPayload` holds only error/conflict context. `title`,
// `externalId`, `externalUrl` are deliberate SNAPSHOTS (not joins) so each row
// stays a faithful, self-contained record after the entity is edited or
// deleted. Only SUCCESS/FAILURE/CONFLICT attempts get a row — skipped
// (nothing-to-do) syncs emit none (D4).
model PmSyncLog {
  id String @id @default(cuid())

  createdAt DateTime @default(now()) // attempt timestamp

  direction    String // "push" | "pull"
  entityType   String // "EPIC" | "FEATURE" | "STORY" (plain String, no enum, no TASK)
  entityId     String // Fabric entity id
  title        String // SNAPSHOT of the entity title at attempt time
  pmTool       String // e.g. "azure-devops" | "jira" | "gitlab"
  status       PmSyncLogStatus
  errorPayload Json? // populated for failures (+ conflict context where useful)

  batchId       String? // groups all rows from one Temporal workflow run (D14)
  actorUserId   String? // null for system / poll-driven runs; set for user-triggered pushes
  correlationId String? // Temporal workflow runId — joins log rows to Temporal/Grafana traces
  durationMs    Int? // attempt latency

  externalId  String? // SNAPSHOT of the PM-tool work-item id
  externalUrl String? // SNAPSHOT of the deep-link URL

  // Tenant isolation — XOR organizationId/userId, never both, never OR-filtered.
  organizationId String?
  userId         String?
  projectId      String? // log is per-project (drives Sync History tab + Review Center count)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)]) // Sync History tab + Review Center count
  @@index([entityId, createdAt(sort: Desc)]) // per-item history drill-down
  @@index([batchId]) // group a bulk-push / poll session
  @@index([status, createdAt(sort: Desc)]) // filter failures/conflicts
  @@map("pm_sync_log")
}

// RequestSpan — append-only tail-sampled spans persisted on failure.
// Lightweight observability rows captured by Prisma / Temporal / HTTP
// instrumentation; buffered per request and persisted ONLY when the
// originating request errors (success path drops the buffer). Drives
// the audit-log trace viewer's "what happened underneath" section.
// See `docs/audit-log/README.md and
// `packages/api/lib/request-span.ts`.
//
// TTL: 7 days enforced by an opt-in Temporal cleanup activity (mirrors
// the audit-log retention pattern). Storage is bounded because spans
// only persist on failure (typically << 1% of requests).
model RequestSpan {
  id String @id @default(cuid())

  // Tenant isolation (XOR per AGENTS.md lines 58-99) — copied off the
  // emitting request's audit context so the trace viewer's WHERE plan
  // is identical to the audit-log query.
  organizationId String?
  userId         String?

  // Groups spans into the same request flow. Matches the
  // `metadata.correlationId` of the audit row(s) emitted in the same
  // request — the viewer joins on this field.
  correlationId String

  // One of: db | temporal_workflow | temporal_activity | http_outbound | other.
  // String rather than enum so a new instrumenter can ship without a
  // migration (the renderer falls back to the generic icon).
  kind String

  // Human-readable identifier for the span. For DB spans we use
  // `<Model>.<action>` (e.g. `User.findUnique`); for Temporal we use
  // the workflow / activity type name.
  name String

  // Wall-clock start. `durationMs` is the elapsed time (ms). Null
  // durations are allowed for spans that never completed (rare —
  // typically the request crashed mid-flight).
  startedAt  DateTime
  durationMs Int?

  // `ok | error` — drives the visual tone on the trace view.
  status String

  // Short error message captured from a thrown error. Truncated by the
  // helper at write time so we don't blow up the row size.
  errorMessage String?

  // Arbitrary metadata captured by the instrumenter (e.g. for DB spans
  // the Prisma model + action). Already sanitized at write time.
  attributes Json?

  createdAt DateTime @default(now())

  @@index([correlationId, startedAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("request_span")
}

model ProjectUserPreference {
  id                                String    @id @default(cuid())
  projectId                         String
  userId                            String
  organizationId                    String?
  kanbanLocalRepoPath               String?
  // Welcome-widget dismissal. Set together when the invitee
  // dismisses the dashboard welcome widget. The widget is suppressed only for
  // invites whose expiresAt <= inviteWidgetDismissedInviteExpiry, so a re-invite
  // (which resets ProjectInvitation.expiresAt to a later time) re-surfaces it.
  inviteWidgetDismissedAt           DateTime?
  inviteWidgetDismissedInviteExpiry DateTime?
  // Per-user roadmap view preferences (layout, grouping, sort, card fields +
  // order). JSON so the shape can evolve without a migration; the client
  // sanitizes on read. See apps/web .../hooks/useRoadmapView.ts.
  roadmapView                       Json?
  // Per-user manual roadmap ordering — a { storyId: order } map so each user's
  // drag-to-reorder sequence is personal (the shared story.roadmapOrder stays
  // the default/fallback). Persists immediately on drag (not draft-gated).
  roadmapStoryOrder                 Json?
  // Per-user Architecture Decision Log view preference (list vs table). JSON for
  // forward-compat — the web client owns the shape and sanitizes on read.
  decisionsView                     Json?
  // Quick-access project shortcuts (#1694). Both nullable, and null is
  // meaningful: every row that predates the feature carries null on both, and a
  // descending sort puts nulls FIRST in Postgres — so the shortcut queries
  // filter `IS NOT NULL` per branch rather than relying on ordering alone.
  // Neither column is a tenant filter: organizationId here is a denormalized
  // copy of the project's org, so a guest's row on a host-org project would be
  // invisible in their personal context. Tenancy is derived from whether the
  // related project is reachable. See docs/plans/2026-08-04-001-*.
  favoritedAt                       DateTime?
  // One overwritten marker per user-project pair, not a history of opens.
  lastVisitedAt                     DateTime?
  // Per-user project-tab personalization (Fizzy card 1837), bounded by the
  // admin's Project.projectTabConfig: { hidden: string[], order: string[] }.
  // `hidden` lists tabs this user personally hides; `order` is the user's full
  // desired tab sequence — unlisted tabs append in default order, unknown ids
  // are ignored on read. JSON so the shape evolves without a migration; the
  // client sanitizes against the live tab list. Shape: @repo/database
  // src/project-tabs.ts.
  projectTabPrefs                   Json?
  /// Readiness attention state, per user per project (Fizzy #2165).
  ///
  /// Every attention rule asks "has anything changed since YOU last looked", and
  /// nothing answered that: `lastVisitedAt` above records opening the project,
  /// not opening the checklist, and is overwritten on every visit. Written when
  /// the panel is EXPANDED rather than on page load — opening a project with the
  /// panel collapsed must not clear markers nobody saw.
  readinessSeenAt                   DateTime?
  /// The level at that moment, so a drop (Ready -> Partially, Partially -> Not)
  /// can be detected without storing a history.
  readinessSeenLevel                String?
  /// When the panel last opened itself for this person, capping the daily
  /// auto-expand at once. A regression ignores this cap; routine incompleteness
  /// does not.
  readinessAutoExpandedAt           DateTime?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  // One index per shortcut-resolution branch. A single (userId, lastVisitedAt)
  // index leaves the favorites branch unindexed.
  @@index([userId, lastVisitedAt(sort: Desc)])
  @@index([userId, favoritedAt(sort: Desc)])
  @@map("project_user_preference")
}

enum FunctionTag {
  PRODUCT_OWNER
  PRODUCT_CONTRIBUTOR
  DEVELOPER
  ARCHITECT
  SDET_QA
  SME
  STAKEHOLDER
  DESIGNER
}

model ProjectUserFunctionTag {
  id                  String        @id @default(cuid())
  projectId           String
  userId              String
  organizationId      String?
  tags                FunctionTag[] @default([])
  // Fizzy #2264 (spec §5.1). Confirmed ⇔ a row exists AND confirmedAt is not
  // null; a member with no row at all is unconfirmed, which is the correct
  // default for someone who has never had tags here. Nullable means every
  // existing row is born unconfirmed, so there is no backfill.
  confirmedAt         DateTime?
  // Compare-and-set token for `confirmForProject` (spec §5.7). Every writer of
  // `tags` or `confirmedAt` MUST advance it; a BEFORE UPDATE trigger enforces
  // that. `updatedAt` cannot serve as the token — `@updatedAt` is Prisma client
  // codegen, not a database default, so a raw UPDATE leaves it untouched and
  // every later compare matches the same stale value forever.
  confirmationVersion Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_user_function_tag")
}

// DailyBrief — AI-aggregated morning digest shared across all users of a project.
// One row per (projectId, timeWindowKind). Partial unique index on GENERATING status
// prevents duplicate in-flight regen workflows.
model DailyBrief {
  id                 String   @id @default(cuid())
  projectId          String
  organizationId     String?
  userId             String?
  generatedAt        DateTime @default(now())
  timeWindowStart    DateTime
  timeWindowEnd      DateTime
  timeWindowKind     String // LAST_24H | LAST_7D | LAST_2W | CUSTOM
  status             String // GENERATING | READY | EMPTY | FAILED
  content            Json? // Zod-validated dailyBriefContentSchema (schemaVersion: 1)
  errorMessage       String?
  generatedByUserId  String
  temporalWorkflowId String?
  aiUsageTokens      Int?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation("DailyBriefTenantUser", fields: [userId], references: [id], onDelete: Cascade)
  generatedBy  User             @relation("DailyBriefGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: Cascade)
  views        DailyBriefView[]

  @@index([projectId, generatedAt(sort: Desc)])
  @@index([projectId, status])
  @@index([organizationId])
  @@index([userId])
  @@index([generatedByUserId])
