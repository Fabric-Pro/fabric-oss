// NewsletterSettings — per-project external release-notes newsletter config (1:1 with Project).
model NewsletterSettings {
  id                  String    @id @default(cuid())
  projectId           String    @unique
  organizationId      String?
  userId              String?
  enabled             Boolean   @default(false)
  cadence             String    @default("WEEKLY") // WEEKLY | MONTHLY
  dayOfWeek           Int       @default(1) // 0=Sun..6=Sat, used when cadence=WEEKLY
  dayOfMonth          Int       @default(1) // 1..28, used when cadence=MONTHLY
  sendHourUtc         Int       @default(9) // 0..23
  lastSentAt          DateTime? // advanced only on a successful non-empty send
  lookbackDays        Int? // null => caller fallback (manual 7 / scheduled 7 weekly,30 monthly); else minimum days 1..365
  detailLevel         String    @default("STANDARD") // BRIEF | STANDARD | DETAILED — AI newsletter verbosity tier
  deliveryDestination String    @default("EMAIL") // EMAIL | CHAT | BOTH — where release notes are delivered
  chatChannels        Json? // NewsletterChatChannel[] — selected chat delivery targets; null/[] = none
  approvalChatChannels Json? // NewsletterApprovalChatChannel[] — review-alert targets; null/[] = no chat alerts (Fizzy #2203)
  requireApproval     Boolean   @default(false) // when true, every send is held at PENDING_APPROVAL for reviewer sign-off before delivery

  publicWidgetEnabled     Boolean @default(false)
  publicEmbedToken        String? @unique
  publicEmbedTokenVersion Int     @default(1) // starts at 1; first lazy mint reuses v1 (no bump), each disable/rotate increments. NewsletterSubscriber.embedTokenVersion is stamped from this at subscribe and gate-checked at confirm.
  publicWidgetTheme       String? // "light" | "dark"
  publicWidgetAccent      String? // validated hex e.g. #9F2A3A
  publicWidgetConfig      Json? // { font, radius, width, density }

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([enabled])
  @@map("newsletter_settings")
}

// NewsletterSubscriber — external recipient of a project's newsletter.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  projectId        String
  organizationId   String?
  userId           String?
  email            String
  name             String?
  status           String    @default("ACTIVE") // PENDING_CONFIRMATION | ACTIVE | UNSUBSCRIBED
  unsubscribeToken String    @unique
  createdByUserId  String
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  embedTokenVersion Int? // null = non-embed (marketing/legacy); set = embed-originated, version-gated at confirm

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([projectId, status])
  @@index([userId])
  @@index([organizationId])
  @@map("newsletter_subscriber")
}

// NewsletterSend — one newsletter generation+distribution run (audit + window + idempotency).
model NewsletterSend {
  id                      String    @id @default(cuid())
  projectId               String
  organizationId          String?
  userId                  String?
  dedupeKey               String    @unique // scheduled:<projectId>:<periodBucket> | manual:<projectId>:<windowEndMinuteIso>
  status                  String // PENDING | SENT | PARTIAL | FAILED | SKIPPED_EMPTY
  skipReason              String? // NO_ACTIVE_REPOS | NO_RELEASES | NO_MAJOR_FEATURES | INCOMPLETE_SCAN | NO_SUBSCRIBERS | NO_CHAT_TARGETS (set only when status=SKIPPED_EMPTY)
  trigger                 String // MANUAL | SCHEDULED
  timeWindowStart         DateTime
  timeWindowEnd           DateTime
  recipientCount          Int       @default(0)
  sentCount               Int       @default(0)
  failedCount             Int       @default(0)
  content                 Json? // newsletterContentSchema payload (audit)
  detailLevel             String? // effective verbosity tier used for this send (BRIEF|STANDARD|DETAILED)
  deliveryDestination     String? // effective destination used for this send (EMAIL|CHAT|BOTH)
  requireApproval         Boolean   @default(false) // effective gate decision frozen at row creation (retry-consistency)
  chatChannels            Json? // NewsletterChatChannel[] frozen at creation; send phase reads these, never live settings
  reviewedByUserId        String? // reviewer who approved/rejected
  reviewedAt              DateTime?
  rejectionReason         String? // optional reviewer note on reject
  removedHighlightIndexes Json? // number[] indexes into frozen content.highlights the reviewer dropped
  aiUsageTokens           Int?
  temporalWorkflowId      String?
  errorMessage            String?
  triggeredByUserId       String?
  createdAt               DateTime  @default(now())
  completedAt             DateTime?

  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     NewsletterDelivery[]
  chatDeliveries NewsletterChatDelivery[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([organizationId])
  @@map("newsletter_send")
}

// NewsletterDelivery — per-recipient claim row; the unique key makes retries non-double-mailing.
model NewsletterDelivery {
  id             String    @id @default(cuid())
  sendId         String
  projectId      String
  organizationId String?
  userId         String?
  recipientEmail String
  status         String // SENDING | SENT | FAILED
  attemptCount   Int       @default(0)
  errorMessage   String?
  claimedAt      DateTime  @default(now())
  sentAt         DateTime?

  send         NewsletterSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([sendId, recipientEmail])
  @@index([sendId])
  @@index([userId])
  @@index([organizationId])
  @@map("newsletter_delivery")
}

// NewsletterChatDelivery — per-channel chat delivery ledger (chat analog of
// NewsletterDelivery). The unique (sendId, kind, platform, externalTeamId,
// channelId) is the claim-before-post key: exactly-once posting per channel
// across retries, with `kind` letting a review alert and a content delivery
// to the same channel coexist within one send.
model NewsletterChatDelivery {
  id              String    @id @default(cuid())
  sendId          String
  projectId       String
  organizationId  String?
  userId          String?
  platform        String // TEAMS | SLACK
  kind            String    @default("CONTENT") // CONTENT | APPROVAL
  externalTeamId  String // Teams teamId / Slack slackTeamId
  channelId       String
  status          String // SENDING | SENT | FAILED | SKIPPED
  errorMessage    String?   @db.Text
  postedMessageId String? // provider message id on success (Teams messageId / Slack ts)
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?

  send NewsletterSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  // Dedup key for the delivery ledger, carrying `kind` so the review alert and
  // the published notes are separate claims on one channel. The narrower
  // (sendId, platform, externalTeamId, channelId) key this replaced was retained
  // for one release as a rollback fence and dropped in
  // 20260820190000_newsletter_chat_delivery_drop_legacy_fence (Fizzy #2203).
  @@unique([sendId, kind, platform, externalTeamId, channelId], map: "newsletter_chat_delivery_send_kind_channel_key")
  @@index([sendId])
  @@index([userId])
  @@index([organizationId])
  @@map("newsletter_chat_delivery")
}

// ProjectBriefCursor — per-user "last reviewed" marker used by the client-side
