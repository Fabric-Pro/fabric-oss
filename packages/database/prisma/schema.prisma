  lastUsedAt     DateTime?

  // Relations
  workflow                 Workflow?                           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentConfigurations      AgentIntegrationConfiguration[] // Agent instances using this integration
  projectKnowledgeBindings ProjectDatabricksKnowledgeBinding[] // Projects using this integration for read-only knowledge retrieval

  @@index([workflowId])
  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@map("workflow_integration")
}

/// Project-level Databricks Vector Search knowledge binding (read-only).
///
/// One binding per project (v1): an org admin binds the project to ONE
/// Databricks Vector Search integration plus a set of its indexes. Once
/// bound, `search_databricks_indexes` becomes available to chat/agent flows
/// operating in the project, and "Update using context" retrieval folds
/// Databricks hits in as an additional ranked source. No write path.
///
/// Tenancy: the row carries no tenant columns of its own — the parent
/// Project is the authorization boundary (RLS policy `project_scoped`,
/// `PROJECT_SCOPED_TABLES` in tenant-db.ts). Write-time validation in the
/// save path additionally checks the integration row belongs to the same
/// tenant, is active, and is a DATABRICKS_VECTOR_SEARCH provider — RLS
/// validates the project, not the integration.
///
/// `onDelete: Restrict` on the integration: deleting the org's Databricks
/// connection while a project depends on it fails loudly (the delete
/// procedures surface the dependent projects) instead of silently wiping
/// the binding.
model ProjectDatabricksKnowledgeBinding {
  id               String   @id @default(cuid())
  projectId        String   @unique // one binding per project for v1
  integrationId    String
  allowedResources Json // { schema: string, indexes: string[] }
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integration WorkflowIntegration @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@index([integrationId])
  @@map("project_databricks_knowledge_binding")
}

// API keys for triggering workflows externally
model WorkflowApiKey {
  id          String    @id @default(cuid())
  workflowId  String
  name        String // User-friendly name for the key
  keyHash     String // Hashed API key (never store raw)
  keyPrefix   String // First 8 chars for identification (e.g., "wfk_abc1")
  permissions String[] // ["trigger", "read", "admin"]
  expiresAt   DateTime? // Optional expiration
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  createdBy   String // User ID who created the key

  // Tenant isolation (copied from parent Workflow)
  userId         String?
  organizationId String?

  // Relations
  workflow     Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([keyPrefix])
  @@index([isActive])
  @@index([userId])
  @@index([organizationId])
  @@map("workflow_api_key")
}

// =============================================================================
// Browser Automation Models
// =============================================================================

// BrowserTask - Tracks browser automation tasks with multi-tenancy
model BrowserTask {
  id             String            @id @default(cuid())
  userId         String
  organizationId String?
  status         BrowserTaskStatus @default(PENDING)
  sessionId      String? // Playwright session ID
  url            String // Initial URL to navigate to
  actions        Json // Array of BrowserAction[]
  extractors     Json? // Array of ContentExtractor[]
  result         Json? // Extraction results
  screenshots    String[]          @default([]) // S3 URLs for screenshots
  error          String?
  metadata       Json? // Additional task metadata
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  // Temporal workflow tracking
  workflowId String? // Temporal workflow ID
  runId      String? // Temporal run ID

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([workflowId])
  @@map("browser_task")
}

// AutomationTemplate - Save & Reuse workflow templates (CUGA-inspired)
model AutomationTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Template definition
  workflowSteps Json // Parameterized workflow steps
  parameters    Json? // User-configurable parameters schema

  // Source tracking
  sourceTaskId String? // Original task that was saved as template

  // Multi-tenancy
  userId         String
  organizationId String?
  isPublic       Boolean @default(false) // Share with org members

  // Versioning
  version Int @default(1)

  // Categorization
  category String? // e.g., "data-extraction", "reporting", "onboarding"
  tags     String[] @default([])

  // Usage tracking
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([category])
  @@index([isPublic])
  @@map("automation_template")
}

enum BrowserTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================================
// OpenAPI Dynamic Tool Loading
// ============================================================================

enum OpenAPIAuthType {
  NONE
  API_KEY
  BEARER
  BASIC
  OAUTH2
}

enum OpenAPIAuthLocation {
  HEADER
  QUERY
  COOKIE
}

enum OpenAPIServiceStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
}

// Stores onboarded OpenAPI services
model OpenAPIService {
  id String @id @default(cuid())

  // Service identification
  name         String // Display name
  description  String?
  specUrl      String // URL to OpenAPI spec (JSON/YAML)
  baseUrl      String? // Override base URL from spec
  specVersion  String? // e.g., "3.0.0", "3.1.0"
  heroEmojis   String[] @default([])
  heroImageUrl String?

  // Parsed spec info
  specTitle       String? // Title from spec info
  specDescription String? // Description from spec info
  specHash        String? // Hash of spec for change detection
  lastSyncedAt    DateTime? // Last time spec was synced

  // Authentication configuration
  authType           OpenAPIAuthType      @default(NONE)
  authLocation       OpenAPIAuthLocation? // Where to send auth (header/query)
  authKey            String? // Header/query param name (e.g., "X-API-Key", "api_key")
  encryptedAuthValue String? // Encrypted API key or token

  // OAuth2 specific (if authType = OAUTH2)
  oauth2TokenUrl         String?
  oauth2AuthorizationUrl String?
  oauth2ClientId         String?
  encryptedOauth2Secret  String?
  oauth2Scopes           String[]  @default([])
  encryptedAccessToken   String?
  encryptedRefreshToken  String?
  tokenExpiresAt         DateTime?

  // Multi-tenancy
  userId         String?
  organizationId String?
  createdById    String

  // Status and metadata
  status       OpenAPIServiceStatus @default(ACTIVE)
  errorMessage String?
  toolCount    Int                  @default(0)

  // Categorization
  category String?
  tags     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?                  @relation("OpenAPIServiceOwner", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("OpenAPIServiceCreatedBy", fields: [createdById], references: [id])
  tools        OpenAPITool[]
  configs      OpenAPIServiceConfig[]

  @@unique([specUrl, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("openapi_service")
}

// Stores individual tools/operations extracted from OpenAPI specs
model OpenAPITool {
  id        String @id @default(cuid())
  serviceId String

  // Tool identification
  operationId String // From OpenAPI spec
  name        String // Generated friendly name
  description String? // From spec or generated

  // HTTP details
  method String // GET, POST, PUT, DELETE, PATCH
  path   String // /users/{id}/orders

  // Parameters schema (JSON Schema format)
  parametersSchema  Json? // Combined parameters schema
  requestBodySchema Json? // Request body schema
  responseSchema    Json? // Response schema (for 200/default)

  // Parameter details for easy access
  pathParams   Json? // [{name, required, schema}]
  queryParams  Json? // [{name, required, schema}]
  headerParams Json? // [{name, required, schema}]

  // Metadata
  deprecated Boolean  @default(false)
  tags       String[] @default([])
  enabled    Boolean  @default(true)

  // Usage tracking
  useCount        Int       @default(0)
  lastUsedAt      DateTime?
  avgResponseTime Float     @default(0)
  errorRate       Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  service OpenAPIService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, operationId])
  @@index([serviceId])
  @@index([method])
  @@index([useCount])
  @@index([enabled])
  @@map("openapi_tool")
}

// User/org specific configuration for OpenAPI services
model OpenAPIServiceConfig {
  id             String  @id @default(cuid())
  serviceId      String
  userId         String?
  organizationId String?

  // Configuration overrides
  enabled       Boolean @default(true)
  customBaseUrl String? // Override base URL per config

  // Auth overrides (can override service-level auth)
  customAuthType           OpenAPIAuthType?
  encryptedCustomAuthValue String?

  // Tool filtering
  enabledToolIds  String[] @default([]) // Empty = all enabled
  disabledToolIds String[] @default([])

  // Rate limiting
  maxRequestsPerMinute Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  service      OpenAPIService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([enabled])
  @@map("openapi_service_config")
}

// ============================================================================
// Agent Workspace - Virtual file system for agent-generated artifacts
// ============================================================================

model AgentWorkspaceFile {
  id             String  @id @default(cuid())
  conversationId String? // Associated conversation (optional)
  userId         String
  organizationId String?

  // File metadata
  path      String // Virtual path (e.g., "/documents/report.md")
  name      String // File name
  extension String? // File extension (e.g., "md", "json", "py")
  mimeType  String? // MIME type

  // Content
  content String @db.Text // File content
  size    Int // Content size in bytes

  // File type
  fileType AgentFileType @default(DOCUMENT)

  // Versioning
  version           Int     @default(1)
  previousVersionId String? // Link to previous version

  // Status
  status AgentFileStatus @default(DRAFT)

  // Frame/public sharing
  shareToken         String?             @unique
  shareScope         FrameShareScope     @default(PRIVATE)
  isPublic           Boolean             @default(false)
  sharingGrants      FrameSharingGrant[]
  editHistory        FrameEditHistory[]
  sourceRunType      String?
  sourceRunId        String?
  authoritySessionId String?
  providerKeys       String[]            @default([])

  // Metadata
  metadata    Json? // Additional metadata (language, created_by_agent, etc.)
  description String? // Optional description

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-reference for versioning
  previousVersion AgentWorkspaceFile?  @relation("FileVersions", fields: [previousVersionId], references: [id])
  newerVersions   AgentWorkspaceFile[] @relation("FileVersions")

  @@unique([userId, organizationId, path]) // Unique path per user/org
  @@index([conversationId])
  @@index([userId])
  @@index([organizationId])
  @@index([path])
  @@index([fileType])
  @@index([status])
  @@index([shareToken])
  @@index([isPublic])
  @@index([createdAt])
  @@map("agent_workspace_file")
}

enum AgentFileType {
  DOCUMENT // Markdown, text documents
  CODE // Source code files
  DATA // JSON, CSV, data files
  CONFIG // Configuration files
  OUTPUT // Agent execution output
  ARTIFACT // Build artifacts, generated files
  FRAME // First-class Fabric frame document
  SLIDESHOW // First-class Fabric frame slideshow
}

enum AgentFileStatus {
  DRAFT // Work in progress
  COMPLETE // Finalized
  ARCHIVED // Archived/hidden
}

// Frame sharing scopes for multi-level sharing
enum FrameShareScope {
  PRIVATE
  EMAILS_ONLY
  WORKSPACE_AND_EMAILS
  PUBLIC
}

// Autonomy levels for orchestrator execution
enum AutonomyLevel {
  CONSERVATIVE // Always ask for approval on medium+ risk
  BALANCED // Ask for high/critical risk only
  AUTONOMOUS // Only critical risk requires approval
}

// Email-based sharing grants for frames
model FrameSharingGrant {
  id      String             @id @default(cuid())
  frameId String
  frame   AgentWorkspaceFile @relation(fields: [frameId], references: [id], onDelete: Cascade)

  // Email invite (for EMAILS_ONLY scope)
  email     String?
  invitedBy String
  invitedAt DateTime @default(now())

  // Access tracking
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  @@unique([frameId, email])
  @@index([frameId])
  @@index([email])
  @@map("frame_sharing_grant")
}

// Frame edit history for versioning and revert
model FrameEditHistory {
  id      String             @id @default(cuid())
  frameId String
  frame   AgentWorkspaceFile @relation(fields: [frameId], references: [id], onDelete: Cascade)

  // Edit metadata
  editType String // 'string_replace', 'full_update', 'revert'

  // For string_replace edits
  oldString String? @db.Text
  newString String? @db.Text

  // Full snapshot for reverts
  contentSnapshot String? @db.Text

  // Who made the edit
  editedBy String
  editedAt DateTime @default(now())

  // Revert tracking
  revertedToVersion Int?

  @@index([frameId, editedAt])
  @@map("frame_edit_history")
}

// Frame templates for creating frames from templates
model FrameTemplate {
  id String @id @default(cuid())

  // Template metadata
  name        String
  description String?
  category    String // 'dashboard', 'report', 'presentation', 'document', etc.

  // Template content (FrameDocument structure)
  content Json

  // Variables that can be substituted
  variables Json? // { "companyName": { type: "string", default: "", label: "Company Name" } }

  // Organization-wide or system
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isSystem       Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([isSystem])
  @@map("frame_template")
}

// ============================================================================
// Orchestrator Workspaces - Document management for AI orchestration
// ============================================================================

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Ownership
  userId         String // Creator (auto-added to Administrators)
  organizationId String? // Null = personal workspace

  // Type & Status
  type   WorkspaceType   @default(CUSTOM)
  status WorkspaceStatus @default(ACTIVE)

  // Limits (expandable later)
  documentLimit Int @default(20)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents     WorkspaceDocument[]
  conversations WorkspaceConversation[]
  ragSettings   WorkspaceRagSettings?

  // Fixed Groups (auto-created with workspace)
  administrators WorkspaceAdministrator[]
  contributors   WorkspaceContributor[]
  stakeholders   WorkspaceStakeholder[]
  agents         WorkspaceAgent[]

  // Episodic memory relation (conversations scoped to workspace)
  episodicMemories EpisodicMemory[]

  // Data sync relations (synced resources from external connections)
  syncedResources SyncedResource[]

  // Note: Uniqueness for PERSONAL workspaces (one per user+org) is enforced via a partial unique index in the migration.
  // CUSTOM workspaces have no uniqueness constraint, allowing users to create multiple.
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@map("workspace")
}

enum WorkspaceType {
  PERSONAL // Auto-created, one per user
  CUSTOM // User-created workspaces
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================================
// Workspace Documents
// ============================================================================

model WorkspaceDocument {
  id          String @id @default(cuid())
  workspaceId String

  // File Information
  filename         String
  originalFilename String
  mimeType         String
  size             Int

  // S3 Storage
  s3Bucket String
  s3Path   String

  // Processing Status
  status          WorkspaceDocumentStatus @default(PENDING)
  processingError String?

  // Extraction Results
  extractedText String? @db.Text
  extractorUsed String?
  pageCount     Int?
  wordCount     Int?

  // Qdrant Integration
  qdrantPointIds String[] // Array of chunk point IDs
  embeddedAt     DateTime?
  chunkCount     Int       @default(0)

  // Metadata
  metadata Json?

  // Temporal Workflow
  workflowId String? // Temporal workflow ID

  // Timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  uploadedBy String // User who uploaded

  // Relations
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks         WorkspaceDocumentChunk[]
  uploader       User                     @relation("WorkspaceDocumentUploader", fields: [uploadedBy], references: [id])
  syncedResource SyncedResource? // Link to external synced resource (if created from data connection)

  @@index([workspaceId])
  @@index([status])
  @@index([workflowId])
  @@map("workspace_document")
}

enum WorkspaceDocumentStatus {
  PENDING // Awaiting upload
  UPLOADING // S3 upload in progress
  UPLOADED // S3 upload complete
  EXTRACTING // Text extraction in progress
  CHUNKING // Chunking in progress
  EMBEDDING // Embedding generation in progress
  STORING // Storing in Qdrant
  READY // Fully processed
  FAILED // Processing failed
}

model WorkspaceDocumentChunk {
  id         String @id @default(cuid())
  documentId String

  // Content
  content    String @db.Text
  chunkIndex Int

  // Qdrant Reference
  qdrantId String? @unique

  // Chunk Metadata
  startOffset Int?
  endOffset   Int?
  pageNumber  Int?
  headings    String[] // Breadcrumb trail for document-aware chunking

  // Relations
  document WorkspaceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([qdrantId])
  @@map("workspace_document_chunk")
}

// ============================================================================
// Workspace Fixed Groups (Administrators, Contributors, Stakeholders, Agents)
// ============================================================================

// Administrators: Full access (CRUD, manage members, delete workspace)
model WorkspaceAdministrator {
  id          String @id @default(cuid())
  workspaceId String
  userId      String

  // Audit
  addedBy String
  addedAt DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceAdmin", fields: [userId], references: [id], onDelete: Cascade)
  adder     User      @relation("WorkspaceAdminAdder", fields: [addedBy], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_administrator")
}

// Contributors: Create, Read, Update (no Delete)
model WorkspaceContributor {
  id          String @id @default(cuid())
  workspaceId String
  userId      String

  // Audit
  addedBy String
  addedAt DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceContributor", fields: [userId], references: [id], onDelete: Cascade)
  adder     User      @relation("WorkspaceContributorAdder", fields: [addedBy], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_contributor")
}

// Stakeholders: Read-only access
model WorkspaceStakeholder {
  id          String @id @default(cuid())
  workspaceId String
  userId      String

  // Audit
  addedBy String
  addedAt DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceStakeholder", fields: [userId], references: [id], onDelete: Cascade)
  adder     User      @relation("WorkspaceStakeholderAdder", fields: [addedBy], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_stakeholder")
}

// Agents: AI Agent read-only access (only admins can add)
model WorkspaceAgent {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String // References Agent.id

  // Audit
  addedBy String // Must be an administrator
  addedAt DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  adder     User      @relation("WorkspaceAgentAdder", fields: [addedBy], references: [id])

  @@unique([workspaceId, agentId])
  @@index([workspaceId])
  @@index([agentId])
  @@map("workspace_agent")
}

// ============================================================================
// Workspace <-> Conversation Attachment
// ============================================================================

model WorkspaceConversation {
  id             String @id @default(cuid())
  workspaceId    String
  conversationId String

  // Document Filtering (empty = all documents)
  allowedDocumentIds String[]

  // Access Level
  accessLevel WorkspaceAccessLevel @default(READ)

  // Timestamps
  attachedAt DateTime @default(now())
  attachedBy String

  // Relations
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attacher     User              @relation("WorkspaceConversationAttacher", fields: [attachedBy], references: [id])

  @@unique([workspaceId, conversationId])
  @@index([conversationId])
  @@index([workspaceId])
  @@map("workspace_conversation")
}

enum WorkspaceAccessLevel {
  READ // Can read documents during execution
  WRITE // Can also add documents during execution (future)
}

model ProjectConversation {
  id             String @id @default(cuid())
  projectId      String
  conversationId String

  attachedAt DateTime @default(now())
  attachedBy String

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attacher     User              @relation("ProjectConversationAttacher", fields: [attachedBy], references: [id])

  @@unique([conversationId])
  @@index([projectId])
  @@index([conversationId])
  @@map("project_conversation")
}

// ============================================================================
// Document Assistant Conversation
// ----------------------------------------------------------------------------
// Join row binding a single AgentConversation to one (documentRef, author).
// Powers the CopilotSidebar's persistent chat history inside DocumentEditor.
// Polymorphic by `documentRefKind` — the FK cascade lives on AgentConversation
// / Project / Organization / User; cascade on ProjectDocument / UserStory
// delete is implemented at the query layer because the
// documentRefId column is not a single FK.
// ============================================================================

enum DocumentRefKind {
  PROJECT_DOCUMENT
  USER_STORY
}

enum DocumentAssistantVisibility {
  SHARED
  PRIVATE
}

model DocumentAssistantConversation {
  id                 String                      @id @default(cuid())
  conversationId     String                      @unique
  documentRefKind    DocumentRefKind
  documentRefId      String
  projectId          String
  organizationId     String?
  userId             String
  visibility         DocumentAssistantVisibility @default(SHARED)
  visibilityLockedAt DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentRefKind, documentRefId, conversationId])
  @@index([documentRefKind, documentRefId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("document_assistant_conversation")
}

// ============================================================================
// Workspace RAG Settings
// ============================================================================

model WorkspaceRagSettings {
  id          String @id @default(cuid())
  workspaceId String @unique

  // Chunking Configuration
  chunkSize    Int              @default(3000)
  chunkOverlap Int              @default(500)
  splitMethod  ChunkSplitMethod @default(DOCUMENT)

  // Embedding Configuration
  embeddingModel EmbeddingModel @default(TEXT_EMBEDDING_3_SMALL)

  // Retrieval Configuration
  topK                Int     @default(5)
  similarityThreshold Float   @default(0.5)
  enableReranking     Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_rag_settings")
}

// ============================================================================
// AI Configuration System - Dynamic Provider & Model Management
// ============================================================================

// Enums for AI Model Catalog
enum AiModelCapability {
  TEXT
  IMAGE
  AUDIO
  EMBEDDING
  TOOL_CALLING
  VISION
  CODE
  REASONING
}

enum AiTaskType {
  SIMPLE
  COMPLEX
  REASONING
  CHAT
  TOOL_CALLING
  EMBEDDING
  IMAGE
  AUDIO
  EVAL
}

enum SpeedTier {
  FAST // <500ms TTFT, >100 tokens/sec
  BALANCED // 500-2000ms TTFT, 50-100 tokens/sec
  QUALITY // >2000ms TTFT, <50 tokens/sec (reasoning models)
}

enum QualityTier {
  BASIC // Small models, simple tasks
  STANDARD // Mid-range, most use cases
  PREMIUM // Largest/best, complex reasoning
}

enum TaskComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

enum ProviderCategory {
  GATEWAY // Unified API providers (Vercel, OpenRouter, Cloudflare)
  DIRECT // Direct API access (OpenAI, Anthropic, Groq)
}

// AI Model Catalog - System-wide model definitions
model AiModel {
  id String @id @default(cuid())

  // Canonical identification
  canonicalName String  @unique // e.g., "llama-3.3-70b", "gpt-4o"
  displayName   String
  description   String? @db.Text

  // Model family/vendor
  family String // e.g., "llama", "gpt", "claude"
  vendor String // e.g., "Meta", "OpenAI", "Anthropic"

  // Capabilities
  capabilities AiModelCapability[] @default([TEXT])

  // Technical specifications
  contextWindow   Int // Max tokens (e.g., 128000)
  maxOutputTokens Int? // Max output tokens if different from context

  // Performance tiers
  speedTier   SpeedTier   @default(BALANCED)
  qualityTier QualityTier @default(STANDARD)

  // Cost information (per 1M tokens in USD)
  inputCostPer1M  Float?
  outputCostPer1M Float?

  // Task type suitability (used for auto-selection)
  suitableForTasks AiTaskType[] @default([])

  // Status
  isActive     Boolean   @default(true)
  deprecatedAt DateTime?

  // Replacement model for deprecated models (for automatic migration)
  // When a model is deprecated, this points to the recommended replacement
  replacementModelId String?
  replacementModel   AiModel?  @relation("ModelReplacement", fields: [replacementModelId], references: [id], onDelete: SetNull)
  replacedBy         AiModel[] @relation("ModelReplacement")

  // Metadata
  releaseDate DateTime?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  providerMappings AiModelProviderMapping[]
  taskDefaults     AiTaskModelDefault[]
  userPreferences  UserModelPreference[]
  orgPreferences   OrganizationModelPreference[]

  @@index([canonicalName])
  @@index([family])
  @@index([isActive])
  @@index([speedTier])
  @@index([qualityTier])
  @@index([replacementModelId])
  @@map("ai_model")
}

// Provider-specific model name mappings
model AiModelProviderMapping {
  id              String     @id @default(cuid())
  modelId         String
  provider        AIProvider
  providerModelId String // Provider-specific: "llama-3.3-70b-versatile"

  // Provider-specific overrides
  maxContextWindow  Int? // Provider may have different limits
  supportedFeatures String[] @default([])

  // Availability
  isAvailable      Boolean @default(true)
  availabilityNote String?

  // Provider-specific pricing (if different from model defaults)
  inputCostPer1M  Float?
  outputCostPer1M Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, provider])
  @@index([provider])
  @@index([providerModelId])
  @@index([isAvailable])
  @@map("ai_model_provider_mapping")
}

// Task type to model mappings (system defaults)
// Each provider can have its own default model for each task type
model AiTaskModelDefault {
  id         String         @id @default(cuid())
  taskType   AiTaskType
  complexity TaskComplexity @default(MEDIUM)
  modelId    String
  provider   AIProvider? // Provider-specific default (null = legacy/global fallback)
  priority   Int            @default(0) // Higher = preferred

  // Conditions for selection
  requiresToolCalling Boolean @default(false)
  minContextWindow    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([taskType, complexity, provider])
  @@index([taskType])
  @@index([taskType, complexity])
  @@index([provider])
  @@map("ai_task_model_default")
}

// User-level model preferences (overrides per provider)
// Stores user's model overrides for each task type, scoped by provider.
// When user switches default provider, their overrides for that provider are restored.
model UserModelPreference {
  id     String @id @default(cuid())
  userId String

  // Which provider this override is for
  provider AIProvider

  // What this preference applies to
  taskType AiTaskType // Required - which task type this override is for

  // The overridden model (must be available for the provider)
  modelId String

  // Optional custom parameters
  customParameters Json? // Temperature, top_p, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  // Unique per user + task type + provider (one override per task per provider)
  @@unique([userId, taskType, provider])
  @@index([userId])
  @@index([userId, provider])
  @@index([taskType])
  @@map("user_model_preference")
}

// User-level orchestrator preferences
// Stores which MCP servers, agents, and workspaces are enabled for the user
model UserOrchestratorPreferences {
  id             String @id @default(cuid())
  userId         String
  organizationId String @default("") // "" = personal account, non-empty = organization-scoped

  // Enabled IDs (stored as JSON arrays for flexibility)
  enabledMcpConfigIds Json @default("[]") // String array of enabled MCP config IDs
  enabledAgentIds     Json @default("[]") // String array of enabled agent IDs
  enabledWorkspaceIds Json @default("[]") // String array of enabled workspace IDs

  // Trust-based approval configuration (from Phase 3.2 orchestrator improvements)
  // Stores trust levels per agent, auto-approval settings, and approval history
  trustConfiguration Json? // TrustConfiguration object for trust-based approval system

  // Autonomy level for orchestrator execution
  autonomyLevel AutonomyLevel @default(BALANCED) // CONSERVATIVE, BALANCED, AUTONOMOUS

  // Loom (Fabric Agent) UI preferences — persisted so the user's choice
  // survives page reload. Stored as plain strings (not enums) so adding
  // a new mode (e.g. "team") in the future does not require a coupled
  // migration. The frontend validates against the closed set of values
  // at hydration time and falls back to the default when an unknown
  // string lands here (defensive — matches the chat-agent-selection
  // validator's forward-compat pattern).
  //   chatMode      ∈ {"direct", "orchestrator", "research"}
  //   reasoningMode ∈ {"lite", "balanced", "deep", "planner"}
  chatMode      String @default("orchestrator")
  reasoningMode String @default("balanced")

  // How much of the interface is exposed, independent of what runs. This is a
  // presentation setting, not a capability gate: `chatMode` above still decides
  // the engine, and any user can switch to advanced. Simple hides the engine
  // control and runs direct chat; advanced exposes the agent picker, the MCP
  // panel, the frame tools and the chatMode tabs.
  // Defaults to simple so a first-time user meets the reduced surface.
  //   uiMode ∈ {"simple", "advanced"}
  uiMode String @default("simple")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: organizationId is not a FK to avoid referential integrity issues with "" default
  // The application layer handles validation that organizationId exists when non-empty

  // Composite unique: one preference record per user per context (personal or org)
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_orchestrator_preferences")
}

/// Persisted "last sent" agent picker selection per (user, organization context).
/// Mirrors UserOrchestratorPreferences:
///  - organizationId = "" denotes personal scope (Prisma compound unique does not handle null cleanly).
///  - The application layer enforces XOR via tenantProtectedProcedure.
/// Naming is deliberately generic (`chatAgentSelection`, not `nexusAgentSelection`)
/// so a future Loom picker can plug in without a rename. (Decision 1.)
model UserChatAgentSelection {
  id             String @id @default(cuid())
  userId         String
  organizationId String @default("") // "" = personal account, non-empty = org-scoped

  /// Forward-compat marker for the JSON shape below. Bumped when the
  /// PersistedSelectedAgent Zod schema gains a non-additive change. The
  /// read-side validator drops entries whose `version` it cannot interpret.
  /// (Locks in research.md "Open Implementation Questions" #4 as "yes, version it".)
  version Int @default(1)

  /// Polymorphic chip array. JSON in Prisma / jsonb in Postgres.
  /// Typed by `PersistedSelectedAgentSchema` exported from @repo/database.
  /// Captures everything the picker needs to reconstruct a chip on reload
  /// AND everything the server-side validator needs to confirm the chip
  /// still resolves for this tenant: agentId, name, vendor, modelOverride,
  /// instanceId, plus any structural fields required by the chip variant.
  selectedAgents Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: organizationId is not a FK to keep the "" default sound,
  // matching UserOrchestratorPreferences.

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_chat_agent_selection")
}

/// Per-user Notification Center preferences (which in-app notification
/// categories the user receives). Account-global: there is exactly one row
/// per user, keyed at the organizationId = "" sentinel. The compound unique
/// keeps the door open for per-org scoping later, but the write-time filter
/// and the Settings UI both read/write the "" row only (Notification Center
/// Preferences feature, AC-3/AC-11).
///
/// Defaults are all `true` (opt-out model): a missing row OR a missing column
/// means "enabled". Only the curated, user-facing categories get a column —
/// SYSTEM, BILLING, CONTEXT_INDEXING_* and incident/digest types are always-on
/// and have no toggle. Mirrors UserOrchestratorPreferences ("" sentinel, no FK
/// on organizationId).
model NotificationPreference {
  id             String @id @default(cuid())
  userId         String
  organizationId String @default("") // "" = account-global (reserved for future per-org scoping)

  // Curated toggles. Each maps to a NotificationCategory (see
  // CATEGORY_TO_TOGGLE in queries/notification-preferences.ts).
  mentions     Boolean @default(true) // category MENTION
  replies      Boolean @default(true) // category REPLY
  assignments  Boolean @default(true) // category ASSIGNMENT
  status       Boolean @default(true) // category STATUS
  syncProject  Boolean @default(true) // category PROJECT (PM sync, repo token, scans)
  aiAgent      Boolean @default(true) // category AGENT
  publishingSuggestions Boolean @default(true) // category PUBLISHING (in-app bell)
  publishingEmails      Boolean @default(true) // EMAIL channel for publishing suggestions (1C-2c). NOT in CATEGORY_TO_TOGGLE — that map gates the in-app bell only.
  reportEmails Boolean @default(true) // EMAIL channel: report-run completion/failure. NOT a NotificationCategory toggle — gates email only; the in-app REPORT bell stays always-on.
  reviewEmails Boolean @default(true) // EMAIL channel: a release-notes draft is awaiting your review. NOT a NotificationCategory toggle — gates email only; the in-app approval-pending bell stays always-on.

  /// Display-only preference (#2117): render notifications as stacked cards
  /// instead of compact rows. Deliberately NOT part of
  /// NotificationPreferenceFlags or CATEGORY_TO_TOGGLE — it gates no delivery
  /// on any channel, and unlike every delivery flag it defaults to false
  /// because the style is opt-in.
  stackedCardStyle Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Note: organizationId is not a FK to keep the "" default sound,
  // matching UserOrchestratorPreferences.

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("notification_preference")
}

// Organization-level model preferences (overrides per provider)
// Stores org's model overrides for each task type, scoped by provider.
// When org switches default provider, their overrides for that provider are restored.
model OrganizationModelPreference {
  id             String @id @default(cuid())
  organizationId String

  // Which provider this override is for
  provider AIProvider

  // What this preference applies to
  taskType AiTaskType // Required - which task type this override is for

  // The overridden model (must be available for the provider)
  modelId String

  // Optional custom parameters
  customParameters Json? // Temperature, top_p, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  model        AiModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)

  // Unique per org + task type + provider (one override per task per provider)
  @@unique([organizationId, taskType, provider])
  @@index([organizationId])
  @@index([organizationId, provider])
  @@index([taskType])
  @@map("organization_model_preference")
}

// Provider Fallback Chains - Define fallback providers for resilience
// When a primary provider fails, the system can automatically try fallback providers
model AiProviderFallback {
  id String @id @default(cuid())

  // Primary provider that triggers the fallback
  primaryProvider AIProvider

  // Fallback provider to try when primary fails
  fallbackProvider AIProvider

  // Priority order (lower = higher priority, tried first)
  priority Int @default(0)

  // Task types this fallback applies to (empty = all task types)
  taskTypes AiTaskType[] @default([])

  // Error types that trigger this fallback (empty = all errors)
  // Examples: "rate_limit", "timeout", "model_unavailable", "api_error"
  triggerOnErrors String[] @default([])

  // Cooldown period in seconds before retrying primary provider
  cooldownSeconds Int @default(60)

  // Whether this fallback is currently active
  isActive Boolean @default(true)

  // Scope: SYSTEM (applies to all), USER (per-user), ORG (per-org)
  scope          String  @default("SYSTEM")
  userId         String?
  organizationId String?

  // Metadata for tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([primaryProvider, fallbackProvider, scope, userId, organizationId])
  @@index([primaryProvider])
  @@index([isActive])
  @@index([scope])
  @@index([userId])
  @@index([organizationId])
  @@map("ai_provider_fallback")
}

// Approval Templates - Pre-approved patterns for orchestrator operations
model ApprovalTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Matching criteria (JSON)
  // { agentPattern?, operationPattern?, resourcePattern?, stepDescriptionPattern?, maxRiskLevel, executorTypes? }
  criteria Json

  // Template behavior (JSON)
  // { autoApprove, notifyOnly, requireConfirmation, expiresAfter?, validUntil? }
  behavior Json

  // Scope
  scope          String  @default("USER") // USER, ORGANIZATION, SYSTEM
  userId         String?
  organizationId String?

  // Usage tracking
  usageCount Int       @default(0)
  lastUsed   DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([scope])
  @@index([isActive])
  @@map("approval_template")
}

// AI Usage Log - Track usage for analytics
model AiUsageLog {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?
  projectId      String?

  // Provider info
  providerConfigId String? // Reference to cloud_provider_config or user_cloud_provider_config
  provider         AIProvider

  // Model info
  modelCanonicalName String? // Canonical model name
  providerModelId    String // Provider-specific model ID used

  // Context
  taskType       AiTaskType?
  agentId        String?
  conversationId String?
  // Product-feature attribution (Fizzy #2230, Phase 1): which user-facing AI
  // feature made this call, and the resolved prompt version it ran with.
  // Nullable by design — untagged call sites write null and tag coverage
  // grows incrementally; never treat null as "no feature", only as "untagged".
  featureKey      String?
  promptVersionId String?
  // Invocation-source attribution (Fizzy #1894): when set, the call came from
  // a scheduled or background pipeline rather than a user action; the value
  // is the job-type label ("scheduled-report", "meeting-transcript-sync", …).
  // Nullable by design — user-initiated rows stay null.
  jobType         String?

  // Usage metrics
  inputTokens              Int
  outputTokens             Int
  totalTokens              Int
  // Prompt-cache + reasoning token breakdown (default 0 = pre-caching / not reported).
  // cachedInputTokens = prompt tokens served from cache (Anthropic: separate from
  // inputTokens; OpenAI: a subset of inputTokens). cacheCreationInputTokens =
  // tokens written into the cache (Anthropic, billed at a write premium). These
  // let estimateAiUsageCostUsd price cache reads/writes at their real discounted
  // rates instead of charging every input token at the full rate.
  cachedInputTokens        Int                     @default(0)
  cacheCreationInputTokens Int                     @default(0)
  reasoningTokens          Int                     @default(0)
  costCents                Int                     @default(0) // Rounded integer cents (legacy; used by AI credit leaderboards in ai-credits.ts)
  costMicroUsd             Int                     @default(0) // Cost in micro-USD (1μ$ = $10^-6). Precise per-row value; sum these for dashboards. Int32 max ≈ $2147 per row.
  // Actual-cost reconciliation. Vercel-gateway calls carry a generationId whose
  // real billed cost (total_cost) is fetched shortly after via GET /v1/generation
  // and written back, flipping cost from the initial estimate to the provider's
  // actual figure. gatewayGenerationId is null for non-gateway calls (which report
  // no cost and stay estimates); costIsActual stays false until reconciled.
  gatewayGenerationId      String?
  costIsActual             Boolean                 @default(false)
  latencyMs                Int // Time to first token or completion
  billingCategory          AiUsageBillingCategory?
  billingCustomerId        String?

  // Status
  success      Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([provider, createdAt])
  @@index([billingCategory, createdAt])
  @@index([modelCanonicalName])
  @@index([taskType])
  @@index([agentId])
  // Reconciliation sweep: pending gateway rows (costIsActual=false) by recency.
  // Non-gateway rows are written costIsActual=true, so false ⇒ only awaits a
  // gateway total_cost lookup.
  @@index([costIsActual, createdAt])
  // Feature-level adoption dashboards: per-feature volume/cost over a time
  // range, and acceptance-rate segmentation by model/prompt version.
  @@index([featureKey, createdAt])
  // Background-job attribution (Fizzy #1894): per-pipeline volume/cost and
  // "system vs user" filtered views.
  @@index([jobType, createdAt])
  @@map("ai_usage_log")
}

// ============================================================================
// AI Usage Limits - Tenant-configurable spend / token caps with HARD/SOFT
// enforcement. Enforced at the chokepoint
// (packages/ai/lib/dynamic-model-selector.ts). Counters are dual-written to
// Redis (fast pre-check) and ai_usage_limit_counter (source of truth).
// ============================================================================

enum AiUsageLimitDimension {
  TOKENS
  SPEND_USD
}

enum AiUsageLimitWindow {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum AiUsageLimitEnforcement {
  HARD
  SOFT
}

model AiUsageLimit {
  id String @id @default(cuid())

  // Tenant XOR (per CLAUDE.md). Exactly one of these is non-null at a time;
  // enforced by application code and by the partial unique index below.
  organizationId String?
  userId         String?

  // Optional project scope. NULL = workspace-global (applies to every AI call
  // in the tenant); non-NULL = applies only to AI calls scoped to this
  // project. Project ownership is enforced at the procedure layer (project
  // must belong to the same tenant as the limit). Multiple limits may exist
  // for the same project: a project may have its own budget AND inherit the
  // tenant-global budget; the chokepoint enforces BOTH.
  projectId String?

  name String?

  // Optional scope filters. NULL on a row means "matches every value of this
  // dimension" — a row with providerConfigId = NULL applies to every provider.
  // Soft FK: providerConfigId polymorphically references either
  // CloudProviderConfig.id (org context) or UserCloudProviderConfig.id
  // (personal context); resolved by the chokepoint helper, so no Prisma
  // relation is declared. The @@index covers join performance.
  providerConfigId   String?
  modelCanonicalName String?
  taskType           AiTaskType?

  dimension   AiUsageLimitDimension
  window      AiUsageLimitWindow
  // BigInt for tokens (high-volume monthly counters can exceed Int32) and for
  // spend (stored as micro-USD, mirroring AiUsageLog.costMicroUsd, to avoid
  // float drift). 1 micro-USD = 1e-6 USD.
  maxValue    BigInt
  enforcement AiUsageLimitEnforcement

  // Percent (1-99) at which the in-app warning banner appears. Default 90.
  // Independent of the fixed 80% / 100% notification thresholds — the banner
  // is a persistent visual surface, notifications are one-shot events.
  // Validated at the DTO layer (Zod refine).
  bannerThresholdPercent Int @default(90)

  createdById String
  // Soft-delete: preserves counter rows for historical reporting and prevents
  // accidental data loss. The partial unique index only enforces
  // uniqueness for live (archivedAt IS NULL) rows.
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                 @relation("AiUsageLimitUser", fields: [userId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("AiUsageLimitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  counters     AiUsageLimitCounter[]

  @@index([organizationId, archivedAt])
  @@index([userId, archivedAt])
  @@index([projectId, archivedAt])
  @@index([providerConfigId])
  @@index([createdById])
  @@map("ai_usage_limit")
}

model AiUsageLimitCounter {
  id String @id @default(cuid())

  limitId     String
  // First instant of the calendar window in the tenant's timezone, then
  // converted to UTC for storage. Computed by the chokepoint helper at write
  // time so that all writers agree on the bucket key under DST transitions.
  windowStart DateTime

  usedTokens   BigInt @default(0)
  usedMicroUsd BigInt @default(0)

  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  limit AiUsageLimit @relation(fields: [limitId], references: [id], onDelete: Cascade)

  // Atomic upsert key: concurrent increments collapse onto one row per window.
  @@unique([limitId, windowStart], name: "limitId_windowStart")
  // Supports periodic ops cleanup of historical counter rows.
  @@index([windowStart])
  @@map("ai_usage_limit_counter")
}

// ============================================================================
// Reporting Templates - Reusable report definitions with scheduling
// ============================================================================

model ReportTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  heroEmojis   String[] @default([])
  heroImageUrl String?

  // Template type & category
  templateType ReportTemplateType
  category     String?
  tags         String[]           @default([])

  // Template definition (JSON)
  // Contains: dataSources, aiAgents, sections, layout
  definition   Json
  // User-configurable parameters schema (JSON Schema format)
  parameters   Json?
  // Output format(s) supported
  outputFormat ReportOutputFormat @default(MARKDOWN)

  // Required connections - what integrations/tools this template needs
  // { mcpServerKeys: ["linear", "github"], workspaceRequired: true, agentIds: [] }
  connections Json?

  // Fabric AI enrichment configuration
  // { strategy?, context?, pattern?, variables?, enableAutoDetection? }
  fabricConfig Json?

  // Schedule configuration (optional) — default inherited by instances created from this template.
  // Stored as RAW UI input (today often just { frequency }); hour/minute/timezone are optional
  // here and get defaulted + phase-anchored during normalization when copied to TemplateInstance.schedule.
  // { frequency, dayOfWeek?, dayOfMonth?, hour?, minute?, timezone? } (no nextRunAt — templates are never scheduled directly)
  schedule Json?

  // Evidence.dev integration (optional)
  evidenceProjectId  String?
  evidenceReportSlug String?
  // Evidence configuration: theme, layout, chart preferences
  // { theme?: { colors?, fonts? }, layout?: { columns?, sidebar? }, defaultChartType?, componentOverrides? }
  evidenceConfig     Json?

  // Multi-tenancy
  userId         String?
  organizationId String?
  scope          ReportTemplateScope @default(USER)
  isPublic       Boolean             @default(false)

  // Versioning
  version Int @default(1)

  // Usage tracking
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   ReportExecution[]
  artifacts    ReportArtifact[]
  instances    TemplateInstance[]
  skills       ReportTemplateSkill[]

  @@index([userId])
  @@index([organizationId])
  @@index([templateType])
  @@index([category])
  @@index([scope])
  @@index([isPublic])
  @@map("report_template")
}

// Template instance lifecycle status
enum TemplateInstanceStatus {
  PENDING // Captured sId, awaiting full configuration
  ACTIVE // Currently in use, latest version
  ARCHIVED // Superseded by newer version or soft-deleted
  DRAFT // Being edited, not ready for use
}

/// How a report instance's schedule is determined.
enum ScheduleMode {
  INHERITED // follow the template's schedule (snapshot-seeded)
  CUSTOM // this instance has its own schedule
  OFF // scheduling disabled for this instance (durable opt-out)
}

// TemplateInstance - User's configured template artifact
// When a user "uses" a template, they configure their specific connections
// and it becomes their personal artifact that can be executed or scheduled
model TemplateInstance {
  id             String  @id @default(cuid())
  templateId     String
  userId         String
  organizationId String?

  // Versioning
  sId     String                 @default(cuid())
  version Int                    @default(1)
  status  TemplateInstanceStatus @default(ACTIVE)

  // User's name and description for this instance
  name        String
  description String?
  heroEmojis  String[] @default([])

  // Bound connections - maps template's required connections to user's specific configs
  // { mcpConfigs: { "linear": "config-id-123" }, workspaceIds: ["ws-1"], agentIds: [] }
  connections Json

  // User's parameter defaults for this instance
  parameterDefaults Json?

  // Fabric AI enrichment overrides (inherits from template if not set)
  // { strategy?, context?, pattern?, variables? }
  fabricConfig Json?

  // Schedule configuration for this instance (normalized + phase-anchored)
  // { frequency, dayOfWeek?, dayOfMonth?, hour, minute, timezone, anchorAt }
  schedule     Json?
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  // How scheduling is determined for this instance. The AUTHORITY for whether a
  // row runs — OFF retains `schedule` JSON but is never swept.
  scheduleMode ScheduleMode @default(INHERITED)

  // Status
  isActive Boolean @default(true)

  // Usage tracking
  runCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  template     ReportTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   TemplateInstanceExecution[]

  @@unique([sId, version])
  @@index([sId])
  @@index([status])
  @@index([templateId])
  @@index([userId])
  @@index([organizationId])
  @@index([isActive])
  @@index([nextRunAt])
  @@map("template_instance")
}

// TemplateInstanceExecution - Each run of a template instance
model TemplateInstanceExecution {
  id             String  @id @default(cuid())
  instanceId     String
  userId         String
  organizationId String?

  // Execution status
  status      TemplateExecutionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  // Input parameters used for this execution
  parameters Json?

  // Fabric AI enrichment used (captured for audit)
  fabricEnrichment Json?

  // Data sources that were queried and their results summary
  dataSources Json?

  // Temporal workflow tracking
  workflowId String?
  runId      String?

  // Error tracking
  error String?

  // Cancellation audit — who cancelled this run and when. cancelledBy may differ
  // from userId when an organization admin/owner cancels another member's run.
  cancelledBy String?
  cancelledAt DateTime?

  // Idempotency claim for the one-shot completion notification.
  // Set atomically with the notification.create; guarantees at most one
  // notification per execution, independent of the recipient's read/archive state.
  notificationEmittedAt DateTime?

  // Durable at-most-once claim for the one-shot report-run EMAIL.
  // Claimed atomically before send and NEVER released — guarantees no duplicate
  // email across replay/restart/history-loss; delivery is best-effort.
  emailSentAt DateTime?

  // Per-MCP-server connection diagnostics from the agentic data-gathering loop
  mcpDiagnostics Json?

  createdAt DateTime @default(now())

  // Relations
  instance  TemplateInstance           @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  artifacts TemplateInstanceArtifact[]

  @@index([instanceId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([workflowId])
  @@index([createdAt])
  @@map("template_instance_execution")
}

// TemplateInstanceArtifact - Output artifacts from instance execution
model TemplateInstanceArtifact {
  id             String  @id @default(cuid())
  executionId    String
  userId         String
  organizationId String?

  // Artifact metadata
  name         String
  description  String?
  artifactType ReportArtifactType

  // Storage
  s3Path   String?
  s3Bucket String?
  mimeType String
  size     Int

  // Content (for smaller artifacts & RAG indexing)
  content  String? @db.Text
  metadata Json?

  // RAG Integration
  qdrantId   String?
  embeddedAt DateTime?
  chunkCount Int       @default(0)

  createdAt DateTime @default(now())

  // Relations
  execution       TemplateInstanceExecution               @relation(fields: [executionId], references: [id], onDelete: Cascade)
  chunks          TemplateInstanceArtifactChunk[]
  emailDeliveries TemplateInstanceArtifactEmailDelivery[]

  @@index([executionId])
  @@index([userId])
  @@index([organizationId])
  @@index([artifactType])
  @@index([qdrantId])
  @@map("template_instance_artifact")
}

// TemplateInstanceArtifactChunk - Chunks for RAG indexing
model TemplateInstanceArtifactChunk {
  id         String @id @default(cuid())
  artifactId String

  content    String @db.Text
  chunkIndex Int

  qdrantId String? @unique
  metadata Json?

  // Tenant isolation (copied from parent TemplateInstanceArtifact)
  userId         String?
  organizationId String?

  artifact     TemplateInstanceArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([qdrantId])
  @@index([userId])
  @@index([organizationId])
  @@map("template_instance_artifact_chunk")
}

enum TemplateExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ReportExecution {
  id             String  @id @default(cuid())
  templateId     String
  userId         String
  organizationId String?

  // Execution status
  status      ReportExecutionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  // Input parameters used for this execution
  parameters Json?
  // Date range for the report { start, end, period }
  dateRange  Json?

  // Data sources that were queried
  dataSources Json?

  // Temporal workflow tracking
  workflowId String?
  runId      String?

  // Error tracking
  error String?

  createdAt DateTime @default(now())

  // Relations
  template  ReportTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  artifacts ReportArtifact[]

  @@index([templateId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([workflowId])
  @@index([createdAt])
  @@map("report_execution")
}

model ReportArtifact {
  id             String  @id @default(cuid())
  executionId    String
  templateId     String
  userId         String
  organizationId String?

  // Artifact metadata
  name         String
  description  String?
  artifactType ReportArtifactType

  // Storage
  s3Path   String?
  s3Bucket String?
  mimeType String
  size     Int

  // Content (for smaller artifacts & RAG indexing)
  content  String? @db.Text
  metadata Json?

  // RAG Integration
