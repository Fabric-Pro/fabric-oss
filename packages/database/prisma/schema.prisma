  @@index([analysisId, startedAt])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_analysis_run")
}

// Persistent codebase-chat conversation (shared or private), per project repo.
model AtlasConversation {
  id                      String              @id @default(cuid())
  projectId               String
  repositoryIntegrationId String?
  mode                    AtlasGraphMode      @default(BUSINESS) // sessions are separate per mode; Business is the default view
  title                   String              @default("New conversation")
  visibility              AtlasChatVisibility @default(PRIVATE)
  messages                Json                @default("[]") // [{ role, content, createdAt }]

  // Multi-repo "System map" chat scope (additive; backfills false). true = a
  // project-wide conversation spanning the selected repos (repositoryIntegrationId
  // is null for these); false (default) = the existing per-repo conversation.
  isSystemScope Boolean @default(false)

  // Tenant isolation (userId = owner; visibility enforced at the procedure layer)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, repositoryIntegrationId, mode])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_conversation")
}

// STABLE user overrides for a graph node's description / category. Keyed by
// (project, repo, branch, mode, node key) — NOT by analysisId — so a user's
// authoritative notes SURVIVE re-analysis (they are overlaid onto whichever
// analysis row currently serves that branch). Never deleted with an analysis.
model AtlasNodeOverride {
  id                      String  @id @default(cuid())
  projectId               String
  repositoryIntegrationId String? // null = project's legacy/default repository
  branch                  String  @default("main")

  mode AtlasGraphMode
  key  String

  userDescription String? @db.Text
  userCategory    String?
  updatedByUserId String? // who last edited (nullable so the row survives user removal)

  // Tenant isolation (mirrors AtlasConversation: scalar columns +
  // a project relation for cascade; visibility is enforced at the procedure
  // layer so project teammates share the same overrides).
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history AtlasNodeOverrideHistory[]

  // One override per (project, repo, branch, mode, node key).
  @@unique([projectId, repositoryIntegrationId, branch, mode, key])
  @@index([projectId])
  @@index([projectId, repositoryIntegrationId, branch, mode])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_node_override")
