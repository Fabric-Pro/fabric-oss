  analysis AtlasAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, mode])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_edge")
}

enum AtlasRunStatus {
  RUNNING
  READY
  FAILED
}

enum AtlasChatVisibility {
  PRIVATE
  SHARED
}

// One row per analysis RUN — the history (who/when/commit) for a repo's analysis.
model AtlasAnalysisRun {
  id                String         @id @default(cuid())
  analysisId        String
  projectId         String
  triggeredByUserId String?
  mode              String // "full" | "incremental"
  status            AtlasRunStatus @default(RUNNING)
  branch            String? // branch this run analysed (per-branch analyses)
  commitSha         String?
  commitAt          DateTime?
  nodeCount         Int            @default(0)
  edgeCount         Int            @default(0)
  filesAnalyzed     Int            @default(0)
  modulesDescribed  Int            @default(0)
  // Per-run AI telemetry (mirrors the analysis row's latest-run snapshot).
  model             String? // canonical model name used for this run's AI work
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  costMicroUsd      Int? // micro-USD (1μ$ = $10^-6)
  error             String?
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
