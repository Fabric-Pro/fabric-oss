  contentHash String? // For change detection
  metadata    Json? // Labels, tags, authors, etc.

  // Link to workspace document (after vectorization)
  workspaceId String?
  documentId  String? @unique // One document per synced resource

  // Sync status
  lastSyncedAt DateTime?
  syncStatus   ResourceSyncStatus @default(PENDING)
  syncError    String?

  // Size/limits
  sizeBytes  Int?
  textLength Int? // Extracted text length

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connection DataConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workspace  Workspace?         @relation(fields: [workspaceId], references: [id])
  document   WorkspaceDocument? @relation(fields: [documentId], references: [id])

  @@unique([connectionId, externalId])
  @@index([connectionId])
  @@index([workspaceId])
  @@index([documentId])
  @@index([syncStatus])
  @@map("synced_resource")
}

enum ResourceSyncStatus {
  PENDING
  SYNCED
  FAILED
  DELETED
  EXCLUDED // Manually excluded or filtered out
}

// DataSyncSchedule - Sync schedule configuration
model DataSyncSchedule {
  id           String @id @default(cuid())
  connectionId String @unique

  // Schedule
  frequency      SyncFrequency @default(HOURLY)
  cronExpression String? // For custom schedules

  // Status
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connection DataConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([nextRunAt])
  @@map("data_sync_schedule")
}

enum SyncFrequency {
  REALTIME // Webhook-based, near-instant
  EVERY_5_MIN // Microsoft (5 min)
  HOURLY // Most providers
  EVERY_8_HOURS // GitHub code
  DAILY // Large data sources
  WEEKLY
  CUSTOM // Uses cronExpression
}

