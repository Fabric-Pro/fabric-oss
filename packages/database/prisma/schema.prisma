  userId         String?
  organizationId String?
  kind           RegisteredAgentSuggestionKind
  title          String
  description    String                         @db.Text
  /// [SuggestionPayload]
  payload        Json?
  state          RegisteredAgentSuggestionState @default(PENDING)
  source         String                         @default("generated")
  conversationId String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  agent          RegisteredAgent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentId, key], map: "registered_agent_suggestion_agentId_key_key")
  @@index([agentId], map: "registered_agent_suggestion_agentId_idx")
  @@index([userId], map: "registered_agent_suggestion_userId_idx")
  @@index([organizationId], map: "registered_agent_suggestion_organizationId_idx")
  @@index([state], map: "registered_agent_suggestion_state_idx")
  @@index([conversationId], map: "registered_agent_suggestion_conversationId_idx")
  @@map("registered_agent_suggestion")
}

// Agent Conversation - Stores chat history for Fabric AI and other agents
model AgentConversation {
  id             String                  @id @default(cuid())
  userId         String
  organizationId String?
  agentId        String // The agent this conversation is with (e.g., "orchestrator")
  title          String? // Auto-generated or user-set title
  /// [AgentConversationMessages]
  messages       Json                    @default("[]") // Array of conversation messages
  /// [AgentTrajectory]
  trajectory     Json? // Optional execution trajectory for visualization
  metadata       Json? // Additional context (reasoning mode, etc.)
  pinned         Boolean                 @default(false)
  status         AgentConversationStatus @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Conversation continuation — set on conversations created via the
  // "Continue in new chat" handoff when the parent hit its token-budget cap.
  // `parentConversationId` links back to the source thread; `carriedOverSummary`
  // holds the structured "PROGRESS SO FAR" produced by the orchestrator's
  // exhaustion synthesis and is prepended to the new conversation's history
  // on its first turn so the orchestrator sees the established context.
  parentConversationId String?
  parent               AgentConversation?  @relation("ConversationContinuation", fields: [parentConversationId], references: [id], onDelete: SetNull)
  continuations        AgentConversation[] @relation("ConversationContinuation")
  carriedOverSummary   String?
  carriedOverAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Workspace attachments
  workspaceAttachments WorkspaceConversation[]

  // Project attachment (one project per conversation)
  projectConversation ProjectConversation?

  // Optional 1:1 back-link to the document-assistant join row.
  // Present only for conversations created via the
  // CopilotSidebar inside DocumentEditor; null for every other surface
  // (standalone Fabric AI, workspace doc chat, etc.).
  documentAttachment DocumentAssistantConversation?

  @@index([userId, agentId])
  @@index([organizationId, agentId])
  @@index([status])
  @@index([pinned])
  @@index([createdAt])
  @@index([parentConversationId])
  @@map("agent_conversation")
}

enum AgentConversationStatus {
  ACTIVE
  ARCHIVED
}

