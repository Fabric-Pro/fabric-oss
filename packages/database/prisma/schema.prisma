  azureAiModelRouterName          String?
  azureAiProjectName              String?
  azureAiRegion                   String?
  azureAiResourceGroup            String?
  azureAiSubscriptionId           String?
  azureAiTenantId                 String?
  azureAiUseModelRouter           Boolean                       @default(false)
  useDelegatedExecution           Boolean                       @default(true) // Delegate Fabric AI operations to server instead of executing in Temporal
  // Org-level kill switch for the persistent document-assistant chat history
  // feature. Default true so the feature is on
  // for every existing org; flip to false per-org if the SSR hydration path
  // regresses the document editor.
  documentAssistantHistoryEnabled Boolean                       @default(true)
  // Org-level opt-in for the Feature Maturation V2 three-tab editor (Summary &
  // Questions / Decision Log / Clean Specification). Default true (#1797): V2 is
  // rolled out to all orgs now that every creation path drafts a Clean Spec (#1799).
  // Retained as the per-org kill-switch — flip an org back to false via SQL to
  // disable V2 for it without a deploy. The v1/v2 manual switch a flagged user
  // sees is session-scoped and separate.
  featureMaturationV2Enabled      Boolean                       @default(true)
  // AI answer recommendations for Maturation V2 open questions (demo feedback #7 /
  // Fizzy 1711, FR-15). Default false: dogfood-gated, flipped to true to enroll the
  // internal Fabric org first (SQL flip, like featureMaturationV2Enabled). Gates the
  // recommendation pass on top of the per-feature autoProposeAnswers toggle.
  aiAnswerRecommendationsEnabled  Boolean                       @default(false)
  // SOC 2 CC6.1 — opt-in organization-wide MFA enforcement. When true, members
  // without two-factor enabled are redirected to enroll before they can access
  // this organization's resources. Default false so enabling the feature changes
  // nothing for any existing org until an owner/admin turns it on.
  requireTwoFactor                Boolean                       @default(false)
  /// Default retention window for soft-deleted attachments, in days (#1749).
  /// null = inherit the server default. Range enforced by a CHECK constraint.
  attachmentRetentionDays          Int?
  /// When attachmentRetentionDays last changed. Arms the grace floor: a newly
  /// shortened window cannot delete anything until this is 7 days old.
  attachmentRetentionDaysUpdatedAt DateTime?
