/// Proposing an existing prompt as the default for one or more actions.
///
/// Distinct from PromptChangeRequest, which proposes new CONTENT for a prompt.
/// A nomination proposes an existing prompt for a ROLE: it changes which prompt
/// an action uses, not what any prompt says. Overloading one table with both
/// would mean every reader working out which kind of row they are holding.
///
/// `targets` is JSON rather than a child table on purpose: the set is written
/// once, read as a unit, and edited wholesale by the reviewer before approval
/// (FR23). Nothing queries a nomination BY target, so a join table would add a
/// migration and a second write path to maintain for no read it serves.
model PromptNomination {
  id              String                 @id @default(cuid())
  promptVersionId String
  nominatedById   String
  /// SYSTEM or ORG. A personal default needs no one's approval.
  targetScope     PromptScope
  /// Required when targetScope is ORG; null for SYSTEM.
  organizationId  String?
  /// [{ targetKey, documentType, storyKind }] — the actions this applies to.
  targets         Json
  /// Summary of what differs from the current default (FR16).
  changeSummary   String?
  /// True when changeSummary came from the plain fallback rather than the model
  /// — the summarizer was unavailable, and a reviewer should know that the
  /// sentence they are reading is a character count rather than a reading.
  /// Review is never blocked on the summarizer, so this is a quality flag on a
  /// present summary, not an absence.
  summaryDegraded Boolean                @default(false)
  status          PromptNominationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  nominatedBy   User          @relation("PromptNominationsCreated", fields: [nominatedById], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("PromptNominationsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, targetScope])
  @@index([organizationId, status])
  @@index([promptVersionId])
  @@index([nominatedById])
  @@map("prompt_nomination")
}

enum PromptNominationStatus {
  PENDING
  APPROVED
  DECLINED
  /// Withdrawn by the nominator before review.
  WITHDRAWN
  /// Closed because a competing nomination for the same action was approved.
  SUPERSEDED
}

