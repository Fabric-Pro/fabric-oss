  embeddedAt DateTime?
  chunkCount Int       @default(0)

  // Evidence.dev specific
  evidenceEmbedUrl String?

  createdAt DateTime @default(now())

  // Relations
  execution ReportExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  template  ReportTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  chunks    ReportArtifactChunk[]

  @@index([executionId])
  @@index([templateId])
  @@index([userId])
  @@index([organizationId])
  @@index([artifactType])
  @@index([qdrantId])
  @@map("report_artifact")
