  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_brief_cursor")
}

// DailyBriefReleaseNoteExclusion — per-project record of PRs/stories excluded
// from the Daily Brief's release-notes panel (and its downstream newsletter
