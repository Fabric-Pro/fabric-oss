model ProjectDocument {
  id                    String                @id @default(cuid())
  projectId             String
  type                  ProjectDocumentType
  title                 String
  content               String
  status                ProjectDocumentStatus @default(DRAFT)
  version               Int                   @default(1)
  generationPrompt      String?
  generationError       String?
  generationProgress    Int                   @default(0)
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  workflowId            String?
  runId                 String?
  wordCount             Int?
  lastEditedBy          String?
  // Async contradiction pre-check result for the latest generated content
  // (a DecisionPrecheckResult plus the checkedContentHash it was judged
  // against). Null when the content is clear or has never been checked; a
  // stale hash marks findings the UI ignores until the check reruns.
  decisionPrecheck      Json?

  // Document source tracking
  source          DocumentSource @default(GENERATED)
  sourceContextId String? // Links to original ProjectContext if imported
  isActive        Boolean        @default(true) // For multiple docs of same type

  // RAG embedding fields (for using generated docs as context)
  qdrantId    String?
  embeddedAt  DateTime?
  contentHash String? // To detect actual content changes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  versions      DocumentVersion[]
  assets        ProjectDocumentAsset[] // Binary/HTML artifacts generated alongside the document (e.g. architecture diagrams)
  project       Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceContext ProjectContext?              @relation("ImportedDocument", fields: [sourceContextId], references: [id], onDelete: SetNull)
  lock          DocumentLock?
  evals         DocumentEval[]
  autoRefresh   DocumentAutoRefreshSettings?
  user          User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([organizationId])
  @@index([qdrantId])
  @@index([sourceContextId])
  @@index([isActive])
  @@map("project_document")
}

// ProjectDocumentAsset - Binary or HTML artifacts generated alongside a ProjectDocument
// (e.g. a self-contained HTML architecture diagram from the architecture-diagram skill).
// Stored in S3; the document's markdown stays clean and readable.
model ProjectDocumentAsset {
  id                String @id @default(cuid())
  projectDocumentId String
  filename          String // e.g. "architecture-diagram.html"
  contentType       String
  storageKey        String // S3: projectDocuments/{projectDocumentId}/{id}/{filename}
  sizeBytes         Int
  sha256            String
  sortOrder         Int    @default(0)

  // Tenant isolation (mirrors ProjectDocument's XOR pattern)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  // Relations
  projectDocument ProjectDocument @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectDocumentId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_document_asset")
}

model ProjectContext {
  id         String             @id @default(cuid())
  projectId  String
  type       ProjectContextType
  content    String             @db.Text
  qdrantId   String?
  embeddedAt DateTime?
  metadata   Json?

  // File upload fields
  s3Path           String?
  s3Bucket         String?
  originalFilename String?
  mimeType         String?
  fileSize         Int?

  // Extraction status
  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?
  extractedAt      DateTime?

  // Source URL for LINK type
  sourceUrl   String?
  sourceTitle String?

  // What kind of source a LINK is (Fizzy #2165). Required on new link sources;
  // NULL on every row that predates this, deliberately — a link with no category
  // simply does not satisfy the Knowledge Base readiness item. Guessing a
  // category during a backfill would report readiness the project has not earned.
  knowledgeBaseSourceCategory      KnowledgeBaseSourceCategory?
  /// Free text, required by the API only when the category is OTHER.
  knowledgeBaseSourceCategoryOther String?

  // URL Context Sources (LINK type).
  // All nullable so legacy LINK rows are unaffected; defaults applied by data backfill.
  urlScope            UrlSourceScope?
  urlMaxPages         Int?
  urlRefreshMode      UrlRefreshMode?
  urlNextRefreshAt    DateTime?
  urlLastSyncedAt     DateTime?
  urlScheduleId       String? // Temporal schedule ID for DAILY/WEEKLY/MONTHLY
  urlActiveWorkflowId String? // Temporal workflowId of the in-flight crawl, NULL when none. Used by the cancel procedure to look up the workflow and propagate cancellation. Cleared by updateParentStatusActivity when the workflow finalizes.

  // User-declared source type label ("Client Chat", "Architect Chat", …) and
  // free-text guidance for how the AI should use this source. Distinct from
  // `type` above, which is the system discriminator (FILE/LINK/TEXT/…). Both
  // nullable — sources without them behave exactly as before. Read live from
  // this row at retrieval time (never embedded into Qdrant payloads) so an
  // edit takes effect on the next AI invocation without a re-embed.
  sourceType     String?
  aiInstructions String?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  /// DATABASE-GENERATED — never write this from application code.
  ///
  /// `GENERATED ALWAYS AS (COALESCE("organizationId", "userId")) STORED`. It
  /// collapses the tenant XOR into one non-null identity so a child table can
  /// carry a foreign key that COMPARES OWNERS, not just parentage. A composite
  /// FK over `(parentContextId, projectId)` alone still admits an
  /// organization-owned child under a personal parent, because it never looks
  /// at who owns either row; and a plain FK on `(userId, organizationId)` can
  /// never be enforced at all, since MATCH SIMPLE skips any row with a NULL in
  /// the referencing columns and the XOR guarantees one of them always is.
  ///
  /// Prisma cannot express generation, so it is declared here as an ordinary
  /// nullable column purely so the schema and the database agree; a
  /// shadow-database diff sees a matching TEXT column and reports no drift.
  /// Postgres rejects any INSERT or UPDATE that supplies a value.
  /// Added by migration 20260826120000.
  ownerKey String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation("ProjectContexts", fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Back-reference for project PRD source binding (one-to-one with Project.prdSourceContextId)
  prdSourceProject Project? @relation("PrdSourceContext")

  // Back-reference for imported documents
  importedDocuments ProjectDocument[] @relation("ImportedDocument")

  // Indexed child pages for PATH_PREFIX crawls
  urlPages ProjectContextUrlPage[]

  // Captured conversation bundles and the per-message claims that key them
  conversationBundles ProjectContextConversationBundle[]
  conversationClaims  ProjectContextConversationClaim[]

  /// The owner-inclusive identity a conversation child's composite foreign key
  /// points at. Unique rather than a plain index because a foreign key needs a
  /// unique index over exactly the referenced columns — `id` alone already
  /// makes the triple unique, so this adds no constraint on this table's own
  /// rows; it exists so ownership disagreement is unrepresentable in the
  /// children. Built CONCURRENTLY in migration 20260826120100 (this table is
  /// populated, so an in-transaction build would take a write lock for the
  /// length of it).
  @@unique([id, projectId, ownerKey], map: "project_context_id_projectId_ownerKey_key")
  @@index([projectId])
  @@index([type])
  @@index([userId])
  @@index([organizationId])
  @@index([qdrantId])
  @@index([extractionStatus])
  @@map("project_context")
}

// A readiness checklist item that a user has deliberately put into a manual
// state (Fizzy #2165). Only rows for items someone has acted on exist — an
// untouched item has no row, and completion is never stored here at all
// because it is derived from live project state on every read.
//
// `personalForUserId` carries the SCOPE of the action and is distinct from the
// tenant `userId` below:
//   - SNOOZED rows set it. A snooze is personal — it quiets one person's
//     reminder and must not silently change what the rest of the team sees.
//   - NOT_APPLICABLE and HELP_REQUESTED rows leave it NULL. Both are statements
//     about the project rather than about the person making them, so they apply
//     project-wide. NOT_APPLICABLE is permission-gated for that reason.
model ProjectReadinessItemState {
  id        String @id @default(cuid())
  projectId String
  /// Stable key from the readiness rule registry, not a display name — copy can
  /// change without orphaning a user's snooze.
  itemKey   String

  state             ProjectReadinessItemStateValue
  /// Scope of the action. NULL = project-wide. See the model comment.
  personalForUserId String?
  /// Set on SNOOZED rows only; the item returns to the active list once passed.
  snoozeUntil       DateTime?

  /// Set true the first time this item ever enters HELP_REQUESTED and never
  /// cleared, so the friction stays visible after the item is later resolved.
  everHelpRequested Boolean   @default(false)
  helpRequestedAt   DateTime?

  // Tenant XOR fields (mirror the parent project — never both set)
  userId         String?
  organizationId String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A FIFTH index exists that Prisma cannot express: the partial
  // `project_readiness_item_state_project_wide_key` on ("projectId", "itemKey")
  // WHERE "personalForUserId" IS NULL, added in migration 20260820140000.
  // The @@unique below constrains the PERSONAL rows only — Postgres treats NULLs
  // as distinct, so without the partial index a project could hold two
  // "not applicable" rows for the same item. Documented here because a reader
  // would otherwise see one unique constraint and no hint that a second exists,
  // and because a shadow-database diff can read it as drift and try to DROP it.
  @@unique([projectId, itemKey, personalForUserId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_readiness_item_state")
}

// The last computed completion verdict per readiness item (Fizzy #2165).
//
// This is a cache and nothing depends on it for correctness — the level shown to
// a user is always recomputed from live state. It exists for exactly one
// requirement: the panel shows one or two RECENTLY completed items, and "recently"
// is unanswerable from derivation alone, which only ever sees the present. Storing
// the previous verdict is what makes the transition observable.
model ProjectReadinessVerdict {
  id        String @id @default(cuid())
  projectId String
  itemKey   String

  isComplete Boolean
  /// Whether the panel could show the item, so a dependency landing is
  /// distinguishable from the initial seed (Fizzy #2165). Verdict rows are
  /// written for ALL items on a project's first read, so without this an item
  /// becoming reachable looks exactly like the row being created.
  isVisible  Boolean  @default(false)
  /// When VISIBILITY last flipped. Deliberately separate from `changedAt`:
  /// that column means "when completion flipped" and "recently completed" reads
  /// it, so bumping it because a dependency landed would announce long-finished
  /// items as fresh news — the exact defect this table was corrected for once.
  visibleChangedAt DateTime?
  /// When the verdict last flipped — not when it was last recomputed.
  changedAt  DateTime @default(now())

  // Tenant XOR fields (mirror the parent project — never both set)
  userId         String?
  organizationId String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, itemKey])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_readiness_verdict")
}

// Per-page row for URL Context Sources crawled under PATH_PREFIX scope.
// Single-page sources do NOT create rows here (parent.content holds the page).
model ProjectContextUrlPage {
  id              String         @id @default(cuid())
  parentContextId String
  parentContext   ProjectContext @relation(fields: [parentContextId], references: [id], onDelete: Cascade)

  // Denormalized projectId mirrors parent.projectId so RLS / project-scoped
  // carve-out filters can apply without a join. Kept in sync at insert time.
  projectId String

  pageUrl            String
  pageTitle          String?
  content            String           @db.Text
  qdrantId           String?
  embeddedAt         DateTime?
  lastFetchedAt      DateTime         @default(now())
  etag               String?
  lastModifiedHeader String?
  contentHash        String // sha256, drives skip-if-unchanged on re-sync
  chunkCount         Int              @default(0)
  extractionStatus   ExtractionStatus @default(PENDING)
  extractionError    String?

  // Tenant XOR fields (mirrors parent ProjectContext — never both set)
  userId         String?
  organizationId String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([parentContextId])
  @@index([projectId])
  @@index([qdrantId])
  @@index([extractionStatus])
  @@index([userId])
  @@index([organizationId])
  @@index([parentContextId, extractionStatus])
  @@map("project_context_url_page")
}

// One captured bundle of messages from a monitored Teams or Slack CHANNEL
// (Fizzy #2228). A linked channel's ProjectContext row is a pointer — it stores
// a cursor and dedup markers, never the messages — so a channel exported as
// "Content unavailable" and the assistant could not cite it. Each analyzed
// bundle now lands here as its own durable, individually embedded row hanging
// off that channel's context row.
//
// # Ownership is enforced by the database, not by the query layer
//
// A plain foreign key on `parentContextId` is not enough. Postgres does not
// evaluate the PARENT's row-level-security policy through a foreign key, so a
// raw or buggy writer could attach a row to a parent in another project while
// carrying tenant columns that satisfy this table's own policy — and every
// later read, export and cascade would then run under contradictory ownership.
// Matching the project is not enough either: a foreign key over
// `(parentContextId, projectId)` still admits an organization-owned child under
// a personal parent, or a child naming a different organization, because it
// never compares owners.
//
// So the foreign key is composite over `(parentContextId, projectId, ownerKey)`
// against `project_context (id, projectId, ownerKey)` — see `ownerKey` on
// ProjectContext for why a normalized owner identity is what makes that
// enforceable. Ownership disagreement cannot be expressed.
//
// TWO CONSTRAINTS BELOW ARE RAW SQL, because Prisma cannot express either:
//   - `project_context_conversation_bundle_owner_fkey`, the composite FK above
//     (modelling it as a Prisma relation would put the generated `ownerKey`
//     into every INSERT, which Postgres rejects);
//   - `project_context_conversation_bundle_tenant_xor`, the CHECK enforcing
//     that exactly one of `userId` / `organizationId` is set — the generated
//     column depends on it, since COALESCE over two NULLs is NULL.
// Both live in migration 20260826120200. A shadow-database diff cannot see them
// in this file and may read them as drift and try to DROP them; they are not
// drift. (Same situation as the partial index documented on
// ProjectReadinessItemState.)
model ProjectContextConversationBundle {
  id              String         @id @default(cuid())
  parentContextId String
  parentContext   ProjectContext @relation(fields: [parentContextId], references: [id], onDelete: Cascade)

  /// Denormalized from parent.projectId so project-scoped filters and RLS apply
  /// without a join. Held to the parent's value by the composite FK, not by
  /// convention.
  projectId String

  /// Provider thread this bundle was formed over (a Teams reply chain, a Slack
  /// thread ts). Nullable — a channel-level bundle need not belong to a thread.
  providerThreadId String?

  /// Formatted and prompt-injection-neutralized bundle text. Every derived copy
  /// — vector payload, retrieval result, export archive, MCP read — inherits
  /// the guard from here, so it must never be re-derived from raw provider text.
  content      String @db.Text
  contentHash  String
  messageCount Int    @default(0)

  /// Chronological ordering, and the coverage window an export states. Not
  /// `createdAt`: capture can lag the conversation by a poll interval.
  bundleStartedAt DateTime
  bundleEndedAt   DateTime?

  qdrantId String?

  /// Claimed by compare-and-set before embedding starts. NEVER use `embeddedAt`
  /// as the claim: a crash between claiming and the vector write would leave it
  /// non-null with no vector, and the recovery pass — which looks for a null
  /// `embeddedAt` and no live lease — would skip that row forever.
  embeddingLeaseAt DateTime?

  /// Written ONLY after the vector store confirms the point.
  embeddedAt DateTime?

  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?

  // Tenant XOR fields (mirrors parent ProjectContext — never both set)
  userId         String?
  organizationId String?

  /// DATABASE-GENERATED — never write this from application code. See
  /// `ProjectContext.ownerKey`.
  ownerKey String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  claims ProjectContextConversationClaim[]

  @@index([parentContextId])
  @@index([projectId])
  @@index([qdrantId])
  @@index([extractionStatus])
  @@index([userId])
  @@index([organizationId])
  /// Chronological read-back for one channel, and the export's coverage window.
  @@index([parentContextId, bundleStartedAt], map: "project_context_conversation_bundle_parent_started_idx")
  /// The recovery sweep's predicate: null `embeddedAt` with no live lease.
  @@index([embeddedAt, embeddingLeaseAt], map: "project_context_conversation_bundle_embed_sweep_idx")
  @@map("project_context_conversation_bundle")
}

// One claimed provider message, per monitored channel context (Fizzy #2228).
//
// This is what makes capture idempotent by construction. A bundle is written
// over the messages whose claim rows this transaction actually INSERTed, so a
// retried or concurrent write of the same message loses the uniqueness race and
// contributes nothing rather than duplicating — and two workers racing one
// thread produce disjoint bundles regardless of what each fetched.
//
// It carries the same tenant columns, the same XOR CHECK and the same
// owner-inclusive composite foreign key as the bundle table, and its own
// entries in the tenant-db project-scoped map and the RLS allowlist. That is
// not symmetry for its own sake: this table holds tenant-associated provider
// message identifiers, and it GATES whether a message can ever be captured — an
// unprivileged cross-tenant write here could suppress capture through a
// uniqueness conflict without ever touching content.
//
// `project_context_conversation_claim_owner_fkey` and
// `project_context_conversation_claim_tenant_xor` are raw SQL in migration
// 20260826120200 for the same reasons given on the bundle model.
model ProjectContextConversationClaim {
  id              String         @id @default(cuid())
  parentContextId String
  parentContext   ProjectContext @relation(fields: [parentContextId], references: [id], onDelete: Cascade)

  /// Denormalized from parent.projectId; held there by the composite FK.
  projectId String

  /// The provider's own message identifier. Unique within the parent context —
  /// that uniqueness IS the claim.
  providerMessageId String
  providerThreadId  String?
  messageCreatedAt  DateTime?

  /// The bundle this claim was folded into. Nullable only for the window inside
  /// the claiming transaction before the bundle row exists; a claim that
  /// committed without one would leave a retry with an empty claim set and no
  /// row to attach to, which is why claim and bundle share a transaction.
  bundleId String?
  bundle   ProjectContextConversationBundle? @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  // Tenant XOR fields (mirrors parent ProjectContext — never both set)
  userId         String?
  organizationId String?

  /// DATABASE-GENERATED — never write this from application code. See
  /// `ProjectContext.ownerKey`.
  ownerKey String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([parentContextId, providerMessageId], map: "project_context_conversation_claim_message_key")
  @@index([parentContextId])
  @@index([projectId])
  @@index([bundleId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_context_conversation_claim")
}

// The ids whose VECTORS still have to be deleted, after the rows that held them
// are already gone (Fizzy #2228).
//
// Unlinking a monitored channel deletes the pointer context row and its bundles
// BEFORE it touches the vector store, and that ordering is not incidental: row
// absence is the state a concurrent embedder reads to decide whether to abandon
// its write or compensate for it (see `capture-conversation-bundle.ts`). The
// price is that between the commit and the vector delete, the ids exist only in
// that one call's memory — so a vector-store failure stranded the points where
// no retry could ever find them. The user's retry found no context row, took
// the "nothing to delete" path, and reported SUCCESS while the conversation
// text stayed indexed. The Qdrant payload carries the message text, so that is
// retained third-party conversation content after the user was told it was
// removed.
//
// A row here is written in the SAME transaction as the row delete, so the ids
// cannot be lost with the rows, and it is removed only once the vector store
// has confirmed. Both a retried unlink and the scheduled recovery sweep drain
// it, so the cleanup finishes whether or not the user comes back.
//
// Deliberately NOT a child of project_context: outliving those rows is the
// entire point. It hangs off the PROJECT instead, which is also the scope the
// unlink drains by.
//
// `project_context_pending_vector_cleanup_tenant_xor` is raw SQL in migration
// 20260826130000 — a CHECK constraint is not expressible in schema.prisma, the
// same way the two capture tables' are not.
model ProjectContextPendingVectorCleanup {
  id String @id @default(cuid())

  /// The project whose collection the stranded points are in, and what the
  /// unlink drain looks a record up by.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Every id whose points must go: the pointer context row's own id, and each
  /// bundle row that cascaded with it. They reach the vector payload through
  /// `contextId` / `originalContextId`, which is what the delete filter matches
  /// — see `deleteContextVectors`.
  contextIds String[]

  /// Failed drains. The sweep orders on this so one poisoned record cannot
  /// starve fresh ones at the head of a bounded batch.
  attempts  Int     @default(0)
  lastError String?

  // Tenant XOR fields — exactly one set, like the two capture tables. The
  // `organizationId` also DECIDES WHICH COLLECTION the points are in, so the
  // drain reads it off the record rather than from an ambient value; a sweep
  // that used a run-wide tenant would aim at a collection the points are not in
  // and report a clean delete.
  userId         String?
  organizationId String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  /// The sweep's queue order: fewest failures first, oldest first within that.
  @@index([attempts, createdAt], map: "project_context_pending_vector_cleanup_queue_idx")
  @@map("project_context_pending_vector_cleanup")
}

// Compressed project-history summary. Holds an LLM-generated digest of a project's
// OLDER accumulated ProjectContext so AI generation reads a compact summary plus the
// recent raw context instead of the full history. Raw ProjectContext rows are never
// deleted — `coveredThrough` is the watermark up to which this summary stands in for
// them; anything created after it is still retrieved live. Gated by
// FABRIC_FEATURE_CONTEXT_SUMMARIZATION; inert when the flag is off.
model ProjectContextSummary {
  id        String @id @default(cuid())
  projectId String

  content String                @db.Text
  status  ContextSummaryStatus  @default(PENDING)
  trigger ContextSummaryTrigger

  // `coveredThrough` is the TRUE watermark — the createdAt of the latest raw
  // source actually folded into a COMPLETED summary (never the run's wall-clock
  // start). RAG stands the summary in for raw context created at or before it and
  // still returns anything newer live. `snapshotThrough` is the stable high-water
  // mark captured at run start; the run only processes sources <= it, so context
  // created mid-run is deferred to the next run. coveredThrough <= snapshotThrough.
  coveredThrough      DateTime
  snapshotThrough     DateTime?
  coveredContextCount Int       @default(0)
  tokenCount          Int?

  // Source-level references cited by the summary — a JSON array of
  // { marker, sourceType, sourceId, sourceTimestamp, label? } (see
  // ContextSourceReference). Powers AI + staff drill-down back to the original
  // raw context / decision. Null for legacy (engineVersion 1) summaries.
  references Json?

  // Coverage-trust marker. 1 = legacy engine (single-shot, watermark = run start,
  // NOT trustworthy — RAG treats it as additive-only and the cron rebuilds it).
  // 2 = map-reduce engine (whole-history coverage, true watermark, references).
  engineVersion Int @default(1)

  // Observability + resume checkpoint: eligible/processed/deferred source counts,
  // batch count, input chars, first/last processed timestamps, keyset cursor,
  // markerSeq, and incomplete-coverage flag. See ContextSummaryStats.
  stats Json?

  // Which source types were considered for this run — a JSON object
  // { context, decisions, roadmap, codeRepo: boolean } (see SourceSelection).
  // Null on legacy rows means "all sources" (backward compatible). Remembered per
  // history entry so a re-run/restore can show what was included.
  sourceSelection Json?

  // Manual-edit provenance. `manualEdit` rows are user-authored (no LLM spend) and
  // supersede the generated run they were edited from, inheriting its coveredThrough.
  manualEdit     Boolean @default(false)
  editedByUserId String?

  // Real token spend for this run, captured from the fold's generateObject usage and
  // summed across batches (NOT the output digest size — that's tokenCount). Zero for
  // manual-edit rows. costMicroUsd is derived from spent tokens + model.
  spentInputTokens  Int?
  spentOutputTokens Int?
  spentCostMicroUsd BigInt?

  // Provenance / observability
  model             String?
  error             String?
  triggeredByUserId String?

  // Embedding link (mirrors ProjectContext) so the summary is queryable in Qdrant.
  qdrantId   String?
  embeddedAt DateTime?

  // Soft pointer to the newer summary that superseded this one (resolved in the query
  // layer, mirroring ArchitectureDecision.supersededById). Prior summaries are kept.
  supersededById String?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@index([qdrantId])
  @@map("project_context_summary")
}

// Wizard Temp Context - Temporary storage for file uploads during project wizard
// Files are stored here before project creation and moved to ProjectContext after
model WizardTempContext {
  id             String             @id @default(cuid())
  sessionId      String // Browser session identifier for grouping uploads
  userId         String
  organizationId String?
  type           ProjectContextType
  content        String             @db.Text // Extracted text content
  qdrantId       String? // Vector DB reference
  embeddedAt     DateTime?
  metadata       Json?

  // File storage (same pattern as ProjectContext)
  s3Path           String
  s3Bucket         String
  originalFilename String
  mimeType         String
  fileSize         Int

  // Extraction status
  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?
  extractedAt      DateTime?

  // Cleanup tracking
  createdAt DateTime @default(now())
  expiresAt DateTime // Default: 24 hours from creation

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("wizard_temp_context")
}

model DocumentVersion {
  id                String   @id @default(cuid())
  documentId        String
  version           Int
  content           String
  changeDescription String?
  changedBy         String?
  createdAt         DateTime @default(now())

  // Prompt attribution - which prompt version generated this document version
  promptVersionId String?

  // Tenant isolation (copied from parent ProjectDocument)
  userId         String?
  organizationId String?

  document      ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion?  @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([version])
  @@index([promptVersionId])
  @@index([userId])
  @@index([organizationId])
  @@map("document_version")
}

// DocumentAutoRefreshSettings — per-document enrollment in the Living Documents
// auto-refresh sweep. Opt-in: a document with no row here is never refreshed,
// and `enabled` defaults false even when a row exists.
//
// `cadence` is a plain String (not an enum) on purpose, matching the
// NewsletterSettings precedent — the TS union lives in
// `src/document-refresh-cadence.ts`, so adding a cadence costs no enum migration.
//
// `createdByUserId` is load-bearing, not bookkeeping: the sweep has no session,
// and AI model resolution + usage logging are per-user, so it borrows the
// enroller's identity. The find-due activity skips a document whose enroller is
// no longer a valid member of the owning organization (same stale-actor guard as
// the newsletter dispatcher). Re-enabling re-homes it to the current caller.
model DocumentAutoRefreshSettings {
  id         String  @id @default(cuid())
  documentId String  @unique
  projectId  String
  enabled    Boolean @default(false)
  cadence    String  @default("BIWEEKLY") // ON_DEPLOY | DAILY | WEEKLY | BIWEEKLY | MONTHLY

  /// Set when a deployment is observed for this document's project, and cleared
  /// when the refresh cycle completes. Only ON_DEPLOY documents ever carry it.
  ///
  /// This is what lets a deploy trigger a refresh WITHOUT a second dispatch
  /// path. The hourly sweep already refuses to touch a document somebody has
  /// open, refuses a stale enroller, and fails a mis-tenanted row closed; a
  /// parallel deploy-driven dispatcher would have to reproduce all three, and
  /// the one it forgot would overwrite live human work. So a deploy only marks
  /// the document due and the existing sweep does the rest, with every guard
  /// intact.
  ///
  /// The cost is latency: a deploy-triggered refresh starts on the next sweep
  /// rather than instantly. For a document refresh that is a fair trade.
  deployPendingSince DateTime?

  // When false (the default) a refresh does NOT write to the document: it stores
  // its result as a proposal below and notifies, and a human accepts or rejects
  // it. Turning this on is the "AI commits directly" behavior — a deliberate,
  // per-document opt-in rather than the default, because an unattended
  // whole-document rewrite with nobody looking is a write primitive pointed at
  // the customer's specs.
  autoApply Boolean @default(false)

  // The pending proposal, when a refresh ran with autoApply off. Cleared on
  // accept or reject. `pendingBaselineVersion` is what the proposal was built
  // from — accepting it re-runs the same compare-and-set, so a proposal that has
  // been overtaken by a human edit cannot be applied blind.
  pendingContent         String?   @db.Text
  pendingSummary         String?   @db.Text
  pendingProposedAt      DateTime?
  pendingBaselineVersion Int?

  createdByUserId String

  // Advanced only when a cycle COMPLETES (committed, or judged no-change).
  lastRefreshedAt    DateTime?
  // Advanced on EVERY attempt including failures. Without this a persistently
  // failing document stays due and the hourly sweep re-dispatches it 24x/day.
  lastAttemptAt      DateTime?
  // COMMITTED | NO_CHANGES | SKIPPED_COLLISION | SKIPPED_STALE_ACTOR | FAILED
  lastRefreshStatus  String?
  lastRefreshSummary String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant isolation (copied from parent ProjectDocument)
  userId         String?
  organizationId String?

  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("document_auto_refresh_settings")
}

// Project RAG Settings - Per-project RAG configuration
model ProjectRagSettings {
  id        String @id @default(cuid())
  projectId String @unique

  // Chunking settings
  chunkSize    Int              @default(3000) // 1000-5000 chars
  chunkOverlap Int              @default(500) // 100-1000 chars
  splitMethod  ChunkSplitMethod @default(DOCUMENT) // Structure-aware (markdown, code)

  // Embedding settings
  embeddingModel EmbeddingModel @default(TEXT_EMBEDDING_3_SMALL)

  // Retrieval settings
  topK                 Int     @default(50) // 1-100, retrieve more for reranking
  similarityThreshold  Float   @default(0.3) // 0.1-0.9, lower threshold since reranking filters
  enableReranking      Boolean @default(true)
  rerankTopK           Int     @default(10) // Final count after reranking (1-50)
  rerankerProvider     String  @default("cross-encoder") // cross-encoder | cohere
  enableEpisodicMemory Boolean @default(true) // Include past project discussions

  // Code search settings
  codeSearchEnabled  Boolean @default(false) // Enable code search tools for AI agents
  codeSearchProvider String? // "api" | "indexed" | "hybrid" — defaults to "api" when enabled

  // Code embedding model (Phase 2: AST-aware indexing)
  codeEmbeddingModel String? @default("TEXT_EMBEDDING_3_SMALL") // "TEXT_EMBEDDING_3_SMALL" | "VOYAGE_CODE_3"

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("project_rag_settings")
}

// ============================================================================
// Security & Accessibility Scanning
// AI agents scan a project's Fabric-held content (feature text + generated
// documents + indexed code context) for OWASP Top 10 vulnerabilities and
// WCAG 2.1 AA accessibility issues, plus per-project custom rule sets.
// ============================================================================

enum ScanCategory {
  SECURITY
  ACCESSIBILITY
}

enum ScanSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Lifecycle for a finding→tickets grouping run. Distinct from ScanStatus so the
// review gate (AWAITING_REVIEW) and the transient apply lock (APPLYING) stay
// isolated to this feature. PENDING→RUNNING (propose/draft)→AWAITING_REVIEW
// (user previews)→APPLYING (accept in progress)→COMPLETED; FAILED on error/cancel.
enum GroupingRunStatus {
  PENDING
  RUNNING
  AWAITING_REVIEW
  APPLYING
  COMPLETED
  FAILED
}

enum ScanTrigger {
  MANUAL
  MATURATION_GATE
}

enum ScanTargetType {
  PROJECT
  FEATURE
}

enum ScanFindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ScanEnforcementMode {
  WARN
  BLOCK
}

enum ScanMode {
  FULL
  INCREMENTAL
}

// Per-project scanning configuration (1:1 with Project). Mirrors
// ProjectRagSettings' tenant + lifecycle shape.
model ProjectScanConfig {
  id                     String               @id @default(cuid())
  projectId              String               @unique
  securityEnabled        Boolean              @default(true)
  accessibilityEnabled   Boolean              @default(true)
  enforcementMode        ScanEnforcementMode  @default(WARN)
  // Auto-trigger a feature-scoped scan when a feature crosses the maturation
  // gate below. Soft and non-blocking by default.
  autoScanOnMaturation   Boolean              @default(true)
  maturationGate         FeatureDraftingStage @default(PUBLISHED)
  // Opt-in: run a real Semgrep SAST scan over the project's connected
  // repository code (project scope only), alongside the AI doc/feature review.
  // Off by default — only runs when a repository is connected.
  semgrepEnabled         Boolean              @default(false)
  // Opt-in: scan the connected repository's git history for secrets that were
  // committed and later removed (gitleaks over the full commit log). Off by
  // default — heavier than the working-tree Semgrep scan (full clone).
  gitHistoryEnabled      Boolean              @default(false)
  // Auto-run the adversarial AI false-positive review as the final scan phase,
  // so findings arrive pre-triaged (likely false positives auto-dismissed,
  // reversibly). On by default; best-effort — a review failure never fails the
  // scan, and the deterministic confidence-threshold default view holds without
  // it. Independent of the four scanners (works over whichever produced findings).
  autoReviewFindings     Boolean              @default(true)
  // Which git branch the repo-based scanners (Semgrep SAST + git-history
  // secrets) clone and scan. Null / blank ⇒ fall back to the repository's
  // default branch (current behavior). Whitespace-only is normalized to null.
  scanBranch             String?
  // Durable "stays declined" store for the finding→tickets review flow. JSON
  // array of { themeKey, category, ruleSource, declinedByUserId, declinedAt }.
  // A theme the user declines in the review dialog is recorded here (by its
  // stable themeKey) so future runs surface it as declined instead of
  // re-proposing it. "Re-add" removes the entry (and creates the ticket now).
  declinedGroupingThemes Json?
  // Industry-specific custom rule sets (AC3). JSON array of
  // { id, name, category: "SECURITY"|"ACCESSIBILITY", severity, guidance, enabled }.
  // Applied in addition to the default OWASP/WCAG rule sets; findings are
  // attributed back to the rule that produced them.
  customRules            Json?
  // Editable severity rubric — what makes a finding Critical/High/Medium/Low.
  // JSON array of { severity, definition }. Null ⇒ seeded CVSS-aligned defaults.
  // Injected into the scanner prompt; applies on the next scan (existing
  // findings remain unchanged).
  severityRubric         Json?
  // Optional attachable knowledge packs — richer security-review guidance
  // appended to the scanner prompt. JSON array of { id, title, content, appliesTo? }.
  // Knowledge text only (never executed). Applies on the next scan.
  securityKnowledgePacks Json?
  userId                 String
  organizationId         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("project_scan_config")
}

// One scan run (manual or maturation-gate triggered).
model ProjectScan {
  id                        String         @id @default(cuid())
  projectId                 String
  storyId                   String? // set for FEATURE-scoped scans
  status                    ScanStatus     @default(PENDING)
  trigger                   ScanTrigger    @default(MANUAL)
  targetType                ScanTargetType @default(PROJECT)
  // FULL re-scans the whole project; INCREMENTAL re-scans only items changed
  // since the last completed scan and carries unchanged findings forward.
  mode                      ScanMode       @default(FULL)
  // The git branch this scan's repo-based scanners ran against — the resolved
  // ProjectScanConfig.scanBranch, else the repository's default branch, else
  // null (no connected repo). Drives the branch-aware results view + history.
  branch                    String?
  securityRequested         Boolean        @default(true)
  accessibilityRequested    Boolean        @default(true)
  securityFindingCount      Int            @default(0)
  accessibilityFindingCount Int            @default(0)
  // Telemetry (mirrors Atlas analysis-run telemetry).
  modelName                 String?
  inputTokens               Int?
  outputTokens              Int?
  costUsd                   Float?
  durationMs                Int?
  error                     String?        @db.Text
  workflowId                String?
  startedAt                 DateTime?
  completedAt               DateTime?
  userId                    String
  organizationId            String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story        UserStory?              @relation(fields: [storyId], references: [id], onDelete: SetNull)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings     ScanFinding[]
  checkpoints  ProjectScanCheckpoint[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([storyId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("project_scan")
}

/// Per-branch incremental-scan checkpoint: the last COMPLETED-scan commit SHA on a
/// (project, branch), so subsequent scans diff only what changed since it and the
/// branch-status panel can show Scanned / Stale (live HEAD != commitSha). One row per
/// (projectId, branch); advances ONLY on a successful scan. Precedent:
/// AtlasParseCheckpoint / ProjectCodeIndex.commitSha.
model ProjectScanCheckpoint {
  id                 String   @id @default(cuid())
  projectId          String
  // Concrete resolved branch name (never the null "no-repo" case). Normalized.
  branch             String
  // Last COMPLETED-scan commit SHA on this branch. Advances only on success.
  commitSha          String
  // The scan run that last advanced this checkpoint (null if that run was purged).
  lastScanId         String?
  lastScannedAt      DateTime
  // Scope telemetry captured by the diff step of the run that advanced it.
  changedFileCount   Int?
  changedCommitCount Int?
  userId             String
  organizationId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan         ProjectScan?  @relation(fields: [lastScanId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, branch])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_scan_checkpoint")
}

// A single finding produced by a scan.
model ScanFinding {
  id              String            @id @default(cuid())
  scanId          String
  projectId       String
  storyId         String?
  category        ScanCategory
  severity        ScanSeverity
  title           String            @db.Text
  description     String            @db.Text
  remediation     String            @db.Text
  // Human-readable rule attribution, e.g. "OWASP Top 10 — A03:2021 Injection",
  // "WCAG 2.1 AA — 1.4.3 Contrast (Minimum)", or "Custom: <rule name>".
  ruleSource      String
  isCustomRule    Boolean           @default(false)
  location        String?           @db.Text // doc/feature reference the finding is about
  // Verifiable source link for the finding: a repo blob URL (Semgrep file:line),
  // a repo commit URL (git-history secret), else null. In-app feature links use
  // storyId instead (resolved from the finding's feature identifier).
  sourceUrl       String?           @db.Text
  // A short, redacted source excerpt that grounds the finding — Semgrep's matched
  // lines, a gitleaks rule/location description, or the AI scanner's cited quote.
  // Fed to the adversarial false-positive judge so it evaluates real evidence
  // (never `undefined`). Redacted like every field; null on legacy rows.
  evidence        String?           @db.Text
  status          ScanFindingStatus @default(OPEN)
  // Reviewer confidence 0..1 — the LLM's categorical bucket (high/medium/low)
  // mapped to a float so findings can be sorted/filtered by reliability. Repo
  // scanners (Semgrep/gitleaks) carry a derived confidence. Null for legacy rows.
  confidence      Float?
  // Stable cross-scan dedup key: a hash of category + rule + location + title.
  // Collapses intra-scan duplicates (parallel chunks overlap) and lets a re-scan
  // carry a recurring finding's triage forward instead of re-listing it. Null = legacy.
  fingerprint     String?
  // When this fingerprint was first detected, carried across scans on re-detection.
  firstDetectedAt DateTime?
  userId          String
  organizationId  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  scan         ProjectScan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story        UserStory?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, fingerprint])
  @@index([scanId])
  @@index([storyId])
  @@index([userId])
  @@index([organizationId])
  @@index([category, severity])
  @@map("scan_finding")
}

// Global, append-only activity log for a project's Security & Accessibility
// page: scan runs (who/when/result), finding status changes, and work-item
// conversions. Powers the page's "History" view. Tenant-scoped + user_owned RLS.
enum ScanActivityType {
  SCAN_STARTED
  SCAN_COMPLETED
  SCAN_FAILED
  FINDING_RESOLVED
  FINDING_DISMISSED
  FINDING_REOPENED
  FINDING_CONVERTED
  FINDING_EDITED
  CONFIG_UPDATED
  // A purge re-scan deleted the current unresolved findings before re-scanning.
  FINDINGS_PURGED
  // An AI false-positive review ran (or its proposals were applied in bulk).
  FINDINGS_REVIEWED
  // An on-demand AI false-positive review was triggered (who/when).
  REVIEW_STARTED
  // A running AI false-positive review was cancelled by the user.
  REVIEW_CANCELLED
  // The security-finding-grouping pipeline ran: one project-level summary row
  // per run, plus one per-theme row for each created/updated ticket outcome.
  FINDINGS_GROUPED
}

model ScanActivity {
  id             String           @id @default(cuid())
  projectId      String
  type           ScanActivityType
  // Optional links to the subject of the event.
  scanId         String?
  findingId      String?
  storyId        String? // converted work item
  // Human-readable summary, e.g. "22 findings (12 security, 10 accessibility)"
  // or "Converted to F-123". Rendered directly in the history list.
  summary        String?          @db.Text
  metadata       Json?
  userId         String // the actor
  organizationId String?
  createdAt      DateTime         @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([organizationId])
  // Supports "last known fingerprints for this ticket" lookups (the security
  // finding-grouping pipeline's incremental-update diff) in O(index scan).
  @@index([storyId, createdAt(sort: Desc)])
  @@map("scan_activity")
}

// One on-demand AI false-positive review run over a project's current
// unresolved findings. An adversarial (refute-by-default) judge re-examines each
// finding in a fresh context and PROPOSES a dismissal / severity change /
// "uncertain" with reasoning — it never mutates a finding. The user applies a
// subset explicitly. Tenant-scoped + user_owned RLS, like its scan siblings.
model ScanFindingReview {
  id             String     @id @default(cuid())
  projectId      String
  status         ScanStatus @default(PENDING)
  // Proposals JSON: [{ findingId, verdict: "confirmed"|"false_positive"|"uncertain",
  // suggestedStatus?, suggestedSeverity?, reasoning, confidence, evidence? }].
  proposals      Json?
  reviewedCount  Int        @default(0)
  modelName      String?
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Float?
  durationMs     Int?
  error          String?    @db.Text
  workflowId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  userId         String
  organizationId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([organizationId])
  @@map("scan_finding_review")
}

// One manually-triggered run of the security/accessibility finding-grouping pipeline.
// Unlike ScanFindingReview, this has no "apply" step: tickets/comments are written
// during the run. `results` is the durable record the UI's results dialog renders
// and the headline toast is computed from. Tenant-scoped + user_owned RLS, mirroring
// its scan siblings.
model ScanFindingGrouping {
  id             String            @id @default(cuid())
  projectId      String
  scanId         String? // the ProjectScan whose OPEN findings were read at run start (audit/debug only)
  status         GroupingRunStatus @default(PENDING)
  // Propose→apply payload. After the propose phase (AWAITING_REVIEW):
  // { proposedCreate[], proposedUpdate[], declinedThemes[], skippedThemes[],
  //   failedThemes[] }. After apply (COMPLETED) the applied themes also carry
  // { createdThemes[], updatedThemes[] } with their story ids.
  results        Json?
  createdCount   Int               @default(0)
  updatedCount   Int               @default(0)
  skippedCount   Int               @default(0)
  failedCount    Int               @default(0)
  themeCount     Int               @default(0) // total distinct (category, ruleSource) themes considered
  findingCount   Int               @default(0) // total eligible OPEN findings considered
  modelName      String?
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Float?
  durationMs     Int?
  error          String?           @db.Text
  workflowId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  userId         String
  organizationId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([organizationId])
  @@map("scan_finding_grouping")
}

// Code Index - Tracks AST-aware code indexing status for a project repository
model ProjectCodeIndex {
  id                      String          @id @default(cuid())
  projectId               String
  repositoryIntegrationId String? // null = project's legacy/default repositoryUrl
  branch                  String          @default("main")
  commitSha               String // Last indexed commit SHA
  filesIndexed            Int             @default(0)
  chunksCreated           Int             @default(0)
  summariesCreated        Int             @default(0)
  indexedFileCount        Int? // Live progress: files embedded so far in the current run
  totalFileCount          Int? // Live progress: total files to embed in the current run
  indexedAt               DateTime
  indexDurationMs         Int?
  status                  CodeIndexStatus @default(PENDING)
  error                   String?
  lastFullIndexAt         DateTime?
  lastIncrementalAt       DateTime?
  fileManifest            Json? // [{ path, sha, language }]
  redactionManifest       Json? // [{ path, type, count }] from secret scan
  workflowId              String? // Temporal workflow ID for tracking/cancellation

  // Tenant isolation
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, repositoryIntegrationId, branch])
  @@index([projectId])
  @@index([repositoryIntegrationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("project_code_index")
}

enum CodeIndexStatus {
  PENDING
  INDEXING
  READY
  STALE
  FAILED
}

// Code Symbol - Extracted function/class/enum names for symbol-level code search
model CodeSymbol {
  id        String  @id @default(cuid())
  projectId String
  name      String
  type      String // function, class, enum, interface, const, type, trait, impl
  filePath  String
  lineStart Int
  lineEnd   Int?
  signature String?
  language  String

  // Tenant isolation (strict XOR: either userId OR organizationId)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, name])
  @@index([projectId, type])
  @@index([userId])
  @@index([organizationId])
  @@map("code_symbol")
}

// ============================================================================
// Atlas tab
// Per-repository, AI-described dependency graph with Technical + Business
// lenses, plus a graph-grounded chat. Additive — sits beside ProjectCodeIndex.
// ============================================================================

enum AtlasStatus {
  NOT_ANALYZED
  PENDING
  ANALYZING
  READY
  FAILED
}

enum AtlasGraphMode {
  TECHNICAL
  BUSINESS
}

enum AtlasNodeKind {
  DIRECTORY
  MODULE
  FILE
  CAPABILITY
  DOMAIN
}

enum AtlasEdgeKind {
  CONTAINS
  IMPORTS
  DEPENDS_ON
  COVERS
  RELATES_TO
}

// One analysis snapshot per (project, connected repository).
model AtlasAnalysis {
  id                      String  @id @default(cuid())
  projectId               String
  repositoryIntegrationId String? // null = project's legacy/default repositoryUrl
  provider                String // RepositoryProvider as string
  repositoryUrl           String
  repositoryName          String?
  branch                  String  @default("main")

  status             AtlasStatus @default(NOT_ANALYZED)
  analyzedCommitSha  String? // snapshot commit the graph reflects (R7)
  analyzedCommitAt   DateTime?
  analyzedAt         DateTime?
  lastFullAnalysisAt DateTime?
  lastIncrementalAt  DateTime?

  nodeCount     Int @default(0)
  edgeCount     Int @default(0)
  filesAnalyzed Int @default(0)

  fileManifest      Json? // { [path]: contentHash } — drives incremental re-analysis (R9)
  techStack         Json? // [{ ecosystem, name, version, kind, dev }] — frameworks/libraries from manifests
  publishedPackages Json? // string[] — package identities this repo publishes (workspace names, module path…); drives precise cross-repo DEPENDS_ON
  businessTour      Json? // { intro, steps: [{ capabilityKey, title, narrative }] } — newcomer onboarding tour
  businessSignature String? // fnv1a of the module summaries+notes that produced the BUSINESS graph; on retry, identical inputs → skip the (expensive) AI re-derivation (resumability)
  workflowId        String?
  error             String?

  // Smart-analysis telemetry — captured by the workflow (summed across the AI
  // activities) and persisted by `finalize`. `analysisDurationMs` = run start →
  // finalize; cost is computed from the model's `AiModel` rates (micro-USD;
  // 1μ$ = $10^-6). All nullable so a structure-only / no-AI-provider run leaves
  // them blank.
  analysisModel      String? // canonical model name that produced the descriptions
  analysisDurationMs Int? // total analysis wall-clock (run start → finalize)
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  costMicroUsd       Int? // cost in micro-USD (1μ$ = $10^-6) of the AI describe/business spend
  reasoning          String? @db.Text // optional best-effort reasoning text from the AI calls

  // Non-blocking re-analysis (R2): a re-run of an already-READY analysis keeps
  // the served `status` = READY (the last-good graph stays visible) while these
  // mirror the in-flight run. First-ever analyses still flip `status` itself.
  // Cleared on finalize. `appliedUserOverrides` is false for a "from fresh" run.
  activeRunStatus      AtlasStatus? // PENDING | ANALYZING while a background run is in flight; null otherwise
  activeRunStartedAt   DateTime?
  appliedUserOverrides Boolean      @default(true)

  // Tenant isolation (mirrors ProjectCodeIndex)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes            AtlasNode[]
  edges            AtlasEdge[]
  runs             AtlasAnalysisRun[]
  parseCheckpoints AtlasParseCheckpoint[]

  // One analysis row per (project, repo, BRANCH): switching the monitored
  // branch and back restores the already-analysed map instead of resetting it.
  @@unique([projectId, repositoryIntegrationId, branch])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("atlas_analysis")
}

/// Resumability checkpoint for the structure (clone+parse) phase. One row per
/// parsed file holding only the compact, content-FREE per-file metadata
/// (FileMeta). When the worker is disrupted mid-parse (node eviction, OOM,
/// deploy), the retried activity re-clones the SAME commit, reloads these rows,
/// and skips re-parsing those files — only the holistic graph assembly re-runs
/// over the complete set, so the resulting graph stays byte-identical. Keyed by
/// (analysisId, commitSha): a re-clone at a different commit discards stale rows.
/// Cleared on success and on terminal failure.
model AtlasParseCheckpoint {
  id         String @id @default(cuid())
  analysisId String
  projectId  String
  commitSha  String

  path           String
  language       String
  namespace      String?
  loc            Int
  symbolCount    Int
  contentHash    String
  contentPreview String   @db.Text
  importSpecs    String[]

  // Tenant isolation (scalar columns for RLS; cascade handled via `analysis`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  analysis AtlasAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, path])
  @@index([analysisId, commitSha])
  @@index([organizationId])
  @@map("atlas_parse_checkpoint")
}

// Graph node. `key` is a stable identifier within (analysis, mode) so
// incremental re-runs upsert without id churn and edges reference by key.
model AtlasNode {
  id         String @id @default(cuid())
  analysisId String
  projectId  String

  mode      AtlasGraphMode
  kind      AtlasNodeKind
  key       String
  label     String
  filePath  String?
  language  String?
  parentKey String?

  technicalDescription String? @db.Text
  businessDescription  String? @db.Text
  category             String? // AI-assigned: ai|integration|security|infra|data|experience|ops, or a custom keyword
  contentPreview       String? @db.Text // capped, redacted snippet — context for on-demand AI describe + chat grounding
  documentation        String? @db.Text // attached markdown docs (README etc.) for this node, rendered in the panel
  metrics              Json?
  layout               Json?
  contentHash          String? // for incremental file-change detection
  qdrantPointId        String? // reserved for future semantic retrieval

  // Tenant isolation (scalar columns for RLS; cascade handled via `analysis`)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis AtlasAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, mode, key])
  @@index([analysisId, mode])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("atlas_node")
}

// Graph edge, referencing nodes by their stable `key` within (analysis, mode).
model AtlasEdge {
  id         String @id @default(cuid())
  analysisId String
  projectId  String

  mode      AtlasGraphMode
  kind      AtlasEdgeKind
  sourceKey String
  targetKey String
  weight    Int?

  // Tenant isolation (scalar columns for RLS; cascade handled via `analysis`)
  userId         String
  organizationId String?

