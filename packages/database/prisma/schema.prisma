// =============================================================================
// AGENT DEPLOYMENT INFRASTRUCTURE
// Durable, long-running agent deployment system
// =============================================================================

enum AgentDeploymentStatus {
  PENDING // Deployment requested, supervisor not started
  DEPLOYING // Starting supervisor workflow
  ACTIVE // Running, accepting executions
  PAUSED // Temporarily stopped, supervisor sleeping
  DEGRADED // Running but unhealthy
  FAILED // Deployment failed, needs manual intervention
  TERMINATED // Permanently stopped
}

enum AgentDeploymentHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum DeploymentExecutionStatus {
  PENDING // Queued, waiting to start
  RUNNING // Currently executing
  WAITING_INPUT // Waiting for user input (HITL)
  COMPLETED // Successfully completed
  FAILED // Failed with error
  CANCELLED // Cancelled by user
  TIMED_OUT // Exceeded timeout
}

enum DeploymentTriggerType {
  MANUAL
  WEBHOOK
  SLACK
  SCHEDULE
  EMAIL
  API
  LIFECYCLE_EVENT
  /// Slice 5a.1 — uniform channel trigger. `config` carries
  /// `{ channel: "telegram" | ..., chatIdPattern?: string }`.
  /// Replaces SLACK long-term as Slack migrates onto ChannelAdapter (Slice 5b).
  CHANNEL_MESSAGE
}

// AgentDeployment - Running instance of an agent
// Represents a deployed, durable agent that can accept executions
model AgentDeployment {
  id             String  @id @default(cuid())
  instanceId     String  @unique
  userId         String
  organizationId String?

  // Deployment identification
  name String
  slug String // URL-friendly identifier

  // Deployment state
  status       AgentDeploymentStatus @default(PENDING)
  deployedAt   DateTime?
  pausedAt     DateTime?
  terminatedAt DateTime?
  lastActiveAt DateTime?

  // Temporal workflow management
  supervisorWorkflowId String? // Long-running supervisor workflow
  supervisorRunId      String?

  // Task queue assignment (for sharding)
  taskQueue String? // e.g., "agents-org-abc123-shard-0"

  // Health & monitoring
  healthStatus        AgentDeploymentHealthStatus @default(UNKNOWN)
  lastHealthCheck     DateTime?
  consecutiveFailures Int                         @default(0)

  // Concurrency control
  maxConcurrentExecutions Int @default(5)
  currentExecutions       Int @default(0)

  // Rate limiting (per deployment)
  rateLimitPerMinute Int @default(60)
  rateLimitPerHour   Int @default(500)

  // Active trigger configurations
  activeTriggers Json @default("[]") // Activated triggers from instance

  // Resource quotas
  dailyExecutionLimit   Int?
  monthlyExecutionLimit Int?
  dailyExecutionCount   Int       @default(0)
  monthlyExecutionCount Int       @default(0)
  quotaResetAt          DateTime?

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instance            AgentTemplateInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions          AgentDeploymentExecution[]
  triggers            AgentDeploymentTrigger[]
  metrics             AgentDeploymentMetrics[]
  slackThreadMappings SlackThreadMapping[]

  @@unique([userId, slug])
  @@unique([organizationId, slug])
  @@index([status])
  @@index([taskQueue])
  @@index([healthStatus])
  @@index([userId])
  @@index([organizationId])
  @@map("agent_deployment")
}

// AgentDeploymentExecution - Individual execution record
model AgentDeploymentExecution {
  id             String  @id @default(cuid())
  deploymentId   String
  userId         String
  organizationId String?

  // Execution identification
  executionId String @unique // Temporal workflow execution ID

  // Trigger information
  triggerType String // "manual", "webhook", "slack", "schedule", "api"
  triggerId   String? // Reference to specific trigger
  triggerData Json? // Data from the trigger

  // Status tracking
  status      DeploymentExecutionStatus @default(PENDING)
  queuedAt    DateTime                  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // milliseconds

  // Priority (for queue ordering)
  priority Int @default(5) // 1 (highest) to 10 (lowest)

  // Input/Output
  input  Json?
  output Json?
  error  String? @db.Text

  // Temporal tracking
  workflowId String?
  runId      String?

  // Token usage
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalCost    Decimal? @db.Decimal(10, 6)

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deployment AgentDeployment      @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  steps      AgentExecutionStep[]

  @@index([deploymentId])
  @@index([status])
  @@index([triggerType])
  @@index([priority])
  @@index([queuedAt])
  @@index([userId])
  @@index([organizationId])
  @@map("agent_deployment_execution")
}

// AgentExecutionStep - Individual step within an execution
model AgentExecutionStep {
  id          String @id @default(cuid())
  executionId String

  // Step identification
  stepNumber Int
  stepType   String // "planning", "tool_call", "llm_call", "approval", etc.

  // Step details
  name        String?
  description String?

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?

  // Input/Output
  input  Json?
  output Json?
  error  String?

  // Status
  status String @default("pending") // pending, running, completed, failed, skipped

  // Tenant isolation (copied from parent AgentDeploymentExecution)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  // Relations
  execution    AgentDeploymentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([stepType])
  @@index([userId])
  @@index([organizationId])
  @@map("agent_execution_step")
}

// AgentDeploymentTrigger - Activated trigger for a deployment
model AgentDeploymentTrigger {
  id           String @id @default(cuid())
  deploymentId String

  // Trigger type
  type DeploymentTriggerType

  // Trigger configuration (type-specific)
  config Json

  // Webhook-specific
  webhookSecret String? // Secret for validating webhook signatures
  webhookUrl    String? // Generated URL for this trigger

  // Schedule-specific
  cronExpression String?
  timezone       String?
  nextRunAt      DateTime?
  lastRunAt      DateTime?

  // Slack-specific
  slackChannelId String?
  slackTeamId    String?

  // Optional project binding — when set, agents invoked via this trigger
  // receive project metadata in the system prompt and can use project-scoped
  // tools (e.g., project_rag_query) bound to this project.
  projectId String?

  // Status
  isActive Boolean @default(true)

  // Execution tracking
  totalExecutions Int     @default(0)
  lastExecutionId String?

  // Tenant isolation (copied from parent AgentDeployment)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deployment   AgentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([deploymentId, type, slackChannelId])
  @@index([type])
  @@index([isActive])
  @@index([nextRunAt])
  @@index([userId])
  @@index([organizationId])
  @@index([projectId])
  @@map("agent_deployment_trigger")
}

// SlackThreadMapping - Tracks Slack thread to Fabric conversation/workflow mapping
// Enables conversational thread continuity for Slack agent interactions
model SlackThreadMapping {
  id String @id @default(cuid())

  // Slack identifiers (composite unique key for thread lookup)
  slackTeamId    String
  slackChannelId String
  slackThreadTs  String // Parent message timestamp (thread ID)

  // Fabric identifiers
  deploymentId   String
  triggerId      String?
  workflowId     String? // Active workflow identity for signaling
  conversationId String? // Links to AgentConversation if stored

  // State tracking
  status        String    @default("active") // active, paused, closed
  lastMessageTs String? // Last processed message timestamp
  timeoutAt     DateTime? // When thread auto-closes

  // Context preservation (lightweight summary only)
  // Full conversation history stays in existing conversation/workflow systems
  contextJson Json?

  // Tenant isolation
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deployment   AgentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([slackTeamId, slackChannelId, slackThreadTs])
  @@index([deploymentId])
  @@index([workflowId])
  @@index([conversationId])
  @@index([status])
  @@index([userId])
  @@index([organizationId])
  @@map("slack_thread_mapping")
}

// SlackEventReceipt - Idempotency protection for Slack Events API
// Prevents duplicate processing of retried events
model SlackEventReceipt {
  id             String   @id @default(cuid())
  slackEventId   String   @unique // Slack's event_id for deduplication
  slackTeamId    String
  slackChannelId String?
  slackMessageTs String?
  processedAt    DateTime @default(now())

  // Tenant isolation
  organizationId String?
  userId         String?

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([slackTeamId])
  @@index([slackEventId])
  @@index([userId])
  @@index([organizationId])
  @@map("slack_event_receipt")
}

// TeamsEventReceipt - Idempotency and rate-limiting protection for Teams Events API
// Creates one record per incoming webhook event for accurate burst detection
model TeamsEventReceipt {
  id           String   @id @default(cuid())
  teamsEventId String   @unique // Teams activity.id for deduplication
  channelId    String
  teamId       String?
  messageId    String
  receivedAt   DateTime @default(now())

  // Tenant isolation
  userId         String?
  organizationId String?

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([channelId, receivedAt])
  @@index([teamsEventId])
  @@index([userId])
  @@index([organizationId])
  @@map("teams_event_receipt")
}

// AgentDeploymentMetrics - Aggregated metrics per deployment
model AgentDeploymentMetrics {
  id           String @id @default(cuid())
  deploymentId String

  // Time window
  windowStart DateTime
  windowEnd   DateTime
  windowType  String // "hourly", "daily", "weekly", "monthly"

  // Execution metrics
  totalExecutions      Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions     Int @default(0)
  cancelledExecutions  Int @default(0)
  timedOutExecutions   Int @default(0)

  // Performance metrics
  avgDurationMs Int?
  p50DurationMs Int?
  p95DurationMs Int?
  p99DurationMs Int?

  // Token usage
  totalInputTokens  Int      @default(0)
  totalOutputTokens Int      @default(0)
  totalCost         Decimal? @db.Decimal(10, 6)

  // Trigger breakdown
  executionsByTrigger Json @default("{}") // { "webhook": 100, "slack": 50, ... }

  // Tenant isolation (copied from parent AgentDeployment)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  // Relations
  deployment   AgentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, windowStart, windowType])
  @@index([deploymentId])
  @@index([windowStart])
  @@index([userId])
  @@index([organizationId])
  @@map("agent_deployment_metrics")
}

// TaskQueueShard - Dynamic task queue management
model TaskQueueShard {
  id String @id @default(cuid())

  // Queue identification
  queueName String @unique
  shardType String // "personal", "organization", "priority", "batch"

  // Ownership (for org shards)
  organizationId String?

  // Capacity tracking
  currentDepth Int @default(0)
  maxDepth     Int @default(1000)

  // Worker tracking
  activeWorkers Int @default(0)
  targetWorkers Int @default(2)

  // Health
  isHealthy       Boolean   @default(true)
  lastHealthCheck DateTime?

  // Metrics
  totalProcessed Int  @default(0)
  avgLatencyMs   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shardType])
  @@index([organizationId])
  @@index([isHealthy])
  @@map("task_queue_shard")
}

// OrganizationDeploymentQuota - Per-org deployment limits
model OrganizationDeploymentQuota {
  id             String @id @default(cuid())
  organizationId String @unique

  // Deployment limits
  maxDeployments          Int @default(10)
  maxConcurrentExecutions Int @default(50)

  // Execution limits
  dailyExecutionLimit   Int @default(1000)
  monthlyExecutionLimit Int @default(20000)

  // Current usage
  currentDeployments    Int @default(0)
  dailyExecutionCount   Int @default(0)
  monthlyExecutionCount Int @default(0)

  // Reset tracking
  dailyResetAt   DateTime?
  monthlyResetAt DateTime?

  // Custom limits (for enterprise)
  customLimits Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_deployment_quota")
}

// UserDeploymentQuota - Per-user deployment limits (personal accounts)
model UserDeploymentQuota {
  id     String @id @default(cuid())
  userId String @unique

  // Deployment limits
  maxDeployments          Int @default(3)
  maxConcurrentExecutions Int @default(10)

  // Execution limits
  dailyExecutionLimit   Int @default(100)
  monthlyExecutionLimit Int @default(2000)

  // Current usage
  currentDeployments    Int @default(0)
  dailyExecutionCount   Int @default(0)
  monthlyExecutionCount Int @default(0)

  // Reset tracking
  dailyResetAt   DateTime?
  monthlyResetAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_deployment_quota")
}

// =============================================================================
// AGENT MEMORY SYSTEM
// Virtual filesystem for agent procedural, semantic, and episodic memory
// Based on LangSmith Agent Builder's COALA-inspired memory architecture
// =============================================================================

// AgentMemoryFile - Virtual filesystem entries for agent memory
// Stores AGENTS.md, mcp.json, skills, knowledge, and conversation summaries
model AgentMemoryFile {
  id String @id @default(cuid())

  // Ownership (XOR pattern for tenant isolation)
  agentInstanceId String? // For Agent Template Instances
  userId          String
  organizationId  String?

  // File system representation
  path     String // "AGENTS.md", "skills/research/SKILL.md", etc.
  fileType AgentMemoryFileType

  // Content
  content     String @db.Text
  contentHash String // SHA-256 hash for change detection

  // Versioning & validation
  version         Int     @default(1)
  isValid         Boolean @default(true)
  validationError String?

  // Audit trail
  lastModifiedBy String // "user" | "agent" | "system"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Skill provenance tracking
  sourceSkillId String? // Links back to the Skill catalog entry this was materialized from
  isEnabled     Boolean @default(true) // Allows toggling skills on/off per instance

  // Relations
  agentInstance AgentTemplateInstance? @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  edits         AgentMemoryEdit[]      @relation("MemoryFileEdits")
  sourceSkill   Skill?                 @relation(fields: [sourceSkillId], references: [id], onDelete: SetNull)

  @@unique([agentInstanceId, path])
  @@index([userId])
  @@index([organizationId])
  @@index([fileType])
  @@index([agentInstanceId])
  @@index([sourceSkillId])
  @@map("agent_memory_file")
}

// AgentMemoryEdit - Pending/applied edits to memory files (for HITL approval)
model AgentMemoryEdit {
  id String @id @default(cuid())

  // Target file (null for CREATE operations on new files)
  memoryFileId String?

  // Ownership (mirrors AgentMemoryFile)
  agentInstanceId String?
  userId          String
  organizationId  String?

  // Edit details
  operation  AgentMemoryEditOperation
  path       String // Target path for the edit
  oldContent String?                  @db.Text // Previous content (for UPDATE/DELETE)
  newContent String                   @db.Text // New content (for CREATE/UPDATE)
  reason     String? // Why the agent wants to make this change

  // Approval workflow
  status          AgentMemoryEditStatus @default(PENDING)
  autoApproved    Boolean               @default(false) // YOLO mode
  approvedBy      String? // User ID who approved
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  // Relations
  memoryFile    AgentMemoryFile?       @relation("MemoryFileEdits", fields: [memoryFileId], references: [id], onDelete: Cascade)
  agentInstance AgentTemplateInstance? @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([agentInstanceId, status])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([memoryFileId])
  @@map("agent_memory_edit")
}

// Enums for Agent Memory

enum AgentMemoryFileType {
  AGENTS_MD // Procedural - core instructions
  MCP_JSON // Procedural - tool configuration
  SKILL // Semantic - specialized task instructions
  KNOWLEDGE // Semantic - domain facts and context
  CONVERSATION // Episodic - summarized past conversations
  CUSTOM // User-created arbitrary files
}

enum AgentMemoryEditOperation {
  CREATE
  UPDATE
  DELETE
}

enum AgentMemoryEditStatus {
  PENDING // Awaiting user approval
  APPROVED // Approved and applied
  REJECTED // Rejected by user
  AUTO_APPROVED // Automatically approved (YOLO mode)
}

// =============================================================================
// SKILL CATALOG
// Reusable skill definitions that can be attached to agent templates and
// materialized as AgentMemoryFile entries on instance creation.
// =============================================================================

// Skill - Reusable skill definition (browsable catalog)
model Skill {
  id          String @id @default(cuid())
  slug        String // URL-friendly identifier (unique per scope)
  name        String
  description String @db.Text
  content     String @db.Text // Markdown content (the actual skill instructions)

  // Categorization
  category String? // e.g., "data-analysis", "code-review", "research"
  tags     String[] @default([])

  // Multi-tenancy (same pattern as AgentTemplate)
  scope          AgentTemplateScope @default(SYSTEM)
  userId         String?
  organizationId String?

  // Publishing & versioning
  version     Int     @default(1)
  isPublished Boolean @default(true)

  // Usage tracking
  useCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateSkills       AgentTemplateSkill[]
  reportTemplateSkills ReportTemplateSkill[]
  memoryFiles          AgentMemoryFile[] // Materialized instances of this skill
  files                SkillFile[] // Additional skill files (assets/, references/, scripts/) beyond SKILL.md stored in `content`

  @@unique([slug, scope, userId, organizationId])
  @@index([scope])
  @@index([userId])
  @@index([organizationId])
  @@index([category])
  @@index([isPublished])
  @@map("skill")
}

// SkillFile - Non-SKILL.md files that ship with a skill (assets, references, scripts).
// The canonical SKILL.md body lives in `Skill.content`; binary or large files live
// in S3 and are referenced here. Mirrors Anthropic Agent Skills directory layout:
//   skills/<slug>/SKILL.md              -> Skill.content
//   skills/<slug>/assets/template.html  -> SkillFile(path="assets/template.html")
//   skills/<slug>/references/colors.md  -> SkillFile(path="references/colors.md")
model SkillFile {
  id          String @id @default(cuid())
  skillId     String
  path        String // Relative path inside the skill, e.g. "assets/template.html"
  contentType String // MIME type
  storageKey  String // S3 object key: skills/{skillId}/{id}/{basename}
  sizeBytes   Int
  sha256      String
  version     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, path])
  @@index([skillId])
  @@map("skill_file")
}

// AgentTemplateSkill - Join table linking skills to templates
model AgentTemplateSkill {
  id         String  @id @default(cuid())
  templateId String
  skillId    String
  isRequired Boolean @default(true) // Whether skill can be opted out during instance creation
  sortOrder  Int     @default(0) // Display/loading order

  createdAt DateTime @default(now())

  // Relations
  template AgentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skill    Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([templateId, skillId])
  @@index([templateId])
  @@index([skillId])
  @@map("agent_template_skill")
}

// ReportTemplateSkill - Join table linking skills to report templates
model ReportTemplateSkill {
  id         String  @id @default(cuid())
  templateId String
  skillId    String
  isRequired Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())

  // Relations
  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skill    Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([templateId, skillId])
  @@index([templateId])
  @@index([skillId])
  @@map("report_template_skill")
}

// =============================================================================
// ORCHESTRATOR MEMORY SYSTEM
// Hybrid memory architecture for Fabric Loom with multi-tenant isolation
// Tier 1 (Hot): User preferences - always loaded (<10ms)
// Tier 2 (Warm): Session cache - Letta memory blocks
// Tier 3 (Cold): Semantic search - Qdrant episodic memory
// Tier 4 (Archive): Full content - PostgreSQL VFS + S3
// =============================================================================

// OrchestratorMemoryPreferences - Hot memory tier for user preferences
// Small, frequently accessed, always loaded in context (~2KB max)
model OrchestratorMemoryPreferences {
  id String @id @default(cuid())

  // Ownership (XOR pattern - personal OR org context)
  userId         String
  organizationId String? // NULL = personal context

  // Quick access fields (denormalized for speed)
  responseStyle String? // "bullet_points" | "prose" | "concise" | "detailed"
  verbosity     String? // "minimal" | "balanced" | "comprehensive"
  codeLanguage  String? // Preferred programming language
  timezone      String? // User's timezone for scheduling context
  language      String? // Preferred response language

  // Compact preferences (max 2KB JSON)
  preferences Json @default("{}")
  // Example:
  // {
  //   "formatting": { "useBulletPoints": true, "maxParagraphLength": 3 },
  //   "communication": { "formality": "casual", "technicalLevel": "expert" },
  //   "workflow": { "autoApproveMinor": true, "confirmBeforeDelete": true },
  //   "learnedPatterns": ["prefers error handling in code", "likes concise summaries"]
  // }

  // Recent context (for session continuity)
  recentProjectIds   String[] // Last 5 active projects
  recentWorkspaceIds String[] // Last 5 active workspaces
  lastActiveAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId]) // One per user per context
  @@index([userId])
  @@index([organizationId])
  @@map("orchestrator_memory_preferences")
}

// EpisodicMemory - Cold memory tier for past conversations
// Searchable via Qdrant embeddings, full content in PostgreSQL
model EpisodicMemory {
  id String @id @default(cuid())

  // Ownership (multi-level scoping for access control)
  userId         String
  organizationId String? // NULL = personal context
  projectId      String? // Scope to specific project (optional)
  workspaceId    String? // Scope to specific workspace (optional)

  // Conversation reference
  conversationId String  @unique // Link to original AgentConversation
  agentId        String? // "fabric-ai" for orchestrator, or agent template ID

  // Summary content (stored in PostgreSQL for fast access)
  title   String
  summary String @db.Text

  // Extracted metadata for filtering
  keyTopics   String[] // ["project-planning", "debugging", "requirements"]
  userIntents String[] // ["fix bug", "create document", "analyze data"]
  outcome     String // "completed" | "abandoned" | "ongoing" | "delegated"

  // Interaction metrics
  messageCount Int
  turnCount    Int
  toolsUsed    String[]
  agentsUsed   String[] // For delegated tasks

  // Timestamps
  conversationStartedAt DateTime
  conversationEndedAt   DateTime?
  createdAt             DateTime  @default(now())

  // Qdrant reference (for semantic search)
  qdrantPointId    String? // Reference to vector in Qdrant collection
  qdrantCollection String? // Collection name for tenant isolation

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, organizationId])
  @@index([projectId])
  @@index([workspaceId])
  @@index([conversationEndedAt])
  @@index([agentId])
  @@index([keyTopics])
  @@index([qdrantPointId])
  @@map("episodic_memory")
}

// =============================================================================
// DOCUMENT EVALUATION SYSTEM
// Golden reference comparison and quality metrics for generated documents
// =============================================================================

// GoldenReference - Pre-approved reference documents for quality comparison
// Used to evaluate generated documents against known-good examples
model GoldenReference {
  id String @id @default(cuid())

  // Document type this reference applies to
  documentType ProjectDocumentType

  // Human-readable name for this reference
  name        String
  description String?

  // The actual reference document content (markdown)
  content String @db.Text

  // Sample project context that goes with this reference
  // Useful for understanding what kind of project this reference is for
  projectContext Json?
  // Example:
  // {
  //   "name": "E-commerce Checkout App",
  //   "techStack": ["React", "Node.js", "PostgreSQL"],
  //   "features": ["cart", "checkout", "payment"],
  //   "projectTypes": ["web", "mobile"]
  // }

  // Key sections and phrases that MUST appear in a good document
  requiredSections String[] // ["Executive Summary", "Goals & Success Metrics", ...]
  keyPhrases       String[] // Important terms/concepts that should be covered

  // Embedding for semantic similarity comparison
  qdrantPointId    String? // Reference to vector in Qdrant
  qdrantCollection String? // Collection name

  // Version tracking
  version  Int     @default(1)
  isActive Boolean @default(true)

  // Ownership - SYSTEM references are global, USER/ORG are custom
  scope          GoldenReferenceScope @default(SYSTEM)
  userId         String? // Only for USER scope
  organizationId String? // Only for ORG scope

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  evals DocumentEval[]

  @@index([documentType])
  @@index([scope])
  @@index([isActive])
  @@index([userId])
  @@index([organizationId])
  @@map("golden_reference")
}

// DocumentEval - Evaluation results for a generated document
// Links a project document to its evaluation against golden references
model DocumentEval {
  id String @id @default(cuid())

  // The document being evaluated
  projectDocumentId String
  documentVersion   Int // Version of the document at time of eval

  // The golden reference used for comparison (optional - can eval without one)
  goldenReferenceId String?

  // Overall evaluation result
  overallScore Float // 0-100 composite score
  passed       Boolean // Did it meet the threshold?
  threshold    Float   @default(70) // Pass/fail threshold used

  // Breakdown scores
  structureScore  Float // Required sections present, correct hierarchy
  coverageScore   Float // Key topics from golden reference covered
  similarityScore Float // Semantic similarity score (embedding-based)
  qualityScore    Float // Formatting, content quality from validation

  // Mastra evaluation metadata
  evalVersion   Int     @default(1) // 1 = legacy, 2 = Mastra
  contentHash   String?
  costUsd       Float   @default(0)
  evalMode      String  @default("hybrid") // "hybrid" | "nlp_only"
  llmProvider   String?
  llmModel      String?
  nlpDurationMs Int?
  llmDurationMs Int?
  nlpScores     Json?
  llmScores     Json?

  // Detailed feedback
  feedback    String?  @db.Text // Human-readable summary
  suggestions String[] // Improvement suggestions

  // Missing elements
  missingSections String[] // Required sections not found
  missingPhrases  String[] // Key phrases not covered

  // Execution context
  workflowId      String? // Temporal workflow ID if triggered from workflow
  executionTimeMs Int? // How long the eval took

  // Ownership (matches the document's ownership)
  userId         String
  organizationId String?

  createdAt DateTime @default(now())

  // Relations
  projectDocument ProjectDocument      @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  goldenReference GoldenReference?     @relation(fields: [goldenReferenceId], references: [id], onDelete: Cascade)
  metrics         DocumentEvalMetric[]

  @@index([projectDocumentId])
  @@index([goldenReferenceId])
  @@index([userId])
  @@index([organizationId])
  @@index([passed])
  @@index([createdAt])
  @@map("document_eval")
}

model OrganizationEvalBudget {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  monthlyBudgetUsd Float?   @default(100.0)
  currentMonthUsd  Float    @default(0)
  lastResetAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_eval_budget")
}

// DocumentEvalMetric - Individual metric scores for fine-grained tracking
// Allows tracking specific dimensions over time
model DocumentEvalMetric {
  id String @id @default(cuid())

  documentEvalId String

  // Metric identification
  metricName String // "structure_match", "content_coverage", "semantic_similarity", etc.
  category   String // "structure", "content", "quality", "similarity"

  // Score and details
  score       Float // 0-100
  weight      Float   @default(1.0) // Weight in composite score
  rawValue    Float? // Raw value before normalization (e.g., cosine similarity)
  description String? // Human-readable explanation

  // Additional context
  metadata Json? // Metric-specific details
  // Example for structure_match:
  // { "foundSections": ["Executive Summary", "Goals"], "expectedSections": ["Executive Summary", "Goals", "User Stories"] }

  createdAt DateTime @default(now())

  // Relations
  documentEval DocumentEval @relation(fields: [documentEvalId], references: [id], onDelete: Cascade)

  @@index([documentEvalId])
  @@index([metricName])
  @@index([category])
  @@map("document_eval_metric")
}

enum GoldenReferenceScope {
  SYSTEM // Global, available to all users
  USER // Personal golden reference
  ORG // Organization-specific golden reference
}

// ============================================================================
// DYNAMIC AGENTS - Dynamic Agent System
// ============================================================================

// OffloadedToolOutput - Temporary storage for large tool outputs
// Used by context pruning to offload large outputs and retrieve summaries
model OffloadedToolOutput {
  id              String    @id @default(cuid())
  executionId     String // Reference to the execution
  toolName        String
  summary         String    @db.Text // Brief summary for context
  fullOutput      String    @db.Text // Full output stored for retrieval
  outputSizeBytes Int
  contentHash     String // For deduplication
  expiresAt       DateTime?

  // Tenant isolation
  userId         String?
  organizationId String?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([contentHash])
  @@index([expiresAt])
  @@index([userId])
  @@index([organizationId])
  @@map("offloaded_tool_output")
}

// DynamicAgentConfig - User-created dynamic agents (Visual Agent Builder)
model DynamicAgentConfig {
  id          String  @id @default(cuid())
  name        String
  displayName String
  description String? @db.Text
  avatarUrl   String?

  // Tenant isolation (XOR: either user OR organization)
  userId         String?
  organizationId String?
  scope          AgentScope @default(USER)

  // Instructions (Dust-style)
  systemPrompt        String @db.Text
  instructionSections Json   @default("[]") // Array of { title, content }

  // Capabilities - MCP Tools
  enabledToolIds String[] // MCP config IDs

  // Capabilities - Data Sources
  workspaceIds String[] // Workspace IDs for RAG
  connectorIds String[] // Connector IDs (Slack, Notion, GitHub)

  // Sub-agent Delegation
  canDelegateToAgents Boolean  @default(false)
  delegatableAgentIds String[] // Agent IDs that can be delegated to
  maxRecursionDepth   Int      @default(4)

  // Model Configuration
  aiModel     String?
  aiProvider  String? // Provider type: OPENAI_DIRECT, ANTHROPIC_DIRECT, etc.
  temperature Float?

  // Execution Limits
  maxIterations    Int @default(50)
  maxTokensPerTurn Int @default(8000)
  timeoutMs        Int @default(1800000) // 30 minutes

  // Versioning
  version           Int     @default(1)
  versionNotes      String?
  previousVersionId String?

  // Status
  status DynamicAgentStatus @default(DRAFT)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  triggers     DynamicAgentTrigger[]
  executions   DynamicAgentExecution[]
  favorites    DynamicAgentFavorite[]

  @@unique([name, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("dynamic_agent_config")
}

enum DynamicAgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DEPRECATED
}

// DynamicAgentTrigger - Trigger configurations for dynamic agents
// Supports manual, scheduled, webhook, event, and mention triggers
model DynamicAgentTrigger {
  id            String @id @default(cuid())
  agentConfigId String

  // Trigger type and name
  type        DynamicAgentTriggerType
  name        String
  description String?

  // Status
  isEnabled Boolean @default(true)

  // Schedule trigger (cron expression)
  schedule String? // Cron expression: "0 9 * * *"
  timezone String? @default("UTC")

  // Webhook trigger
  webhookSecret String?

  // Event trigger
  eventType   String? // e.g., "github.push", "notion.page.updated"
  eventFilter Json? // Filter conditions

  // Input template (for automated triggers)
  inputTemplate Json?

  // Execution tracking
  lastTriggeredAt DateTime?
  nextScheduledAt DateTime?
  triggerCount    Int       @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  agentConfig DynamicAgentConfig      @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  executions  DynamicAgentExecution[]

  @@index([agentConfigId])
  @@index([type])
  @@index([isEnabled])
  @@index([nextScheduledAt])
  @@map("dynamic_agent_trigger")
}

enum DynamicAgentTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
  MENTION
}

// DynamicAgentExecution - Execution records for dynamic agents
model DynamicAgentExecution {
  id            String  @id @default(cuid())
  agentConfigId String
  triggerId     String?

  // Temporal workflow reference
  temporalWorkflowId String?
  temporalRunId      String?

  // Tenant isolation
  userId         String?
  organizationId String?

  // Status
  status DynamicAgentExecutionStatus @default(PENDING)

  // Input/Output
  input  Json?
  output Json?
  error  String? @db.Text

  // Metrics
  iterationCount   Int  @default(0)
  totalTokensUsed  Int  @default(0)
  totalToolCalls   Int  @default(0)
  totalDelegations Int  @default(0)
  durationMs       Int?

  // Conversation history (for retrieval)
  conversationHistory Json     @default("[]")
  toolOutputRefs      String[] // IDs of offloaded tool outputs

  // Metadata
  metadata Json?

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  agentConfig  DynamicAgentConfig   @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  trigger      DynamicAgentTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([agentConfigId])
  @@index([triggerId])
  @@index([temporalWorkflowId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("dynamic_agent_execution")
}

enum DynamicAgentExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

// DynamicAgentFavorite - User favorites for quick access
model DynamicAgentFavorite {
  id            String @id @default(cuid())
  userId        String
  agentConfigId String

  createdAt DateTime @default(now())

  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConfig DynamicAgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, agentConfigId])
  @@index([userId])
  @@index([agentConfigId])
  @@map("dynamic_agent_favorite")
}

// ============================================================================
// DATA CONNECTIONS - External Data Sync
// Connections → Workspaces → Agents pattern
// ============================================================================

// DataConnection - Connection to an external service for data sync
model DataConnection {
  id String @id @default(cuid())

  // Tenant isolation (XOR pattern)
  userId         String?
  organizationId String?

  // Connection details
  provider     DataConnectionProvider
  name         String
  status       DataConnectionStatus   @default(PENDING)
  credentialId String?

  // External workspace/instance identification (allows multiple per provider)
  externalWorkspaceId   String? // Workspace ID from the provider (e.g., Notion workspace ID)
  externalWorkspaceName String? // Human-readable workspace name

  // OAuth/credentials (encrypted)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  credentials    Json? // For API key-based providers (Snowflake, BigQuery)

  // Configuration
  config        Json? // Provider-specific config (selected folders, channels, etc.)
  lastSyncAt    DateTime?
  lastSyncError String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relations
  user            User?                     @relation("DataConnectionUser", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User                      @relation("DataConnectionCreator", fields: [createdBy], references: [id])
  credential      DataConnectionCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  syncJobs        DataSyncJob[]
  syncedResources SyncedResource[]
  schedules       DataSyncSchedule[]

  // Unique per workspace per provider per user/org (allows multiple workspaces)
  @@unique([userId, provider, externalWorkspaceId], name: "user_provider_workspace_unique")
  @@unique([organizationId, provider, externalWorkspaceId], name: "org_provider_workspace_unique")
  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@index([status])
  @@index([createdBy])
  @@index([credentialId])
  @@map("data_connection")
}

model DataConnectionCredential {
  id String @id @default(cuid())

  // Tenant isolation (XOR pattern)
  userId         String?
  organizationId String?

  provider         DataConnectionProvider
  name             String
  credentialType   String?
  encryptedPayload String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  user            User?            @relation("DataConnectionCredentialUser", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User             @relation("DataConnectionCredentialCreator", fields: [createdBy], references: [id])
  dataConnections DataConnection[]

  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@index([createdBy])
  @@map("data_connection_credential")
}

enum DataConnectionProvider {
  GOOGLE_DRIVE
  S3
  GOOGLE_STORAGE
  R2
  DROPBOX
  AIRTABLE
  CODA
  GITBOOK
  NOTION
  CONFLUENCE
  TEAMS
  INTERCOM
  GITHUB
  GITLAB
  BITBUCKET
  LINEAR
  ASANA
  CLICKUP
  SLACK
  SNOWFLAKE
  BIGQUERY
  ZENDESK
  GONG
  GMAIL
  JIRA
  MICROSOFT_365
  SALESFORCE
  HUBSPOT
}

enum DataConnectionStatus {
  PENDING // OAuth not completed
  CONNECTED // Active connection
  SYNCING // Currently syncing
  ERROR // Connection error
  PAUSED // Manually paused
  EXPIRED // Token expired, needs reauth
}

// =====================================================
// MONITORING / INCIDENTS MODELS
// =====================================================
// Admin-owned global tables that record error-rate burn-rate alerts (Path A)
// and external integration outages (Path B). All four tables are GLOBAL:
// there is no per-tenant column. Read/write is gated by `adminProcedure` in
// oRPC, and RLS denies access from per-tenant connections. Per-org rollups
// are derived from Prometheus labels at query time.

// Severity tier for any incident emitted by Prometheus / Alertmanager.
enum IncidentSeverity {
  SEV1 // page: email + Teams + Slack + in-app banner
  SEV2 // high: Teams + email + in-app banner
  SEV3 // ticket: in-app Notification + weekly digest only
}

// Append-only event log for incident lifecycle transitions.
enum IncidentEventType {
  FIRED // Alert first transitioned to firing.
  RE_FIRED // Alert resolved, then fired again within the same window.
  ACKNOWLEDGED // Human acknowledged the alert in the admin UI.
  COMMENT // Human added a free-text note.
  AUTO_RESOLVED // Alertmanager fired a "resolved" event.
  MANUAL_RESOLVED // Human resolved in the admin UI.
}

enum IncidentStatus {
  FIRING
  ACKNOWLEDGED
  RESOLVED
}

// Health status of an external integration provider.
// Distinct from DataConnectionStatus (which is per-tenant sync status).
enum ProviderHealthStatus {
  OPERATIONAL // Provider reports all components green.
  DEGRADED // Provider reports degraded performance.
  PARTIAL_OUTAGE // Some components down, some up.
  MAJOR_OUTAGE // All components down or critical functionality broken.
  MAINTENANCE // Scheduled maintenance window.
  UNKNOWN // Provider has no public statuspage, OR poll failed.
  NOT_CONFIGURED // Synthetic probe disabled because required env vars are missing in this environment. The provider itself is not necessarily down; we just can't probe it from here. Rendered as a neutral/gray badge, NOT as an outage.
}

// Detection method that opened the incident.
enum IncidentDetectionMethod {
  STATUSPAGE_POLL // Atlassian Statuspage summary.json poller.
  SYNTHETIC_PROBE // Active probe call from Temporal cron.
  BREAKER_OPEN // Cockatiel circuit breaker transitioned to OPEN.
  ALERT_MANAGER // Prometheus + Alertmanager fired the alert.
  WEBHOOK // Provider's incident webhook (future use).
}

// -----------------------------------------------------------------------------
// ErrorRateIncident — one row per fired app-error burn-rate alert.
// -----------------------------------------------------------------------------
// Tenant scope: GLOBAL. Admins own thresholds; per-org rollups are derived from
// `appErrorsTotal` labels at query time.
// -----------------------------------------------------------------------------
model ErrorRateIncident {
  id String @id @default(cuid())

  // Alert identity
  alertName  String // e.g., "AppErrorBudgetBurn_Critical"
  severity   IncidentSeverity
  service    String // e.g., "api"
  feature    String // e.g., "ai_generation"
  errorClass String? // e.g., "5xx"; nullable for aggregate alerts

  // Lifecycle
  status         IncidentStatus @default(FIRING)
  firedAt        DateTime       @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String? // userId

  // Burn-rate context at fire time (denormalized for forensic reads)
  burnRate1h Float?
  burnRate5m Float?
  errorCount Int

  // Provenance — Alertmanager fingerprint to de-duplicate
  alertmanagerFingerprint String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  acknowledger User?           @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  events       IncidentEvent[]

  @@index([status])
  @@index([severity])
  @@index([service, feature])
  @@index([firedAt(sort: Desc)])
  @@map("error_rate_incident")
}

// -----------------------------------------------------------------------------
// IntegrationIncident — one row per detected provider outage.
// -----------------------------------------------------------------------------
// Tenant scope: GLOBAL. The provider's outage affects everyone equally;
// per-org Notifications are emitted as a side effect, but the canonical
// record is global.
// -----------------------------------------------------------------------------
model IntegrationIncident {
  id String @id @default(cuid())

  // Provider identity
  // `providerKey` is the registry key (e.g., "openai", "stripe", "notion"),
  // NOT a DataConnectionProvider enum value, so platform providers
  // (OpenAI, Anthropic, Resend) that are not in the enum are also covered.
  providerKey  String
  providerName String // e.g., "OpenAI", "Stripe", "Notion"

  // Lifecycle
  status         IncidentStatus       @default(FIRING)
  severity       IncidentSeverity
  health         ProviderHealthStatus
  startedAt      DateTime             @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  // Detection provenance
  detectionMethod IncidentDetectionMethod

  // Statuspage payload (when detectionMethod == STATUSPAGE_POLL)
  statusPageUrl        String?
  statusPageIncidentId String?  @unique // Provider's incident ID
  affectedComponents   String[] // Component names from summary.json

  // Free-text incident summary (Statuspage `name` or synthetic probe message)
  summary String? @db.Text

  // Provenance — for de-duplication
  alertmanagerFingerprint String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  acknowledger User?           @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  events       IncidentEvent[]

  @@index([providerKey, status])
  @@index([severity])
  @@index([startedAt(sort: Desc)])
  @@index([status])
  @@map("integration_incident")
}

// -----------------------------------------------------------------------------
// ComponentIncident — internal Fabric subsystem outages (v3).
// -----------------------------------------------------------------------------
// Tenant scope: GLOBAL. A subsystem outage (Temporal worker stalled, Prisma
// migration drift, RAG indexer queue backed up, agent rail down, etc.) affects
// every tenant; the canonical record is global. Per-org notifications are NOT
// emitted (admin-only, per the v3 admin-incidents pass).
// -----------------------------------------------------------------------------
model ComponentIncident {
  id String @id @default(cuid())

  // Component identity. `componentKey` is a stable string identifier for the
  // affected subsystem (e.g., "temporal-worker", "prisma-drift",
  // "rag-indexer", "agent-rail"). `componentName` is the human-readable label.
  componentKey  String
  componentName String

  // Lifecycle
  status         IncidentStatus   @default(FIRING)
  severity       IncidentSeverity
  firedAt        DateTime         @default(now())
  resolvedAt     DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  // Auto-resolve provenance (matches IntegrationIncident hysteresis fields).
  autoResolved Boolean @default(false)

  // Free-text incident summary.
  summary String? @db.Text

  // Detection provenance — Alertmanager fingerprint to de-duplicate.
  alertmanagerFingerprint String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  acknowledger User?           @relation("ComponentIncidentAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  events       IncidentEvent[]

  @@index([componentKey, status])
  @@index([severity])
  @@index([firedAt(sort: Desc)])
  @@index([status])
  @@map("component_incident")
}

// -----------------------------------------------------------------------------
// IncidentEvent — append-only audit log for any incident lifecycle transition.
// -----------------------------------------------------------------------------
// Each event belongs to EXACTLY ONE of (errorRateIncidentId,
// integrationIncidentId, componentIncidentId). XOR is enforced by
// application logic (no CHECK constraint in Prisma schema).
// -----------------------------------------------------------------------------
model IncidentEvent {
  id String @id @default(cuid())

  // XOR: exactly one of these is non-null.
  errorRateIncidentId   String?
  integrationIncidentId String?
  componentIncidentId   String?

  eventType IncidentEventType

  // Free-text payload for COMMENT events; structured payload for others.
  message String? @db.Text
  payload Json?

  // Actor — null for system events.
  actorUserId String?

  createdAt DateTime @default(now())

  // Relations
  errorRateIncident   ErrorRateIncident?   @relation(fields: [errorRateIncidentId], references: [id], onDelete: Cascade)
  integrationIncident IntegrationIncident? @relation(fields: [integrationIncidentId], references: [id], onDelete: Cascade)
  componentIncident   ComponentIncident?   @relation(fields: [componentIncidentId], references: [id], onDelete: Cascade)
  actor               User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([errorRateIncidentId, createdAt])
  @@index([integrationIncidentId, createdAt])
  @@index([componentIncidentId, createdAt])
  @@map("incident_event")
}

// -----------------------------------------------------------------------------
// IntegrationProviderRegistry — DB-backed mirror of the TS provider registry,
// updated at boot time. Used so the Settings → Integrations UI can render
// health badges from a single bulk query without importing the registry into
// the client bundle.
// -----------------------------------------------------------------------------
model IntegrationProviderRegistry {
  id String @id @default(cuid())

  providerKey String @unique // e.g., "openai", "stripe", "github"
  displayName String // e.g., "OpenAI", "Stripe"

  // Current health rollup (most recent statuspage poll + breaker state).
  currentHealth  ProviderHealthStatus @default(UNKNOWN)
  lastPolledAt   DateTime?
  lastIncidentId String? // FK into IntegrationIncident.id, nullable

  // Statuspage configuration
  statusPageUrl     String? // e.g., "https://status.openai.com"
  statusPageApiUrl  String? // summary.json endpoint
  statusPagePolling Boolean @default(true)

  // Synthetic probe configuration (MVP-5 only)
  syntheticProbeEnabled  Boolean @default(false)
  syntheticProbeInterval String? // e.g., "5m"

  // Cockatiel breaker key
  breakerKey String?

  // Mapping
  affectedFeatures String[] // e.g., ["ai_generation"]

  // Maps to the DataConnectionProvider enum when applicable
  dataConnectionProvider String? // raw enum value as string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentHealth])
  @@map("integration_provider_registry")
}

// -----------------------------------------------------------------------------
// StatusUpdate — the customer-facing announcement about platform status.
// -----------------------------------------------------------------------------
// Deliberately NOT the same row as ComponentIncident / IntegrationIncident /
// ErrorRateIncident. Those are DETECTIONS: machine-written, fingerprinted, and
// their `summary` text carries internal topology (alert names, component keys,
// vendor payloads) that must never reach a customer. This table is what a
// customer READS: human-authored, customer-safe, with a lifecycle a
// non-operator understands.
//
// The link to a detection is deliberately loose and optional. One detection may
// get zero or one announcement, and an announcement may exist with no detection
// at all — planned maintenance, or a vendor problem learned out-of-band.
//
// Tenant scope: GLOBAL, consistent with every incident table. Per-tenant
// relevance is derived at read time from which components and providers the
// tenant actually uses; nothing is stored per tenant, so there is no fan-out
// when an announcement is published and no backfill when one is edited.
// -----------------------------------------------------------------------------
model StatusUpdate {
  id String @id @default(cuid())

  /// Customer-safe headline. Plain language, no internal identifiers.
  title String
  /// Customer-safe body, markdown. Reviewed by a human before publish; must
  /// not carry stack traces, fingerprints, hostnames or component topology.
  body  String @db.Text

  lifecycle StatusUpdateLifecycle @default(INVESTIGATING)
  impact    StatusUpdateImpact

  /// `PlatformComponent` registry keys this announcement covers. Validated
  /// against the registry at write time so a typo cannot silently produce an
  /// announcement that attaches to nothing.
  affectedComponentKeys String[]
  /// `IntegrationProviderRegistry.providerKey` values this covers. Drives
  /// per-tenant relevance: an announcement about a provider the tenant never
  /// connected is not shown to them.
  affectedProviderKeys  String[]

  /// When customers were first affected — not when the row was created, so an
  /// announcement written after the fact still reads truthfully.
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  /// Set for planned maintenance announced ahead of time. A row with
  /// `scheduledFor` in the future and lifecycle SCHEDULED renders as upcoming
  /// rather than as a live problem.
  scheduledFor DateTime?

  /// Optional back-pointers to the internal detection that prompted this, so
  /// an operator can navigate internal → external. Never serialized to a
  /// customer response.
  componentIncidentId   String?
  integrationIncidentId String?

  /// Author. SetNull rather than Cascade so an announcement outlives the
  /// operator who wrote it — the same reasoning as the audit ledger.
  publishedByUserId String?
  publishedBy       User?   @relation("StatusUpdateAuthor", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  revisions StatusUpdateRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycle, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@index([scheduledFor])
  @@map("status_update")
}

// -----------------------------------------------------------------------------
// StatusUpdateRevision — append-only progression of one announcement.
// -----------------------------------------------------------------------------
// "14:02 Investigating → 14:31 Identified → 15:10 Resolved". Without this the
// surface can only show a single frozen state, and a stale "Investigating" from
// three hours ago is the most common failure of a status page.
//
// Append-only by convention (no update/delete path is exposed): editing history
// after customers have read it defeats the purpose of publishing it.
// -----------------------------------------------------------------------------
model StatusUpdateRevision {
  id             String @id @default(cuid())
  statusUpdateId String

  /// Lifecycle this revision moved the announcement INTO. Denormalized so the
  /// timeline reads correctly without replaying the parent's history.
  lifecycle StatusUpdateLifecycle
  /// Customer-safe note for this step. Same content rules as the parent body.
  body      String                @db.Text

  authorUserId String?
  createdAt    DateTime @default(now())

  statusUpdate StatusUpdate @relation(fields: [statusUpdateId], references: [id], onDelete: Cascade)
  author       User?        @relation("StatusUpdateRevisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([statusUpdateId, createdAt])
  @@map("status_update_revision")
}

/// Customer-legible lifecycle for a status announcement. Mirrors the vocabulary
/// customers already know from vendor status pages, rather than the internal
/// FIRING/ACKNOWLEDGED/RESOLVED triple, which describes what an operator did
/// rather than what a customer should expect.
enum StatusUpdateLifecycle {
  INVESTIGATING // We know something is wrong, cause not yet established.
  IDENTIFIED // Cause established, fix in progress.
  MONITORING // Fix applied, watching for recurrence.
  RESOLVED // Over.
  SCHEDULED // Planned maintenance, not started.
  IN_PROGRESS // Planned maintenance, underway.
  COMPLETED // Planned maintenance, finished.
}

/// Customer-facing severity. Separate from the internal SEV1/2/3 ladder, which
/// encodes on-call urgency rather than customer impact — a SEV-1 page for an
/// internal replica restart may be invisible to customers, and a "minor"
/// vendor degradation may be the only thing a customer notices.
enum StatusUpdateImpact {
  NONE // Informational only.
  MINOR // Some users see slower or partial behaviour.
  MAJOR // A capability is substantially unavailable.
  CRITICAL // Broad unavailability.
}

// DataSyncJob - Individual sync job execution
model DataSyncJob {
  id           String @id @default(cuid())
  connectionId String

  // Job details
  status SyncJobStatus @default(PENDING)
  type   SyncJobType   @default(FULL)

  // Progress tracking
  totalItems     Int?
  processedItems Int  @default(0)
  failedItems    Int  @default(0)

  // Timing
  startedAt   DateTime?
  completedAt DateTime?

  // Results
  error String?
  stats Json? // { added: n, updated: n, deleted: n }

  // Temporal workflow tracking
  workflowId String?
  runId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  connection DataConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([status])
  @@index([workflowId])
  @@index([createdAt])
  @@map("data_sync_job")
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncJobType {
  FULL // Complete re-sync
  INCREMENTAL // Only changes since last sync
  SELECTIVE // Specific resources only
}

// BackgroundJob — unified per-run history for user-visible background work
// (the Job Hub panel). One row per tick/flush-with-work for continuous channel
// monitors; one row per execution for one-shot workflows (code indexing,
// context processing). This table — not the volatile Temporal progress queries
// (which reset on continueAsNew and vanish after workflow close) — is the
// source of truth. Writers live in prisma/queries/background-jobs.ts and are
// callable from both API procedures and Temporal activities.
//
// A partial unique index (raw SQL in the migration — same technique as the
// Notification dedupe index) enforces at most one OPEN row per source:
//   background_job_workflow_source_running_uq
//     ON ("workflowId", COALESCE("sourceId", '')) WHERE status = 'RUNNING'
// workflowId alone is NOT unique: monitors reuse a stable workflow id across
// ticks, and per-repo code indexing reuses its id across runs
// (TERMINATE_EXISTING).
model BackgroundJob {
  id     String              @id @default(cuid())
  kind   BackgroundJobKind
  status BackgroundJobStatus @default(RUNNING)

  // Human-readable target: "Teams · #general", "acme/api", "requirements.pdf"
  title String @db.Text

  // Source pointer for inline-indicator matching at connection rows
  sourceType String? // "teamsLinkedChannel" | "slackLinkedChannel" | "repositoryIntegration" | "projectContext"
  sourceId   String?

  // Per-kind aggregate counters, label -> number (kinds have disjoint keys):
  // { threadsAnalyzed: 3, proposalsCreated: 1 } / { filesProcessed: 120, chunksCreated: 900 }
  counts Json @default("{}")

  // Ordered subtasks: [{ key, status: "pending"|"running"|"completed"|"failed"|"skipped", startedAt?, completedAt?, error? }]
  // "skipped" is written when a job closes with the step still open — it was
  // conditional and never ran, or was interrupted mid-flight.
  steps Json @default("[]")

  error      String? @db.Text
  errorClass String?

  // Temporal correlation
  workflowId String
  runId      String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Bumped by every writer; the background-job-watchdog schedule fails rows
  // whose heartbeat goes stale (worker died mid-run)
  heartbeatAt DateTime  @default(now())

  // Tenant isolation
  projectId      String
  userId         String
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workflowId])
  @@index([status, heartbeatAt])
  @@index([projectId])
  @@map("background_job")
}

enum BackgroundJobKind {
  TEAMS_CHANNEL_MONITOR
  TEAMS_CHAT_MONITOR
  SLACK_CHANNEL_MONITOR
  SLACK_BACKFILL
  CODE_INDEXING
  CONTEXT_PROCESSING
  // One work item's body being redrafted through its new type's template after a
  // BUG <-> FEATURE conversion (Fizzy #2048). The rewrite is a model call on the
  // order of a minute and runs with nobody watching, so its state is persisted
  // here rather than inferred: the row is what the detail view polls, and it is
  // also what tells the user the rewrite was refused and their prior body kept.
  STORY_KIND_REGENERATION
  // One publishing topic-generation cycle, from dispatch to its terminal state
  // (Fizzy #1850). The run is long, unattended, and — when it decides there is
  // nothing worth saying — produces no other visible trace, which is exactly the
  // case that reads as a fault. The row is scoped to GENERATION: notification and
  // chat delivery happen after the cycle terminalizes and are reported by the
  // refresh history's Notified column instead.
  PUBLISHING_TOPIC_GENERATION
}

enum BackgroundJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

// SyncedResource - Maps external resources to workspace documents
model SyncedResource {
  id           String @id @default(cuid())
  connectionId String

  // External resource identification
  externalId   String // ID in the external system
  externalPath String? // Path/URL in external system
  resourceType String // file, page, issue, channel, etc.

  // Content tracking
