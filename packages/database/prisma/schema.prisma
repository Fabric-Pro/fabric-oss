/// What a human did with one piece of AI-generated output (Fizzy #2230).
/// Complements DecisionLogEntry.answerSource, which already records this for
/// maturation answers; this covers every other AI surface — including the ones
/// with no natural accept action, where an explicit rating is the only signal
/// available.
enum AiOutcomeKind {
  /// Used as generated, unmodified.
  ACCEPTED_AS_IS
  /// Used, but the human changed it first.
  ACCEPTED_WITH_EDITS
  /// Explicitly rejected, dismissed, or discarded.
  REJECTED
  /// Explicit positive rating, where no accept/reject action exists.
  RATED_UP
  /// Explicit negative rating.
  RATED_DOWN

  @@map("ai_outcome_kind")
}

/// One human verdict on one piece of AI output. Written from the mutation that
/// handles the human's action (accept / reject / rate), NOT from the model
/// call: the verdict lands minutes later in a different request, so it cannot
/// live on the AiUsageLog row.
///
/// `modelCanonicalName` and `promptVersionId` are SNAPSHOTS taken at write
/// time, deliberately denormalized. The point of this table is comparing
/// acceptance across model and prompt changes, and a join that resolved "which
/// prompt is bound now" would answer for today rather than for the moment the
/// output was produced.
model AiOutcomeEvent {
  id String @id @default(cuid())

  /// Which AI feature produced the output being judged. Matches the
  /// AI_FEATURE_KEYS registry in packages/ai; a plain string so dashboards
  /// tolerate keys written by a different app version.
  featureKey String
  outcome    AiOutcomeKind

  /// What the verdict is about: the kind of thing ("chat-message",
  /// "spec-patch", "backlog-proposal") and its id. A bare string pair rather
  /// than a relation because the subject lives in a different table per
  /// feature — and for chat, inside a JSON messages blob with no row of its
  /// own.
  subjectType String
  subjectId   String

  /// Snapshot of what produced the output (see note above).
  modelCanonicalName String?
  promptVersionId    String?

  /// Optional free text the human supplied (a thumbs-down reason).
  comment String? @db.Text

  userId         String?
  organizationId String?
  projectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One verdict per person per thing — re-rating updates in place, so a user
  /// toggling up then down leaves one row rather than two contradictory ones.
  @@unique([featureKey, subjectType, subjectId, userId])
  /// Adoption dashboards: per-feature acceptance over a time range.
  @@index([featureKey, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  /// Model / prompt segmentation.
  @@index([modelCanonicalName, createdAt])
  @@map("ai_outcome_event")
}

