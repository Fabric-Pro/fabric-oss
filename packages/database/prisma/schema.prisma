  // File storage (S3) for binary/large artifacts
  s3Path   String?
  s3Bucket String?
  fileSize Int?

  // Structured metadata (type-specific data — report sections, chart config, etc.)
  metadata Json?

  // Versioning
  version  Int     @default(1)
  parentId String? // Previous version of this artifact

  // Knowledge indexing (when added to project knowledge)
