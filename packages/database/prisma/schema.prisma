model Workflow {
  id             String                @id @default(cuid())
  name           String
  description    String?
  heroEmojis     String[]              @default([])
  heroImageUrl   String? // AI-generated hero image URL
  status         WorkflowBuilderStatus @default(DRAFT)
  triggerType    WorkflowTriggerType   @default(MANUAL)
  triggerConfig  Json? // Trigger-specific configuration
  nodes          Json // React Flow nodes array
  edges          Json // React Flow edges array
  variables      Json? // Workflow-level variables
  settings       Json? // Additional workflow settings
  version        Int                   @default(1)
  isTemplate     Boolean               @default(false)
  templateId     String? // If created from a template
  userId         String
  organizationId String?
  projectId      String? // Optional link to a project
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lastRunAt      DateTime?

  // Publishing fields
  publishedAt      DateTime? // When the workflow was last published
  publishedBy      String? // User ID who published
  publishedVersion Int? // Version number that is currently published
  webhookSecret    String? // Secret for validating webhook triggers

  // Relations
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template         Workflow?             @relation("WorkflowTemplates", fields: [templateId], references: [id], onDelete: SetNull)
  derivedWorkflows Workflow[]            @relation("WorkflowTemplates")
  versions         WorkflowVersion[]
  executions       WorkflowExecution[]
  integrations     WorkflowIntegration[]
  apiKeys          WorkflowApiKey[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([triggerType])
  @@index([isTemplate])
  @@map("workflow")
}

model WorkflowVersion {
  id            String    @id @default(cuid())
  workflowId    String
  version       Int
  nodes         Json
  edges         Json
  variables     Json?
  settings      Json?
  triggerConfig Json? // Trigger configuration at time of publish
  changelog     String?
  isPublished   Boolean   @default(false) // Whether this version was published
  publishedAt   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  // Tenant isolation (copied from parent Workflow)
  userId         String?
  organizationId String?

  // Relations
  workflow     Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([version])
  @@index([isPublished])
  @@index([userId])
  @@index([organizationId])
  @@map("workflow_version")
}

model WorkflowExecution {
