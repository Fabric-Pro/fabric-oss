  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ============================================================================
// User Stories & Tasks (Kanban Board)
// ============================================================================

enum StoryPriority {
  P0_CRITICAL
  P1_HIGH
  P2_MEDIUM
  P3_LOW
}

// Who moved a work item's priority band. AI = a Roadmap "Re-prioritize" run;
// MANUAL = a person setting the band by hand (optionally with a comment).
enum PriorityChangeSource {
  AI
  MANUAL
}

enum StorySize {
  XS
  S
  M
  L
  XL
}

// Discriminates roadmap items by work-item type. Drives the "Type" filter on
// the project roadmap. Fabric supports exactly two work-item types — Feature
// and Bug. The frontend has long referred to UserStory rows as "Features" so
// existing rows default to FEATURE; flows that produce bugs (e.g. backlog
// proposals tagged "bug") set BUG explicitly. The legacy USER_STORY value was
// retired (migrated to FEATURE) — "User Story" is no longer a Fabric type.
enum StoryKind {
  FEATURE
  BUG
}

enum FeatureDraftingStage {
  PLACEHOLDER
  PASSIVE_ANALYSIS
  ACTIVE_ANALYSIS
  SANITY_CHECK
  DRAFT
  PUBLISHED
  DECLINED
  CLOSED
}

// Maturation V2 status label. A deliberately "dummy" three-bucket label that
// replaces the per-stage maturation pipeline in the V2 feature editor — it
// carries no logic (no enhance trigger, no PM push, no FeatureVersion snapshot).
// Eventually it will guide the swim lanes on the kanban roadmap. Nullable: a
// null value falls back to a label derived from draftingStage on the client.
enum MaturationStatus {
  TO_DO
  DISCOVERY
  DONE
}

// Where a UserStory was first reported from. Drives the reporter metadata
// surface on bug cards (REQ-8). Manual UI submissions set MANUAL; agents
// that have richer context (Slack thread, Teams message) set the matching
// value and pass reporterSourceUrl.
enum ReporterSource {
  SLACK
  TEAMS
  MANUAL
}

enum StorySource {
  MANUAL
  JIRA
  AZURE_DEVOPS
  FIZZY
  GITLAB
  LINEAR
  GITHUB
  AI_UPDATE
  APPROVED_PROPOSAL
  CUSTOM_AGENT
  SLACK
  SECURITY_SCAN
  // A bug opened automatically from a red automated-test result
  // ingested from a CI/pipeline run (RCA→BUG). Gated per-project by
  // Project.autoCreateBugsFromFailures.
  PIPELINE_FAILURE
}

enum StoryTitleSource {
  AI
  DESCRIPTION_FALLBACK
  UNTITLED_FALLBACK
}

// Provenance of the last genuine UserStory edit. Distinct from `StorySource`
// (creation origin) and `StoryTitleSource` (how the title was generated).
enum LastEditSource {
  MANUAL
  AI_BACKLOG_UPDATE
  AI_MATURATION
  CONFLICT_RESOLUTION
  PM_PULL
}

enum PmSyncStatus {
  PENDING
  SUCCESS
  CONFLICT
  FAILED

  @@map("pm_sync_status")
}

enum PendingPmStateChangeAction {
  HIDE
  UNHIDE
  FLAG_MISSING
  CONTENT_DRIFT

  @@map("pending_pm_state_change_action")
}

enum PendingPmStateChangeStatus {
  PENDING
  APPROVED
  DISMISSED

  @@map("pending_pm_state_change_status")
}

enum PmStateChangeEntityType {
  EPIC
  FEATURE
  STORY
  TEST_CASE

  @@map("pm_state_change_entity_type")
}

// PmSyncLogStatus — outcome of one PM-sync attempt (three terminal values).
// Deliberately DISTINCT from the per-item lifecycle enum `PmSyncStatus`
// { PENDING, SUCCESS, CONFLICT, FAILED }: the log records the outcome of a
// single attempt (no PENDING, no SKIP), so it carries FAILURE — not FAILED.
// The FAILURE/FAILED naming difference is intentional; a
// separate enum keeps the audit log decoupled from story-lifecycle changes.
enum PmSyncLogStatus {
  SUCCESS
  FAILURE
  CONFLICT

  @@map("pm_sync_log_status")
}

enum TestCaseState {
  /// Authored by a sceptic role and awaiting a human's Accept or Reject.
  ///
  /// Distinct from DRAFT, which is a case someone has committed to and is still
  /// polishing. A PROPOSED case is one nobody has agreed to yet, so it must NOT
  /// count as coverage — otherwise a project's "tested by N cases" rises the
  /// moment an AI suggests something, which is the opposite of what coverage is
  /// supposed to tell you.
  PROPOSED
  DRAFT
  READY
  CLOSED

  @@map("test_case_state")
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("test_case_priority")
}

/// Which level of the test pyramid a case sits at.
///
/// The traceability matrix reports coverage per criterion, and "three cases"
/// means something very different when all three are manual clickthroughs than
/// when one is a unit test, one an integration test and one an E2E run. Without
/// this the matrix can count coverage but not characterise it — which is the
/// question a team actually asks of a coverage report.
///
/// Nullable on purpose. Every case that predates this has no honest answer, and
/// defaulting them all to one level would be inventing data — a matrix column
/// full of confidently wrong values is worse than one that admits it does not
/// know.
enum QaCoverageType {
  UNIT
  INTEGRATION
  E2E
  /// Run by a person, not a runner. Distinct from "unknown": someone said so.
  MANUAL

  @@map("qa_coverage_type")
}

/// What an outstanding step proposal was checked against.
///
/// The two revision paths answer different questions. SPEC asks "does this case
/// still match what we said we would build"; IMPLEMENTATION asks "does it match
/// what we actually built". Recording which one produced a proposal is what lets
/// the accept path decide whether clearing the spec-drift flag would be a lie.
enum TestCaseProposalSource {
  /// Revised against the feature's acceptance criteria as they stand now.
  SPEC
  /// Revised against the diff of the pull request that implemented the feature.
  IMPLEMENTATION

  @@map("test_case_proposal_source")
}

enum AutomationStatus {
  NOT_AUTOMATED
  PLANNED
  AUTOMATED

  @@map("automation_status")
}

enum TestPlanState {
  ACTIVE
  INACTIVE

  @@map("test_plan_state")
}

enum TestResult {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  // A test the suite deliberately did not run (`skipped`, `pending` in some
  // runners, `[Ignore]`). Distinct from NOT_RUN, which means "queued / never
  // reached", and from BLOCKED, which means "attempted and could not proceed".
  // Before this existed, genuine skips fell into BLOCKED and read as "needs
  // attention", while the run's skippedCount actually counted NOT_RUN.
  SKIPPED

  @@map("test_result")
}

enum ResultSource {
  MANUAL
  PM_SYNC
  // A result ingested from an automated CI / test-pipeline run
  // (GitHub Actions, GitLab CI, ADO Test Runs, Jira-Xray). The provider identity
  // is carried in TestResultEvent.actorLabel + the linked TestPipelineRun.
  PIPELINE

  @@map("result_source")
}

enum PublishingCycleStatus {
  GENERATING
  READY
  NO_TOPICS
  INSUFFICIENT_CONTEXT
  FAILED

  @@map("publishing_cycle_status")
}

/// Snooze is deliberately NOT a value here. It is an overlay
/// (PublishingTopic.snoozedUntil/snoozeReason), because a status cannot carry a
/// snooze without destroying the status the topic already had — which is the
/// state FR8 routes by. This enum carried a DEFERRED value until 1D-1b
/// (Fizzy #2265) and that was the mistake; adding a SNOOZED here would repeat
/// it. Unrelated, despite the shared name: publishing_notification_delivery.status
/// is a String column whose own DEFERRED value is a live deferral state, and so
/// is QaOpenQuestionStatus.DEFERRED.
enum PublishingTopicStatus {
  SUGGESTION
  SELECTED
  IN_PROGRESS
  PUBLISHED
  DECLINED

  @@map("publishing_topic_status")
}

enum PublishingTopicOrigin {
  AI
  MANUAL

  @@map("publishing_topic_origin")
}

enum PublishingTopicPostType {
  TWEET
  BLOG_POST
  CASE_STUDY
  STAKEHOLDER_EMAIL
}

// Custom Kanban columns per project
model ProjectStoryStatus {
  id               String   @id @default(cuid())
  projectId        String
  name             String // "Backlog", "In Progress", etc.
  color            String // Hex color for column
  order            Int // Display order
  isDefault        Boolean  @default(false) // Default for new stories
  isFinal          Boolean  @default(false) // Marks completion
  requiresApproval Boolean  @default(false) // Agent pauses for approval before moving here
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories UserStory[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_story_status")
}

model UserStory {
  id                        String               @id @default(cuid())
  projectId                 String
  statusId                  String
  identifier                String // "US-001" (auto-generated per project)
  title                     String
  description               String?              @db.Text // TipTap JSON or plain text
  acceptanceCriteria        String?              @db.Text
  kind                      StoryKind            @default(FEATURE)
  priority                  StoryPriority        @default(P2_MEDIUM)
  size                      StorySize?
  storyPoints               Int?
  order                     Float                @default(0) // Fractional ordering for Kanban (per-column)
  roadmapOrder              Float                @default(0) // Fractional ordering for Roadmap (per-priority-bucket)
  // Shared, project-wide manual rank for the Roadmap "Priority" layout. NULL =
  // never hand-placed, so the item sits in its computed rank; non-null = pinned,
  // and pinned items sort ahead of every unpinned one. Distinct from
  // roadmapOrder (within a priority bucket) and from
  // ProjectUserPreference.roadmapStoryOrder (per-user, not shared).
  priorityOrder             Float?
  // Denormalised "last priority change" stamp, mirroring the newest
  // StoryPriorityChange row for this story. The Roadmap Priority list renders
  // a "set <when>" on every row, so reading it from the story avoids a join
  // (and an N+1) on a list that routinely runs to hundreds of items. NULL =
  // the band has never been changed since the story was created.
  priorityChangedAt         DateTime?
  // Denormalised rationale of that same newest change — the AI's reason on a
  // re-prioritization, or the person's optional comment on a manual set. Shown
  // inline on the (collapsed) Priority row for at-a-glance "why", alongside the
  // full trail behind the row. NULL = the last change carried no comment (e.g.
  // a drag), or the band has never changed. Full per-change history still lives
  // in StoryPriorityChange.
  priorityChangeReason      String?              @db.Text
  labels                    String[]
  createdById               String // User who created
  assigneeId                String? // Optional assignee
  externalId                String? // PM tool ID (Fizzy/Linear)
  externalUrl               String?
  externalMcpServerId       String? // MCP server that last synced this story
  // Per-feature opt-in for auto-pushing edits to the linked PM tool. False
  // by default so new Fabric-originated features stay local until the PM
  // explicitly enables sync (junior-PM review workflow). Imported / linked-
  // at-create paths set this to true at creation; the migration backfills
  // true for every pre-existing row that already has `externalId IS NOT NULL`
  // so no observable behavior changes on day one.
  pmAutoSyncEnabled         Boolean              @default(false)
  // The statusId at the time of the most recent successful PM-tool push.
  // Used by sync to compute the label delta to send (so the previous
  // status's label is removed instead of accumulating).
  lastSyncedStatusId        String?
  pipelineExecutionId       String? // Traceability to pipeline
  source                    StorySource          @default(MANUAL) // Origin of the story (immutable after create)
  // Failure-to-bug: the test case whose red pipeline result opened this bug.
  // Set only when source=PIPELINE_FAILURE; also the dedup key (one OPEN bug per
  // case). Plain scalar — no back-relation on TestCase, and never a hard FK, so a
  // deleted case leaves the historical bug intact.
  originTestCaseId          String?
  // Stable dedup key for machine-filed bugs (e.g. a hash of a normalized error
  // signature supplied by an autonomous monitoring agent through the MCP
  // gateway's `fabric_create_bug` tool). Deliberately NOT `externalId`:
  // externalId means "this row is linked to a PM-tool issue" and several flows
  // key off it being non-null alone — the roadmap auto-push gate
  // (`move-story.ts`), the PM-sync enqueue short-circuit (`enqueue-pm-sync.ts`),
  // the conflict preview filter, and the PmSyncChip external link — so reusing
  // it would make every machine-filed bug masquerade as PM-linked.
  //
  // A PARTIAL unique index on (projectId, bugFingerprint) WHERE bugFingerprint
  // IS NOT NULL AND draftingStage NOT IN ('DECLINED','CLOSED') is enforced via
  // the hand-written migration `*_user_story_bug_fingerprint_unique` (Prisma's
  // `@@unique` can only emit a plain, non-partial index). Scoping the predicate
  // to NON-TERMINAL rows mirrors BacklogDedupGuard: a closed bug is a resolved
  // record and must not block re-filing when the same error recurs. Consequence
  // to be aware of: reopening a closed fingerprinted bug while another
  // non-terminal row holds the same fingerprint raises a unique violation.
  bugFingerprint            String?
  // Meeting provenance (#1814): the digest meeting this story was created
  // from (via an approved MONITORED_MEETING proposal). Orthogonal to `source`
  // (which stays APPROVED_PROPOSAL). SetNull so deleting a transcript never
  // deletes stories.
  sourceMeetingTranscriptId String?
  // The PendingBacklogProposal this item was created from, so the roadmap can
  // link back to the proposal that produced it — `source` alone only says "a
  // proposal made me", not which one. Nullable: most items have no proposal,
  // and it is only recorded from this change onward (historical rows cannot be
  // backfilled — the link was never stored). Deliberately NOT a relation/FK:
  // proposals are prunable, and a hard FK would either block their deletion or
  // cascade into work items.
  createdFromProposalId     String?
  // Telemetry for AI-generated titles. `aiGeneratedTitle` defaults to false so
  // existing rows are unaffected (forward-looking only — no backfill per
  // Decision 9). `titleSource` is null for legacy rows; populated on insert
  // by createStoryProcedure / regenerateStoryTitleProcedure / fabric_create_story.
  aiGeneratedTitle          Boolean              @default(false)
  titleSource               StoryTitleSource?
  releaseNotes              String?              @db.Text // Plain language summary for release notes
  draftingStage             FeatureDraftingStage @default(PLACEHOLDER)
  draftingStageUpdatedAt    DateTime?
  // Maturation V2 "dummy" status label (To Do / Discovery / Done). Decoupled
  // from draftingStage on purpose so the stage machinery can never corrupt it.
  // Null for non-V2 / legacy rows; the client derives a label from draftingStage
  // when null. Backfilled from draftingStage in the introducing migration.
  maturationStatus          MaturationStatus?

  // --- Shipping below the project's coverage target -------------------------
  //
  // The target used to be a number nothing read: a project could set 80% and
  // close every feature at 10% without anything noticing. It now blocks the
  // move to Done — but blocking alone would strand low-risk work for a reason
  // far less clear-cut than a missing sign-off, so it is overridable and the
  // override is recorded here rather than swallowed.
  //
  // That record is the point. A team that ships under target repeatedly can see
  // that it did, and why, which neither a silent number nor a hard wall gives
  // them. Null on every feature that met the target — the columns only fill
  // when somebody consciously went under it.
  coverageOverrideReason String?
  coverageOverrideById   String?
  coverageOverrideAt     DateTime?

  // PM terminal-status snapshot (card #1360 Phase A) — set by the ADO poll.
  // pmTicketTerminal drives the roadmap checkmark; status is the raw PM state.
  pmTicketTerminal             Boolean                 @default(false)
  pmTicketTerminalStatus       String?
  // UNHIDE provenance (#1360): true iff the story is currently CLOSED because
  // the terminal-status poll auto-hid it, with no other stage write since.
  // Set only by the auto-hide path; cleared by every other draftingStage writer.
  pmAutoHidden                 Boolean                 @default(false)
  version                      Int                     @default(1)
  // F-171 bug triage: AI-determined flag indicating the reporter's input is
  // too ambiguous for engineering to act on. Set at bug-creation time by the
  // bug_creation prompt; cleared only by the bug_reanalysis prompt via the
  // "Re-evaluate Bug" action. No manual PM override. Always false for features.
  needsMoreInfo                Boolean                 @default(false)
  // Blocked flag (like needsMoreInfo): a manual or scan-finding-driven marker
  // that this work item is blocked, with an optional reason shown on hover.
  // Changes are recorded in the feature version history.
  blocked                      Boolean                 @default(false)
  blockedReason                String?                 @db.Text
  // F-171 reporter tracking. Populated at creation time from the ingestion
  // context. MANUAL when created from the roadmap UI; SLACK/TEAMS when the
  // fabric_create_story tool was invoked by a custom agent and passed the
  // upstream source. UI displays these on bug detail pages; ignored for
  // features.
  reporterName                 String?
  reporterSource               ReporterSource?
  reporterSourceUrl            String?
  // PM sync state (F-1166): hash + status of last attempted push to PM tool.
  // Null baseline means legacy story — first push stamps without conflict check.
  lastSyncedPmHash             String?
  lastSyncedAt                 DateTime?
  lastPmSyncStatus             PmSyncStatus?
  lastPmSyncError              String?                 @db.VarChar(500)
  lastPmSyncAttemptAt          DateTime?
  // Set when this story was discarded by a duplicate-merge: the id of the
  // survivor it was merged into. Drives the roadmap "Declined duplicate" chip
  // + "Merged into {identifier}" tooltip. Null for every other story. No FK
  // relation (the survivor identifier is resolved by id at read time);
  // nullable + no default so all existing rows are untouched.
  mergedIntoStoryId            String?
  // Semantic last-edit event (denormalized snapshots; NOT FKs). These three
  // fields move together only when canonical ticket data actually changes.
  // `updatedAt` below remains Prisma's operational row-write clock, so derived
  // summary/hash/analysis writes must never be presented as ticket edits.
  // Nullable with no backfill because historical `updatedAt` values are not
  // reliable edit times. `lastEditedByName` stays null for autonomous PM/AI
  // changes while `lastEditedSource` records their provenance.
  lastEditedAt                 DateTime?
  lastEditedByName             String?
  lastEditedSource             LastEditSource?
  // Feature Maturation V2. Additive + nullable / no-touch
  // default → existing rows untouched, clean flag-off rollback. The Clean
  // Spec is still description + acceptanceCriteria — no cleanSpecContent field.
  summaryDigest                String?                 @db.Text // Tab 1 human-readable digest
  workingNotesContent          String?                 @db.Text // Tab 1 working notes / open-questions body
  // Hash of the Clean Spec at the last question extraction. The on-open / post-run
  // extraction re-scans only when this differs from the current spec hash, so it is
  // self-healing across every spec-write path (placeholder, agent Enhance, fallback)
  // yet no-ops on an unchanged spec.
  lastQuestionScanHash         String?
  // Hash of (Clean Spec + bound Summary prompt) at the last Logic Summary
  // generation. The summary regenerates only when this differs — so it refreshes
  // when the spec changes OR when the org edits the Summary prompt, and no-ops
  // otherwise (demo feedback #4a).
  lastSummaryHash              String?
  // When the Clean Spec was last (re)built by an AI/context path — a stage Enhance,
  // an "Update using context" run, or a "Refresh Clean Spec" run. Deliberately NOT
  // stamped on manual edits, so the editor can colour the refresh control by genuine
  // staleness (demo feedback #2/#3). Null = never refreshed via context.
  lastContextUpdateAt          DateTime?
  maturationV2OptedIn          Boolean                 @default(false) // set on first V2 open; drives "stay v1 until re-opened"
  // Auto-propose AI answers for newly minted open questions (demo feedback #7). ON by
  // default; disabling is per-feature only (other features stay ON). Gates the
  // structured recommendation pass in extractMaturationQuestions.
  autoProposeAnswers           Boolean                 @default(true)
  // QA tab: AI-generated QA analysis — per-criterion under-specification
  // warnings, integration-test implications, and E2E scenario outlines. JSON payload
  // (`QaAnalysisContent` in queries/feature-maturation.ts) carrying the spec hash and
  // depth it was generated at, so the tab can flag staleness. Test cases themselves are
  // NOT stored here — they are real TestCase rows linked via TestCaseWorkItemLink.
  // Additive + nullable → existing rows untouched. PM-sync isolated.
  qaAnalysis                   Json?
  cleanSpecApprovalMode        MaturationApprovalMode? // per-feature override (null → per-user default)
  decisionLogApprovalMode      MaturationApprovalMode?
  summaryQuestionsApprovalMode MaturationApprovalMode?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  project                 Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                  ProjectStoryStatus        @relation(fields: [statusId], references: [id])
  sourceMeetingTranscript ProjectMeetingTranscript? @relation("StorySourceMeeting", fields: [sourceMeetingTranscriptId], references: [id], onDelete: SetNull)
  tasks                   StoryTask[]
  versions                FeatureVersion[]
  qaAnalysisVersions      QaAnalysisVersion[]
  codingRuns              CodingRun[]
  kanbanQueue             KanbanQueue[]
  comments                UserStoryComment[]
  tags                    StoryTag[]
  attachments             StoryAttachment[]
  attachmentSyncIssues    StoryAttachmentSyncIssue[]

  // Feature Maturation V2 — threaded Decision Log changelog
  decisionLogEntries DecisionLogEntry[]

  // Roadmap Priority — the append-only band-change trail behind each row.
  priorityChanges StoryPriorityChange[]

  // Weave relations
  weavePlans WeavePlan[]

  // Duplicate-detection links — pairwise; a story can appear on either side.
  duplicateLinksA StoryDuplicateLink[] @relation("DupLinkA")
  duplicateLinksB StoryDuplicateLink[] @relation("DupLinkB")

  // Meeting action items that reference this work item (#1902). Cascade, so a
  // deleted work item leaves no dangling link and the digest needs no
  // "ticket no longer exists" state.
  meetingActionItemLinks MeetingActionItemLink[]

  // Cached detection embedding for the incremental duplicate scan. One-to-one;
  // invalidated by a content-hash or embedding-model change and removed on
  // story delete (onDelete: Cascade on the child side).
  duplicateEmbedding StoryDuplicateEmbedding?
  routingEmbedding   StoryRoutingEmbedding?

  // Test case coverage links (case <-> work-item)
  testCaseLinks   TestCaseWorkItemLink[]
  qaOpenQuestions QaOpenQuestion[]
  qaSignOffs      QaSignOff[]

  // Security & accessibility scans scoped to this feature (and their findings).
  scans                        ProjectScan[]
  scanFindings                 ScanFinding[]
  promotedFromFindings         TestFinding[]              @relation("TestFindingPromotedStory")
  prReviewFindings             PullRequestReviewFinding[] @relation("PrReviewFindingStory")
  promotedFromPrReviewFindings PullRequestReviewFinding[] @relation("PrReviewFindingPromotedStory")

  // A PARTIAL unique index on (projectId, externalId) WHERE externalId IS NOT
  // NULL is enforced via the hand-written migration
  // `*_user_story_external_id_unique`. It guarantees one Fabric story per
  // remote PM issue (prevents duplicate pull/import) while still allowing many
  // local stories with externalId = NULL. Prisma's `@@unique` can only emit a
  // plain (non-partial) index, which would clash with the filtered one — so it
  // is intentionally NOT declared here.
  //
  // Defense-in-depth: makes duplicate identifiers within a project physically
  // impossible. The atomic per-project counter (Project.nextStoryNumber) is the
  // primary guarantee; this constraint guards against bugs in the allocator or
  // out-of-band data writes.
  @@unique([projectId, identifier])
  @@index([projectId])
  @@index([statusId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([pipelineExecutionId])
  @@index([projectId, source])
  @@index([projectId, lastPmSyncStatus])
  // Serves the per-band MAX(roadmapOrder) rebase in recordPriorityMove and the
  // roadmap's per-lane reads — without it each of a re-prioritization run's
  // rebases scans every story in the project.
  @@index([projectId, priority])
  @@index([sourceMeetingTranscriptId])
  // RCA→BUG dedup: "is there already a bug for this test case?"
  @@index([originTestCaseId])
  @@map("user_story")
}

/// Append-only trail of priority-band changes for one work item, powering the
/// Roadmap "Priority" view's per-row history.
///
/// One row per *actual* band change. A "Re-prioritize" run that leaves an
/// item's band where it was writes nothing — the history is a record of
/// movement, not of every time the ranker looked at the item. `fromPriority`
/// is NULL only for the first recorded change of a story whose band predates
/// this table.
///
/// `reason` carries the AI's rationale for an AI row, or the author's optional
/// comment for a MANUAL one; both are free text and may be absent. The actor
/// is nullable + SetNull so deleting a user preserves the trail (the UI falls
/// back to the snapshotted `actorName`).
model StoryPriorityChange {
  id           String               @id @default(cuid())
  storyId      String
  projectId    String
  fromPriority StoryPriority?
  toPriority   StoryPriority
  source       PriorityChangeSource
  reason       String?              @db.Text
  actorId      String?
  /// Actor display name snapshotted at write time, so a deleted user still
  /// reads as a person rather than "Unknown".
  actorName    String?
  createdAt    DateTime             @default(now())

  story   UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The per-row history query: one story, newest first, cursor-paginated.
  @@index([storyId, createdAt(sort: Desc)])
  // Project-wide sweeps (a future "all priority changes" view, and the
  // cascade-free cleanup path).
  @@index([projectId, createdAt(sort: Desc)])
  @@map("story_priority_change")
}

/// Fabric-internal, free-form custom tags on a work item. Independent of
/// UserStory.labels (which drives GitLab label-status-mapping sync). NEVER
/// synced to any PM tool. Per-tag creator is tracked so the creator (or a
/// project admin) can remove it; createdById is nullable + onDelete: SetNull
/// so deleting the creating user preserves the tag (admin-only removal then).
model StoryTag {
  id          String   @id @default(cuid())
  storyId     String
  value       String // normalized: trimmed + lowercased at write time
  createdById String?
  createdAt   DateTime @default(now())

  story     UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([storyId, value])
  @@index([storyId])
  @@index([createdById])
  @@map("story_tag")
}

enum StoryAttachmentDesignation {
  LOCKED
  UNLOCKED
}

enum StoryAttachmentSource {
  FABRIC
  PM_SYNCED // marks a row ingested from a PM tool, written by the sync engine (Fizzy #1746); nothing writes it yet on this branch
}

/// First-class file attachment on a work item (#1702 Part 1). Stored
/// SEPARATELY from UserStory.description so the AI Assistant cannot rewrite it.
/// Mirrors StoryTag: project-scoped child, procedural tenant gates, NO RLS.
///
/// INVARIANTS (the blanket "never reaches an agent path" rule no longer holds —
/// UNLOCKED attachments now feed ticket-level AI context on purpose):
///   1. A LOCKED attachment's content NEVER reaches a prompt. LOCKED is the
///      default, so silence still means isolation.
///   2. `extractedText` is read by ONE caller: the AI-context resolver at
///      `packages/api/modules/projects/lib/story-attachment-ai-context.ts`.
///      Every other read path MUST omit it from its `select` — it is document
///      text, not metadata, and `list-attachments` serves the browser.
///   3. Bytes DO travel to a linked PM tool when the project opts in via
///      `Project.syncAttachments` (Fizzy #1746). That does not weaken 1 or 2:
///      files arriving from a PM tool are written LOCKED, so their content
///      still never reaches a prompt.
model StoryAttachment {
  id             String                     @id @default(cuid())
  storyId        String
  filename       String // original name (sanitized at write); used for Content-Disposition
  mimeType       String // client-declared (pinned at PUT); allowlist-checked, NOT byte-sniffed
  sizeBytes      Int // authoritative R2 ContentLength; config caps MAX at <= 2 GB
  storageKey     String                     @unique // story-attachments/{projectId}/{storyId}/{uuid}.{ext}
  designation    StoryAttachmentDesignation @default(LOCKED)
  source         StoryAttachmentSource      @default(FABRIC)
  uploaderUserId String?
  /// PM server key of the tool this file came from ("azure-devops" | "jira" |
  /// "fizzy"); NULL for Fabric-origin files. Drives the "From ADO" source label.
  sourceTool           String?
  /// Opaque tool-native handle: ADO relation URL, Jira attachment id, Fizzy blob
  /// sgid. Set on inbound ingest AND on outbound push — identifies which
  /// PM-side files are ours to delete, and lets the sync engine recognize a
  /// pushed file coming back rather than re-importing it as a new row. The
  /// database does not enforce uniqueness through this field declaration
  /// alone; see the partial index noted above the index block below. Fizzy
  /// #1746.
  externalAttachmentId String?
  /// SHA-256 of the stored bytes. Distinguishes "the same file came back" from
  /// "a different file with the same name" — the basis of conflict detection.
  contentHash          String?
  /// NULL on an un-promoted inbound row: read-only in the UI, no lock or delete
  /// controls. Always treat `source = FABRIC` as implicitly promoted.
  promotedAt           DateTime?
  /// PM-side author display name; NULL where the tool does not expose one (ADO
  /// relations, Fizzy body-embedded blobs) — rendered as "Unknown".
  externalAuthor       String?
  /// PM-side creation timestamp; NULL where unavailable.
  externalCreatedAt    DateTime?
  /// Consecutive reconcile passes in which this file was absent from the PM
  /// tool's listing. Soft-delete only at 2, so one flaky listing cannot wipe a
  /// story's attachments. Mirrors the missing-streak debounce in pm-state-poll.
  missingStreak        Int       @default(0)
  /// Cached text extracted from the file, populated lazily on the first AI run
  /// that needs it (never at upload). Character-budgeted BY THE RESOLVER — the
  /// text/pdf/docx extractors ignore the budget option — and carrying a
  /// truncation marker when the budget cut it. NULL = not yet extracted OR not
  /// extractable. See invariant 2 above before adding this to a `select`.
  extractedText  String?                    @db.Text
  /// When extractedText was populated; NULL while unextracted. Deliberately
  /// write-only today — nothing reads it. It is kept because it is the only
  /// way to answer "when was this cached" while debugging a stale-looking AI
  /// answer, and because re-extraction (if the extractor ever changes) needs a
  /// watermark that cannot be backfilled after the fact. Not an oversight.
  extractedAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  deletedAt      DateTime? // null = live; set = soft-deleted (hidden), pending retention purge (#1702 Part 5)

  story    UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  uploader User?     @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)

  /// The real per-story external-file uniqueness constraint is a PARTIAL
  /// unique index, created via raw SQL because Prisma cannot express a
  /// partial index in the schema DSL. It ships in
  /// 20260811130100_story_attachment_external_ref_index, as a
  /// single-statement migration so Prisma does not wrap CONCURRENTLY in a
  /// transaction:
  ///
  ///   CREATE UNIQUE INDEX CONCURRENTLY "story_attachment_external_ref_key"
  ///     ON "story_attachment" ("storyId", "externalAttachmentId")
  ///     WHERE "deletedAt" IS NULL AND "externalAttachmentId" IS NOT NULL;
  ///
  /// It is intentionally NOT declared here as `@@unique(...)`. A plain
  /// (non-partial) Prisma unique on (storyId, sourceTool, externalAttachmentId)
  /// gets it wrong in both directions: it UNDER-enforces, because two nullable
  /// columns plus Postgres's default NULLS DISTINCT reject nothing for
  /// Fabric-origin rows (sourceTool is NULL for them by design — see the
  /// decision above); and it OVER-enforces, because it would span
  /// soft-deleted rows, so re-importing a PM file after any soft-delete
  /// (including the missingStreak >= 2 path) would raise P2002 for up to
  /// the project's configured attachment retention window. The partial index
  /// above fixes both:
  /// dropping sourceTool from the key covers Fabric-origin rows too, and the
  /// `deleted_at IS NULL` predicate excludes tombstones.
  ///
  /// Consequence for callers: Prisma only generates `findUnique` for
  /// constraints it knows about, and this one is invisible to it — use
  /// `findFirst` on (storyId, externalAttachmentId), never `findUnique`.
  @@index([storyId])
  @@index([uploaderUserId])
  @@index([deletedAt]) // purge scan: WHERE deletedAt < cutoff (mirrors Project/UserStoryComment)
  /// Purge keyset walk: WHERE deletedAt < cutoff AND id > lastId ORDER BY id.
  /// Without the composite the sort is not index-covered, and once unexpired
  /// rows stop consuming the deletion budget the page count — not MAX_DELETIONS
  /// — becomes the binding cost, so a per-page sort can exceed the activity's
  /// one-hour timeout. Created CONCURRENTLY in the migration.
  @@index([deletedAt, id])
  @@map("story_attachment")
}

/// A file a PM-tool reconcile pass refused to import (too large, disallowed MIME
/// type, or the per-story cap was already reached). Such a file has no bytes and
/// no StoryAttachment row, so this is the only record of it — the Attachments tab
/// renders these as a banner. Rewritten wholesale on every successful reconcile
/// for a story, so rows are never stale. Fizzy #1746.
model StoryAttachmentSyncIssue {
  id         String   @id @default(cuid())
  storyId    String
  sourceTool String
  filename   String
  /// Machine-readable cause. Import-validation causes, enforced against
  /// #1702's limits by the PM pull path (Fizzy #1745, AC-9):
  /// "TOO_LARGE" | "DISALLOWED_TYPE" | "STORY_CAP_REACHED".
  /// Divergence causes, which describe the two sides disagreeing rather than
  /// a file being refused (Fizzy #1745, AC-7/AC-8):
  /// "CONFLICT" — same filename both sides, different content hash; neither
  /// copy was changed.
  /// "REMOTE_DELETED" — a previously-pulled upload is no longer referenced by
  /// the linked item; Fabric's copy was kept.
  reason     String
  detectedAt DateTime @default(now())

  story UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_attachment_sync_issue")
}

/// Resolution state of a detected duplicate pair.
enum DuplicateLinkStatus {
  PENDING // surfaced on the roadmap, awaiting user action
  DISMISSED // user marked "not a duplicate" — never re-surface
  RESOLVED // user merged the pair (the discarded side moved to CLOSED)
  NOT_DUPLICATE // verifier judged the pair distinct — cached negative verdict, never surfaced in the UI; valid only while both sides' verified content hashes match (re-verified after either text changes)
}

/// How strongly a flagged pair is related.
enum DuplicateLinkType {
  DUPLICATE // the same underlying work item — one would be closed as a dup of the other
  OVERLAP // overlapping scope: same problem/capability with different framing — needs a human to merge or explicitly separate
}

/// A detected potential-duplicate relationship between two stories in the same
/// project, produced by the semantic duplicate scan (embedding similarity +
/// LLM verification). Pairwise and de-duplicated by canonical ordering
/// (storyAId < storyBId). Project-scoped; tenant isolation is enforced at the
/// procedure layer via project access (mirrors UserStory/StoryTask, which have
/// no direct row-level security).
///
/// Also doubles as the verifier's verdict cache: a NOT_DUPLICATE row records
/// that the LLM judged the pair distinct at the stored content hashes, so
/// re-scans skip the pair until either side's detection text changes.
model StoryDuplicateLink {
  id                   String              @id @default(cuid())
  projectId            String
  storyAId             String // canonical: storyAId < storyBId (lexicographic)
  storyBId             String
  similarity           Float // cosine similarity 0..1 (embedding stage)
  confidence           Float // LLM verifier confidence 0..1
  reasoning            String?             @db.Text // LLM explanation, shown in the resolve dialog
  status               DuplicateLinkStatus @default(PENDING)
  linkType             DuplicateLinkType   @default(DUPLICATE)
  // Detection-text hashes (hashDetectionText) of each side at the last LLM
  // verification. Lets re-scans skip pairs whose texts are unchanged and
  // automatically re-verify a pair when either side is edited. Null on rows
  // written before this column existed — treated as "not yet verified at any
  // known content", so the next scan re-verifies them once.
  verifiedContentHashA String?
  verifiedContentHashB String?
  detectedAt           DateTime            @default(now())
  resolvedAt           DateTime?
  resolvedById         String? // user who merged/dismissed the pair
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyA  UserStory @relation("DupLinkA", fields: [storyAId], references: [id], onDelete: Cascade)
  storyB  UserStory @relation("DupLinkB", fields: [storyBId], references: [id], onDelete: Cascade)

  @@unique([storyAId, storyBId])
  @@index([projectId, status])
  @@map("story_duplicate_link")
}

/// Cached title+description embedding for a story, keyed by the content hash and
/// embedding model it was produced with. Lets the manual duplicate scan re-embed
/// only stories whose detection text or embedding model changed since the last
/// run, and reuse cached vectors for the rest. Project-scoped; tenant isolation
/// is enforced at the procedure layer via project access (mirrors
/// UserStory/StoryDuplicateLink, which have no direct row-level security). A
/// stale row is harmless — it is overwritten on the next scan that touches the
/// story, and removed when the story or its project is deleted
/// (onDelete: Cascade on both relations, mirroring StoryDuplicateLink).
model StoryDuplicateEmbedding {
  id          String   @id @default(cuid())
  storyId     String   @unique
  projectId   String
  contentHash String // sha256 of buildDetectionText(title, description)
  model       String // embedding model used (base name from generateEmbeddings)
  embedding   Json // number[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story   UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("story_duplicate_embedding")
}

// DEPRECATED (expand/contract, contract phase pending). Nothing reads or
// writes this table any more: action-item routing now shares
// `story_duplicate_embedding`, because both features embed the identical
// `buildDetectionText` output and a second table stored the same vectors under
// a different key. The table is left in place deliberately — dropping it in the
// same release that stops using it would break the still-running previous
// worker version mid-rollout. Drop it in a follow-up release once this one has
// fully rolled out.
model StoryRoutingEmbedding {
  id          String   @id @default(cuid())
  storyId     String   @unique
  projectId   String
  contentHash String // sha256 of buildRoutingText(title, description, acceptanceCriteria)
  model       String // embedding model used (base name from generateEmbeddings)
  embedding   Json // number[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story   UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("story_routing_embedding")
}

model FeatureVersion {
  id                    String               @id @default(cuid())
  storyId               String
  version               Int
  description           String?              @db.Text
  acceptanceCriteria    String?              @db.Text
  draftingStage         FeatureDraftingStage
  changeDescription     String?
  changedBy             String?
  createdAt             DateTime             @default(now())
  userId                String?
  organizationId        String?
  // Feature Maturation V2: snapshot the working-notes content so one
  // version = the coherent triple (summary digest + description + AC). Nullable,
  // no default → existing rows untouched. Decision Log rows are append-only, so a
  // version references log state rather than copying rows.
  summaryDigestSnapshot String?              @db.Text
  workingNotesSnapshot  String?              @db.Text
  // Feature Maturation V2: per-run change summary — the section-tagged bullets
  // the enhance model emits describing what it changed, so the PO reviews ~4
  // lines instead of a 1k-row diff. Empty for non-enhance / pre-feature versions.
  changeSummary         String[]             @default([])

  story        UserStory     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([storyId, version], map: "feature_version_storyId_version_key")
  @@index([userId])
  @@index([organizationId])
  @@map("feature_version")
}

model StoryTask {
  id             String   @id @default(cuid())
  storyId        String
  identifier     String // "TASK-001"
  title          String
  description    String?  @db.Text
  isCompleted    Boolean  @default(false)
  order          Float    @default(0)
  estimatedHours Float?
  externalId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Agent assignment fields (Weft-style task automation)
  assignedAgentId  String? // RegisteredAgent.agentId
  agentTaskId      String? // Link to AgentTask for execution tracking
  agentStatus      String? // "pending", "working", "awaiting_approval", "completed", "failed"
  agentStartedAt   DateTime?
  agentCompletedAt DateTime?
  agentError       String?   @db.Text // Error message if agent failed

  // GitHub repository context for code tasks
  repositoryUrl   String? // Full URL: "https://github.com/owner/repo"
  repositoryOwner String? // GitHub owner: "owner"
  repositoryName  String? // GitHub repo: "repo"
  targetBranch    String? // Branch to work from: "main" or "develop"

  // Artifacts created by agent (PR URL, etc.)
  artifactUrl  String? // URL to created artifact (e.g., PR URL)
  artifactType String? // Type: "pull_request", "issue", etc.

  story      UserStory          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  subtasks   StorySubtask[]
  codingRuns CodingRun[]
  comments   StoryTaskComment[]

  // Weave relations
  weavePlans WeavePlan[]

  @@index([storyId])
  @@index([assignedAgentId])
  @@index([agentStatus])
  @@map("story_task")
}

enum ProjectCommentAuthorType {
  USER
  AGENT

  @@map("project_comment_author_type")
}

model UserStoryComment {
  id              String                   @id @default(cuid())
  storyId         String
  authorId        String
  authorType      ProjectCommentAuthorType @default(USER)
  content         String                   @db.Text
  parentId        String?
  sourceCommentId String?
  workflowId      String?
  metadata        Json?
  organizationId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  story         UserStory          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  parent        UserStoryComment?  @relation("UserStoryCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       UserStoryComment[] @relation("UserStoryCommentReplies")
  sourceComment UserStoryComment?  @relation("UserStoryAgentReplies", fields: [sourceCommentId], references: [id], onDelete: SetNull)
  agentReplies  UserStoryComment[] @relation("UserStoryAgentReplies")
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([authorId])
  @@index([authorType])
  @@index([parentId])
  @@index([sourceCommentId])
  @@index([organizationId])
  @@map("user_story_comment")
}

model StoryTaskComment {
  id              String                   @id @default(cuid())
  taskId          String
  authorId        String
  authorType      ProjectCommentAuthorType @default(USER)
  content         String                   @db.Text
  parentId        String?
  sourceCommentId String?
  workflowId      String?
  metadata        Json?
  organizationId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  task          StoryTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent        StoryTaskComment?  @relation("StoryTaskCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       StoryTaskComment[] @relation("StoryTaskCommentReplies")
  sourceComment StoryTaskComment?  @relation("StoryTaskAgentReplies", fields: [sourceCommentId], references: [id], onDelete: SetNull)
  agentReplies  StoryTaskComment[] @relation("StoryTaskAgentReplies")
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([authorType])
  @@index([parentId])
  @@index([sourceCommentId])
  @@index([organizationId])
  @@map("story_task_comment")
}

// ---------------------------------------------------------------------------
// Feature Maturation V2 — Three-Tab Feature Editor
// Additive, nullable, clean flag-off rollback. The Clean Spec IS the existing
// UserStory.description + acceptanceCriteria — no parallel cleanSpecContent.
// "Interactive Sanity Check" is the Clean Spec tab's MANUAL approval mode, NOT a
// FeatureDraftingStage member (the SANITY_CHECK collision is avoided).
// ---------------------------------------------------------------------------

/// Per-tab AI approval gate. AUTO_ACCEPT commits a confirmed decision's patch
/// without a per-change review; MANUAL holds it for review (the "Interactive
/// Sanity Check" experience on the Clean Spec tab). Resolved server-side as
/// feature override ?? per-user default ?? hard default.
enum MaturationApprovalMode {
  AUTO_ACCEPT
  MANUAL

  @@map("maturation_approval_mode")
}

/// Who authored a Decision Log turn. Mirrors UserStoryComment.authorType.
enum DecisionAuthorType {
  USER
  AGENT

  @@map("decision_author_type")
}

/// Lifecycle of a Decision Log thread. FORMATTING_ONLY marks a pure-formatting
/// change logged as "Spec updated — no logic impact" without an LLM call.
enum DecisionStatus {
  OPEN
  RESOLVED
  REJECTED
  FORMATTING_ONLY
  // An OPEN question the latest Clean Spec refresh no longer lists — soft-closed by
  // reconciliation (demo feedback #5, option A+C). Dropped from the active open
  // list but kept (collapsed, restorable) and auto-reactivated to OPEN if it
  // reappears in a later refresh. Never deletes a question, preserving recall.
  POSSIBLY_RESOLVED

  @@map("decision_status")
}

/// Provenance of a settled decision: a human answer vs. an AI-confirmed one.
enum DecisionSource {
  HUMAN
  AI_CONFIRMED

  @@map("decision_source")
}

/// How a PO produced the answer to an open question, relative to the AI's proposed
/// recommendation (demo feedback #7). Queryable so we can measure recommendation
/// acceptance. AI_SUGGESTED = took a suggested option/recommendation unchanged,
/// whether by one click or by opening it in the editor and saving it untouched;
/// AI_EDITED = opened a suggestion in the editor and changed its text;
/// MANUAL = typed the answer from an empty box — including when suggestions were
/// on offer and the PO ignored them ("type your own"), since nothing was taken
/// from the AI in that case.
///
/// AI_EDITED previously meant "a recommendation was offered but the PO typed their
/// own answer" — there was no way to start from a suggestion and edit it, so the
/// name never matched. Adding that path freed the value for its literal meaning
/// and moved the old rows to MANUAL. "The AI offered and was ignored" is still
/// measurable without a value of its own: the question root persists its
/// suggestedOptions, so it is that set being non-empty next to a MANUAL answer.
enum AnswerSource {
  AI_SUGGESTED
  AI_EDITED
  MANUAL

  @@map("answer_source")
}

/// Threaded, append-only Decision Log child of a UserStory — the human-readable
/// maturation changelog. Follows the UserStoryComment shape: self-relation
/// for threads (parent root vs reply), soft delete, XOR tenant isolation.
/// `userId` is the tenant key (mirrors the user_owned RLS policy); `authorUserId`
/// and `decidedBy` are bare user-id strings (no FK), like UserStory's denormalized
/// last-edit provenance.
model DecisionLogEntry {
  id               String             @id @default(cuid())
  userStoryId      String
  parentId         String?
  authorType       DecisionAuthorType
  authorUserId     String?
  status           DecisionStatus     @default(OPEN)
  summary          String?            @db.Text
  content          String?            @db.Text
  impactedSection  String?
  topic            String?
  questionId       String?
  source           DecisionSource     @default(HUMAN)
  decidedBy        String?
  authorName       String?
  sourceProvenance String?
  // Set on a settled answer turn (reply) / minted RESOLVED root: how the PO produced
  // the answer relative to the AI recommendation (demo feedback #7). Null on OPEN
  // question roots and on pre-feature rows. Real column (not metadata) so acceptance
  // is queryable.
  answerSource     AnswerSource?
  // Amendment pointer (#1910): set on an answer turn that REPLACES an earlier
  // answer turn on the same thread. Amending never mutates the row it replaces —
  // the log stays append-only and the previous answer remains readable as
  // history. Unique because a given turn can be superseded at most once: a second
  // amendment supersedes the amendment, not the original, so the chain stays
  // linear and the DB refuses a double-supersede race outright.
  //
  // CRITICAL: a turn with a `supersededBy` row is retracted. It must never reach
  // an AI surface — see the Temporal feature-decisions handler, which renders
  // thread replies into model context.
  supersedesId     String?       @unique
  metadata         Json?
  organizationId   String?
  userId           String
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  story        UserStory          @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  parent       DecisionLogEntry?  @relation("DecisionLogEntryReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      DecisionLogEntry[] @relation("DecisionLogEntryReplies")
  // SetNull, not Cascade: if the superseded turn is ever hard-deleted, the
  // amendment that replaced it is still the live answer and must survive.
  supersedes   DecisionLogEntry?  @relation("DecisionLogEntrySupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy DecisionLogEntry?  @relation("DecisionLogEntrySupersedes")
  assignees    DecisionLogEntryAssignee[]
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A FIFTH index exists that Prisma cannot express: the partial
  // `decision_log_entry_open_roots_idx` on ("userStoryId") WHERE status = 'OPEN'
  // AND "parentId" IS NULL AND "deletedAt" IS NULL, added in migration
  // 20260720230000. It serves the roadmap Priority layout's open-question
  // counts. Documented here because a reader of this model would otherwise see
  // four indexes and no hint that a query's performance depends on a fifth —
  // and because a shadow-database diff can read it as drift and try to DROP it.
  @@index([userStoryId, createdAt])
  @@index([parentId])
  @@index([organizationId])
  @@index([userId])
  @@map("decision_log_entry")
}

/// Routes an open maturation question to the people who can answer it (Fizzy #1751).
///
/// TENANCY — read this before adding a column. `userId` is the TENANT key and mirrors the
/// parent entry's owner; it is NOT the assignee. The `user_owned` RLS policy matches
/// `"userId" = current_user_id()` on its personal branch, so naming the assignee `userId`
/// would scope a row to the person being asked rather than to the tenant that owns the
/// question. The assignee is `assigneeUserId`.
///
/// `assignedByUserId` is load-bearing, not bookkeeping: after a re-assignment there are two
/// candidate "askers", and it is what makes "notify the original assigner when the question
/// is answered" (AC-14) well defined.
///
/// There is deliberately no `status` here. A question's `Assigned` state is DERIVED
/// (`assignees.length > 0 && status === OPEN`) rather than stored, because a new
/// `DecisionStatus` member would fall out of the `status: "OPEN"` predicates in
/// `getOpenQuestionCounts` and `markQuestionsPossiblyResolved` and silently break both.
model DecisionLogEntryAssignee {
  id                 String   @id @default(cuid())
  decisionLogEntryId String
  /// The project member being asked.
  assigneeUserId     String
  /// Who created this assignment — the recipient of the "answered" notification.
  assignedByUserId   String
  /// Tenant key (mirrors the parent entry), NOT the assignee. See the note above.
  userId             String
  organizationId     String?
  createdAt          DateTime @default(now())

  entry        DecisionLogEntry @relation(fields: [decisionLogEntryId], references: [id], onDelete: Cascade)
  assignee     User             @relation("DecisionQuestionAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  assignedBy   User             @relation("DecisionQuestionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([decisionLogEntryId, assigneeUserId])
  @@index([decisionLogEntryId])
  @@index([assigneeUserId])
  @@index([organizationId])
  @@index([userId])
  @@map("decision_log_entry_assignee")
}

/// Per-user default approval mode per tab plus the "Auto-accept all" preset
/// state. The per-user home; per-feature overrides live as the three
/// nullable *ApprovalMode columns on UserStory. XOR tenant isolation
/// (per_user_within_org RLS): userId is always required, organizationId scopes
/// the org/personal context. Hard defaults match the spec's effective-mode
/// resolution: Clean Spec / Decision Log AUTO_ACCEPT, Summary & Questions MANUAL.
model MaturationApprovalPreference {
  id                   String                 @id @default(cuid())
  userId               String
  organizationId       String?
  cleanSpecMode        MaturationApprovalMode @default(AUTO_ACCEPT)
  decisionLogMode      MaturationApprovalMode @default(AUTO_ACCEPT)
  summaryQuestionsMode MaturationApprovalMode @default(MANUAL)
  autoAcceptAll        Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // This plain unique covers ORG rows. It does NOT constrain personal-context
  // rows (organizationId IS NULL): Postgres treats NULL as DISTINCT in a plain
  // unique index. A hand-written PARTIAL unique index
  // `maturation_approval_preference_user_personal_unique` (in the migration,
  // mirroring user_story's `*_external_id_unique`) enforces one personal-context
  // preference per user. Prisma's `@@unique` can only emit a plain index, so the
  // partial one intentionally lives only in the migration, not here.
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("maturation_approval_preference")
}

// ---------------------------------------------------------------------------
// Architecture Decision Log (ADL)
// Project-scoped, AI-aware records of architectural decisions: context, the
// decision, rationale, alternatives, participants, status lifecycle, threaded
// comments, and per-save version history. Mirrors the project-scoped tenant-XOR
// pattern used by ProjectDocument / UserStory. Frontend label: "Decisions".
// ---------------------------------------------------------------------------

enum ArchitectureDecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  DEPRECATED
  REJECTED

  @@map("architecture_decision_status")
}

model ArchitectureDecision {
  id         String @id @default(cuid())
  projectId  String
  identifier String // Per-project human id, e.g. "ADR-001"

  title                  String
  contextProblem         String                     @db.Text
  decision               String                     @db.Text
  rationale              String                     @db.Text
  decisionDrivers        String?                    @db.Text
  alternativesConsidered String?                    @db.Text
  consequences           String?                    @db.Text
  status                 ArchitectureDecisionStatus @default(PROPOSED)
  domain                 String? // category/area: infra, data, ai, security, frontend, platform
  decisionDate           DateTime                   @default(now())

  // Participants (hybrid): linked project members + free-text externals
  participantUserIds String[] @default([])
  participantsText   String?

  // Supersede pointer (soft id; target identifier resolved in the query layer)
  supersededById String?

  // Related decisions (soft ids; "see also" links shown as relationship chips)
  relatedDecisionIds String[] @default([])

  // Team-wide pin — pinned decisions sort to the top of the list (most-recent pin first).
  pinnedAt DateTime?

  // Authorship / audit (plain ids, resolved best-effort — mirrors ProjectDocument.lastEditedBy)
  createdById    String
  lastEditedById String?
  currentVersion Int     @default(1) // bumped on each saved edit; comments tag the version they were posted on

  // Human endorsement ("vouch") — a maintainer's seal that elevates the decision
  // to "settled" in AI context (mirrors the PCR provenance stamp).
  vouchedAt   DateTime?
  vouchedById String?

  // RAG/AI context link — soft pointer to the mirrored ProjectContext row (AC5)
  contextId String?

  // Source bridge — when created from an extracted meeting decision
  sourceKind     String? // e.g. "meeting_decision"
  sourceMetadata Json?

  // Tagging metadata: type from the project's evolving taxonomy, an accountable
  // owner, how long the decision stands, and whether it should drive roadmap
  // prioritization. Nullable throughout so legacy rows stay valid until touched;
  // ownerUserId is a bare id (no FK) mirroring createdById/lastEditedById.
  decisionTypeId    String?
  ownerUserId       String?
  duration          DecisionDuration?
  priorityFlagged   Boolean   @default(false)
  priorityFlaggedAt DateTime?

  // The owner's sign-off. Notifying an owner tells them a decision is theirs;
  // it does not record that they accepted it, so "has the owner acted?" had no
  // answer to query. Cleared whenever ownerUserId changes — a new owner has not
  // acknowledged anything.
  ownerAcknowledgedAt DateTime?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionType DecisionType?                 @relation(fields: [decisionTypeId], references: [id], onDelete: SetNull)
  comments     ArchitectureDecisionComment[]
  versions     ArchitectureDecisionVersion[]

  @@unique([projectId, identifier])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([projectId, priorityFlagged])
  @@map("architecture_decision")
}

model ArchitectureDecisionComment {
  id                     String                   @id @default(cuid())
  architectureDecisionId String
  authorId               String
  authorType             ProjectCommentAuthorType @default(USER)
  content                String                   @db.Text
  parentId               String?
  decisionVersion        Int? // decision version current when this comment was posted (continuous thread, tagged)
  organizationId         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  deletedAt              DateTime?

  decision     ArchitectureDecision          @relation(fields: [architectureDecisionId], references: [id], onDelete: Cascade)
  parent       ArchitectureDecisionComment?  @relation("ArchitectureDecisionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ArchitectureDecisionComment[] @relation("ArchitectureDecisionCommentReplies")
  author       User                          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([architectureDecisionId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([organizationId])
  @@map("architecture_decision_comment")
}

model ArchitectureDecisionVersion {
  id                     String @id @default(cuid())
  architectureDecisionId String
  version                Int

  // Snapshot of the decision's content at this save
  title                  String
  contextProblem         String                     @db.Text
  decision               String                     @db.Text
  rationale              String                     @db.Text
  decisionDrivers        String?                    @db.Text
  alternativesConsidered String?                    @db.Text
  consequences           String?                    @db.Text
  status                 ArchitectureDecisionStatus
  decisionDate           DateTime
  participantUserIds     String[]                   @default([])
  participantsText       String?
  // Tagging metadata at this save (mirrors the parent decision's fields).
  decisionTypeId         String?
  ownerUserId            String?
  duration               DecisionDuration?
  priorityFlagged        Boolean                    @default(false)

  // Who made this edit (plain id + denormalized name — mirrors ProjectActivity.userName)
  editedById   String
  editedByName String

  // Tenant isolation (copied from parent decision)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  architectureDecision ArchitectureDecision @relation(fields: [architectureDecisionId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([architectureDecisionId, version])
  @@index([architectureDecisionId, version])
  @@index([userId])
  @@index([organizationId])
  @@map("architecture_decision_version")
}

/// How long a decision stands before it should be revisited. Two states by
/// design: LONG_STANDING is standing guidance ("security always wins"),
/// SHORT_TERM is bound to a horizon ("compliance deadline this quarter").
enum DecisionDuration {
  LONG_STANDING
  SHORT_TERM

  @@map("decision_duration")
}

/// Who introduced a DecisionType row: the capture-time AI suggestion flow or a
/// human adding a label nothing fit. Purely informational today.
enum DecisionTypeOrigin {
  AI
  HUMAN

  @@map("decision_type_origin")
}

/// Per-project decision-type taxonomy. Deliberately NOT a fixed enum: the AI
/// suggestion flow reuses an existing type when one fits and mints a new row
/// only when nothing does, so the taxonomy grows with the project's actual
/// decisions. Archived types stay resolvable on decisions that reference them.
model DecisionType {
  id         String              @id @default(cuid())
  projectId  String
  name       String // display label, e.g. "Architecture", "QA", "Deployment"
  origin     DecisionTypeOrigin  @default(HUMAN)
  archivedAt DateTime?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisions    ArchitectureDecision[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("decision_type")
}

model PublishingSuggestionCycle {
  id                 String                @id @default(cuid())
  projectId          String
  organizationId     String? // denormalized from parent Project
  userId             String? // denormalized from parent Project
  status             PublishingCycleStatus @default(GENERATING)
  actorUserId        String // = Project.userId at run start (AI-usage actor)
  triggeredByUserId  String? // audit breadcrumb only, NOT the AI-usage actor: NULL = the scheduled sweep (no human initiator); set = the user who clicked "Generate now". Bare String, no relation/FK/index — mirrors actorUserId so the breadcrumb survives the user's deletion instead of being nulled or cascaded.
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  executionTimeoutAt DateTime? // server-enforced timeout for liveness-aware reclaim
  coveredThrough     DateTime // upper collection boundary captured before collection
  sourceCoverage     Json? // per-source advanced-through timestamps (committed only on terminal success)
  sourceFailures     Json? // per-source failure detail; completeness = full|partial

  // 1C-1b (§7.1): fingerprint of the preferences this cycle RAN with, written
  // only by a CAS that takes a still-GENERATING cycle TERMINAL — BOTH of them,
  // the suggestions path and the INSUFFICIENT_CONTEXT path, which are separate
  // updates in mutually exclusive branches — and on each only when that terminal
  // counts as a run: READY and NO_TOPICS always, INSUFFICIENT_CONTEXT only when
  // collection was clean. Each branch also backfills a NULL on replay recovery,
  // never overwriting a hash already recorded.
  // NULLABLE, and null is load-bearing in two ways: a cycle that failed
  // or was superseded never records one, so a failure cannot consume the single
  // recovery run a preference change buys; and a pre-1C-1b cycle has none, which
  // reads as a mismatch and gives every existing project exactly one recovery
  // run after deploy. Stamping this at cycle CREATION would break the first
  // guarantee, which is why it is written nowhere else.
  preferencesHash    String?
  temporalWorkflowId String?
  occurrenceKey      String? // stable per-dispatch-run id (Temporal dispatcher runId); partial-unique on (projectId, occurrenceKey) WHERE NOT NULL for retry-safe cycle idempotency (Codex N2). NULL for manual/legacy rows.
  error              String?               @db.VarChar(500)
  // 1C-2b (§9.7): the notification lifecycle. NON-NULL with a default, deliberately — the default
  // is what classifies a cycle written by any worker that does not know about this feature,
  // whenever it is written, including mid-rolling-deploy. A cycle ENTERS the lifecycle explicitly,
  // by transitioning to PENDING in the same transaction that sets it READY. The value set is
  // enforced twice: a typed writer in publishing-notification-outcome.ts, and a CHECK constraint.
  notificationOutcome        String @default("NOT_APPLICABLE")
  // Shared lifecycle version — NOT a per-activity attempt number. The column has several writers
  // drawing attempt numbers from different sequences, so a guard keyed to one writer's private
  // numbering is not a guard (§9.7 rule 4). Activation does NOT bump it: the entry transition is
  // fenced on its own expected value, and leaving the version alone keeps a mid-flight activity's
  // compare-and-swap valid.
  notificationOutcomeVersion Int    @default(0)
  // 1C-2d-2a: when the notification lifecycle was ACTIVATED — NOT when the row
  // was created, and NOT `updatedAt`. The ABANDONED sweep's staleness bound is
  // the suggestion workflow's EXECUTION timeout, so the clock has to start at
  // activation. `createdAt` cannot serve: dispatch inserts the cycle BEFORE
  // client.workflow.start, a start failure retries the whole activity, and
  // activation happens later still — so a live cycle can already carry a
  // createdAt past the bound. `updatedAt` cannot serve either, for a subtler
  // reason: it is stamped by ANY writer, so it is the activation instant only
  // while every writer of this model happens to be fenced away from PENDING
  // rows, which is an inventory rather than a property.
  //
  // NULLABLE, and null means "activated by a build that predates this column".
  // The migration's backfill cannot reach such a row — it did not exist yet —
  // so the sweep's first pass ENROLS it, at GREATEST(`updatedAt`, the database
  // clock in the statement that writes it). NOT `updatedAt` alone: @updatedAt is
  // CLIENT-side, so a worker whose clock trails the sweeper stamps a value below
  // the true activation instant, and the sweep would then terminalize a live
  // cycle. The floor delays an alert rather than manufacturing one, which is the
  // only acceptable direction because ABANDONED is irreversible. What is still
  // null after that pass is REPORTED by the run, not left for someone to query.
  //
  // WHAT THIS COLUMN GUARANTEES IS ONE WRITER, NOT A TRUSTWORTHY CLOCK, and the
  // paragraph above is easy to misread as claiming the second. The GREATEST
  // floor applies to exactly two statements — the backfill and the sweep's
  // enrolment pass — because those are the ones with no writer-supplied value to
  // use. The PRIMARY path does not have that problem and does not get that
  // treatment: activateCycleNotificationLifecycle stamps the WORKER's own clock,
  // client-side, on every ordinary activation.
  //
  // What covers the residual is not a bound on the SIZE of the skew, but a bound
  // on what the skew can DO. Staleness is `notificationOutcomeAt < now() - 2h`,
  // so a worker whose clock reads X behind the database moves THIS cycle's
  // abandonment deadline X earlier — ANY X does that, not only X above two
  // hours, and it puts a cycle in the final X of its window at risk. What makes
  // that acceptable is that such a cycle is already within X of the suggestion
  // workflow's execution timeout, which would have ended it regardless of this
  // column. So the error this write can manufacture is BOUNDED BY, AND
  // PROPORTIONAL TO, the skew — never unbounded, which is what distinguishes it
  // from the GREATEST floor's hazard, where a value derived from `updatedAt` has
  // no such bound. No writer change follows: a value written at the moment of
  // activation still needs no floor, on this argument as much as the discarded
  // "more than two hours of skew" one.
  notificationOutcomeAt      DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topics       PublishingTopic[]
  notificationDeliveries PublishingNotificationDelivery[]
  chatDeliveries         PublishingChatDelivery[]

  @@index([projectId, createdAt])
  @@index([organizationId])
  @@index([userId])
  @@map("publishing_suggestion_cycle")
}

model PublishingTopic {
  id                      String                    @id @default(cuid())
  projectId               String
  organizationId          String? // denormalized from parent Project
  userId                  String? // denormalized from parent Project
  cycleId                 String? // null for manually-created topics
  title                   String
  pitch                   String?                   @db.Text
  status                  PublishingTopicStatus     @default(SUGGESTION)
  origin                  PublishingTopicOrigin
  createdById             String? // creating user (manual topics)
  declineReason           String?                   @db.Text
  // 1D (Fizzy #2265). Snooze is an OVERLAY, not a status: the topic keeps its
  // real status so FR8 can return it to the right Inbox section. null =
  // not snoozed. A value <= now() means the snooze elapsed — nothing rewrites
  // the row when that happens, which is why re-surfacing cannot drift.
  snoozedUntil            DateTime?
  snoozeReason            String?                   @db.Text // optional (FR7)
  publishedUrl            String?                   @db.Text // optional user-entered URL, set only when PUBLISHED (FR14/DV5); no strict validation (DV6)
  provenance              Json? // {repoPrs:[{repoFullName,prNumber}], storyIds, featureVersionIds, transcriptIds, docIds}
  suggestedPostTypes      PublishingTopicPostType[] @default([]) // AI topics only; [] for manual
  contributorUserIds      String[]                  @default([]) // resolved Fabric user ids (stories+docs); [] valid
  relevantFunctionTags    FunctionTag[]             @default([]) // AI-stamped disciplines the topic serves (FR2/FR3 ranking signal, NOT an angle); [] for manual
  postTypeRecommendations Json                      @default("[]") // [{type,theme,rationale}] display-only enrichment; suggestedPostTypes is derived from this
  postTypesOverridden     Boolean                   @default(false) // false → effective post types = suggestedPostTypes (AI); true → userPostTypes (may be [])
  userPostTypes           PublishingTopicPostType[] @default([]) // user override set; meaningful only when postTypesOverridden = true
  angle                   String? // FR9/10 (incremental): AI-stamped short angle label; distinct from title and from relevantFunctionTags; null = none / manual topics
  subject                 String? // FR9/10 multiplication: canonical subject line; set only on a >=2 angle-group member; null otherwise
  subjectKey              String? // FR9/10 multiplication: grouping identity = hash(projectId + normalize(subject||title)); server-side only; NEVER in the unique index
  dedupeKey               String // canonical subject hash — set for BOTH AI and manual topics
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?                      @relation("PublishingTopicOwner", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        PublishingSuggestionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdBy    User?                      @relation("PublishingTopicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  readMarkers  PublishingTopicRead[]
  planningAnalyses PublishingTopicPlanningAnalysis[]
  publishingTopicDecisions PublishingTopicDecisionEntry[]
  drafts       PublishingTopicDraft[]
  workingDrafts PublishingTopicWorkingDraft[]

  @@unique([projectId, dedupeKey]) // project-wide dedup across ALL statuses (dedupeKey is non-null)
  @@index([projectId, status])
  @@index([cycleId])
  @@index([createdById])
  @@map("publishing_topic")
}

/// AI-generated pre-draft planning worksheet for ONE publishing topic
/// (Phase 2A-2, Fizzy #1851).
///
/// TENANCY: `organizationId`/`userId` are denormalised from the parent topic and
/// are strict XOR — an org project stores `userId = NULL`. They are TENANCY, not
/// ownership; who asked for the run is `requestedById`. Copying
/// `DecisionLogEntry`'s required `userId` here would make every org-project write
/// violate the CHECK constraint.
///
/// Three things this model needs that Prisma cannot express, all created in
/// `20260830120000_add_publishing_topic_planning_analysis`:
///   - a partial unique index `(topicId) WHERE status = 'GENERATING'` — the
///     in-flight guard, so one topic cannot have two runs in flight;
///   - `CHECK (("organizationId" IS NULL) <> ("userId" IS NULL))` — strict XOR,
///     matching `publishing_topic_tenant_xor`. RLS does NOT substitute: its org
///     branch permits any `userId`, it does not require null;
///   - `CHECK ("status" <> 'GENERATING' OR "executionTimeoutAt" IS NOT NULL)` —
///     the liveness deadline, matching
///     `publishing_suggestion_cycle_generating_timeout`. Without it the partial
///     index above becomes a PERMANENT lock the moment a worker dies between the
///     insert and the terminal marker: no user action would ever free the topic.
model PublishingTopicPlanningAnalysis {
  id             String                          @id @default(cuid())
  topicId        String
  projectId      String
  organizationId String? // denormalized from the parent topic (XOR)
  userId         String? // denormalized from the parent topic (XOR — null for org topics)
  version        Int
  status         PublishingPlanningAnalysisStatus @default(GENERATING)
  content        Json? // Zod-validated planning document; null until READY
  sourceRefs     Json                            @default("{}") // what fed this version, and what failed to
  model          String?
  /// BOUND | DEFAULT_UNBOUND | DEFAULT_RENDER_FAILED — which prompt actually
  /// shaped this analysis. An analysis built from the default body because a
  /// bound prompt would not render reads exactly like one built from the bound
  /// prompt, so it is the one thing a reader cannot recover from the output.
  promptSource   String?
  error          String?                         @db.Text
  requestedById  String? // authorship, never tenancy
  /// Liveness deadline for the reclaim; CHECK-enforced while GENERATING.
  executionTimeoutAt DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  topic        PublishingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation("PublishingPlanningAnalysisTenant", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy  User?           @relation("PublishingPlanningAnalysisRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([topicId, version])
  @@index([topicId, createdAt])
  @@index([organizationId])
  @@index([userId])
  @@index([requestedById])
  @@map("publishing_topic_planning_analysis")
}

enum PublishingPlanningAnalysisStatus {
  GENERATING
  READY
  FAILED
}

/// One AI generation ATTEMPT for one content type of one publishing topic
/// (Phase 2B-1, Fizzy #1853).
///
/// Deliberately shaped as a twin of `PublishingTopicPlanningAnalysis`: same
/// GENERATING/READY/FAILED lifecycle, same XOR tenancy denormalised from the
/// parent topic, same `requestedById`-is-authorship-never-tenancy split, same
/// `executionTimeoutAt` liveness deadline. A reviewer who knows that table
/// should not have to learn a second set of conventions for this one.
///
/// Rows are treated as immutable once terminal, which is HELPER DISCIPLINE and
/// not a database invariant: the writers compare-and-set on
/// `status = 'GENERATING'`, but nothing stops a raw `$executeRaw` or a
/// bypass-role writer mutating a READY row. No sibling enforces it in-database
/// either, and a trigger here alone would imply a guarantee the rest of the
/// publishing family does not make.
///
/// `postType` carries the FULL four-value enum rather than a 2B-only pair, so
/// Phase 2C activates Case Study and Stakeholder Email by adding a prompt
/// rather than a migration.
///
/// Five things this model needs that Prisma cannot express, all created in
/// `20260901120000_add_publishing_topic_drafts`:
///   - a composite FK `(topicId, projectId)` onto `publishing_topic (id,
///     projectId)`. The single-column FKs below prove each id names a real row
///     and nothing about the two AGREEING, so a draft could otherwise be
///     attached to a topic in a different project — and `listTopicDrafts`
///     authorizes on `projectId` and then reads by exactly these two columns;
///   - a partial unique index `(topicId, postType) WHERE status = 'GENERATING'`
///     — one run in flight PER CONTENT TYPE. Not per topic: generating a short
///     post while a blog post generates is legitimate and users will do it;
///   - `CHECK (("organizationId" IS NULL) <> ("userId" IS NULL))` — strict XOR,
///     matching `publishing_topic_tenant_xor`. RLS does NOT substitute: its org
///     branch permits any `userId`, it does not require null;
///   - `CHECK ("status" <> 'GENERATING' OR "executionTimeoutAt" IS NOT NULL)` —
///     without it the partial index becomes a PERMANENT lock the moment a
///     worker dies between the insert and the terminal marker;
///   - `UNIQUE ("id", "topicId", "postType")` — redundant on its own (`id` is
///     the primary key) and required anyway, because Postgres accepts the
///     composite foreign key on `publishing_topic_working_draft` only if the
///     referenced column list carries a unique constraint.
model PublishingTopicDraft {
  id                 String                  @id @default(cuid())
  topicId            String
  projectId          String
  organizationId     String? // denormalized from the parent topic (XOR)
  userId             String? // denormalized from the parent topic (XOR — null for org topics)
  postType           PublishingTopicPostType
  version            Int // per (topicId, postType), allocated under the locked project row
  status             PublishingDraftStatus   @default(GENERATING)
  content            Json? // validated draft document; null until READY
  /// The user's optional generation guidance for THIS run (DV7). Stored per
  /// attempt rather than per topic: regenerating with different guidance is the
  /// normal way to use this feature, and a topic-level column could not say
  /// which guidance produced which draft.
  guidance           String?                 @db.Text
  sourceRefs         Json                    @default("{}") // what fed this version, and what failed to
  model              String?
  /// BOUND | DEFAULT_UNBOUND | DEFAULT_RENDER_FAILED — which prompt actually
  /// shaped this draft. A draft built from the default body because a bound
  /// prompt would not render reads exactly like one built from the bound
  /// prompt, so it is the one thing a reader cannot recover from the output.
  promptSource       String?
  promptId           String? // DV6
  promptVersion      Int? // DV6
  error              String?                 @db.Text
  requestedById      String? // authorship, never tenancy
  /// Liveness deadline for the reclaim; CHECK-enforced while GENERATING.
  executionTimeoutAt DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  topic        PublishingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation("PublishingTopicDraftTenant", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy  User?           @relation("PublishingTopicDraftRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([topicId, postType, version])
  @@index([topicId, postType, createdAt])
  @@index([projectId])
  @@index([organizationId])
  @@index([userId])
  @@index([requestedById])
  @@map("publishing_topic_draft")
}

enum PublishingDraftStatus {
  GENERATING
  READY
  FAILED
}

/// The working draft for one content type of one publishing topic (Phase 2B-1,
/// Fizzy #1853) — the selected short-post option, or the blog post body as
/// edited.
///
/// SHARED PROJECT CONTENT, not per-author. `@@unique([topicId, postType])` means
/// one draft per content type for the whole topic, and that is the card's own
/// model rather than an accident of the key: FR37 scopes a generated draft to
/// "the current project and topic" — never to a user — and UC2 speaks of "the
/// working Short Post draft", singular. A publishing topic is a shared work
/// item and its draft is the team's draft.
///
/// Stated here explicitly because the alternative is a breaking change, not an
/// authorization tweak: making drafts author-private later would need an owner
/// column inside the unique key and a data migration. `updatedById` is
/// therefore "who last edited", never an owner.
///
/// It also carries the composite `(topicId, projectId)` FK described on
/// `PublishingTopicDraft`, for the same reason.
///
/// WHY THIS IS A SEPARATE TABLE FROM `PublishingTopicDraft`. FR33/FR35 require
/// that regenerating never silently overwrites saved work. With one table that
/// is a rule every future writer must remember; with two it is a property of
/// WHERE THE WRITES GO — generation only ever writes
/// `publishing_topic_draft`, so it cannot reach this row at all. A rule a later
/// change can forget is not the same guarantee as one it cannot express.
///
/// `sourceDraftId` is a PLAIN COLUMN, not a Prisma relation, and that is
/// deliberate. The real constraint is composite — it must prove the cited
/// candidate belongs to the SAME topic and post type, not merely that it
/// exists — and its delete action must null only `sourceDraftId`:
///
///   FOREIGN KEY ("sourceDraftId", "topicId", "postType")
///     REFERENCES "publishing_topic_draft" ("id", "topicId", "postType")
///     ON DELETE SET NULL ("sourceDraftId") ON UPDATE CASCADE
///
/// Prisma cannot express that subset action; declaring the relation would
/// generate the all-columns form, which tries to null NOT NULL `topicId` and
/// `postType` and makes deleting a candidate FAIL instead of preserving the
/// body. Declaring it as a single-column relation would be worse still — the
/// schema and the database would disagree about the constraint's shape.
///
/// So the constraint is hand-written in
/// `20260901120000_add_publishing_topic_drafts` and documented here for the
/// same reason `PublishingTopicDecisionEntry` documents its partial unique
/// index: a shadow-database diff can read it as drift and try to DROP it. The
/// subset syntax requires PostgreSQL 15+ (dev runs 15, CI 16).
///
/// Deleting a CANDIDATE keeps this row and nulls its provenance; deleting the
/// TOPIC or the PROJECT deletes it outright. That asymmetry is intended: a
/// candidate is one attempt among many, whereas a topic is the thing the draft
/// is about, and a working draft outliving its topic would be an orphan no
/// screen can reach.
model PublishingTopicWorkingDraft {
  id                String                  @id @default(cuid())
  topicId           String
  projectId         String
  organizationId    String? // denormalized from the parent topic (XOR)
  userId            String? // denormalized from the parent topic (XOR — null for org topics)
  postType          PublishingTopicPostType
  body              String                  @db.Text // Markdown the user owns
  /// Which candidate this body came from. Plain column — see the model doc.
  sourceDraftId     String?
  /// TWEET: which prompt-authored option label was selected (DV3). Null for a
  /// blog post, whose generation produces one draft rather than options.
  sourceOptionLabel String?
  updatedById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  topic        PublishingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation("PublishingWorkingDraftTenant", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy    User?           @relation("PublishingWorkingDraftUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([topicId, postType]) // at most one working draft per content type
  @@index([projectId])
  @@index([organizationId])
  @@index([userId])
  @@index([updatedById])
  @@map("publishing_topic_working_draft")
}

enum PublishingDecisionEntryKind {
  QUESTION
  AI_UPDATE
}

/// One turn in a publishing topic's decision thread: an OPEN question root, the
/// answer reply that resolves it, or an AGENT-authored AI Update note.
///
/// Tenancy and authorship are SEPARATE columns, unlike `DecisionLogEntry` whose
/// `userId` is a required owner key. `PublishingTopic` is XOR-normalised — an
/// org topic has `userId = null` — so a child of a topic cannot carry a
/// required `userId`. `authorUserId` is who wrote the turn, never tenancy.
///
/// A SIXTH index exists that Prisma cannot express: the partial unique
/// `publishing_topic_decision_entry_question_root` on ("topicId", "questionId")
/// WHERE "parentId" IS NULL AND "deletedAt" IS NULL, added in migration
/// 20260831120000. It is the reconciliation key — without it a regeneration
/// mints a duplicate of a question the user may already have answered.
/// Documented here because a shadow-database diff can read it as drift and
/// try to DROP it.
model PublishingTopicDecisionEntry {
  id             String                      @id @default(cuid())
  topicId        String
  projectId      String
  organizationId String?
  userId         String?
  parentId       String?
  authorType     DecisionAuthorType
  authorUserId   String?
  status         DecisionStatus              @default(OPEN)
  kind           PublishingDecisionEntryKind @default(QUESTION)
  questionId     String?
  /// The question's CATEGORY (`CUSTOMER_NAME`, `ASSET_APPROVAL`, …). Stored
  /// rather than re-read from the analysis, because a question answered against
  /// version 1 must still render its own grouping after version 2 supersedes
  /// that analysis.
  decisionKind   String?
  subject        String?
  summary        String?                     @db.Text
  content        String?                     @db.Text
  recommendedResponse String?                @db.Text
  /// The rationale behind the question — why the decision matters, not what
  /// it is. Carried from the analysis's own `whyItMatters` field so a reader
  /// on the Summary & Questions tab sees why to bother, not just what to
  /// answer.
  whyItMatters   String?                     @db.Text
  answerSource   AnswerSource?
  analysisVersion Int?
  deletedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  topic        PublishingTopic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  project      Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       PublishingTopicDecisionEntry?  @relation("PublishingTopicDecisionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      PublishingTopicDecisionEntry[] @relation("PublishingTopicDecisionReplies")
  organization Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  author       User?                          @relation("PublishingTopicDecisionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([topicId, createdAt])
  @@index([parentId])
  @@index([organizationId])
  @@index([userId])
  @@map("publishing_topic_decision_entry")
}

/// Per-user read marker for a publishing topic (1D, Fizzy #2265).
///
/// Row present = this user has read this topic. Marking unread DELETES the row.
/// There is deliberately no boolean and no nullable readAt: absence already
/// means unread, and a second representation is a second thing to get wrong.
/// Mirrors DailyBriefView, including its per_user_within_org RLS policy.
///
/// Read state lives HERE and not on PublishingTopic because a column there
/// would bump PublishingTopic.updatedAt on every open, silently reordering the
/// "Recently Modified" section that FR2 defines by last-modified date.
model PublishingTopicRead {
  id             String   @id @default(cuid())
  topicId        String
  userId         String
  projectId      String // denormalized from the parent topic, never from ambient context
  organizationId String? // denormalized from the parent topic; null in personal context
  readAt         DateTime @default(now())

  topic        PublishingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId, projectId])
  @@index([organizationId])
  @@map("publishing_topic_read")
}

// PublishingSuiteSettings — per-project Publishing Suite configuration (1:1 with Project).
// Phase 1C-1: cadence + lookback + notification kill switch. Recommendation
// preferences land in 1C-1b together with the prompt clause that consumes them.
model PublishingSuiteSettings {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  organizationId       String? // denormalized from parent Project
  userId               String? // denormalized from parent Project
  cadence              String   @default("MANUAL") // MANUAL | WEEKLY | BIWEEKLY | MONTHLY
  lookbackDays         Int? // null => engine default (180); else 1..365
  notificationsEnabled Boolean  @default(true) // project-level kill switch (1C-2)
  chatChannels         Json? // 1C-3: PublishingChatChannel[] — selected broadcast targets. NULL or [] means chat is off; there is deliberately no separate boolean, because a second switch could disagree with the selection.

  // 1C-1b (§7.1(a), FR8–FR10): the ADVISORY recommendation preferences. They
  // shape generation through a prompt clause and are hashed into
  // PublishingSuggestionCycle.preferencesHash, so an edit here buys the project
  // exactly one reprocessing run.
  //
  // Lists are NOT nullable: `[]` is the only "none", and a second empty
  // representation is a second thing to get wrong — the same argument
  // chatChannels makes above about a redundant boolean.
  //
  // `excludedKeywords` is deliberately ABSENT. It is an ENFORCEMENT control and
  // lands together with the deterministic filter that honours it; a stored
  // exclusion with no filter is a switch that visibly does nothing.
  preferredThemes      String[]                  @default([])
  // The CLOSED enum, the same one PublishingTopic.suggestedPostTypes stores.
  // Free-form text here would accept a preference the generator can never emit,
  // because what it produces is validated against this very enum.
  preferredPostTypes   PublishingTopicPostType[] @default([])
  strategicPriorities  String? // null => no guidance. Free text; line structure is part of the instruction, so it is trimmed but never reflowed.

  createdByUserId      String // acting admin; NOT a tenant column, re-homed on every save
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("publishing_suite_settings")
}

// PublishingNotificationDelivery — per-recipient, per-channel delivery ledger (§5.2). Shaped on
// NewsletterChatDelivery. The unique (cycleId, recipientUserId, channel) is the dedupe key AND,
// for IN_APP, the fence: the ledger row and the Notification row commit in one transaction, so
// two overlapping attempts cannot both write.
//
// recipientUserId is the human being notified. It is NOT a tenant column: organizationId/userId
// keep their usual meaning here (denormalized from the parent Project, XOR, CHECK-enforced), and
// folding the recipient into userId would both break the XOR in organization context and hand the
// user_owned RLS policy a column it ignores.
model PublishingNotificationDelivery {
  id              String    @id @default(cuid())
  cycleId         String
  projectId       String
  organizationId  String? // denormalized from parent Project (XOR with userId)
  userId          String? // denormalized from parent Project (XOR with organizationId)
  recipientUserId String // the human being notified — NOT a tenant column
  channel         String // IN_APP | EMAIL. Free String, not an enum, and the reason has CHANGED: it was written expecting 1C-3 to add CHAT here, and 1C-3 does not — a broadcast has no recipient, so it lives in publishing_chat_delivery. The column stays a free String because a future ADDRESSED channel would legitimately belong here, and publishing_notification_delivery_leased_channel is what keeps the three status-only readers correct if one arrives.
  status          String // SENT | FAILED | SKIPPED | SENDING | DEFERRED | EXPIRED. Enforced by publishing_notification_delivery_status_check alone — this model has no Prisma enum, so a value the CHECK admits is a value the type system will not stop.
  reason          String? // skip/failure classification, never a raw provider body
  errorMessage    String?   @db.Text
  createdAt       DateTime  @default(now())
  claimedAt       DateTime? // 1C-2c. Lease start; null = unclaimed. The EMAIL fence (§3.2). IN_APP never sets it.
  claimToken      String? // 1C-2c. Globally unique per claim attempt — NOT an attempt number: 1C-2d's reconciler claims the same rows from a different activity (§11.3).
  lastAttemptAt   DateTime? // 1C-2c. When a message was last handed to the provider. Set with every claim and NEVER cleared — claimedAt is released on a known failure so a retry can recover, so it cannot answer "how long ago might the provider have accepted something".
  deliveredAt     DateTime?
  expiresAt       DateTime? // 1C-2d. Deferral deadline, carrying two guarantees of DIFFERENT strength — the difference is what this comment is for. ENFORCED, by publishing_notification_delivery_deferred_shape: non-null on DEFERRED, and on no other status. CONVENTION, held by the writers and by no constraint: stamped once when the row enters the deferral lifecycle and never touched again, because a crash-recovered SENDING row returns to DEFERRED without restamping and the sweep's (expiresAt, id) keyset cursor breaks if it moves. Hence the asymmetry when reading a NON-DEFERRED row: a non-null value tells you the row passed through the lifecycle, a null does NOT tell you it did not — no constraint stops a future writer clearing it on EXPIRED, so "null means never deferred" is an inference the database will not defend.
  attemptCount    Int       @default(0) // 1C-2d. Incremented inside the claim's conditional UPDATE, never read-then-written. Bound is 5, matching the persist proxy's maximumAttempts.

  cycle     PublishingSuggestionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  recipient User                      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([cycleId, recipientUserId, channel], map: "publishing_notification_delivery_cycle_recipient_channel_key")
  @@index([projectId, createdAt])
  // Two partial indexes live in SQL only (1C-2d-1b) and deliberately have no @@index counterpart,
  // which would generate a non-partial duplicate:
  //   publishing_notification_delivery_deferred_drain_idx  ("expiresAt","id") WHERE status='DEFERRED'
  //   publishing_notification_delivery_sending_lease_idx   ("claimedAt")      WHERE status='SENDING'
  @@map("publishing_notification_delivery")
}

// PublishingChatDelivery — per-CHANNEL broadcast ledger (1C-3). The chat analog of
// PublishingNotificationDelivery, and a separate table rather than a third `channel` value on it,
// because that ledger keys on (cycleId, recipientUserId, channel) with recipientUserId NOT NULL:
// it addresses a PERSON, and a broadcast addresses a ROOM. Shaped on NewsletterChatDelivery, which
// is the same kind of ledger for the same reason.
//
// The unique (cycleId, platform, externalTeamId, channelId) is the claim-before-post key: exactly
// once per channel across retries. There is no DEFERRED and no EXPIRED here and there will not be —
// chat has no deferral, no lease reclaim and no drain.
//
// Do not read that as "a transient gets retried" — this comment used to say so and it was wrong.
// A provider failure is caught, settled FAILED, and the target's handler returns normally, so the
// activity never rejects and its retry policy is never engaged; and a FAILED row is a pre-existing
// row, which this very key refuses the claim on. The fence that stops a retry double-posting is
// the same fence that stops it re-sending. ONE attempt per channel per cycle, by design: a missed
// room is a smaller harm than a duplicate in a room, and there is no addressee left waiting.
model PublishingChatDelivery {
  id              String    @id @default(cuid())
  cycleId         String
  projectId       String
  organizationId  String? // denormalized from parent Project (XOR with userId)
  userId          String? // denormalized from parent Project (XOR with organizationId)
  platform        String // TEAMS | SLACK
  externalTeamId  String // Teams teamId / Slack slackTeamId
  channelId       String
  status          String // SENDING | SENT | FAILED | SKIPPED. Enforced by publishing_chat_delivery_status_check alone — no Prisma enum, so a value the CHECK admits is a value the type system will not stop.
  reason          String? // skip/failure classification, never a raw provider body
  errorMessage    String?   @db.Text
  postedMessageId String? // provider message id on success (Teams messageId / Slack ts)
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?

  cycle PublishingSuggestionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, platform, externalTeamId, channelId], map: "publishing_chat_delivery_cycle_channel_key")
  @@index([projectId, createdAt])
  @@map("publishing_chat_delivery")
}

model TestCase {
  id               String           @id @default(cuid())
  projectId        String
  organizationId   String?
  userId           String?
  identifier       String // "TC-001" — per-project sequence
  title            String
  description      String?          @db.Text // preconditions / summary
  state            TestCaseState    @default(DRAFT)
  priority         TestCasePriority @default(MEDIUM)
  ownerId          String?
  tags             String[]         @default([])
  automationStatus AutomationStatus @default(NOT_AUTOMATED) // forward hook, no runner
  order            Float            @default(0) // fractional list ordering
  createdById      String

  // Automation link — which automated test covers this case. `automationRef` is
  // the identifier the team links by (a test()/.describe name, or a fully
  // qualified test id); it is what makes a case count as automated in the
  // coverage stat, since automationStatus alone is a settable intent.
  automationRef         String? @db.Text
  automationFilePath    String? @db.Text // spec file path, repo-relative
  automationExternalUrl String? // CI / report deep link
  playwrightScript      String? @db.Text

  /// Which level of the test pyramid this case sits at.
  /// Null = nobody has said; see QaCoverageType for why that is not defaulted.
  coverageType QaCoverageType?

  // --- Keeping a case honest as its feature changes -------------------------
  //
  // "Test case updates adjusted to the actually implemented flows." A case
  // drafted from an acceptance criterion goes stale the moment that criterion is
  // rewritten, and nothing said so: the suite kept asserting a flow the product
  // no longer had, which is worse than no coverage because it reads as coverage.

  /// Fingerprint of the feature text this case was drafted from.
  ///
  /// Compared against the feature's CURRENT fingerprint to spot drift. A hash
  /// rather than a timestamp on purpose: a feature saved twice with no textual
  /// change must not make every case it covers look stale, or the signal becomes
  /// noise people learn to dismiss. Null for cases authored by hand, which were
  /// never derived from the text and so cannot drift from it.
  draftedFromSpecHash String?

  /// AI-proposed replacement steps, awaiting a human's Accept or Reject.
  ///
  /// Held on the case rather than in a table of its own: there is at most one
  /// outstanding proposal per case, it is meaningless without the case, and the
  /// review gate it needs already exists for PROPOSED cases. A second model here
  /// would be a parallel lifecycle to keep in step for no gain.
  proposedSteps Json?

  /// When the proposal was generated, so a reader can see it predates their most
  /// recent edit and judge it accordingly.
  proposedAt DateTime?

  /// What the outstanding proposal was checked against.
  ///
  /// Decides whether accepting it also stamps `draftedFromSpecHash`. A proposal
  /// derived from the SPEC brings the case back in line with the feature text,
  /// so accepting it clears the drift. One derived from the IMPLEMENTATION read
  /// a pull request instead and says nothing about the spec — a case can
  /// honestly be both revised-from-implementation and still spec-drifted, and
  /// stamping it would hide that.
  ///
  /// Null for proposals written before this column existed; those were all
  /// spec-derived, which is what the accept path treats null as.
  proposedFrom TestCaseProposalSource?

  // Denormalized current run result — always mirrors the newest non-superseded
  // TestResultEvent; kept in sync on every result write (fast list render).
  currentResult  TestResult    @default(NOT_RUN)
  lastRunAt      DateTime?
  lastRunSource  ResultSource?
  lastRunByLabel String?

  // PM sync (mirror UserStory subset)
  externalId          String?
  externalUrl         String?
  externalMcpServerId String?
  pmAutoSyncEnabled   Boolean       @default(false)
  lastSyncedPmHash    String?
  lastSyncedAt        DateTime?
  lastPmSyncStatus    PmSyncStatus?
  lastPmSyncError     String?       @db.VarChar(500)
  lastPmSyncAttemptAt DateTime?

  // AI context (mirror ArchitectureDecision.contextId)
  contextId String? // soft pointer to ProjectContext row

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps           TestCaseStep[]
  planLinks       TestPlanCase[]
  workItemLinks   TestCaseWorkItemLink[]
  resultEvents    TestResultEvent[]
  activityEvents  TestCaseActivity[]
  scriptRevisions TestCaseScriptRevision[]
  findings        TestFinding[]

  @@unique([projectId, identifier])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([projectId, state])
  @@index([projectId, deletedAt])
  @@index([externalMcpServerId])
  // Pipeline-result ingestion matches an incoming test to a case by
  // its automation ref (the hybrid cascade resolves tag/file+name/title to this).
  @@index([projectId, automationRef])
  @@map("test_case")
}

model TestCaseStep {
  id           String   @id @default(cuid())
  testCaseId   String
  order        Float    @default(0)
  action       String   @db.Text
  expected     String   @db.Text
  data         Json? // parameter hook (unused v1)
  sharedStepId String? // shared-step hook (unused v1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_step")
}

model TestPlan {
  id             String        @id @default(cuid())
  projectId      String
  organizationId String?
  userId         String?
  identifier     String // "TP-001"
  name           String
  description    String?       @db.Text
  state          TestPlanState @default(ACTIVE)
  order          Float         @default(0)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseLinks    TestPlanCase[]
  resultEvents TestResultEvent[]

  @@unique([projectId, identifier])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([projectId, deletedAt])
  @@map("test_plan")
}

model TestPlanCase {
  id         String   @id @default(cuid())
  planId     String
  testCaseId String
  order      Float    @default(0)
  section    String?
  createdAt  DateTime @default(now())

  plan     TestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([planId, testCaseId])
  @@index([planId])
  @@index([testCaseId])
  @@map("test_plan_case")
}

model TestCaseWorkItemLink {
  id                      String   @id @default(cuid())
  testCaseId              String
  userStoryId             String
  /// Which acceptance criteria this case covers on the linked work item.
  ///
  /// A LIST because a case routinely proves more than one criterion, and the
  /// traceability matrix has to count it under each. It was a single nullable
  /// ref until 2026-07-31, which forced whoever authored the case to pick one
  /// criterion and silently under-report the rest.
  ///
  /// Free text by design (`AC 3`, `3`, `criterion 2`) — the criteria themselves
  /// live in one markdown blob with no addressable identity, so a reference is
  /// resolved by counting rather than by key. Empty means the case names no
  /// criterion at all, which the matrix reports differently from a reference it
  /// cannot place (see `qa-traceability.ts`).
  acceptanceCriterionRefs String[]

  /// DEAD — awaiting its contract migration. Superseded by
  /// `acceptanceCriterionRefs` on 2026-07-31 and read by nothing; it remains
  /// only because dropping a column in the same release that stops reading it
  /// breaks every instance still running the previous version mid-rollout.
  /// Drop it in a follow-up once this release is out. Do not write to it.
  acceptanceCriterionRef String?
  linkType               String   @default("TESTS")
  createdAt              DateTime @default(now())

  testCase  TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  userStory UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, userStoryId])
  @@index([testCaseId])
  @@index([userStoryId])
  @@map("test_case_work_item_link")
}

// Append-only history of test-case run results. One row per result change
// (manual mark or PM-sync ingest). TestCase.currentResult denormalizes the
// newest row for fast list render; rows here are never deleted (reset appends
// a NOT_RUN event). Child of TestCase (no tenant columns) — tenant isolation
// flows through the parent, enforced by a parent-scoped RLS policy.
model TestResultEvent {
  id               String       @id @default(cuid())
  testCaseId       String
  result           TestResult
  source           ResultSource
  occurredAt       DateTime     @default(now())
  changedByUserId  String? // Fabric user who set the result (null for PM_SYNC)
  actorLabel       String? // e.g. "Azure DevOps · run 4821" for PM_SYNC provenance
  testPlanId       String? // the plan run this result belongs to (null = ad-hoc)
  pipelineRunId    String? // the CI/pipeline run this result came from (null = manual/PM)
  externalRunRef   String? // PM run id
  externalRunUrl   String? // PM run link
  scriptRevisionId String? // exact Mode B script snapshot used for this result
  note             String?
  createdAt        DateTime     @default(now())

  testCase      TestCase             @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  changedByUser User?                @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  testPlan      TestPlan?            @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  pipelineRun   TestPipelineRun?     @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  agenticSteps  TestAgenticStepLog[]

  @@index([testCaseId, occurredAt])
  @@index([testPlanId])
  @@index([pipelineRunId])
  @@map("test_result_event")
}

// One ingested CI / automated-test run. Groups the per-case
// TestResultEvent rows it produced and carries the run-level metadata the QA tab
// shows (provider, pipeline, branch, commit, counts). Top-level tenant table with
// the same XOR (personal vs org) shape as TestCase; soft-deleted so a project
// purge is reversible. RLS: `user_owned` policy (see apply-rls-direct.ts).
model TestPipelineRun {
  id                        String    @id @default(cuid())
  projectId                 String
  organizationId            String? // XOR with a personal owner — never both (see tenant pattern)
  userId                    String?
  provider                  String // "azure-devops" | "github-actions" | "gitlab-ci" | "jira-xray" | ...
  externalRunId             String // the provider's run/build id (dedup key with provider)
  pipelineName              String? // workflow / pipeline / test-run name
  branch                    String?
  commitSha                 String?
  runUrl                    String? // deep link to the run in the provider
  status                    String? // raw provider run status (informational; normalized per-case)
  startedAt                 DateTime?
  finishedAt                DateTime?
  durationMs                Int?
  totalCount                Int       @default(0)
  passedCount               Int       @default(0)
  failedCount               Int       @default(0)
  skippedCount              Int       @default(0)
  otherCount                Int       @default(0) // blocked/aborted/inconclusive/etc.
  // Who triggered the run on the provider (a person). GitHub triggering_actor,
  // GitLab pipeline user, ADO run owner. Distinct from `userId` (the Fabric
  // owner for tenant isolation). Null when the payload didn't carry it.
  triggeredByActor          String?
  triggeredByActorAvatarUrl String?
  // Full per-test breakdown for the in-portal run-detail view — the flattened
  // JUnit/native results (name, classname, mapped status, failure, duration, and
  // the matched Fabric case if the linkage cascade resolved one). Denormalized
  // JSON: the run detail renders it directly without re-joining per-test rows.
  results                   Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultEvents TestResultEvent[]
  findings     TestFinding[]
  agenticRuns  TestAgenticRun[]

  @@unique([projectId, provider, externalRunId])
  @@index([projectId, startedAt(sort: Desc)])
  @@map("test_pipeline_run")
}

// One distinct FAILURE, tracked across runs (RCA;
// "Failures & Findings"). Identity is `fingerprint` — computed by
// `fingerprintFinding` from what broke and why, deliberately not from the run id
// or timestamps — so the same broken assertion recurring nightly is ONE finding
// with a rising `occurrences`, not N identical rows nobody reads.
//
// Distinct from the RCA bug: a finding is the observation, a bug is the decision
// to act on it. Most findings never become bugs (flakes, known breakage), which
// is exactly why they need somewhere to live that is not the backlog.
//
// Top-level tenant table (XOR organizationId/userId), RLS `user_owned`.
model TestFinding {
  id             String  @id @default(cuid())
  projectId      String
  organizationId String? // XOR with a personal owner — never both
  userId         String?

  // Stable identity across runs. Unique per project: the same fault seen in two
  // projects is two findings, because they are two teams' problems.
  fingerprint    String
  testName       String
  classname      String?
  failureMessage String? @db.Text

  status      TestFindingStatus @default(OPEN)
  occurrences Int               @default(1)
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())

  // The AI failure analysis. ADVISORY ONLY: it enriches the finding
  // so a human triaging it starts from a hypothesis instead of a stack trace. It
  // never files anything — promotion stays a person's action, which is the
  // 2026-07-26 product ruling, not an implementation detail to revisit.
  suspectedCause String?          @db.Text
  suspectedKind  TestFailureKind?
  // Null until someone asks for an analysis. Re-analysing overwrites: the newest
  // occurrence is the one worth reasoning about, and a pile of stale hypotheses
  // is worse than one current one.
  analysedAt     DateTime?
  // Which model produced it. Provenance matters here more than usual — this is a
  // guess presented next to facts, and a reader deserves to know which.
  analysisModel  String?
  // What changed since this test last passed, as the analysis saw it:
  // `{ commitRange: { baseSha, headSha }, changedFiles: [{ path, reason }], truncated }`.
  //
  // Persisted because it is EVIDENCE, not workings. It was already computed and
  // put in front of the model, and a reader shown only the conclusion cannot
  // check whether the suspects were plausible — which is the whole point of an
  // advisory hypothesis.
  //
  // Written on every analysis INCLUDING when there is no diff, where it is set
  // back to null. A stale file list left sitting under a freshly written cause
  // would claim the new hypothesis was reached from a diff it never saw — the
  // exact "silently believing it had the diff" failure `resolve-failure-diff.ts`
  // is built to avoid.
  //
  // Json rather than columns: it is written, read and cleared as one unit, is
  // never queried on, and its shape is owned by `ResolvedFailureDiff`.
  analysisDiff   Json?

  // The case the linkage cascade matched, when it resolved one. Null for a
  // failure in a test Fabric tracks no case for — which is precisely the kind
  // the run-level view loses today.
  testCaseId        String?
  // The most recent run this failure appeared in, for a deep link.
  lastPipelineRunId String?
  // Set when someone promotes this finding to a tracked bug.
  promotedStoryId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  testCase        TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  lastPipelineRun TestPipelineRun? @relation(fields: [lastPipelineRunId], references: [id], onDelete: SetNull)
  promotedStory   UserStory?       @relation("TestFindingPromotedStory", fields: [promotedStoryId], references: [id], onDelete: SetNull)

  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeenAt(sort: Desc)])
  @@index([testCaseId])
  @@map("test_finding")
}

/**
 * What the analysis thinks is BEHIND a failure — the triage question a human
 * actually asks first: is this our bug, or a broken test?
 * Deliberately coarse. A finer taxonomy invites the model to express confidence
 * it does not have, and every value here changes what a person does next.
 * UNKNOWN is a first-class answer, not a failure to answer.
 */
enum TestFailureKind {
  /// The product is broken. The likeliest promote-to-bug candidate.
  PRODUCT_BUG
  /// The test is wrong, brittle, or out of date — fix the test, not the product.
  TEST_DEFECT
  /// Infrastructure, credentials, fixtures, a dependency — not the code under test.
  ENVIRONMENT
  /// Passes and fails without the code changing. Neither a bug nor a test defect yet.
  FLAKY
  /// Not enough signal to say. Better than a confident guess.
  UNKNOWN

  @@map("test_failure_kind")
}

enum TestFindingStatus {
  /// Seen in the latest run and not acted on.
  OPEN
  /// Stopped appearing — the test went green, or was removed.
  RESOLVED
  /// Turned into a tracked bug (`promotedStoryId`).
  PROMOTED
  /// A human decided it is not worth acting on (known flake, third-party).
  IGNORED

  @@map("test_finding_status")
}

// Per-(project, provider, pipeline) incremental-fetch cursor,
// mirroring ProjectScanCheckpoint. `lastFetchedAt` is the last SUCCESSFUL fetch
// and drives the "stale data" badge; the cursor (`lastRunExternalId` /
// `lastCommitSha`) advances only on success so a failed fetch never skips runs.
// Top-level tenant table (XOR), RLS `user_owned`.
model TestPipelineSyncState {
  id                String    @id @default(cuid())
  projectId         String
  organizationId    String?
  userId            String?
  provider          String
  pipelineKey       String    @default("") // provider-specific pipeline/workflow id ("" = all pipelines)
  lastRunExternalId String? // high-watermark run id (advances only on success)
  lastCommitSha     String?
  pageToken         String?   @db.Text // resumable pagination cursor
  lastFetchedAt     DateTime? // last SUCCESSFUL fetch — drives the stale badge
  status            String? // last fetch status (informational)
  lastError         String?   @db.Text
  // The provider's own response body for the last failure, kept apart from the
  // readable sentence in `lastError` so the UI can show one and reveal the other
  // on demand. Joining them produced a sentence with a JSON blob in the middle:
  // unreadable when triaging and unusable when debugging.
  lastErrorDetail   String?   @db.Text
  // The classified failure kind (see `SyncFailureKind` in
  // packages/temporal/src/activities/pipeline-results/sync-failure-classification.ts),
  // stored so a REPEAT of the identical failure state can be detected without
  // string-comparing `lastError` — a rate-limit message embeds a changing
  // reset timestamp, so two consecutive rate-limit failures would otherwise
  // never compare equal and every 15-minute cron tick would read as new.
  lastErrorKind     String?
  lastErrorAt       DateTime?
  // When the sync attempt that last wrote this row STARTED — not when it
  // committed. Both writers (`recordPipelineSyncFailure` and
  // `advancePipelineSyncState`) compare the incoming attempt's start timestamp
  // against this column inside their shared advisory-locked transaction and
  // skip the write when the stored value is strictly newer, so an older
  // attempt that hung in an HTTP call can never clobber a newer attempt's
  // result. The lock alone cannot do this: it serializes the two writes but
  // does not establish which one is newer. Nullable — rows written before this
  // column existed carry no attempt identity, and NULL is treated as
  // always-older so the first write after deploy still lands.
  lastAttemptStartedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider, pipelineKey])
  @@index([projectId])
  @@map("test_pipeline_sync_state")
}

/// One run Fabric ORCHESTRATED itself — driving a browser through a
/// Fabric-authored test case against a live environment — as opposed to a run it
/// ingested from the customer's CI, which is a `TestPipelineRun` and nothing
/// else.
///
/// **The per-case results are NOT here.** A finished agentic run writes a
/// `TestPipelineRun` (provider `fabric-agentic`) and the usual `TestResultEvent`
/// rows, so linkage, findings, RCA, per-feature scoping and the coverage rollup
/// all work on it unchanged — landing a Fabric-driven run in the existing
/// ingestion path is the whole reason none of those needed changing. This row is
/// the envelope around that: the things a dispatched run has and an ingested one
/// cannot — which environment it pointed at, what it was allowed to cost, why it
/// was refused, and which workflow is driving it.
///
/// It also has to exist BEFORE any result does. A `TestPipelineRun` is created at
/// ingestion, i.e. at the end; a dispatch needs a row the moment someone presses
/// the button so the UI has something to show while it is QUEUED.
///
/// Top-level tenant table (XOR organizationId/userId), RLS `user_owned`.
model TestAgenticRun {
  id             String  @id @default(cuid())
  projectId      String
  organizationId String? // XOR with a personal owner — never both
  userId         String?

  status     AgenticRunStatus @default(QUEUED)
  runMode    QaRunMode        @default(MODE_A)
  /// Temporal workflow driving this run. Null until dispatch succeeds; the
  /// handle a cancel needs.
  workflowId String?

  // --- Where it ran -------------------------------------------------------
  //
  // Snapshotted, not just referenced. `environmentId` is a soft pointer (the
  // environment can be edited or deleted), but "which URL did this run actually
  // hit, and was that production" must stay answerable for a run recorded a year
  // ago. A history that silently re-points when someone fixes a typo in an
  // environment's URL is not a history.
  environmentId   String?
  targetBaseUrl   String
  environmentType ProjectEnvironmentType

  // --- What it was allowed to do ------------------------------------------
  //
  // The cost guard REFUSES rather than warns (product ruling, 2026-07-26): an
  // estimate above the cap never dispatches, and the run is stored REFUSED with
  // the numbers that made the decision so it can be argued with.
  estimatedCostUsd Decimal  @db.Decimal(10, 4)
  costCapUsd       Decimal  @db.Decimal(10, 4)
  /// Billed after the fact. Null while running — an in-flight run has no total.
  actualCostUsd    Decimal? @db.Decimal(10, 4)

  /// Playwright context options, snapshotted from the QA policy at dispatch so a
  /// later settings edit cannot rewrite what this run did.
  browser    String
  resolution String

  caseCount        Int @default(0)
  passedCount      Int @default(0)
  failedCount      Int @default(0)
  /// Cases the runner could not attempt at all (no steps, navigation dead).
  blockedCount     Int @default(0)
  /// Cases the model judged but not confidently enough to record the verdict,
  /// under this project's confidence threshold. Counted apart from every other
  /// bucket because the software was exercised and nothing is known about the
  /// outcome — folding these into passed or failed is exactly the false verdict
  /// the threshold exists to prevent.
  needsReviewCount Int @default(0)

  /// Why a REFUSED run never started, in the words the user is shown. Null for
  /// every other status.
  refusalReason String? @db.Text

  /// The ingested-shape run this produced, once there are results to group.
  /// Null while QUEUED/RUNNING and for a REFUSED run, which never has any.
  pipelineRunId String?

  triggeredByUserId String?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelineRun     TestPipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  triggeredByUser User?            @relation("TestAgenticRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  caseResults TestAgenticCaseResult[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@map("test_agentic_run")
}

/// A saved, reusable configuration for a Fabric-orchestrated run.
///
/// The QA policy already carries the project's DEFAULTS (environment, browsers,
/// resolutions). This is a named override of them — "Nightly regression on
/// Firefox", "Smoke on staging" — so a team that runs the same shaped run
/// repeatedly does not re-pick it every time.
///
/// Deliberately NOT a copy of the case list. A configuration says HOW a run
/// executes, never WHICH cases: a saved selection would go stale the moment
/// somebody adds a case, and would quietly stop covering new work while still
/// looking like a regression suite.
model TestRunConfiguration {
  id        String @id @default(cuid())
  projectId String

  name String

  /// Seeded rather than authored by the customer. A SYSTEM row is offered in
  /// every project and cannot be deleted, so there is always at least one
  /// configuration to run and the picker is never empty.
  isSystem Boolean   @default(false)
  runMode  QaRunMode @default(MODE_A)

  /// Deployment target for runs started from this configuration. NOT a foreign
  /// key, matching `ProjectQaSettings.defaultEnvironmentId`: an environment is
  /// edited independently and a deleted one must degrade to "use the project
  /// default", not cascade-delete the configuration.
  environmentId String?

  /// Playwright context options. Null means "use the project's QA policy",
  /// which keeps a configuration meaningful after the policy changes rather
  /// than freezing a copy of it.
  browser    String?
  resolution String?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One name per project — a picker with two "Nightly regression" entries is
  /// a picker nobody can use.
  @@unique([projectId, name])
  @@index([projectId])
  @@map("test_run_configuration")
}

/// One case's outcome inside a Fabric-dispatched run, STAGED while the run is
/// still going (durable batching).
///
/// ## Why this table has to exist
///
/// A run's real home is `TestResultEvent` + `TestAgenticStepLog`, and both are
/// created by `ingestPipelineRun` — which creates ONE pipeline run per
/// `(projectId, provider, externalRunId)` and is idempotent on it. Calling it
/// per batch would make every batch after the first either a no-op or a
/// delete-and-recreate, destroying the earlier batches. So batches cannot write
/// there, and until the final ingest there is nowhere else for their detail to
/// live.
///
/// These rows are that "nowhere else": written as each batch finishes, drained
/// into the ordinary ingestion path by a single reconciling ingest when the last
/// batch completes, and then no longer the source of truth for anything.
///
/// `steps` is JSON on purpose. This is a staging area whose shape is dictated by
/// the activity that produces it, not a surface anything queries by step — the
/// queryable form is `TestAgenticStepLog`, created at the end.
model TestAgenticCaseResult {
  id         String @id @default(cuid())
  runId      String
  testCaseId String

  /// PASSED | FAILED | BLOCKED | NEEDS_REVIEW — the case-level verdict.
  ///
  /// A string rather than the step enum because a case verdict and a step status
  /// are not the same vocabulary — a case is never SKIPPED mid-flight the way a
  /// step is.
  result           String
  failureMessage   String? @db.Text
  durationMs       Int     @default(0)
  /// Model calls this case actually spent, so the run can bill what it used.
  modelCalls       Int     @default(0)
  scriptRevisionId String?
  /// Human-readable label (e.g. `TC-001 Sign in works`), carried so the final
  /// ingest can name results and findings without re-reading the cases.
  label            String?

  /// The step log exactly as `runAgenticCase` produced it.
  steps Json

  // Tenant isolation (copied from the parent run, which copies it from the
  // project). Denormalized like `test_agentic_run` so the same `user_owned` RLS
  // policy applies rather than needing a parent walk.
  projectId      String
  organizationId String?
  userId         String?

  createdAt DateTime @default(now())

  run          TestAgenticRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per case per run. Makes a batch write idempotent under Temporal's
  /// activity retry, which would otherwise double-count a case whose write
  /// succeeded and whose acknowledgement was lost.
  @@unique([runId, testCaseId])
  @@index([runId])
  @@map("test_agentic_case_result")
}

/// Every screenshot a run has stored, so the retention sweep can find it.
///
/// ## Why this table has to exist
///
/// Nothing deleted run evidence before it: storage grew without bound, and
/// deleting a run, a case or a project left its objects behind for good.
///
/// The obvious fix — walk the step log and delete what it points at — cannot
/// work, for two reasons that only show up when you look:
///
///  1. **An evidence key names no run.** It is
///     `{tenant}/qa-runs/{projectId}/{testCaseId}/step-{n}-{ms}.png`, so every run
///     of the same case writes under one prefix, separable only by a millisecond
///     suffix. Listing by prefix gives you "this case, every run it ever had".
///  2. **The only pointer dies with its owner.** `TestAgenticStepLog.evidenceKey`
///     hangs off `TestResultEvent`, which cascades from `TestCase`, which cascades
///     from `Project`. When a project is permanently deleted, Postgres removes
///     every row naming those objects — and no application code runs, so nothing
///     deletes the objects themselves. The pointer disappears; the data does not.
///
/// ## Why it has NO foreign keys
///
/// Not an oversight — the entire point. A relation to `Project`, `TestCase` or
/// `TestAgenticRun` would cascade this row away and recreate the orphan it exists
/// to prevent. `organizationId` and `userId` are plain columns for the same
/// reason: they carry the RLS predicate, and an FK to `Organization` would delete
/// the ledger the moment an organization was removed.
///
/// The tenant columns are still the isolation boundary — `user_owned` RLS
/// compares values, and has no interest in whether the referenced row survives.
///
/// ## Retention is a window, not a cascade (product ruling, 2026-07-31)
///
/// Evidence outlives its run, its case and its project, and expires on
/// `ProjectQaSettings.evidenceRetentionDays` instead. Deleting a test case should
/// not erase the proof of what it once did, and an auditor asking "what did this
/// run actually show" must not be answered by whether somebody has since tidied
/// up the case.
model TestRunEvidence {
  id String @id @default(cuid())

  /// Bucket and key of the stored object. Unique: one ledger row per object, so
  /// a retried activity cannot register the same screenshot twice.
  bucket     String
  storageKey String @unique

  /// Plain columns, deliberately not relations — see the note above. They exist
  /// to trace an object back to what produced it, and to resolve the owning
  /// project's retention window, not to enforce referential integrity.
  projectId  String
  runId      String
  testCaseId String
  stepOrder  Int

  organizationId String? // XOR with a personal owner — never both
  userId         String?

  /// When the screenshot was taken. The sweep's whole predicate.
  capturedAt DateTime @default(now())

  /// Ordered so the sweep can page a project's expired rows on one index.
  @@index([projectId, capturedAt])
  @@index([capturedAt])
  @@map("test_run_evidence")
}

/// One step of one case inside an agentic run — so that every step of a run is
/// logged and readable from the test case it belongs to.
///
/// Hangs off `TestResultEvent`, NOT off a parallel per-case model. The per-case
/// verdict of a run already has a home that every QA surface renders; giving the
/// steps a second one would mean two answers to "how did this case do".
///
/// `action` and `expected` are COPIED from the `TestCaseStep` as it read at run
/// time rather than referenced. A case edited after a run must not retroactively
/// change what the runner was asked to do — that is the same reasoning as the
/// URL snapshot above, and it is why this table can outlive a deleted step.
///
/// No tenant columns: inherits access from `test_result_event` → `test_case`
/// (RLS EXISTS-through, cascade delete), the same shape `test_case_activity` uses.
model TestAgenticStepLog {
  id                String @id @default(cuid())
  testResultEventId String
  order             Float  @default(0)

  action   String @db.Text
  expected String @db.Text

  status AgenticStepStatus

  /// What the runner observed — the sentence a human reads to understand why the
  /// verdict is what it is. Never contains the credential: the sign-in step
  /// records that it signed in, never what with.
  observation String? @db.Text

  /// R2 object key for this step's screenshot, subject to the project's
  /// `evidencePolicy`. A key, not a URL: links are minted signed and short-lived
  /// at read time, so a stored one would be a leak with an expiry date.
  evidenceKey String?

  createdAt DateTime @default(now())

  resultEvent TestResultEvent @relation(fields: [testResultEventId], references: [id], onDelete: Cascade)

  @@index([testResultEventId, order])
  @@map("test_agentic_step_log")
}

/// Append-only versions of a test case's reusable Mode B script.
///
/// A row stores the complete post-change script. This makes any revision
/// independently restorable and keeps diff generation a read-only UI concern.
/// Author display values are snapshots so deleting a user cannot erase who made
/// an old change. Source-run and restored-revision ids are soft references:
/// provenance remains readable even if an old result or revision is later
/// removed with its parent case.
model TestCaseScriptRevision {
  id         String @id @default(cuid())
  projectId  String
  testCaseId String

  script String                       @db.Text
  origin TestCaseScriptRevisionOrigin

  authoredByUserId    String?
  authorNameSnapshot  String?
  authorEmailSnapshot String?

  sourceResultEventId    String?
  restoredFromRevisionId String?
  createdAt              DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("test_case_script_revision")
}

enum TestCaseScriptRevisionOrigin {
  MANUAL
  AGENT_RUN_AND_REPO
  REPO_ONLY
  REVERT

  @@map("test_case_script_revision_origin")
}

enum QaRunMode {
  MODE_A
  MODE_B

  @@map("qa_run_mode")
}

/// Lifecycle of a Fabric-dispatched run.
enum AgenticRunStatus {
  /// Accepted and handed to Temporal; no browser open yet.
  QUEUED
  RUNNING
  /// Every case reached a verdict and none failed.
  PASSED
  /// At least one case failed. The run itself completed — this is a verdict
  /// about the software, not about the runner.
  FAILED
  /// The run completed but at least one case could never be attempted (sign-in
  /// failed, the page never loaded, the model was unreachable) and none failed.
  /// Distinct from PASSED because a blocked case reached no verdict, and from
  /// FAILED because the product never disagreed with anything — the same
  /// distinction REFUSED draws, for the same reason: a green run over cases that
  /// were never tested says the opposite of what happened.
  BLOCKED
  /// A human stopped it, or the workflow died.
  CANCELLED
  /// Never dispatched. The cost guard refused it, or there was no usable
  /// credential. Distinct from FAILED on purpose: nothing was tested, so
  /// reading it as a red test result would be a lie.
  REFUSED
  /// The run completed, nothing failed, and at least one case was judged with
  /// less certainty than this project's confidence threshold demands.
  ///
  /// Ranks below FAILED and BLOCKED: a run holding a real failure is a failed
  /// run whatever else it holds, and a case that never ran outranks one that ran
  /// inconclusively. It ranks above PASSED for the reason the threshold exists —
  /// a green run over a verdict nobody trusts is the claim the setting is there
  /// to stop.
  NEEDS_REVIEW

  @@map("agentic_run_status")
}

enum AgenticStepStatus {
  /// The expectation held.
  PASSED
  /// The expectation did not hold — the step ran and the product disagreed.
  FAILED
  /// The step could not be attempted (the page never loaded, the element was
  /// never reachable). Not the same as FAILED: nothing was actually checked.
  BLOCKED
  /// Never reached, because an earlier step in the same case ended it.
  SKIPPED
  /// The step ran and the model judged it, but reported less confidence than the
  /// project's threshold demands — so no verdict is recorded.
  ///
  /// Not BLOCKED: the step was attempted and the page was read. Not FAILED: the
  /// product may well be fine. The only honest statement is that a person has to
  /// look.
  NEEDS_REVIEW

  @@map("agentic_step_status")
}

/// How much rigor QA applies by default when planning or running tests.
/// EASY = unit only / fast; AVERAGE = + integration, balanced; HARD = the full
/// pyramid with evidence and every sceptic role.
enum QaStrategyDepth {
  EASY
  AVERAGE
  HARD
}

/// What proof a verdict must carry before it is recorded.
enum QaEvidencePolicy {
  SCREENSHOT_REQUIRED
  OPTIONAL
  NONE
}

/// The kind of deployment target an environment points at. Drives the label and
/// keeps "which of these is production" answerable without parsing the URL.
enum ProjectEnvironmentType {
  STAGING
  QA
  PRODUCTION
}

/// How a Fabric-driven run signs in to a ProjectEnvironment.
/// NONE is the default and the only state in which no secret is stored at all.
enum EnvironmentAuthKind {
  NONE
  /// Username + password typed into a sign-in form.
  FORM
  /// `Authorization: Bearer <secret>`.
  TOKEN
  /// An arbitrary header, e.g. `X-API-Key: <secret>`.
  HEADER

  @@map("environment_auth_kind")
}

/// Per-project QA policy — the defaults every QA surface reads (rigor, the
/// confidence needed to record a verdict, coverage targets, the devices and
/// browsers to exercise, the evidence rule, and which adversarial sceptic roles
/// may append cases). One row per project; created lazily on first read so an
/// untouched project still answers with defaults.
/// Top-level tenant table (XOR with the parent Project), RLS `user_owned`.
model ProjectQaSettings {
  id        String @id @default(cuid())
  projectId String @unique

  // Strategy & depth — the default rigor for planned and dispatched runs.
  strategyDepth       QaStrategyDepth @default(AVERAGE)
  /// Which kinds of test this project requires: functional, integration, e2e,
  /// security, performance, accessibility. EMPTY means "follow the depth tier"
  /// rather than "require nothing", so a project that never opens the control
  /// keeps tracking its tier as the tier changes instead of freezing whatever
  /// the default happened to be the day this column shipped. Always read
  /// through `resolveRequiredTestTypes` in @repo/utils/qa-test-types.
  requiredTestTypes   String[]
  /// Minimum AI confidence (0–100) before a verdict is recorded.
  ///
  /// The runner asks the model how sure it is about each step it judges. A step
  /// answered below this bar records NEEDS_REVIEW instead of PASSED or FAILED,
  /// and the case and run carry that upward — the point is that an uncertain
  /// verdict is worse than no verdict, because somebody acts on it.
  ///
  /// `0` disables the gate outright. A model that does not report a confidence
  /// at all keeps its verdict rather than losing it, so a provider that ignores
  /// the field degrades to the old behaviour instead of sending every case to
  /// review; the runner logs each time that happens.
  confidenceThreshold Int             @default(80)

  // Index coverage — tracks which acceptance criteria have run tests, and the
  // target the coverage rings are measured against.
  indexCoverageEnabled Boolean @default(true)
  coverageTarget       Int     @default(80)

  /// How many distinct people must sign a feature off before it can be marked
  /// DONE. Zero — the default — disables the gate entirely, so no project that
  /// never opens this page changes behaviour.
  ///
  /// A count rather than a named-reviewer list on purpose: the requirement is
  /// "enough independent eyes", and a fixed roster would block a team the moment
  /// one named person is on leave.
  requiredQaSignOffs Int @default(0)

  /// Which PR review lenses this project runs.
  ///
  /// Both default ON, so a project that never opens the page behaves as it did
  /// before these existed. They gate the outward action, not the display: turning
  /// one off stops new runs and leaves findings already stored readable, because
  /// deleting somebody's accepted findings is not what "stop running this" means.
  ///
  /// Separate booleans rather than a list of enabled lenses: a list makes "is the
  /// QA lens on" a scan, and every consumer then has to agree on how an absent
  /// list reads.
  /// Review every pull request automatically, from GitHub's own webhook, and
  /// leave the result as a comment on it.
  ///
  /// OFF by default, and that is the whole of the design: a review appearing on
  /// somebody's pull request that nobody asked for is the failure mode that gets
  /// a bot muted, and the lenses have always been person-triggered. A team opts
  /// in per project, and the same per-lens switches below still decide which
  /// lenses run.
  prReviewAutoReviewEnabled       Boolean @default(false)

  prReviewQaLensEnabled           Boolean @default(true)
  prReviewArchitectureLensEnabled Boolean @default(true)

  /// Imports this project's architecture forbids, one rule per line:
  /// `src/ui/** -> src/db/** : the UI must not reach the database directly`.
  ///
  /// The record that makes design-pattern compliance checkable at all. Without
  /// it the lens can only report cycles, because every other "pattern" would be
  /// an assumption about a layout the customer never agreed to — which is
  /// exactly the bug that got the old layer rules withdrawn.
  ///
  /// Free text rather than a structured column on purpose: somebody writes these
  /// by hand and reads them in a diff, and `#` comments let a team group and
  /// explain their own conventions.
  architectureRules String? @db.Text

  // Devices & browsers exercised by default.
  resolutions String[] @default(["1920x1080", "1366x768"])
  browsers    String[] @default(["chromium"])

  // Rules & evidence — policy the automation is expected to enforce.
  rulesMarkdown       String?          @db.Text
  implementationNotes String?          @db.Text
  evidencePolicy      QaEvidencePolicy @default(SCREENSHOT_REQUIRED)

  /// How many days a run's captured screenshots are kept.
  ///
  /// Independent of the run, case and project rows on purpose (see
  /// `TestRunEvidence`): evidence is an audit record, so deleting a test case
  /// must not erase the proof of what it once did. A scheduled sweep deletes
  /// stored objects past this window whatever state their owner is in.
  ///
  /// `0` keeps evidence indefinitely — a real choice for a team under a retention
  /// obligation, and now an explicit one rather than the unbounded growth that
  /// came from having no sweep at all.
  evidenceRetentionDays Int @default(90)

  // Sceptic roles — AI personas that append adversarial cases during planning.
  // Stored as role keys (see `QA_SCEPTIC_ROLES`) so adding a role is data, not
  // a migration.
  scepticRolesEnabled Boolean  @default(true)
  scepticRoles        String[] @default([])

  // --- Automatic pipeline-result sync --------------------------------------
  //
  // The sweep itself stays a SINGLE deployment-wide Temporal schedule. A
  // schedule per project would need reconciling as projects come and go, which
  // is the `url-source-schedule-reconcile` problem all over again. Instead the
  // sweep keeps ticking and the ENUMERATOR honours these two fields, which makes
  // the interval a per-project FLOOR rather than a rival cadence — simpler, and
  // self-healing after an outage.

  /// When false, results arrive ONLY when somebody presses "Sync now". The
  /// manual path is never removed by turning this off.
  pipelineSyncEnabled Boolean @default(true)

  /// Minimum minutes between automatic syncs for this project.
  ///
  /// Minutes, not a cron string: a cron box invites `* * * * *` and a customer
  /// quietly DoSing their own CI provider. Constrained server-side to a closed
  /// set (see `PIPELINE_SYNC_INTERVAL_MINUTES`); the column is an Int so adding
  /// an option is a constant change rather than a migration.
  pipelineSyncIntervalMinutes Int @default(15)

  /// Default run target, referenced by `ProjectEnvironment.id`. Deliberately NOT
  /// a foreign key: environments are edited independently and a deleted target
  /// must degrade to "no default", not cascade-delete the whole QA policy. The
  /// reference is validated at the boundary when the settings are read.
  defaultEnvironmentId String?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("project_qa_settings")
}

/// One review of one pull request in a customer's connected repository.
///
/// The first phase stores what Fabric READ — the PR's identity and the diff
/// it fetched — and nothing it concluded. Findings arrive in a later phase, on
/// the existing `TestFinding` shape, so this table never grows a second findings
/// model.
///
/// The diff is stored, not re-fetched on view: a PR's diff changes as commits
/// land, and a review must be readable against the diff it actually saw. Bounded
/// at fetch time — see `PR_REVIEW_MAX_DIFF_BYTES`.
///
/// Top-level tenant table (XOR organizationId/userId), RLS `user_owned`.
model PullRequestReview {
  id        String @id @default(cuid())
  projectId String

  /// The repository integration this PR was read through, so a project with two
  /// connected repositories can tell its reviews apart. Not a foreign key: the
  /// integration may be disconnected later and the review must survive it.
  integrationId String

  provider  String // "github" — gitlab/ado land in a later phase
  repoOwner String
  repoName  String
  prNumber  Int

  title       String  @db.Text
  authorLabel String?
  headSha     String
  baseSha     String
  prUrl       String?

  /// The unified diff Fabric read, truncated to the byte cap. Null when the PR
  /// had no readable diff.
  diff          String? @db.Text
  /// True when the diff hit the cap. Surfaced so a reader knows the review saw
  /// only part of the change rather than silently trusting a partial read.
  diffTruncated Boolean @default(false)
  changedFiles  Int     @default(0)

  status      String  @default("READ") // READ | FAILED
  failureText String? @db.Text

  requestedById String

  /// When the QA lens last ran over this read, and which model produced it.
  /// Null means nobody has asked — distinct from "ran and found nothing", which
  /// is a timestamp with an empty finding set. The UI has to tell those apart or
  /// "no findings" reads as reassurance it has not earned.
  ///
  /// Per-lens columns rather than a generic bag: there are two lenses, each has
  /// its own run and its own model, and a JSON map would make "has the QA lens
  /// run" a parse instead of a query.
  /// The GitHub comment this review was posted as, so a later run edits it
  /// instead of adding a second.
  ///
  /// Stored rather than searched for. Finding it by listing the pull request's
  /// comments works until a busy pull request has more of them than one page,
  /// at which point ours falls off the end, every later run posts a new comment,
  /// and the thread fills with duplicates — which is the failure the marker was
  /// meant to prevent. An id we wrote down cannot fall off anything.
  postedCommentId BigInt?

  qaAnalysedAt    DateTime?
  qaAnalysisModel String?

  /// When the ARCHITECTURE lens last ran. No model column beside it, unlike the
  /// QA pair above, because that lens computes its findings from Atlas's import
  /// graph — there is no model to attribute, and a null column pretending
  /// otherwise would invite one.
  architectureAnalysedAt DateTime?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy  User                       @relation("PullRequestReviewRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  user         User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings     PullRequestReviewFinding[]

  /// Re-reviewing a PR replaces the previous read for that head commit rather
  /// than accumulating duplicates; a NEW commit is a genuinely new review.
  @@unique([projectId, provider, repoOwner, repoName, prNumber, headSha])
  @@index([projectId, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("pull_request_review")
}

/// One observation a review lens made about a pull request.
///
/// Deliberately NOT `TestFinding`. That model is a *failing test*: it is keyed on
/// a fingerprint derived from a test's identity, requires a `testName`, carries a
/// `failureMessage`, and its RESOLVED state means "the test went green". A PR
/// review observation has none of those — the point of "AC 3 has no case
/// covering it" is that there IS no test — and forcing it in would leave every
/// column of that model holding something other than what it is named for, with
/// the CI findings list rendering review notes beside real failures.
///
/// ADVISORY, like the CI failure analysis: a finding never files anything.
/// Accepting or dismissing one is a person's action.
model PullRequestReviewFinding {
  id             String  @id @default(cuid())
  reviewId       String
  projectId      String
  organizationId String? // XOR with a personal owner — never both
  userId         String?

  /// Which lens produced it: QA | ARCHITECTURE. A string, not an enum, because
  /// the set grows with each phase and a migration per lens buys nothing here.
  lens String

  /// HIGH | MEDIUM | LOW. Normalized in code from whatever the model returns —
  /// `generateObject` rejects `z.enum` at the gateway, so the schema takes a
  /// plain string and the mapping lives in one place.
  severity String @default("MEDIUM")

  title  String
  detail String @db.Text

  /// Where in the diff, when the model named a file it actually saw. Null rather
  /// than a guess: a finding pointing at a path the diff never contained is the
  /// fastest way to teach a reader to stop trusting the list.
  filePath String?

  /// The line in that file's NEW content the finding concerns, when one was
  /// claimed AND verified against the diff's hunks. A finding is meant to carry
  /// file AND line; a line a model invented is worse than none, so an unverifiable
  /// claim is stored as null rather than repeated to the reader.
  line Int?

  /// What to do about it, in one or two sentences.
  ///
  /// Separate from `detail` because the two answer different questions and a
  /// reader acts on only one of them: `detail` says what is wrong, this says
  /// what to change. Folding the remediation into the prose made it optional in
  /// practice — a finding could describe a gap at length and never propose a
  /// fix, and nothing could tell the two apart.
  ///
  /// Nullable for the rows written before this column existed. Every write since
  /// carries one: the QA lens drops a finding whose recommendation is empty, and
  /// the architecture lens composes its own from the violation it proved.
  recommendation String? @db.Text

  /// The feature whose acceptance criterion is uncovered, and which criterion,
  /// when the lens tied the observation to one. Both null for an observation
  /// about the change in general.
  storyId      String?
  criterionRef String?

  /// OPEN | ACCEPTED | DISMISSED. ACCEPTED records "yes, this is real" without
  /// committing to a bug; DISMISSED records that it is not worth acting on.
  status String @default("OPEN")

  /// Why it was dismissed: INCORRECT | WONT_FIX | OUT_OF_SCOPE | ALREADY_COVERED.
  ///
  /// The feature's success criterion is a FALSE-POSITIVE rate under 20%, and a
  /// dismissal rate is not that number. "Not worth acting on" covers a correct
  /// finding somebody chose not to fix, one that is out of scope, and one
  /// already covered elsewhere — none of which is the lens being wrong. Only
  /// INCORRECT is. Without this column the two were the same figure, and the
  /// docs called it the false-positive rate anyway.
  dismissalReason String?

  /// Set when someone turns this into a tracked work item.
  promotedStoryId String?

  /// Which model produced it. Provenance matters more than usual: this is a
  /// guess sitting next to a diff, and a reader deserves to know whose.
  model String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review        PullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization  Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  story         UserStory?        @relation("PrReviewFindingStory", fields: [storyId], references: [id], onDelete: SetNull)
  promotedStory UserStory?        @relation("PrReviewFindingPromotedStory", fields: [promotedStoryId], references: [id], onDelete: SetNull)

  /// Re-running a lens REPLACES its findings for that review rather than adding
  /// to them, so there is no natural key to dedupe on — see
  /// `replaceLensFindings`, which deletes and inserts in one transaction.
  @@index([reviewId, lens])
  @@index([projectId, status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("pull_request_review_finding")
}

/// A person's verdict on one review observation, kept apart from the finding row
/// it was given on.
///
/// Re-running a lens REPLACES its findings — deliberately, because they were
/// observations about a previous commit's diff. The judgements went with them,
/// which meant the accuracy figure the feature is measured by reset every time
/// anyone re-ran a lens, and the architecture lens is free to re-run. So the
/// published number could be erased by a button that costs nothing.
///
/// Keyed by a fingerprint of the observation rather than by the finding's id, so
/// re-judging the same observation updates one row instead of counting twice.
model PrReviewJudgement {
  id String @id @default(cuid())

  projectId String
  lens      String

  /// md5 of lens + file path + title, joined by the unit separator. Identifies
  /// the OBSERVATION, which survives the row it was first reported on.
  ///
  /// Deliberately carries no pull-request reference: surviving a lens re-run is
  /// the whole point. The consequence is that two textually identical findings
  /// about the same file in UNRELATED pull requests share one verdict — the
  /// accuracy figure counts them once. Accepted; see docs/qa/pr-review.md.
  fingerprint String

  /// ACCEPTED | DISMISSED. An OPEN finding is one nobody ruled on and is not
  /// recorded here at all — counting it either way would invent a verdict.
  status String

  /// See `PullRequestReviewFinding.dismissalReason`. Only INCORRECT counts
  /// towards the false-positive rate.
  dismissalReason String?

  judgedById String?

  /// Tenant columns, XOR, taken from the parent project like every other write.
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, lens, fingerprint])
  @@index([projectId, lens])
  @@index([userId])
  @@index([organizationId])
  @@map("pr_review_judgement")
}

/// One person's QA approval of one feature.
///
/// Exists so "this feature has been signed off by enough people" is a countable
/// fact rather than a convention. When `ProjectQaSettings.requiredQaSignOffs` is
/// above zero, a feature cannot be marked DONE until that many rows exist.
///
/// `@@unique([userStoryId, signedById])` is the control itself, not bookkeeping.
/// Without it "two sign-offs" is satisfiable by one person pressing the button
/// twice, which is precisely the assurance the setting is supposed to buy.
///
/// `signedById` is the approver; `userId` / `organizationId` are the tenant XOR
/// columns copied from the parent project, as on every other QA table. They are
/// different things that both happen to reference a user, which is why the
/// approver is not called `userId`.
///
/// Top-level tenant table (XOR organizationId/userId), RLS `user_owned`.
model QaSignOff {
  id          String @id @default(cuid())
  projectId   String
  userStoryId String

  /// Who approved. Not nullable: a sign-off whose approver is unknown cannot be
  /// counted towards a threshold, so there is no meaningful row without one.
  signedById    String
  /// Their display name at the time, so the record survives account deletion.
  signedByLabel String
  /// Optional context — "verified on staging against AC 3".
  note          String? @db.Text

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStory    UserStory     @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  signedBy     User          @relation("QaSignOffSignedBy", fields: [signedById], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One approval per person per feature — the control, see the doc comment.
  @@unique([userStoryId, signedById])
  /// The count read on every DONE attempt, and the feature QA tab's list.
  @@index([userStoryId, createdAt])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("qa_sign_off")
}

/// The lifecycle of a testing unknown raised during QA planning.
enum QaOpenQuestionStatus {
  OPEN
  ANSWERED
  DEFERRED
}

/// A testing unknown, tracked to resolution.
///
/// Ambiguities surfaced while planning tests ("is the 60s SLA in scope, or just
/// functional correctness?") previously lived in prose inside a QA analysis, so
/// nothing could list what was still open, who raised it, or whether it was ever
/// answered. This makes them a queryable record instead: filterable by status,
/// attributable to a person OR an AI persona, and optionally bound to the
/// feature they were raised against.
///
/// Top-level tenant table (XOR with the parent Project), RLS `user_owned`.
model QaOpenQuestion {
  id        String @id @default(cuid())
  projectId String

  /// The feature the question was raised against, when it has one. Nullable:
  /// project-wide questions ("is flow:critical the final label convention?")
  /// are exactly the kind that otherwise go unrecorded.
  userStoryId String?

  question String               @db.Text
  answer   String?              @db.Text
  status   QaOpenQuestionStatus @default(OPEN)

  /// Who raised it, as displayed — a person's name or an AI persona
  /// ("AI · Security Reviewer"). Stored as a label because the asker is often
  /// not a User row, and the UI must attribute it either way.
  askedByLabel String
  /// Set only when a human raised it, so the label survives account deletion.
  askedById    String?

  answeredById String?
  answeredAt   DateTime?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStory    UserStory?    @relation(fields: [userStoryId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The list view: a project's questions, newest first, filtered by status.
  @@index([projectId, status, createdAt])
  @@index([userStoryId])
  @@index([userId])
  @@index([organizationId])
  @@map("qa_open_question")
}

/// A deployment target for a project — the single source of truth shared by QA
/// test runs and any other project automation that needs a base URL, so an
/// environment is defined once and referenced by id everywhere else.
/// Top-level tenant table (XOR with the parent Project), RLS `user_owned`.
model ProjectEnvironment {
  id        String                 @id @default(cuid())
  projectId String
  type      ProjectEnvironmentType @default(STAGING)
  name      String
  baseUrl   String

  /// Where the sign-in FORM lives, when it is not at `baseUrl`.
  ///
  /// `baseUrl` means "where the application is". The runner's form sign-in used
  /// to navigate to it and expect the email and password fields to be right
  /// there, which quietly overloaded the field with a second meaning — and only
  /// holds for an app whose landing page IS its login page. Anything with a
  /// marketing site in front of it (or a login on a different host entirely)
  /// cannot express both in one column, and the workaround was to point
  /// `baseUrl` at the login page and lie about where the app is.
  ///
  /// Null keeps the previous behaviour exactly: sign in at `baseUrl`. When set,
  /// the runner signs in here and then navigates to `baseUrl` to run the case.
  signInUrl String?

  // --- Sign-in credentials for an on-demand run -------------------------
  //
  // How a Fabric-driven run authenticates against this environment. Encrypted
  // at rest with the same AES-256-GCM helper the repo credentials use
  // (`encryptApiKey`), never returned to the browser, and never logged — the
  // SOC 2 log-redaction work (#1864-74) is the precedent.
  //
  // Storing these for a PRODUCTION environment is permitted (a product decision
  // taken 2026-07-26: it is the customer's call). Fabric holding a credential
  // that signs in to a customer's live system is a materially different posture
  // from holding a repo read token, and the code should not pretend otherwise.
  //
  // The oRPC procedure that writes or uses one MUST warn and audit — the queries
  // themselves have no actor and therefore cannot. That is stated as an
  // obligation rather than a fact on purpose: an earlier version of this comment
  // asserted the auditing already happened, which was untrue.
  authKind            EnvironmentAuthKind @default(NONE)
  /// Username / email for FORM auth. Not secret on its own, so not encrypted.
  authUsername        String?
  /// Encrypted: the password (FORM), bearer token (TOKEN) or header value (HEADER).
  encryptedAuthSecret String?
  /// Header name for HEADER auth, e.g. "X-API-Key". Meaningless without the secret.
  authHeaderName      String?
  /// When the secret was last written — surfaced so a stale credential is visible
  /// without ever revealing the value.
  authUpdatedAt       DateTime?

  // Tenant isolation (copied from parent Project)
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@map("project_environment")
}

model ProjectQaWebhook {
  id        String @id @default(cuid())
  projectId String @unique

  encryptedSecret         String
  secretHint              String
  previousEncryptedSecret String?
  previousSecretRetiresAt DateTime?
  expiresAt               DateTime?
  lastDeliveryAt          DateTime?
  deliveryCount           Int       @default(0)
  lastError               String?   @db.Text
  lastErrorAt             DateTime?

  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   ProjectQaWebhookDelivery[]

  @@index([userId])
  @@index([organizationId])
  @@map("project_qa_webhook")
}

model ProjectQaWebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  provider   String
  deliveryId String
  bodyDigest String
  receivedAt DateTime @default(now())

  webhook ProjectQaWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, provider, deliveryId])
  @@unique([webhookId, provider, bodyDigest])
  @@index([webhookId, receivedAt])
  @@map("project_qa_webhook_delivery")
}

/// What kind of change a `TestCaseActivity` row records. Result runs are NOT
/// here — those live in `TestResultEvent`; the per-case Activity timeline merges
/// both. `CREATED` covers both manual and AI-drafted birth (the draft-job id is
/// carried in `metadata`, and `actorLabel` names the drafter).
enum TestCaseActivityType {
  CREATED
  STATE_CHANGED
  PRIORITY_CHANGED
  RENAMED
  STEPS_CHANGED
  AUTOMATION_CHANGED
  PM_LINK_CHANGED
}

/// Append-only edit history for one TestCase — the non-result half of the
/// per-case Activity timeline (result runs live in `TestResultEvent`).
///
/// No direct tenant columns: like `test_result_event`, it inherits access from
/// its parent `test_case` row via `testCaseId` (RLS EXISTS-through-test_case,
/// cascade delete). `actorUserId` is the Fabric user who made the change (null
/// for AI drafting / PM sync / system); `actorLabel` names the non-user actor.
/// `fromValue`/`toValue` snapshot the change (state, priority, old/new title,
/// step counts); `metadata` carries anything structured (e.g. the draft-job id
/// for an AI-created case).
model TestCaseActivity {
  id          String               @id @default(cuid())
  testCaseId  String
  type        TestCaseActivityType
  actorUserId String?
  actorLabel  String?
  fromValue   String?              @db.Text
  toValue     String?              @db.Text
  metadata    Json?
  occurredAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())

  testCase  TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([testCaseId, occurredAt])
  @@map("test_case_activity")
}

/// One historical snapshot of a feature's QA analysis. The current
/// analysis still lives on `UserStory.qaAnalysis` for fast reads; this table
/// keeps every generation so the QA tab can show and compare prior analyses.
///
/// No direct tenant columns: carries `projectId` and inherits access from the
/// parent `project` row (RLS `project_scoped`, same EXISTS shape as
/// `story_priority_change`). `content` is the full `QaAnalysisContent` at
/// generation time; `depth`/`specHash` mirror it for quick listing without
/// parsing the blob.
model QaAnalysisVersion {
  id                String   @id @default(cuid())
  userStoryId       String
  projectId         String
  depth             String
  specHash          String
  content           Json
  generatedByUserId String?
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  userStory       UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedByUser User?     @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([userStoryId, generatedAt])
  @@index([projectId])
  @@map("qa_analysis_version")
}

enum TestCaseDraftJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// One background "draft test cases with AI" run over one or more features.
///
/// This row — not the browser — is the source of truth for a run. Drafting is a
/// multi-minute chain of LLM calls, so it happens in a Temporal workflow rather
/// than on the request path: the dialog closes immediately and the run survives a
/// reload, a tab close, and a logout. A client rediscovers an in-flight run by
/// querying this table for the project, so nothing depends on the browser having
/// remembered a workflow id.
///
/// `createdCaseIds` is what makes a finished batch addressable. The run already
/// knows exactly which cases it produced, so the results view and the Cases list
/// resolve the batch from here — no denormalized batch column on every TestCase
/// row, which would carry a per-case write cost forever to serve a view that is
/// interesting for minutes.
///
/// Tenant scope mirrors TestCase: reads are gated by `projectId` (+ the caller's
/// project permission); `organizationId`/`userId` are denormalized from the
/// parent Project for RLS and cascade delete.
model TestCaseDraftJob {
  id             String  @id @default(cuid())
  projectId      String
  organizationId String? // denormalized from parent Project
  userId         String? // denormalized from parent Project
  requestedById  String // the user who started the run

  status TestCaseDraftJobStatus @default(PENDING)

  /// Features requested at start, in order. Capped by the API — a run is N LLM
  /// calls, so the bound is a spend limit, not a UI convenience.
  storyIds String[] @default([])

  totalFeatures     Int @default(0)
  processedFeatures Int @default(0)

  /// Cases this run created, across every feature. The batch's identity.
  createdCaseIds String[] @default([])

  /// Per-feature ledger: one entry per requested story, recording whether it
  /// drafted, was skipped, or failed and why. A feature failing never aborts the
  /// rest of the run, so partial success has to be reportable.
  featureOutcomes Json?

  /// Set only when the run itself could not proceed (dispatch/finalize failure).
  /// Per-feature failures live in `featureOutcomes`.
  error      String? @db.Text
  workflowId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("TestCaseDraftJobRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  // Rediscovery query: this project's runs for this requester, newest first.
  @@index([projectId, requestedById, startedAt(sort: Desc)])
  @@index([projectId, status])
  @@index([userId])
  @@index([organizationId])
  @@map("test_case_draft_job")
}

model StorySubtask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  order       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task StoryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("story_subtask")
}

// TaskWorkflowPlan - Tracks agent execution for a task (Weft-style workflow)
// One task can have multiple plans (retries), latest is the active one
model TaskWorkflowPlan {
  id             String  @id @default(cuid())
  taskId         String // StoryTask.id
  projectId      String // For easier querying
  userId         String // User who started the workflow
  organizationId String?

  // Workflow state
  status             String  @default("planning") // planning, executing, checkpoint, completed, failed, cancelled
  temporalWorkflowId String? // Temporal workflow ID for tracking

  // Agent output
  summary          String? @db.Text // Agent's summary of what it did
  steps            Json? // Array of AgentStep objects
  currentStepIndex Int? // Index of currently executing step

  // Checkpoint/approval data
  checkpointData Json? // { stepId, tool, action, data } when at checkpoint

  // Result
  result Json? // { success, artifacts, error, etc. }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         TaskWorkflowLog[]

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("task_workflow_plan")
}

// TaskWorkflowLog - Log entries for workflow execution
model TaskWorkflowLog {
  id        String   @id @default(cuid())
  planId    String
  stepId    String? // Optional link to a specific step
  timestamp DateTime @default(now())
  level     String // info, warn, error
  message   String   @db.Text
  metadata  Json? // Additional structured data

  plan TaskWorkflowPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([stepId])
  @@map("task_workflow_log")
}

model MCPServer {
  id                         String           @id @default(cuid())
  key                        String
  name                       String
  description                String?
  heroEmojis                 String[]         @default([])
  heroImageUrl               String? // AI-generated hero image URL
  defaultUrl                 String? // URL for HTTP/SSE remote servers
  command                    String? // npx command for STDIO servers (e.g., "npx @anthropic/mcp-server-fetch")
  docsUrl                    String?
  transport                  MCPTransport     @default(HTTP)
  authMethods                MCPAuthType[]
  apiKeyMethod               MCPApiKeyMethod? // Default API key method for this server (BEARER or HEADER)
  oauthDiscoveryUrl          String?
  oauthAuthorizationEndpoint String?
  oauthTokenEndpoint         String?
  dcrRegistrationEndpoint    String?
  isSystemProvided           Boolean          @default(true)
  isImplemented              Boolean          @default(false)
  // Default-enabled MCP routing (managed-default servers). When
  // `defaultEnabled` is true and `isSystemProvided` is true, the
  // auth-hook seeds a sentinel MCPConfig row per tenant and the registry
  // UI renders an "Always on" pill. `eagerKeywords`, `eagerToolName`,
  // and `suppressOnEager` drive the generalized
  // `applyDefaultMcpEagerRouting` helper in the orchestrator workflow
  // (case-insensitive substring match on the user message).
  defaultEnabled             Boolean          @default(false)
  eagerKeywords              String[]         @default([])
  eagerToolName              String?
  suppressOnEager            String[]         @default([])
  // Additional fields for public registry display (GitHub-style)
  iconUrl                    String? // URL to server icon/logo
  author                     String? // Author or organization name (e.g., "Anthropic")
  repositoryUrl              String? // GitHub repository URL
  category                   String? // Category for filtering (e.g., "Developer Tools", "Data")
  tags                       String[]         @default([]) // Tags for flexible classification (e.g., ["project-management", "issue-tracking"])
  createdById                String?
  userId                     String?
  organizationId             String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  configs                    MCPConfig[]
  oauthStates                MCPOAuthState[]
  createdBy                  User?            @relation("MCPServerCreatedBy", fields: [createdById], references: [id])
  organization               Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                       User?            @relation("MCPServerOwnerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, isSystemProvided, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  // Partial index — the set of default-enabled servers is tiny (1 today,
  // projected <= 10) so a partial-on-true makes `getDefaultEnabledMcpConfigIds`
  // and the workflow's eager-routing scan an index seek, not a sequential scan.
  @@index([defaultEnabled], map: "mcp_server_default_enabled_idx")
  @@map("mcp_server")
}

/// Singleton-row counter that increments on every write to `mcp_server`
/// (via the `mcp_server_bump_registry_version` Postgres trigger installed in
/// migration 20260523000200_add_mcp_registry_version_tracking). The MCP
/// registry Redis cache appends this counter to its key so any DB write —
/// Prisma, raw SQL migration, or hand-edit — naturally invalidates stale
/// cached system-server lists on the next request.
model McpRegistryVersion {
  id        Int      @id @default(1)
  version   BigInt   @default(1)
  updatedAt DateTime @default(now())

  @@map("mcp_registry_version")
}

model MCPConfig {
  id                                  String                        @id @default(cuid())
  mcpServerId                         String
  userId                              String?
  organizationId                      String?
  displayName                         String?
  heroEmojis                          String[]                      @default([])
  heroImageUrl                        String? // AI-generated hero image URL
  baseUrl                             String?
  commandArgs                         String[]                      @default([]) // Command line arguments for STDIO servers (e.g., organization name)
  transport                           MCPTransport?
  authType                            MCPAuthType
  apiKeyMethod                        MCPApiKeyMethod               @default(BEARER) // How API key is sent: BEARER (Authorization header) or HEADER (X-API-Key)
  oauthClientId                       String?
  encryptedOauthClientSecret          String?
  encryptedApiKey                     String?
  encryptedAccessToken                String?
  // SHA-256 hex of the plaintext access token. Lets the GitLab MCP shim resolve
  // a config from a bearer in O(1) without decrypting every row + leaking
  // timing on plaintext compare. Backfilled by `scripts/backfill-mcp-token-hash.ts`.
  accessTokenHash                     String?                       @unique
  dcrRegistrationEndpoint             String?
  dcrClientMetadata                   Json?
  dcrRegisteredAt                     DateTime?
  encryptedRefreshToken               String?
  tokenExpiresAt                      DateTime?
  scopes                              String[]
  enabled                             Boolean                       @default(true)
  // Marks the row as a system-managed sentinel for a `defaultEnabled` server
  // (e.g., the auto-seeded Excalidraw config). Read at telemetry-emission time
  // to differentiate `configSource: "managed-default" | "user-installed"`.
  isManagedDefault                    Boolean                       @default(false)
  status                              MCPStatus                     @default(HEALTHY)
  lastHealthCheckAt                   DateTime?
  consecutiveFailures                 Int                           @default(0)
  failoverUrl                         String?
  // OAuth metadata caching (RFC 8414/9728 discovery results)
  oauthMetadataCache                  Json? // Cached OAuth discovery result
  oauthMetadataCachedAt               DateTime? // When OAuth metadata was cached
  // Token refresh error tracking
  refreshFailureCount                 Int                           @default(0) // Consecutive refresh failures
  lastRefreshFailedAt                 DateTime? // When the last refresh failure occurred
  lastRefreshError                    String? // Last refresh error message
  needsReauth                         Boolean                       @default(false) // Flag to indicate re-authentication is needed
  // -----------------------------------------------------------------
  // Hybrid Atlassian Cloud OAuth 2.0 (3LO) — independent of the primary
  // Rovo MCP OAuth (whose token has aud=mcp.atlassian.com and can't call
  // api.atlassian.com). This secondary token has aud=api.atlassian.com
  // and unlocks REST attachment upload + site-direct attachment URL
  // rewriting for Jira push. ALL fields are optional + nullable — when
  // absent the PM-sync path gracefully degrades to base64 inline (the
  // current behaviour). See PR #1169 for the chained OAuth flow.
  // -----------------------------------------------------------------
  encryptedAtlassianCloudAccessToken  String?
  encryptedAtlassianCloudRefreshToken String?
  atlassianCloudTokenExpiresAt        DateTime?
  atlassianCloudSiteUrl               String? // primary site, e.g. https://acme.atlassian.net (accessible-resources[0])
  atlassianCloudCloudId               String? // primary tenant UUID returned by /oauth/token/accessible-resources
  // Full accessible-resources list: [{ id: cloudId, url: siteUrl, name }].
  // The token grants access to ALL of these sites, so the upload path
  // routes each Jira issue to its OWN site (the cloudId is embedded in
  // the story's externalUrl) rather than assuming the primary site —
  // accounts with multiple Atlassian sites push issues to different
  // ones. When an issue's cloudId isn't in this list the upload degrades
  // to base64 inline.
  atlassianCloudAccessibleResources   Json?
  atlassianCloudScopes                String[]                      @default([])
  atlassianCloudConnectedAt           DateTime?
  // Refresh-failure tracking, separate from the primary token's counters
  atlassianCloudRefreshFailureCount   Int                           @default(0)
  atlassianCloudLastRefreshFailedAt   DateTime?
  atlassianCloudLastRefreshError      String?
  // Tool schema caching - avoid connecting to MCP server on every page load
  cachedTools                         Json? // Array of tool definitions with name, description, inputSchema
  toolsCachedAt                       DateTime? // When tools were last fetched from the server
  toolCount                           Int                           @default(0) // Quick access to tool count without parsing JSON
  // Semantic server routing metadata (Phase 0 + Phase 1)
  description                         String? // Rich description of server's purpose: "CRM project management - assignments, notes, tasks"
  domainKeywords                      String[]                      @default([]) // Domain-specific keywords: ["assignment", "project", "notes", "crm"]
  exampleQueries                      String[]                      @default([]) // Example queries: ["get assignment notes", "list crm tasks"]
  // Note: Server embeddings are stored in Qdrant (unified collection with tools), not Postgres
  createdAt                           DateTime                      @default(now())
  updatedAt                           DateTime                      @updatedAt
  clientSessions                      MCPClientSession[]
  toolConfigs                         MCPToolConfig[] // Per-tool stake level configurations
  mcpServer                           MCPServer                     @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  organization                        Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                                User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthStates                         MCPOAuthState[]
  agentConfigurations                 AgentMCPServerConfiguration[] // Agent instances using this MCP config
  aiChats                             AiChatMcpConfig[]

  @@index([mcpServerId, userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([userId, organizationId, status], map: "mcp_config_userId_organizationId_status_idx")
  @@map("mcp_config")
}

model MCPOAuthState {
  id             String    @id @default(cuid())
  state          String    @unique
  mcpServerId    String
  configId       String
  userId         String
  organizationId String?
  codeVerifier   String?
  redirectUri    String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime  @default(now())
  config         MCPConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  mcpServer      MCPServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("mcp_oauth_state")
}

model MCPClientSession {
  id             String    @id @default(cuid())
  token          String    @unique
  configId       String
  userId         String
  organizationId String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  config         MCPConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([userId])
  @@index([organizationId])
  @@map("mcp_client_session")
}

// MCPToolConfig - Per-tool configuration within an MCP config (Dust-style stake levels)
// Controls approval requirements for individual tools
model MCPToolConfig {
  id           String     @id @default(cuid())
  mcpConfigId  String
  toolName     String // Tool name from MCPConfig.cachedTools
  stakeLevel   StakeLevel @default(MEDIUM) // Approval requirement level
  isEnabled    Boolean    @default(true) // Whether this tool is enabled for use
  customConfig Json? // Tool-specific configuration overrides

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcpConfig MCPConfig         @relation(fields: [mcpConfigId], references: [id], onDelete: Cascade)
  approvals MCPToolApproval[]

  @@unique([mcpConfigId, toolName])
  @@index([mcpConfigId])
  @@map("mcp_tool_config")
}

// MCPToolApproval - Tracks approved agent+tool+target combinations (Dust-style)
// For MEDIUM stake tools, once approved for a specific target, the agent can repeat without asking
model MCPToolApproval {
  id            String    @id @default(cuid())
  toolConfigId  String // Link to MCPToolConfig
  instanceId    String // AgentTemplateInstance that received approval
  targetHash    String // Hash of the target (e.g., email recipient, Slack channel)
  targetDisplay String? // Human-readable target display (e.g., "john@example.com", "#general")
  approvedBy    String // User ID who approved
  approvedAt    DateTime  @default(now())
  expiresAt     DateTime? // Optional expiration for time-limited approvals

  toolConfig MCPToolConfig         @relation(fields: [toolConfigId], references: [id], onDelete: Cascade)
  instance   AgentTemplateInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([toolConfigId, instanceId, targetHash])
  @@index([toolConfigId])
  @@index([instanceId])
  @@index([approvedBy])
  @@map("mcp_tool_approval")
}

// Stake levels for MCP tools (Dust-style approval tiers)
enum StakeLevel {
  LOW // Never asks for approval - auto-approved
  MEDIUM // Approve once per agent + target combination, then auto-approved for that combo
  HIGH // Always asks for approval, every single time
}

// ─── Runtime Authority (Pipes-style session-scoped authorization) ────────────
// Separates persistent credentials (MCPConfig, WorkflowIntegration) from
// ephemeral runtime authority. Agents must obtain human-approved, time-limited
// authority before using connected systems during a run/session.

/// Represents a time-bounded execution context within which authority grants
/// are valid. Tied to an orchestrator run, workflow, or MCP gateway session.
model AuthoritySession {
  id                   String                 @id @default(cuid())
  userId               String
  organizationId       String?
  runType              AuthorityRunType
  runId                String? // Orchestrator run / workflow execution / conversation ID
  status               AuthoritySessionStatus @default(PENDING)
  requestedAt          DateTime               @default(now())
  approvedAt           DateTime?
  expiresAt            DateTime
  revokedAt            DateTime?
  completedAt          DateTime?
  requestedByAgentId   String? // Agent that triggered the authority request
  approvalInstructions String? // User notes back to the agent

  // Relations
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants       AuthorityGrant[]

  @@index([userId])
  @@index([organizationId])
  @@index([runType, runId])
  @@index([status, expiresAt])
  @@index([userId, organizationId, status])
  @@map("authority_session")
}

/// Represents a specific permission granted within an authority session.
/// Scoped to a provider (MCP server or integration) with read/write access level.
model AuthorityGrant {
  id                  String                @id @default(cuid())
  authoritySessionId  String
  kind                AuthorityGrantKind    @default(BROAD)
  providerType        AuthorityProviderType
  providerKey         String // Normalized provider key (e.g., "github", "linear", "custom:my-server")
  providerRefId       String? // MCPConfig.id or WorkflowIntegration.id
  providerDisplayName String? // Human-readable provider name
  accessLevel         AuthorityAccessLevel
  toolScope           String[]              @default([]) // Optional: restrict to specific tool names
  requestFingerprint  String? // For one-shot REQUEST grants: hash of exact request
  status              AuthorityGrantStatus  @default(PENDING)
  approvedBy          String?
  approvedAt          DateTime?
  expiresAt           DateTime
  consumedAt          DateTime? // For one-shot REQUEST grants
  deniedAt            DateTime?
  denialReason        String?
  metadata            Json? // Additional context (e.g., reason for request)

  // Relations
  authoritySession AuthoritySession @relation(fields: [authoritySessionId], references: [id], onDelete: Cascade)

  @@index([authoritySessionId])
  @@index([providerKey, status])
  @@index([providerRefId, status])
  @@index([status, expiresAt])
  @@map("authority_grant")
}

enum AuthorityRunType {
  ORCHESTRATOR
  WORKFLOW
  MCP_GATEWAY
  AGENT_INSTANCE
}

enum AuthoritySessionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  COMPLETED
}

enum AuthorityGrantKind {
  BROAD // Approved for all matching operations within session
  REQUEST // One-shot approval for a specific request
}

enum AuthorityProviderType {
  MCP
  INTEGRATION
  FABRIC_NATIVE
}

enum AuthorityAccessLevel {
  READ
  WRITE
}

enum AuthorityGrantStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED // One-shot grant used
  EXPIRED
  REVOKED
}

model Prompt {
  id               String            @id @default(cuid())
  key              String
  name             String
  slug             String?
  description      String?
  scope            PromptScope
  userId           String?
  organizationId   String?
  forkedFromId     String?
  format           PromptFormat      @default(PLAIN_TEXT)
  promptType       PromptContentType @default(TEXT)
  structuredFormat StructuredFormat?
  category         String?
  tags             String[]          @default([])
  heroEmojis       String[]          @default([])
  heroImageUrl     String?
  mediaUrl         String?
  isPublic         Boolean           @default(false)
  isUnlisted       Boolean           @default(false)
  isFeatured       Boolean           @default(false)
  featuredAt       DateTime?
  forDevs          Boolean           @default(false)
  usageCount       Int               @default(0)
  viewCount        Int               @default(0)
  voteCount        Int               @default(0)
  lastUsedAt       DateTime?
  deletedAt        DateTime?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  forkedFrom          Prompt?               @relation("PromptForks", fields: [forkedFromId], references: [id])
  forks               Prompt[]              @relation("PromptForks")
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions            PromptVersion[]
  votes               PromptVote[]
  promptTags          PromptTagRelation[]
  comments            PromptComment[]
  changeRequests      PromptChangeRequest[]
  outgoingConnections PromptConnection[]    @relation("ConnectionSource")
  incomingConnections PromptConnection[]    @relation("ConnectionTarget")

  @@unique([key, scope, userId, organizationId])
  @@index([scope, userId, organizationId])
  @@index([category])
  @@index([createdBy])
  @@index([usageCount])
  @@index([voteCount])
  @@index([forkedFromId])
  @@index([promptType])
  @@index([isFeatured])
  @@index([isUnlisted])
  @@index([deletedAt])
  @@index([slug])
  @@map("prompt")
}

model PromptVersion {
  id         String   @id @default(cuid())
  promptId   String
  version    Int
  content    String
  variables  Json?
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())

  // Tenant isolation (copied from parent Prompt for scope-based access)
  userId         String?
  organizationId String?
  scope          PromptScope?

  bindings         PromptBinding[]
  documentVersions DocumentVersion[]
  nominations      PromptNomination[]
  prompt           Prompt            @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@index([userId])
  @@index([organizationId])
  @@index([scope])
  @@map("prompt_version")
}

model PromptBinding {
  id              String           @id @default(cuid())
  targetType      PromptTargetType
  targetKey       String
  documentType    String
  // NULL = "any story kind" (used by non-stage bindings like PRD/PROPOSAL).
  // FEATURE / BUG = stage binding scoped to that kind.
  storyKind       StoryKind?
  scope           PromptScope
  userId          String?
  organizationId  String?
  // NULL = the tier's whole tenant (org-wide or personal). Set = a PROJECT
  // default: an ORG-scope binding that wins only inside this project and
  // outranks the org-wide one. Precedence USER > PROJECT > ORG > SYSTEM.
  projectId       String?
  promptVersionId String
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  promptVersion   PromptVersion    @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetKey, documentType, storyKind, scope, userId, organizationId, projectId])
  @@index([targetType, targetKey, documentType])
  @@index([targetType, targetKey, documentType, storyKind])
  @@index([scope, userId, organizationId])
  @@index([projectId])
  @@index([isDefault])
  @@map("prompt_binding")
}

// Prompt Voting
model PromptVote {
  id        String   @id @default(cuid())
  promptId  String
  userId    String
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([promptId])
  @@index([userId])
  @@map("prompt_vote")
}

// Prompt Tags with colors
model PromptTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prompts PromptTagRelation[]

  @@map("prompt_tag")
