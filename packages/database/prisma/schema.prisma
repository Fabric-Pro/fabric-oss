model Session {
  id                       String    @id @default(cuid())
  expiresAt                DateTime
  ipAddress                String?
  userAgent                String?
  userId                   String
  impersonatedBy           String?
  activeOrganizationId     String?
  token                    String    @unique
  createdAt                DateTime
  updatedAt                DateTime
  // Single-use step-up grant for the 2FA MANAGEMENT endpoints (issue #2827).
  // Written on the exact session row that just passed a second-factor
  // verification, and cleared by the management call that spends it. Scoped to
  // the session rather than the user because the grant has to be bound to the
  // browser that proved the factor: a user-scoped flag would let any other live
  // session spend a grant the user minted somewhere else. Row state alone is
  // still not sufficient — under the threat model the attacker holds the SAME
  // session cookie — so a signed, response-only cookie has to match it; see
  // packages/auth/lib/two-factor-management-step-up.ts.
  twoFactorStepUpGrantedAt DateTime?
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Waitlist signups for pre-launch lead capture
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String? // Where they signed up from (e.g., "hero", "navbar", "footer")
  metadata  Json? // Any additional data (UTM params, referrer, etc.)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("waitlist")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkey")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  // Unique so one user can never hold two enrolment rows at once (issue #2827).
  // Better Auth's initial enable is a read-then-deleteMany-then-create with no
  // constraint behind it, so two concurrent first-time enables could leave two
  // rows; every reader — the plugin's `adapter.findOne` and this repo's
  // `findFirst` — then picks one with no defined ordering, which makes "does
  // this account have a verified factor?" answerable two different ways for the
  // same user.
  userId                  String    @unique
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  // Step-up (already-authenticated) verification budget. Deliberately separate
  // from failedVerificationCount/lockedUntil above, which Better Auth owns for
  // the sign-in challenge: sharing them would let an attacker holding only a
  // stolen session lock the victim out of the 2FA sign-in they need in order to
  // revoke that session, and would interleave with Better Auth's own two-phase
  // failure write (an atomic native incrementOne on the counter, then a
  // separate unguarded update that sets lockedUntil).
  stepUpFailedCount       Int       @default(0)
  stepUpLockedUntil       DateTime?
  // Bumped every time the step-up budget is reset (a successful verification,
  // or an elapsed lock being cleared). A request that reserved an attempt
  // carries the epoch it reserved under, so a reservation returned after a
  // reset lands on a stale epoch and is discarded instead of refunding an
  // attempt that a later genuine failure has since spent.
  stepUpEpoch             Int       @default(0)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Organization {
  id                              String                        @id @default(cuid())
  name                            String
  slug                            String?                       @unique
  logo                            String?
  createdAt                       DateTime
  metadata                        String?
  paymentsCustomerId              String?
  // IANA TZ name (e.g., "America/Los_Angeles"). NULL falls back to "UTC" at read
  // time (see packages/payments/src/lib/ai-usage-limits.ts:getTenantTimezone).
  timezone                        String?
  firecrawlApiKey                 String?
