  banExpires                 DateTime?
  onboardingComplete         Boolean                       @default(false)
  mustChangePassword         Boolean                       @default(false)
  welcomeEmailSentAt         DateTime?
  // Last time this user made an authenticated oRPC call from a browser
  // session, written by a 15-minute-throttled middleware.
  // Excludes the public v1 API (requireApiKey) and apps/web/app/api/**
  // REST routes, neither of which passes through protectedProcedure.
  // Distinct from the auth.login.success audit trail: 30-day rolling
  // sessions mean an active user almost never re-authenticates, so login
  // events cannot answer "is this user engaged". Backfilled from each
  // user's most recent session row (expired or not); NULL only if no
  // session row exists.
  lastSeenAt                 DateTime?
  paymentsCustomerId         String?
