  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent       ChatArtifact?  @relation("ArtifactVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions     ChatArtifact[] @relation("ArtifactVersions")

  @@index([userId, organizationId])
  @@index([conversationId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("chat_artifact")
}

/// Per-recipient inbox row. Source-of-truth for the in-app notification
/// center. Tenant-scoped via XOR (organizationId is null for personal).
enum NotificationCategory {
  MENTION
  REPLY
  ASSIGNMENT
  STATUS
  AGENT
  PROJECT
  SYSTEM
  BILLING
  CONTEXT_INDEXING_STARTED
  CONTEXT_INDEXING_COMPLETED
  SUBSCRIPTION
  PUBLISHING
  DECISION_OWNER_ASSIGNED
  DECISION_OWNER_UPDATED
}

enum NotificationType {
  STORY_MENTION
  STORY_COMMENT_REPLY
  STORY_ASSIGNED
  TASK_MENTION
  TASK_COMMENT_REPLY
  COMMENT_MENTION
  DOCUMENT_MENTION
  AGENT_REPLY_READY
  STORY_STATUS_CHANGED
  PM_SYNC_CONFLICT
  AI_USAGE_LIMIT_WARNING
  AI_USAGE_LIMIT_REACHED
  INTEGRATION_INCIDENT
  SYSTEM_INCIDENT
  CONTEXT_INDEXING_STARTED
  CONTEXT_INDEXING_COMPLETED
  REPO_INTEGRATION_TOKEN_EXPIRED
  SECURITY_SCAN_COMPLETED
  PROJECT_SERVICE_ALERT_DIGEST
  REPORT_COMPLETED
  REPORT_FAILED
  SECURITY_TICKETS_GENERATED
  DOCUMENT_UPDATED
  FEATURE_UPDATED
  STORY_SHARED
  NEWSLETTER_APPROVAL_PENDING
  TEST_CASES_DRAFTED
  STATUS_ANNOUNCEMENT
  PUBLISHING_TOPICS_READY
  PROMPT_DEFAULT_UPDATED
  PROMPT_NOMINATION_PENDING
  /// One or more attachments failed to upload during a PM push (Fizzy #1745,
  /// AC-4). Category PROJECT — the file never reached the work item, so the
  /// people who can retry or re-scope the token need to know.
  PM_ATTACHMENT_SYNC_FAILED
  /// A decision was saved with this user as its accountable owner. Category
  /// DECISION_OWNER_ASSIGNED — routes the decision to the person answerable
  /// for it.
  DECISION_OWNER_ASSIGNED
  /// A decision this user owns was edited (content, status, duration, priority).
  DECISION_OWNER_UPDATED

  /// Maturation question routing (Fizzy #1751). The split between the first two
  /// is the whole point and the copy must preserve it: ASSIGNED is a request —
  /// someone is waiting on you — while MENTIONED is purely informational, raised
  /// when an answer merely *cited* you. Categories ASSIGNMENT and MENTION.
  QUESTION_ASSIGNED
  QUESTION_MENTIONED
  /// Sent back to whoever created the assignment once the question is answered.
  QUESTION_ANSWERED
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  organizationId String?
  type           NotificationType
  category       NotificationCategory

  title   String  @db.Text
  snippet String? @db.Text
  link    String?
  iconKey String?

  // Source pointers — used for read-time RBAC re-check and cascade cleanup.
  projectId   String?
  storyId     String?
  taskId      String?
  commentId   String?
  documentId  String?
  actorUserId String?

  payload Json

  readAt     DateTime?
  archivedAt DateTime?
  // Coalescing key. Uniqueness is enforced by the partial unique index described below, over LIVE
  // rows only (unread and unarchived) — there is no time window.
  dedupeKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User?         @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Hottest query: user's unread for the active scope, paginated DESC.
  @@index([userId, organizationId, readAt, createdAt(sort: Desc)])
  @@index([userId, organizationId, category, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([storyId])
  @@index([commentId])
  @@index([userId, dedupeKey, createdAt])
  // Dedup uniqueness is enforced by a partial unique index in SQL (not expressible in Prisma schema):
  //   "notification_userId_dedupeKey_live_uq" ON ("userId", "dedupeKey")
  //   WHERE "readAt" IS NULL AND "archivedAt" IS NULL AND "dedupeKey" IS NOT NULL
  // See migrations: 20260511151927_notification_dedup_create_live_index (create)
  //                 20260511151928_notification_dedup_drop_legacy_index  (drop legacy)
  // Note: notification-service.ts' dedup paths (pre-query AND P2002 coalesce) must also filter
  //   archivedAt IS NULL to stay consistent with this index.
  @@map("notification")
}

/// Per-user notification delivery channel preferences.
///
/// Controls WHERE a user receives notifications, orthogonal to WHICH categories
/// they receive (see `NotificationPreference`). In-app (notification center) is
/// the always-on default and is NOT stored here — only the opt-in external
/// channels are. Account-global: one row per user keyed at the
/// `organizationId = ""` sentinel, mirroring `UserOrchestratorPreferences` (the
/// compound unique reserves room for per-org scoping later). Defaults are the
/// inverse of category prefs: a missing row means every external channel is OFF
/// (in-app only), so existing users are unaffected (no backfill).
///
/// Webhook URL and signing secret are encrypted at rest via `encryptApiKey`
/// (packages/utils/lib/ai-gateway-encryption.ts). The plaintext signing secret
/// is shown to the user exactly once at creation/rotation and is never
/// retrievable thereafter.
model NotificationDeliveryPreference {
  id             String @id @default(cuid())
  userId         String
  organizationId String @default("") // "" = account-global (mirrors UserOrchestratorPreferences)

  // In-app is always on and not represented here. Only opt-in external channels.
  emailEnabled   Boolean @default(false)
  webhookEnabled Boolean @default(false)

  // Encrypted at rest (AES-256-GCM via encryptApiKey). Null until configured.
  encryptedWebhookUrl    String? @db.Text
  encryptedWebhookSecret String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("notification_delivery_preference")
}

/// The kind of item a `Subscription` targets. v1 supports documents and
/// features (backend `UserStory`). Kept as an enum discriminator rather than a
/// typed FK because Prisma cannot express a polymorphic relation across two
/// tables — subject-side cascade cleanup is handled at the query layer, exactly
/// like `Notification.documentId` / `Notification.storyId`.
enum SubscriptionSubjectType {
  DOCUMENT
  FEATURE
}

/// Explicit, opt-in "watch this item" record. When a subscribed document or
/// feature changes (real content change or status/stage change), every
/// subscriber receives a `SUBSCRIPTION`-category notification. Tenant-scoped via
/// XOR (organizationId is null for personal context). Unsubscribing deletes the
/// row. There is intentionally no FK to the subject — see
/// `SubscriptionSubjectType`. Uniqueness excludes organizationId on purpose:
/// subjectId is a globally unique cuid already bound to one tenant, so
/// (userId, subjectType, subjectId) is sufficient — and avoids the Postgres
/// "NULL is distinct" trap that would let personal-context duplicates slip past
/// a compound unique. Mirrors ProjectUserPreference @@unique.
model Subscription {
  id             String                  @id @default(cuid())
  userId         String
  organizationId String?
  subjectType    SubscriptionSubjectType
  subjectId      String
  createdAt      DateTime                @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@index([userId, organizationId])
  @@map("subscription")
}

model PendingPmStateChange {
  id                          String                     @id @default(cuid())
  projectId                   String
  entityType                  PmStateChangeEntityType
  entityId                    String
  externalId                  String
  previousState               String
  newState                    String
  proposedAction              PendingPmStateChangeAction
  status                      PendingPmStateChangeStatus @default(PENDING)
  detectedPmHash              String?
  // FLAG_MISSING provenance (#1360 review Fix B): the PM server the story's link
  // belonged to when the deletion was detected. The atomic unlink predicate
  // requires this to still match the story's current externalMcpServerId, so a
  // stale flag cannot sever a new same-externalId link on a different server
  // after a retool/import. Null for HIDE/UNHIDE/CONTENT_DRIFT.
  expectedExternalMcpServerId String?
  createdAt                   DateTime                   @default(now())
  reviewedAt                  DateTime?
  reviewedBy                  String?

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("PmStateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([entityId])
  @@map("pending_pm_state_change")
}

model PmTicketMissingStreak {
  id               String                  @id @default(cuid())
  projectId        String
  entityType       PmStateChangeEntityType
  entityId         String
  externalId       String
  missStreak       Int                     @default(0)
  firstMissingAt   DateTime                @default(now())
  lastMissingAt    DateTime                @default(now())
  // Idempotency token (#1360 review Fix C): the poll cycle's run id that last
  // advanced this streak. A retried/concurrent activity carrying the same
  // pollRunId returns the existing streak unchanged instead of double-counting,
  // so the threshold reflects DISTINCT poll cycles, not activity attempts.
  lastCountedRunId String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityType, entityId, externalId])
  @@index([projectId, externalId])
  @@map("pm_ticket_missing_streak")
}

/// Global, instance-wide feature-flag overrides (no tenant scope).
///
/// A row OVERRIDES the FABRIC_FEATURE_* env var for that flag; absence of a row
/// means "fall back to the env var, then the registry default". That is why the
/// model is named Override rather than FeatureFlag: an empty table reproduces
/// pre-feature behavior exactly, and `DELETE FROM feature_flag_override`
/// is a complete rollback with no deploy.
///
/// Deliberately NOT in the RLS allowlist (packages/database/scripts/
/// apply-rls-direct.ts) — it has no user or org owner, like ai_model.
model FeatureFlagOverride {
  /// Registry key from packages/utils/lib/feature-flag-registry.ts,
  /// e.g. "PERSONAL_MEETINGS". Not the env-var name.
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
  /// user.id of the instance admin who last flipped this flag.
  updatedBy String

  @@map("feature_flag_override")
}

/// Per-organization override of a registry feature flag. Sits ABOVE
/// FeatureFlagOverride in the resolution chain (org > global > env > default).
///
/// Deliberately a separate table rather than a nullable organizationId on
/// FeatureFlagOverride: that model's `key` is @id, and re-keying a live control
/// table whose read path runs inside the authenticated app layout risks every
/// authenticated page rather than one feature. This one is additive.
///
/// NOT a tenant table despite carrying organizationId. It is an instance-admin
/// control table read by the platform's flag resolver outside any tenant
/// context — the suggestion sweep reads it with no tenant context at all — so
/// it is RLS-EXEMPT by design, not by omission. See rls-coverage.test.ts.
model OrganizationFeatureFlagOverride {
  /// Registry key from packages/utils/lib/feature-flag-registry.ts,
  /// e.g. "PUBLISHING_SUITE". Not the env-var name.
  key            String
  organizationId String
  /// false is meaningful: it excludes this organization from a globally
  /// enabled flag. Absence of a row means "inherit", which is different.
  enabled        Boolean
  updatedAt      DateTime     @updatedAt
  /// user.id of the instance admin who last flipped this flag for this org.
  updatedBy      String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([key, organizationId])
  @@map("organization_feature_flag_override")
}
