model ReportArtifactChunk {
  id         String @id @default(cuid())
  artifactId String

  // Content
  content    String @db.Text
  chunkIndex Int

  // Qdrant Reference
  qdrantId String? @unique

  // Chunk metadata
  metadata Json?

  // Tenant isolation (copied from parent ReportArtifact)
  userId         String?
  organizationId String?

  // Relations
  artifact     ReportArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([qdrantId])
  @@index([userId])
  @@index([organizationId])
  @@map("report_artifact_chunk")
}

/// Per-recipient delivery log for `Send report by email` from the Execution
/// History UI. One row per recipient per send action. Sender + (optional)
/// organization context follow the same XOR pattern as the parent artifact.
///
/// Backed by `template_instance_artifact` because that is the table the
/// report-template-instance workflow actually writes to (see
/// `storeInstanceArtifact` activity / `createTemplateInstanceArtifact` query).
/// `ReportArtifact` is a parallel, currently-unused model — do not confuse.
model TemplateInstanceArtifactEmailDelivery {
  id         String @id @default(cuid())
  artifactId String

  // Groups per-recipient rows into a single Send action — every recipient
  // of one Send-button click shares the same `sendId`. The history list
  // collapses on this column so the UI shows one row with N badges instead
  // of N separate rows.
  sendId String

  // Sender. Tenant columns mirror the parent `TemplateInstanceArtifact`
  // (RLS policy `user_owned` — in org context any member sees all org sends;
  // in personal context only the artifact owner sees their own sends).
  userId         String
  organizationId String?

  // Recipient is either an org member (recipientUserId set) or an external
  // freeform address. `recipientEmail` is always populated — for org members
  // we snapshot their email at send time so the log is meaningful even if
  // the member's address later changes.
  recipientUserId String?
  recipientEmail  String

  // Optional plain-text body the sender included with the message.
  messageBody String? @db.Text

  // Delivery outcome. We record the result of the synchronous `sendEmail()`
  // call; webhook-driven bounces / opens are out of MVP scope.
  status       ReportEmailDeliveryStatus @default(SENT)
  errorMessage String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  // Relations
  artifact      TemplateInstanceArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user          User                     @relation("TemplateInstanceArtifactEmailDeliverySender", fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientUser User?                    @relation("TemplateInstanceArtifactEmailDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([artifactId, sentAt(sort: Desc)])
  @@index([artifactId, sentAt(sort: Desc), sendId], map: "tia_email_delivery_artifact_send_idx")
  @@index([userId])
  @@index([organizationId])
  @@map("template_instance_artifact_email_delivery")
}

