// ============================================================================
// AGENT TEMPLATES - Agent Creation System
// ============================================================================

// AgentTemplate - Pre-configured agent blueprints
// Users can start from these templates to create their own agents
model AgentTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique // URL-friendly identifier (e.g., "sql-expert")
  name         String
  displayName  String // UI display name
  description  String   @db.Text
  heroEmojis   String[] @default([])
  heroImageUrl String?

  // Categorization (DUST-style)
  category AgentTemplateCategory
  tags     String[]              @default([])

  // Reusable template instructions shown when creating an agent instance.
  instructions String @db.Text

  // Default AI model configuration
  suggestedModel String?
  modelConfig    Json?

  // Link to existing prompt system (for versioning)
  promptBindingId String?

  // Document type association (if this template generates documents)
  documentType ProjectDocumentType?

  // Multi-tenancy
  scope          AgentTemplateScope @default(SYSTEM)
  userId         String?
  organizationId String?

  // Publishing
  isPublished Boolean @default(true)
  isFeatured  Boolean @default(false) // Show in featured section

  // Usage tracking
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  // Versioning
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instances    AgentTemplateInstance[]
  skills       AgentTemplateSkill[]

  @@index([category])
  @@index([scope])
  @@index([userId])
  @@index([organizationId])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("agent_template")
}

// AgentTemplateInstance - User's customized agent from a template
// When a user "uses" a template, they create an instance with their configurations
model AgentTemplateInstance {
  id             String  @id @default(cuid())
  templateId     String
  userId         String
  organizationId String?

  // Versioning
  // sId is stable across versions, version increments on each edit
  sId     String              @default(cuid()) // Stable ID across versions
  version Int                 @default(1) // Version number, increments on updates
  status  AgentInstanceStatus @default(ACTIVE) // Lifecycle status

  // User's customization
  name         String
  description  String?
  heroEmojis   String[] @default([])
  heroImageUrl String?

  // Custom instructions (merged with template)
  // Allows user to fill in placeholders like "Company Context"
  customInstructions Json?

  // Connected tools - maps to user's tool configurations
  // { "execute-sql": { "connectionId": "db-conn-123" }, "web-search": { "enabled": true } }
  toolConnections Json @default("{}")

  // Configured triggers
  // [{ type: "slack", config: { channel: "#alerts" } }, { type: "webhook", config: { url: "..." } }]
  triggers Json @default("[]")

  // Model configuration override
  modelOverride String?
  modelConfig   Json?

  // Workspace access (for RAG)
  workspaceIds String[] @default([])

  // Execution mode: "single_turn" (default) or "goal_oriented"
  // single_turn: Simple Q&A, one request → one response
  // goal_oriented: Iterative execution until goal is achieved
  executionMode String @default("single_turn")

  // Goal configuration (for goal_oriented mode)
  // Natural language description of what success looks like
  goal String? @db.Text

  // Success criteria configuration (for goal_oriented mode)
  // { type: "llm_judge" | "output_contains" | "tool_success", ... }
  successCriteria Json?

  // Maximum iterations for goal-oriented execution
  maxIterations Int @default(10)

  // Memory settings
  memoryAutoApprove Boolean @default(false) // YOLO mode - auto-approve memory edits

  // Usage tracking
  runCount  Int       @default(0)
  lastRunAt DateTime?

  // External API exposure
  isApiExposed Boolean @default(false) // Toggle for external API access
  apiConfig    Json? // { rateLimitPerMinute?, inputSchema?, description?, exampleInput?, exampleOutput? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  template      AgentTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations AgentTemplateConversation[]
  executions    AgentTemplateExecution[]
  deployment    AgentDeployment? // Active deployment (one-to-one)
  memoryFiles   AgentMemoryFile[]
  memoryEdits   AgentMemoryEdit[]
  toolApprovals MCPToolApproval[] // Approved tool+target combinations for this instance

  // Enhanced configuration relations (replaces loose JSON fields)
  mcpServerConfigurations   AgentMCPServerConfiguration[] // MCP server bindings
  integrationConfigurations AgentIntegrationConfiguration[] // OAuth integration bindings

  @@unique([sId, version]) // Each version of an instance has unique (sId, version)
  @@index([templateId])
  @@index([userId])
  @@index([organizationId])
  @@index([sId])
  @@index([status])
  @@map("agent_template_instance")
}

// AgentTemplateConversation - Chat sessions with an agent instance
model AgentTemplateConversation {
  id             String  @id @default(cuid())
  instanceId     String
  userId         String
  organizationId String?

  // Version pinning - conversation uses specific instance version
  // Ensures reproducibility even after instance updates
  instanceVersion Int? // Null means use latest version

  // Conversation metadata
  title      String?
  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)

  // Messages stored as JSON array
  // [{ role: "user" | "assistant", content: string, timestamp: string, metadata?: {} }]
  messages Json @default("[]")

  // Context used in this conversation
  // { knowledgeResults: [], toolResults: [] }
  context Json?

  // Token usage tracking
  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instance AgentTemplateInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([userId])
  @@index([organizationId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("agent_template_conversation")
}

// AgentTemplateExecution - Triggered/scheduled execution of an agent instance
model AgentTemplateExecution {
  id             String  @id @default(cuid())
  instanceId     String
  userId         String
  organizationId String?

  // Execution context
  triggerType String? // "manual", "slack", "webhook", "schedule"
  triggerData Json? // Data from the trigger

  // Status tracking
  status      AgentExecutionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // milliseconds

  // Input/Output
  input  Json?
  output Json?
  error  String? @db.Text

  // Temporal workflow tracking
  workflowId String?
  runId      String?

  createdAt DateTime @default(now())

  // Relations
  instance AgentTemplateInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([triggerType])
  @@index([workflowId])
  @@index([createdAt])
  @@map("agent_template_execution")
}

// AgentMCPServerConfiguration - MCP server bindings for agent instances
// Replaces loose toolConnections JSON with proper relational model
model AgentMCPServerConfiguration {
  id          String @id @default(cuid())
  instanceId  String
  mcpConfigId String // Reference to MCPConfig

  // Display metadata
  name        String // Display name for this tool binding
  description String?

  // Data bindings (connects tools to knowledge sources)
  integrationIds String[] @default([]) // OAuth integrations this tool can access
  dataSourceIds  String[] @default([]) // RAG knowledge sources
  tableIds       String[] @default([]) // Database tables for queries
  childAgentId   String? // Agent delegation (for coordinator patterns)

  // Time-based filtering for data freshness
  timeFrameDuration Int?
  timeFrameUnit     String? // "hour" | "day" | "week" | "month"

  // Input validation schema
  jsonSchema Json? // JSON Schema for tool inputs

  // Authorization level
  authLevel String @default("medium") // "low" | "medium" | "high"

  // Enabled/disabled toggle
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instance  AgentTemplateInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  mcpConfig MCPConfig             @relation(fields: [mcpConfigId], references: [id], onDelete: Cascade)

  @@unique([instanceId, mcpConfigId]) // One binding per MCP config per instance
  @@index([instanceId])
  @@index([mcpConfigId])
  @@map("agent_mcp_server_configuration")
}

// AgentIntegrationConfiguration - OAuth integration bindings for agent instances
// Replaces loose knowledgeConnections JSON with proper relational model
model AgentIntegrationConfiguration {
  id            String @id @default(cuid())
  instanceId    String
  integrationId String // Reference to WorkflowIntegration (OAuth connection)

  // Integration type for filtering (uses WorkflowIntegrationProvider values)
  integrationType String // "GITHUB" | "GOOGLE_DRIVE" | "SLACK" | "LINEAR" | "NOTION" | etc.

  // Scoped access - don't expose all resources, just specific ones
  // { repos: ["org/repo"], channels: ["#general"], folders: ["folder-id"] }
  allowedResources Json?

  // Data freshness filtering
  timeFrameDuration Int?
  timeFrameUnit     String? // "hour" | "day" | "week" | "month"

  // Permission level
  accessLevel String @default("read") // "read" | "read_write"

  // Enabled/disabled toggle
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instance    AgentTemplateInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  integration WorkflowIntegration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([instanceId, integrationId]) // One binding per integration per instance
  @@index([instanceId])
  @@index([integrationId])
  @@index([integrationType])
  @@map("agent_integration_configuration")
}

