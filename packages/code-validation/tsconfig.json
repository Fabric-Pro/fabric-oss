{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"target": "ES2022"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
