{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"tools": {
		"write": true,
		"bash": true,
		"webfetch": true
	},
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"webfetch": "allow"
	},
	"mcp": {
		"aspire": {
			"type": "local",
			"command": ["aspire", "agent", "mcp"],
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp@latest"],
			"enabled": true
		}
	}
}
