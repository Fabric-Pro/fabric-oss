# ============================================================================
# FABRIC STAGING ENVIRONMENT CONFIGURATION
# ============================================================================
# This file configures Fabric to use cloud services instead of local Docker.
# Use with: ./aspire.sh staging
# ============================================================================

# ============================================================================
# CORE SETTINGS
# ============================================================================

NEXT_PUBLIC_SITE_URL=""
PORT=3001

# ============================================================================
# DATABASE - Neon PostgreSQL
# ============================================================================
# Get from: https://console.neon.tech

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# ============================================================================
# AUTHENTICATION
# ============================================================================

BETTER_AUTH_SECRET=""

# OAuth Providers
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ============================================================================
# ============================================================================
# STORAGE - Cloudflare R2 (S3-compatible)
# ============================================================================
# All files (documents, avatars, logos) use Cloudflare R2
# ============================================================================

STORAGE_PROVIDER="s3"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Bucket names (used as path prefixes in R2)
NEXT_PUBLIC_AVATARS_BUCKET_NAME="avatars"
NEXT_PUBLIC_CHAT_DOCUMENTS_BUCKET_NAME="chat-documents"
NEXT_PUBLIC_PROJECT_CONTEXTS_BUCKET_NAME="project-contexts"

# ============================================================================
# CACHE - Upstash Redis
# ============================================================================
# Get from: https://console.upstash.com/redis

REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# VECTOR DATABASE - Qdrant Cloud
# ============================================================================
# Get from: https://cloud.qdrant.io

QDRANT_URL=""
QDRANT_API_KEY=""

# ============================================================================
  # DATABRICKS (Optional — deployments using Databricks resources)
  # ============================================================================
  # See docs/deployment/DATABRICKS.md for full Lakebase setup guide
  DATABRICKS_HOST=""
  DATABRICKS_CLIENT_ID=""
  DATABRICKS_CLIENT_SECRET=""
  DATABRICKS_TOKEN=""
  # DATABASE_AUTH_PROVIDER="password"
  # WORKER_RLS_MODE="bypassrls"

# ============================================================================
# AI PROVIDERS
# ============================================================================

# Vercel AI Gateway (recommended)
# Get from: https://vercel.com/dashboard/ai/gateway
#AI_GATEWAY_API_KEY=""

# Direct Provider API Keys (fallback)
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# DEEPSEEK_API_KEY=""

# ============================================================================
# WORKFLOW ORCHESTRATION - Temporal
# ============================================================================

ENABLE_TEMPORAL_WORKFLOWS="true"

# Temporal Cloud
TEMPORAL_ADDRESS="us-east-1.aws.api.temporal.io:7233"
TEMPORAL_NAMESPACE=""
TEMPORAL_CLOUD_API_KEY=""

# ============================================================================
# AI AGENTS - Azure Container Apps
# ============================================================================

# Agent URLs (Azure Container Apps)
# Active agents in the platform
DOCUMENT_GENERATOR_URL="https://YOUR-DOCUMENT-GENERATOR.azurecontainerapps.io"
PROJECT_DOCUMENT_GENERATOR_URL="https://YOUR-PROJECT-DOC-GEN.azurecontainerapps.io"
TASK_PLANNER_URL="https://YOUR-TASK-PLANNER.azurecontainerapps.io"
STORY_BREAKDOWN_URL="https://YOUR-STORY-BREAKDOWN.azurecontainerapps.io"
API_AGENT_URL="https://YOUR-API-AGENT.azurecontainerapps.io"
PROMPT_ENHANCER_URL="https://YOUR-PROMPT-ENHANCER.azurecontainerapps.io"
CUGA_AGENT_URL="https://YOUR-CUGA-BACKEND.azurecontainerapps.io"
CUGA_UI_URL="https://YOUR-CUGA-BACKEND.azurecontainerapps.io"

# Legacy agent URL references (point to new URLs)
AI_DOCUMENT_AGENT_URL="https://YOUR-DOCUMENT-GENERATOR.azurecontainerapps.io"
DYNAMIC_AGENT_RUNTIME_URL="https://YOUR-TASK-PLANNER.azurecontainerapps.io"

# Agent Authentication
AGENT_API_KEY=""

# Fabric API URL - for agents to call back to NextJS
# Agents use this to exchange tokens and fetch dynamic API keys from the database
FABRIC_API_URL=""

# Inter-Agent Security
AGENT_SERVICE_SECRET=""

# AI Token Security - for secure AI API key exchange between agents and API
AI_TOKEN_SECRET=""

# Fabric AI Server - for patterns, YouTube transcripts, web scraping
# Set FABRIC_SERVER_API_KEY and FABRIC_AI_API_KEY to the SAME value
FABRIC_AI_URL="https://YOUR-FABRIC-AI-SERVER.azurecontainerapps.io"
FABRIC_SERVER_API_KEY=""  # Server validates this (set in Azure Key Vault)
FABRIC_AI_API_KEY=""      # Clients send this in X-API-Key header

# ============================================================================
# SEMANTIC MEMORY - Letta
# ============================================================================
# Get from: https://app.letta.com

LETTA_BASE_URL="https://api.letta.com"
LETTA_API_KEY=""

# ============================================================================
# REAL-TIME COLLABORATION - PartyKit
# ============================================================================
# Get from: https://partykit.io
# Deploy PartyKit: cd party && npx partykit deploy

# For staging, either deploy to PartyKit Cloud or disable collaboration
NEXT_PUBLIC_PARTYKIT_HOST=""
NEXT_PUBLIC_ENABLE_COLLABORATION="false"
COLLAB_JWT_SECRET=""

# ============================================================================
# OBSERVABILITY
# ============================================================================

PROMETHEUS_URL="http://localhost:9090"
GRAFANA_URL="http://localhost:3100"
JAEGER_UI_URL="http://localhost:16686"
JAEGER_OTLP_HTTP_URL="http://localhost:4318"
JAEGER_OTLP_GRPC_URL="http://localhost:4317"
NODE_EXPORTER_URL="http://localhost:9100"

# Cloud Observability
# DD_API_KEY=""
# DD_SITE="datadoghq.com"
# SENTRY_DSN=""

