# CLOUDFLARE WORKERS
# ============================================================================
# Get from: https://dash.cloudflare.com/profile/api-tokens

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ============================================================================
# EMAIL
# ============================================================================

MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
PLUNK_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# ============================================================================
# PAYMENTS
# ============================================================================

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe restricted access key used by Vercel AI Gateway metered billing
STRIPE_AI_GATEWAY_RESTRICTED_KEY=""
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
DODO_PAYMENTS_API_KEY=""

# Product Price IDs
NEXT_PUBLIC_PRICE_ID_PRO_MONTHLY=""
NEXT_PUBLIC_PRICE_ID_PRO_YEARLY=""
NEXT_PUBLIC_PRICE_ID_LIFETIME=""

# ============================================================================
# ANALYTICS
# ============================================================================

NEXT_PUBLIC_PIRSCH_CODE=""
NEXT_PUBLIC_PLAUSIBLE_URL=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Role/Function Tags AI context (#1767 Stage 4) — opt-in, default OFF
FABRIC_FEATURE_FUNCTION_TAGS=false

# ============================================================================
# AUDIT LOG (docs: docs/audit-log/)
# ============================================================================
# See deployment/audit-log.md for full operator guidance.

# Comma-separated email addresses that bypass the audit-log permission
# AND the org membership check. Used by Fabric SRE to diagnose remote
# deployments. Empty (default) means no super-admin — only org
# owners/admins can read the trail. Each address in the list is
# effectively a super-admin for the audit-read path.
FABRIC_DEPLOYMENT_ADMIN_EMAILS=""

# Master switch for the Temporal scheduled retention workflow. Staging
# mirrors Cloud production defaults: retention is ON.
FABRIC_AUDIT_LOG_RETENTION_ENABLED="true"

# Status-announcement notifications — ON in every deployed environment. Notifies
# organization
# owners/admins about live MAJOR/CRITICAL platform-wide status announcements. The
# 5-minute schedule is registered regardless; the sweeper returns skipped without
# issuing a query while this is off, so flipping it takes effect on the next tick
# with no redeploy. Read through parseOptInFlag, so true/1/on/yes all enable.
# This is the kill switch, not the rollout gate: publishing the announcement is
# already the admin-only, reviewed, customer-visible decision. Set false to stop
# delivery on the next tick without a redeploy.
FABRIC_STATUS_ANNOUNCEMENT_NOTIFICATIONS_ENABLED="true"

# Number of days to retain audit_log rows before the daily purge fires.
# Staging keeps 365 days to match Cloud production. Values 1–89 emit a
# non-fatal startup warning (compliance-sensitive deployments expect ≥90 days).
FABRIC_AUDIT_LOG_RETENTION_DAYS="365"

# Master kill switch for the automatic error-capture middleware (D16).
# Default false in staging so the trail captures forensic context for
# every procedure throw. Flip only as a temporary panic-button.
FABRIC_AUDIT_ERROR_CAPTURE_DISABLED="false"

# Comma-separated procedure-path skip list (D16). Empty by default —
# add high-cardinality / known-noisy paths only when a specific path
# proves chatty. Trailing `*` makes a prefix match.
FABRIC_AUDIT_ERROR_CAPTURE_SKIP_PATHS=""

# Public audit-log REST API documentation UI.
# Staging exposes the Swagger UI at `/api/v1/docs` so SREs can
# experiment against the staging audit data. Production should leave
# this unset (or "false") so it does not advertise the API surface.
#
# IMPORTANT (Vercel staging): this value is read from the deployed
# environment, NOT from a committed env file. After landing this in
# `.env.staging.example`, set the same key in the Vercel project's
# Environment Variables (Settings → Environment Variables → Preview /
# Production for the staging deployment) and redeploy. Hitting
# `https://your-fabric-host.example/api/v1/docs` without it returns a 404
# instructions page.
FABRIC_PUBLIC_API_DOCS_ENABLED="true"
