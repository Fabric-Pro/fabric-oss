{
	"name": "task-planner-agent",
	"version": "2.0.4",
	"license": "Apache-2.0",
	"description": "LangGraph agent for breaking down user stories into development tasks with AG-UI and A2A protocol support",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "PORT=8126 tsx unified-server.ts",
		"dev:legacy-agui": "langgraph dev --host localhost --port 8126 --no-cluster",
		"dev:legacy-a2a": "PORT=8226 tsx a2a-server.ts",
		"dev:legacy-all": "concurrently \"npm run dev:legacy-agui\" \"npm run dev:legacy-a2a\"",
		"build": "tsup --config tsup.config.ts",
		"start": "PORT=8126 node dist/unified-server.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.11",
		"@langchain/anthropic": "^1.5.9",
		"@langchain/core": "^1.2.9",
		"@langchain/groq": "1.3.1",
		"@langchain/langgraph": "^1.4.14",
		"@langchain/openai": "^1.5.11",
		"@repo/agent-core": "workspace:*",
		"@repo/agent-tools": "workspace:*",
		"@repo/observability": "workspace:*",
		"hono": "^4.13.7",
		"undici": "^8.5.0",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@langchain/langgraph-cli": "1.4.5",
		"@types/node": "^22.10.5",
		"concurrently": "^9.1.2",
		"tsup": "^8.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
