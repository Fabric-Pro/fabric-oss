
# AI Providers - Direct API Keys (NOT USED - All requests go through Vercel AI Gateway)
# Provider API keys are configured in the Vercel AI Gateway Dashboard
# These environment variables are not needed and will be ignored
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
# DEEPSEEK_API_KEY=""
# 2nd key - OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Vercel AI Gateway (REQUIRED - This is the only way to access AI models)
# Get your API key from: https://vercel.com/dashboard/ai/gateway
# Documentation: https://sdk.vercel.ai/providers/ai-sdk-providers/ai-gateway
# The gateway provides unified access to multiple AI providers with centralized monitoring
# Configure your provider API keys (OpenAI, Anthropic, DeepSeek) in the Vercel Dashboard
AI_GATEWAY_API_KEY="YOUR_AI_GATEWAY_API_KEY"
