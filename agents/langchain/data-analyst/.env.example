# =============================================================================
# Data Analyst Agent Environment Variables (Stateless)
# =============================================================================

# Fabric API (REQUIRED)
FABRIC_API_URL="http://localhost:3001"
AGENT_API_KEY="your_agent_api_key"  # From Fabric settings or Key Vault

# Note: AI provider keys are NOT needed here.
# They are provided via token exchange at runtime from Fabric's AI config.
