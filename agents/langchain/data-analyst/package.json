{
	"name": "data-analyst-agent",
	"version": "0.1.3",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --port 3002",
		"dev:server": "PORT=8130 tsx unified-server.ts",
		"dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
		"build": "tsup --config tsup.config.ts",
		"build:next": "next build",
		"build:all": "next build && tsup --config tsup.config.ts",
		"start": "next start",
		"start:server": "PORT=8130 node dist/unified-server.js",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^2.0.56",
		"@ai-sdk/google": "^2.0.46",
		"@ai-sdk/mcp": "^1.0.0",
		"@ai-sdk/openai": "^2.0.80",
		"@ai-sdk/react": "^2.0.109",
		"@anthropic-ai/claude-agent-sdk": "^0.2.141",
		"@hono/node-server": "^2.0.11",
		"@langchain/anthropic": "^1.3.17",
		"@langchain/core": "^1.1.24",
		"@langchain/groq": "1.1.0",
		"@langchain/langgraph": "^1.1.4",
		"@langchain/mcp-adapters": "^1.1.3",
		"@langchain/openai": "^1.2.7",
		"@modelcontextprotocol/sdk": "^1.24.3",
		"@openai/agents": "^0.3.7",
		"@repo/agent-core": "workspace:*",
		"@repo/agent-tools": "workspace:*",
		"@repo/observability": "workspace:*",
		"@repo/utils": "workspace:*",
		"ai": "^6.0.116",
		"clsx": "^2.1.1",
		"hono": "^4.12.34",
		"next": "16.2.11",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-markdown": "^9.1.0",
		"recharts": "^3.6.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.4.0",
		"undici": "^8.5.0",
		"uuid": "^14.0.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"concurrently": "^9.1.2",
		"eslint": "^9",
		"eslint-config-next": "16.0.7",
		"jsdom": "^26.1.0",
		"prettier": "^3.7.4",
		"tailwindcss": "^4",
		"tsup": "^8.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5",
		"vitest": "^4.1.8"
	}
}
