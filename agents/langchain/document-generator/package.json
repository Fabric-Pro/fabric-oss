{
	"name": "document-generator-agent",
	"private": true,
	"version": "1.0.3",
	"license": "Apache-2.0",
	"description": "LangGraph agent for document generation with AG-UI and A2A protocol support",
	"type": "module",
	"scripts": {
		"dev": "langgraph dev --host localhost --port 8124 --no-browser",
		"dev:a2a": "PORT=8224 tsx a2a-server.ts",
		"dev:all": "concurrently \"npm run dev\" \"npm run dev:a2a\"",
		"dev:proxy": "PORT=8124 tsx proxy-server.ts",
		"build": "tsup --config tsup.config.ts",
		"type-check": "tsc --noEmit",
		"start": "node dist/unified-server.js",
		"start:a2a": "PORT=8224 node dist/a2a-server.js",
		"start:proxy": "PORT=8124 node dist/proxy-server.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.11",
		"@langchain/anthropic": "^1.3.17",
		"@langchain/core": "^1.1.24",
		"@langchain/groq": "1.1.0",
		"@langchain/langgraph": "^1.1.4",
		"@langchain/openai": "^1.2.7",
		"@repo/agent-core": "workspace:*",
		"@repo/agent-prompts": "workspace:*",
		"@repo/agent-tools": "workspace:*",
		"@repo/agent-types": "workspace:*",
		"@repo/logs": "workspace:*",
		"@repo/observability": "workspace:*",
		"hono": "^4.12.34",
		"undici": "^8.5.0",
		"uuid": "^14.0.2"
	},
	"devDependencies": {
		"@langchain/langgraph-cli": "1.1.13",
		"@types/node": "^22.10.5",
		"concurrently": "^9.1.2",
		"tsup": "^8.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	}
}
