{
	"name": "api-agent",
	"version": "1.0.3",
	"license": "Apache-2.0",
	"description": "LangGraph API Agent for executing OpenAPI tools with AG-UI and A2A protocol support",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "PORT=8131 tsx unified-server.ts",
		"dev:legacy-agui": "langgraph dev --host localhost --port 8131 --no-cluster",
		"dev:legacy-a2a": "PORT=8231 tsx a2a-server.ts",
		"dev:legacy-all": "concurrently \"npm run dev:legacy-agui\" \"npm run dev:legacy-a2a\"",
		"build": "tsup --config tsup.config.ts",
		"start": "PORT=8131 node dist/unified-server.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.11",
		"@langchain/anthropic": "^1.3.17",
		"@langchain/core": "^1.1.24",
		"@langchain/groq": "1.1.0",
		"@langchain/langgraph": "^1.1.4",
		"@langchain/openai": "^1.2.7",
		"@repo/agent-core": "workspace:*",
		"@repo/observability": "workspace:*",
		"hono": "^4.12.34",
		"undici": "^8.5.0",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@langchain/langgraph-cli": "1.1.13",
		"@types/node": "^22.10.5",
		"concurrently": "^9.1.2",
		"tsup": "^8.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	}
}
