{
	"name": "backlog-updater-agent",
	"private": true,
	"version": "1.0.4",
	"license": "Apache-2.0",
	"description": "LangGraph agent for AI-powered backlog analysis and updates from project context",
	"type": "module",
	"scripts": {
		"dev": "langgraph dev --host localhost --port 8135 --no-browser",
		"build": "tsup --config tsup.config.ts",
		"type-check": "tsc --noEmit",
		"start": "node dist/server.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@langchain/anthropic": "^1.5.9",
		"@langchain/core": "^1.2.9",
		"@langchain/groq": "1.3.1",
		"@langchain/langgraph": "^1.4.14",
		"@langchain/openai": "^1.5.11",
		"@repo/agent-core": "workspace:*",
		"@repo/logs": "workspace:*",
		"@repo/observability": "workspace:*",
		"undici": "^8.5.0"
	},
	"devDependencies": {
		"@langchain/langgraph-cli": "1.4.5",
		"@types/node": "^22.10.5",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
