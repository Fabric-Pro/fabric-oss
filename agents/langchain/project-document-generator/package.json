{
	"name": "project-document-generator-agent",
	"private": true,
	"version": "1.0.4",
	"license": "Apache-2.0",
	"description": "LangGraph agent for project document generation with AG-UI and A2A protocol support",
	"type": "module",
	"scripts": {
		"dev": "PORT=8129 tsx unified-server.ts",
		"dev:a2a": "PORT=8229 tsx a2a-server.ts",
		"build": "tsup --config tsup.config.ts",
		"type-check": "tsgo --noEmit",
		"start": "node dist/unified-server.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@copilotkit/sdk-js": "1.80.0",
		"@hono/node-server": "^2.1.6",
		"@langchain/anthropic": "^1.5.9",
		"@langchain/core": "^1.3.2",
		"@langchain/groq": "1.3.1",
		"@langchain/langgraph": "^1.4.14",
		"@langchain/openai": "^1.5.11",
		"@repo/agent-core": "workspace:*",
		"@repo/agent-prompts": "workspace:*",
		"@repo/agent-tools": "workspace:*",
		"@repo/agent-types": "workspace:*",
		"@repo/logs": "workspace:*",
		"@repo/observability": "workspace:*",
		"@repo/utils": "workspace:*",
		"hono": "^4.13.16",
		"undici": "^8.5.0",
		"uuid": "^14.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"tsup": "^8.5.0",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
