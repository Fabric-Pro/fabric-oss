	"scripts": {
		"build": "node scripts/build-with-memory-report.mjs -- node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build && node scripts/report-function-sizes.mjs",
		"dev": "next dev --hostname 0.0.0.0",
		"e2e": "pnpm exec playwright test --ui",
		"e2e:ci": "pnpm exec playwright install && pnpm exec playwright test",
		"shadcn-ui": "pnpm dlx shadcn@latest",
		"start": "next start",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"test:api": "vitest __tests__/api",
		"test:unit": "vitest modules",
		"test:all": "pnpm test:coverage && pnpm e2e:ci",
		"type-check": "node --max-old-space-size=10240 ../../node_modules/typescript/lib/tsc.js --noEmit",
		"typegen": "next typegen"
	},
