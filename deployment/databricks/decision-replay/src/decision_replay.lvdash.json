{
	"datasets": [
		{
			"name": "funnel",
			"displayName": "Funnel",
			"queryLines": [
				"SELECT COUNT(*) AS proposals, SUM(CASE WHEN first_human_review_at IS NOT NULL THEN 1 ELSE 0 END) AS reviewed, SUM(CASE WHEN applied_at IS NOT NULL THEN 1 ELSE 0 END) AS applied FROM suggestion_journey WHERE project_id = __aibi_external_value"
			]
		},
		{
			"name": "statuses",
			"displayName": "Statuses",
			"queryLines": [
				"SELECT final_outcome, COUNT(*) AS proposals FROM suggestion_journey WHERE project_id = __aibi_external_value GROUP BY final_outcome ORDER BY proposals DESC"
			]
		},
		{
			"name": "daily",
			"displayName": "Daily",
			"queryLines": [
				"SELECT decision_day, proposed, approved, rejected, applied, failed, superseded, median_review_latency_seconds / 3600.0 AS median_review_hours, applied_cohort_count, mature_applied_count, share_applied_edited_within_7d FROM project_decision_daily WHERE project_id = __aibi_external_value ORDER BY decision_day"
			]
		},
		{
			"name": "ratings",
			"displayName": "Ratings",
			"queryLines": [
				"SELECT feature_key, model, prompt_version_id, event_type, outcome, event_count FROM rating_outcomes WHERE project_id = __aibi_external_value ORDER BY event_count DESC"
			]
		},
		{
			"name": "duplicates",
			"displayName": "Duplicates",
			"queryLines": [
				"SELECT feature_key, model, prompt_version_id, outcome, link_count FROM duplicate_outcomes WHERE project_id = __aibi_external_value ORDER BY link_count DESC"
			]
		},
		{
			"name": "changes_accepted",
			"displayName": "Changes accepted",
			"queryLines": [
				"SELECT SUM(change_accepted) AS accepted, SUM(change_decided) AS decided FROM project_decision_daily WHERE project_id = __aibi_external_value"
			]
		},
		{
			"name": "change_statuses",
			"displayName": "Change outcomes",
			"queryLines": [
				"SELECT CASE outcome WHEN 'applied' THEN 'Applied' WHEN 'notSelected' THEN 'Not selected' WHEN 'alreadyOnRoadmap' THEN 'Already on roadmap' WHEN 'failed' THEN 'Failed' WHEN 'inProgress' THEN 'In progress' WHEN 'rejected' THEN 'Rejected' WHEN 'superseded' THEN 'Superseded' WHEN 'pending' THEN 'Pending' ELSE 'Pending' END AS outcome, COUNT(*) AS changes FROM change_outcomes WHERE project_id = __aibi_external_value GROUP BY outcome ORDER BY changes DESC"
			]
		}
	],
