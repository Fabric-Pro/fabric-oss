# Docker Compose defaults for local development.
# Copy to .env.compose for machine-specific overrides. Do not commit .env.compose.

NODE_ENV=development

# Container-network database URLs.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fabric
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/fabric

TEMPORAL_ADDRESS=temporal:7233
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_URL=http://qdrant:6334
REDIS_URL=redis://redis:6379

NEXT_PUBLIC_SITE_URL=http://localhost:3001
BETTER_AUTH_SECRET=dev-compose-better-auth-secret-change-before-shared-use

# Local MinIO/S3 defaults.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
NEXT_PUBLIC_AVATARS_BUCKET_NAME=avatars
NEXT_PUBLIC_UPLOADS_BUCKET_NAME=uploads
AWS_S3_ENDPOINT=http://minio:9000
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_S3_FORCE_PATH_STYLE=true

# Placeholder for AI gateway-dependent flows. Replace in .env.compose when needed.
AI_GATEWAY_API_KEY=dev-compose-ai-gateway-key-placeholder

DOCUMENT_GENERATOR_URL=http://document-generator:8124
PROJECT_DOCUMENT_GENERATOR_URL=http://project-document-generator:8125
