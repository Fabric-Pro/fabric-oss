# ============================================================================
# WEAVE MULTI-AGENT ORCHESTRATION
# ============================================================================
# Service URLs — Aspire injects these automatically. Only needed for manual dev.
# WEAVE_READERS_URL="http://localhost:8140"
# WEAVE_SHUTTLE_URL="http://localhost:8141"
# WEAVE_PLANNERS_URL="http://localhost:8142"
# Internal URL for Shuttle → Next.js coding-run bridge (defaults to http://localhost:3000)
# FABRIC_INTERNAL_URL="http://localhost:3000"

# Hard ceiling (minutes) on a Weave orchestrator run. After this Temporal
# terminates the workflow; the every-5-minute weave-execution-watchdog
# cron then sweeps the row to TERMINATED_STALE and writes a
# weave.session.terminated_stale audit-log entry. Default: 120.
# WEAVE_MAX_RUN_MINUTES="120"

# Same hard ceiling but applied to per-feature coding-run workflows
# (`codingRunWorkflow`). Default: 120.
# CODING_RUN_MAX_MINUTES="120"

# ============================================================================
# AI MODEL REASONING TRACE PERSISTENCE (F-1171)
# ============================================================================

# Opt-in: persist model reasoning text (extended_thinking / o-series thinking blocks)
# alongside conversation messages.
#
# WHY THIS IS OFF BY DEFAULT: Raw model reasoning can contain system-prompt context,
# RAG source citations, MCP tool identifiers, and other workspace data that the model
# received as input but the user did not explicitly author. Persisting this data
# creates durable records that cross reload boundaries, session exports, and
# organization contexts. In multi-tenant environments this is an information-boundary
# risk unless the operator has reviewed the data-handling implications.
#
# Set FABRIC_PERSIST_REASONING_TRACE=true only after reviewing the rationale in
# docs/superpowers/plans/2026-05-14-model-reasoning-trace.md § Data Handling Decision.
# The server-side gate in addMessage / updateConversation / createConversation enforces
# this regardless of what the client sends. The client unconditionally sends
# reasoningText when present; the server is the sole decision point.
FABRIC_PERSIST_REASONING_TRACE=false

# ============================================================================
# SEED DATA
# ============================================================================
SEED_DEV_USERS=true
SEED_ORG_SLUG=example-org
SEED_ORG_NAME=Example Organization

# ============================================================================
# MONITORING V2 FEATURE FLAGS (Kill switches — default ON)
# ============================================================================
#
# Four boolean flags act as KILL SWITCHES for the monitoring surfaces. All
# four default to ON — leave the env vars unset for the standard "fully
# enabled" deployment. Set a flag to "false" / "0" / "no" / "off"
# (case-insensitive) to disable that surface in an emergency without
# redeploying.
#
# Each surface has a SERVER-side env var (FABRIC_FEATURE_*) read by API
# procedures / Temporal activities, and a CLIENT-side mirror
# (NEXT_PUBLIC_FABRIC_FEATURE_*) inlined into the browser bundle. Set BOTH
# to the same value when disabling a flag, otherwise the UI and the
# write path will disagree.

# Settings -> Integrations: provider health badges + Status filter.
# Default ON. Set to false to hide the badges + filter.
# FABRIC_FEATURE_INTEGRATION_HEALTH_BADGES=false
# NEXT_PUBLIC_FABRIC_FEATURE_INTEGRATION_HEALTH_BADGES=false

# In-app SEV-1 / SEV-2 incident banner mounted in the saas shell.
# Default ON. Set to false to suppress the banner.
# FABRIC_FEATURE_INCIDENT_BANNER=false
# NEXT_PUBLIC_FABRIC_FEATURE_INCIDENT_BANNER=false

# Admin monitoring dashboard at /app/admin/monitoring.
# Default ON. Set to false to hide the dashboard route + sidebar entry.
# FABRIC_FEATURE_ADMIN_MONITORING_DASHBOARD=false
# NEXT_PUBLIC_FABRIC_FEATURE_ADMIN_MONITORING_DASHBOARD=false

# Gates whether App Insights `trackEvent` / `trackMetric` calls emit
# (custom-event alerts CircuitBreakerOpened + SyntheticProbeFailing rely
# on these). Default ON. Setting to false is the emergency mute path
# that silences custom-event-driven alert rules without redeploying.
# Server-side only — the UI does not directly consume this; the admin
# dashboard reads the NEXT_PUBLIC_ variant for the rules-status panel.
# FABRIC_FEATURE_BURN_RATE_ALERTS=false
# NEXT_PUBLIC_FABRIC_FEATURE_BURN_RATE_ALERTS=false

# Job Hub: the background-job icon + slide-out panel in the app navigation.
# Client-side only — job rows are always written, so disabling this hides the
# panel without losing the history it would show. Default ON.
# NEXT_PUBLIC_FABRIC_FEATURE_JOB_HUB=false

# Inline job progress on repository + channel connection rows. Independent of
# the Job Hub flag so the inline indicators can be pulled back on their own.
# Default ON.
# NEXT_PUBLIC_FABRIC_FEATURE_INLINE_JOB_PROGRESS=false

# How long finished jobs stay in the Job Hub, in days (1–30, default 7).
# The list query and the nightly `background-job-retention` purge read the
# same value, so they always agree on what "recent" means.
# FABRIC_JOB_RETENTION_DAYS=7
# Fail a running job whose worker died and stopped reporting, in minutes
# (default 45) — set by the `background-job-watchdog` schedule. The default must
# stay above the worst-case silent stretch of any instrumented activity, which
# is its startToCloseTimeout MULTIPLIED BY its retry attempts (code indexing's
# embed batch: 15 min x 5). Too low and a healthy job is reported as timed out.
# FABRIC_JOB_STALE_MINUTES=45

# Dedicated attachments (#1702) — always on. Optional server-authoritative tuning overrides (MAX_BYTES hard ceiling 2 GB):
# FABRIC_ATTACHMENT_MAX_BYTES=26214400
# FABRIC_ATTACHMENT_MAX_PER_STORY=20
# FABRIC_ATTACHMENT_MIME_ALLOWLIST=application/pdf,image/png,...

# AI-chat attachments — a separate system from the story attachments above:
# different pipeline and different allowlist, though the cap now matches. Optional
# server-authoritative overrides; all fail closed. An empty MIME_ALLOWLIST
# rejects every upload, and MAX_BYTES clamps to a 100 MB ceiling.
# FABRIC_AI_CHAT_MAX_BYTES=26214400
# FABRIC_AI_CHAT_MIME_ALLOWLIST=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,...
# Extraction bounds. The character budget applies to chat only — knowledge-base
# ingestion of the same file stays unbounded. The rest bound the workbook walk
# and the archive inflation that precedes it. MAX_INFLATED_BYTES defaults to ten
# times MAX_BYTES: override it too if you lower the cap, or a bomb gets more
# headroom than intended.
# FABRIC_AI_CHAT_EXTRACTED_TEXT_BUDGET_CHARS=100000
# FABRIC_AI_CHAT_MAX_INFLATED_BYTES=262144000
# FABRIC_AI_CHAT_MAX_SHEETS=50
# FABRIC_AI_CHAT_MAX_ROWS=50000
# FABRIC_AI_CHAT_MAX_CELLS=500000
# FABRIC_AI_CHAT_EXTRACTION_DEADLINE_MS=10000

# External PM work-item type mapping (#1305). Backend opt-in flag, default OFF
# (raw process.env, read by API procedures + Temporal activities; mirrors the
# FEATURE_CODE_INDEXING opt-in pattern, not the FABRIC_FEATURE_* kill switches).
# Set to "true" to enable per-kind type mapping on push (ADO) and reverse
# (pull) StoryKind classification. Off = single hardcoded type per project.
FEATURE_PM_TYPE_MAPPING=false

# Living Documents auto-refresh. Opt-in, default OFF (parsed by
# `parseOptInFlag` in packages/utils — NOT one of the FABRIC_FEATURE_* kill
# switches above, which default ON). Gates the per-document enrollment control,
# the enrollment procedures, and the hourly refresh sweep's find-due activity.
# The Temporal schedule registers regardless; gating lives in the handler, so
# flipping this on takes effect on the next tick with no redeploy.
# The FABRIC_ prefix is required — turbo.json passes FABRIC_* through by
# wildcard, and a bare FEATURE_* name would not reach the worker.
# FABRIC_FEATURE_LIVING_DOCS_REFRESH=false
# NEXT_PUBLIC_FABRIC_FEATURE_LIVING_DOCS_REFRESH=false

# PM attachment sync — the server gate on writing Project.syncAttachments, and
# the "Sync attachments with {PM tool}" switch in project
# settings. Opt-in, default OFF. The push half is shipped behind these flags:
# the GitLab reconcile engine uploads unlocked attachments, links them on the
# work item, and notes any excluded locked attachments. The pull/import half
# (bringing files attached on the PM side back into Fabric) does not exist
# yet. Requires the literal string "true" (client flags here are read with
# `=== "true"`, not the looser `parseOptInFlag` most server flags use — the
# two readers are kept
# identical on purpose, so that `=1` cannot open the API write path while the
# toggle meant to drive it stays hidden). The NEXT_PUBLIC_ half is inlined into
# the browser bundle at build time, so changing it needs a rebuild, not a
# restart; the server half is read per call.
# FABRIC_FEATURE_PM_ATTACHMENT_SYNC=false
# NEXT_PUBLIC_FABRIC_FEATURE_PM_ATTACHMENT_SYNC=false
#
# Set both together, not just one: the server flag gates the write path
# (`update-project`) and the reconcile engine; the client flag only reveals
# the settings toggle. Client-only leaves a control the user can see but
# cannot enable (the write is still rejected); server-only opens the write
# path with no UI surface to drive it. While the server flag is off,
# `update-project` rejects any request that would set
# `Project.syncAttachments` to true with an HTTP 400 — flipping the client
# flag alone does not bypass that guard.

# Role/Function Tags AI context (#1767 Stage 4) — opt-in, default OFF
# FABRIC_FEATURE_FUNCTION_TAGS=false

# ============================================================================
# AUDIT LOG (docs: docs/audit-log/)
# ============================================================================
#
# Comma-separated list of email addresses that bypass the
# `ORG_AUDIT_LOG_READ` / `ORG_AUDIT_LOG_EXPORT` permission AND the org
# membership check. Used by Fabric SRE to diagnose remote deployments
# without being added as a member of every customer org. Empty (default)
# means no super-admin — only org owners/admins can read the trail.
# Set comma-separated for multiple, e.g. "sre1@example.com,sre2@example.com".
# FABRIC_DEPLOYMENT_ADMIN_EMAILS=""

# Master switch for the Temporal scheduled retention workflow. Default
# OFF so self-hosted operators do not accidentally lose audit history.
# Fabric Cloud sets this to "true". Setting to "false" (or leaving
# unset) prevents the `audit-log-retention` schedule from being
# registered on worker boot — re-enabling requires a worker restart.
# FABRIC_AUDIT_LOG_RETENTION_ENABLED="false"

# Number of days to retain audit_log rows before the daily purge fires.
# 0 (default) = retain forever. Values between 1 and 89 (inclusive) emit
# a non-fatal startup warning because compliance-sensitive
# deployments expect at least 90 days for diagnostic coverage. Fabric
# Cloud sets this to 365.
# FABRIC_AUDIT_LOG_RETENTION_DAYS="0"

# Master kill switch for the automatic error-capture middleware (D16).
# When "true", no `error.*` rows are written to audit_log for any
# procedure throw. Default-on capture is the right behaviour — flip
# this only as a panic button while diagnosing a high-volume capture
# issue. The original error response is UNAFFECTED by this switch.
# FABRIC_AUDIT_ERROR_CAPTURE_DISABLED="false"

# Public audit-log REST API documentation.
# When "true", `GET /api/v1/docs` serves a Swagger-style UI for the
# audit-log REST endpoints (`/api/v1/audit-log`, `/api/v1/audit-log/export`).
# The endpoints themselves work in every environment — only the docs UI
# is env-gated. Default off in prod so the production deployment does
# not advertise its API surface publicly; turn on for staging so SREs
# can experiment.
# FABRIC_PUBLIC_API_DOCS_ENABLED="false"

# Suppress error-capture for specific procedure paths (D16). Comma-
# separated entries. Exact match by default; trailing `*` makes a
# prefix match. Use to silence high-cardinality or known-noisy paths
# (health checks, debug probes). Example:
# FABRIC_AUDIT_ERROR_CAPTURE_SKIP_PATHS="health.ping,debug.*"
# FABRIC_AUDIT_ERROR_CAPTURE_SKIP_PATHS=""

# ---------------------------------------------------------------------------
# ATLAS (the "Atlas" project tab) — default OFF.
# Analyses a connected repository into an AI-described dependency graph
# (Technical + Business lenses) with a graph-grounded AI chat. Background
# analysis runs on Temporal; descriptions use the tenant's configured AI model.
# Set BOTH to "true" to enable: the SERVER var gates the API procedures, the
# NEXT_PUBLIC var reveals the project tab in the browser bundle.
# FABRIC_FEATURE_ATLAS=false
# NEXT_PUBLIC_FABRIC_FEATURE_ATLAS=false
