# ============================================================================
# REAL-TIME COLLABORATION - PartyKit (Local)
# ============================================================================
# PartyKit powers live document co-editing. Three deployment modes are supported
# (validated at startup — see apps/web/modules/shared/lib/partykit-config.ts):
#
#   1. Cloudflare-hosted (SaaS default): set NEXT_PUBLIC_PARTYKIT_HOST to the
#      Workers host, e.g. "<project>.<account>.workers.dev".
#   2. Kubernetes self-hosted (enterprise): set NEXT_PUBLIC_PARTYKIT_HOST to the
#      in-cluster Service, e.g. "partykit.fabric.svc.cluster.local:1999".
#      Requires sticky routing by room at the ingress — see docs/deployment.
#   3. Disabled (no PartyKit): set NEXT_PUBLIC_ENABLE_COLLABORATION="false".
#      Collaboration UI is gracefully hidden; no host required.
#
# NEXT_PUBLIC_PARTYKIT_HOST must be a bare host[:port] with NO scheme — the
# client adds the WebSocket scheme (ws/wss) automatically.

NEXT_PUBLIC_PARTYKIT_HOST="localhost:1999"
NEXT_PUBLIC_ENABLE_COLLABORATION="true"
COLLAB_JWT_SECRET=""
#PARTYKIT_HOST="https://<your-project>.<your-account>.partykit.dev"
