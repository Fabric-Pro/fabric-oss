# Kill-switch for AI title generation on Feature/Bug creation.
# Unset or "true" = enabled (default). "false" = disabled — generator short-circuits
# to timestamped Untitled fallback (Untitled – YYYY-MM-DD HH:mm UTC).
# Use as a one-line ops revert path; no DB change required.
# AI_TITLE_GENERATION_ENABLED=true

# Kill-switch for Anthropic prompt caching on Databricks-served Claude.
# Unset (default) = the Databricks compat shim injects `cache_control` breakpoints
# into Claude chat-completions bodies so the prompt prefix is cached and re-billed
# at the cache-read rate. Any truthy value ("1", "true") = stop injecting.
# Use as a one-line ops revert path if a serving endpoint ever rejects the field.
# DATABRICKS_PROMPT_CACHE_DISABLED=

