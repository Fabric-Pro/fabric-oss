# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=""
# Service principal OAuth M2M credentials (preferred)
DATABRICKS_CLIENT_ID=""
DATABRICKS_CLIENT_SECRET=""
# Personal access token alternative; takes precedence over OAuth when set
DATABRICKS_TOKEN=""
# Database auth: "password" (default) or "databricks-oauth" (Lakebase OAuth rotation)
# DATABASE_AUTH_PROVIDER="password"
# Worker RLS strategy: "bypassrls" (default) or "policy" (host forbids BYPASSRLS)
# WORKER_RLS_MODE="bypassrls"
# Policy mode on managed Postgres (e.g. Lakebase): the fabric_worker role must be
# created by an admin first (docs/deployment/DATABRICKS.md §2.2/§2.5). Set true so
# the RLS deploy skips role management and only applies the worker_bypass policies.
# WORKER_ROLE_PREPROVISIONED="false"
# Local dev only: route `pnpm dev` (Aspire) at DATABASE_URL/DIRECT_URL above instead
# of the local Postgres container — e.g. to test against Lakebase. OFF by default.
# FABRIC_LOCAL_EXTERNAL_DB="false"
# Kill switch for the Databricks branch of "Update using context" spec retrieval
# (opt-in, default OFF; true/1/on/yes enable). Chat tool exposure is NOT gated
# here — disconnecting the project binding covers that path.
FABRIC_FEATURE_PROJECT_DATABRICKS_KNOWLEDGE="false"

