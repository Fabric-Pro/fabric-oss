public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@opentelemetry/*
public-hoist-pattern[]=prom-client
# Transitive deps that Turbopack traces during apps/web's Next.js build. The
# parent packages (@ag-ui/client, @copilotkitnext/*, better-auth/telemetry,
# d3, d3-delaunay, rehype-katex) don't declare these as their own deps, so
# without hoisting them publicly pnpm's strict-isolation layout leaves them
# unreachable from the consumers' node_modules. Vercel's Turbopack build
# started failing on them on 2026-05-13 ~18:00 UTC when an upstream registry
# publish (likely @ag-ui/client 0.0.45) shifted the resolution.
public-hoist-pattern[]=uuid
public-hoist-pattern[]=katex
public-hoist-pattern[]=d3-format
public-hoist-pattern[]=delaunator
public-hoist-pattern[]=@better-auth/core
