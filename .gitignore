# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local guidances and investigations (not committed)
guidances/

# Local specs (planning artifacts kept out of git; tracked in .specs/)
.specs/
specs/
docs/specs/*/
.claude/specs/
fabric/specs/*/
# Internal planning artifacts (ce-brainstorm / ce-plan). Removed from the
# public-bound tree in Fizzy #2079 — keep them local so they cannot be
# re-added by a planning workflow. Durable lessons belong in docs/solutions/.
docs/plans/
# Working specs and plans: kept locally, never a publication path.
docs/superpowers/

# Claude Code git worktrees — never commit these (they get committed as
# stray gitlinks when `git add` is run while a worktree dir is present)
.claude/worktrees/

# dependencies
node_modules
.pnp
.pnp.js

