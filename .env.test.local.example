# Optional. Copy to `.env.test.local` to let the root `pnpm test` sweep run the
# database-gated suites against your local Postgres. The sweep loads ONLY this
# file, never `.env.local`, so keep it to the database URLs: anything else you
# add here reaches every unit test in the monorepo. Without the file the
# database-gated suites self-skip, exactly as they do in CI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabric"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fabric"
